-- Temporary server runner for a Studio Play session; never mapped into the live game.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local services = game.ServerScriptService.Services
local Dev = require(services.StudioDevService)
local Race = require(services.RaceService)
local Course = require(services.CourseService)
local results = {}
local function waitFor(predicate, timeout)
    local deadline = os.clock() + timeout
    repeat if predicate() then return end; task.wait(0.1) until os.clock() > deadline
    error("Timed out waiting for test state")
end
local function check(name, predicate)
    assert(predicate, name)
    table.insert(results, name)
end
local ok, problem = xpcall(function()
    waitFor(function() return #Players:GetPlayers() > 0 and game.ReplicatedStorage.Remotes:FindFirstChild("StudioDevControl") end, 30)
    local player = Players:GetPlayers()[1]
    waitFor(function() return player.Character and player.Character:FindFirstChild("HumanoidRootPart") end, 20)
    local function request(payload)
        task.wait(0.2)
        return Dev.HandleRequest(player, payload)
    end
    check("Malformed payload rejected", request("bad").ok == false)
    check("Unknown action rejected", request({action="ExecuteCode",code="error('unexpected')"}).ok == false)
    check("Unknown map rejected", request({action="Map",courseId="city_run_v1"}).ok == false)
    check("Fractional checkpoint rejected", request({action="Teleport",destination="Checkpoint",checkpointIndex=1.5}).ok == false)
    check("Infinity checkpoint rejected", request({action="Teleport",destination="Checkpoint",checkpointIndex=math.huge}).ok == false)
    check("NaN checkpoint rejected", request({action="Teleport",destination="Checkpoint",checkpointIndex=0/0}).ok == false)
    check("Start accepted", request({action="StartRace"}).ok)
    waitFor(function() return Race.IsRaceActive() end, 15)
    local current = Course.GetActiveCourse()
    check("V3 is active", current:GetAttribute("MapVersion") == "V3")
    local probe = current:FindFirstChild("__DevelopmentSyncProbe", true)
    check("Edit-mode geometry reaches Play", probe and probe.Position == Vector3.new(11341, 61, 261) and probe.Size == Vector3.new(7, 3, 5))
    check("Retired inspection system inactive", Course.IsInspectionMode() == false and not workspace:FindFirstChild("CityRunInspectionContext"))
    check("Unlimited timer accepted", request({action="UnlimitedTime",enabled=true}).ok and Race.IsInspectionUnlimitedTime())
    check("Checkpoint jump accepted", request({action="Teleport",destination="Checkpoint",checkpointIndex=1}).ok)
    check("Checkpoint progress updated", require(services.CheckpointService).GetLatestCheckpointIndex(player) == 1)
    check("Start jump accepted", request({action="Teleport",destination="Start"}).ok)
    check("Start resets checkpoint progress", require(services.CheckpointService).GetLatestCheckpointIndex(player) == 0)
    check("End race accepted with unlimited time", request({action="EndRace"}).ok)
    waitFor(function() return Race.GetRaceState() == "RaceEnding" or Race.GetRaceState() == "Results" end, 5)
    check("Unlimited timer does not block End Race", not Race.IsRaceActive())
    check("Restart from results accepted", request({action="RestartRace"}).ok)
    waitFor(function() return Race.IsRaceActive() end, 15)
    check("Hold lobby accepted", request({action="HoldLobby"}).ok)
    waitFor(function() return Race.GetRaceState() == "WaitingForPlayers" and Course.GetActiveCourse() == nil end, 6)
    task.wait(2)
    check("Lobby remains held", Race.GetRaceState() == "WaitingForPlayers")
    check("Resume from lobby accepted", request({action="StartRace"}).ok)
    waitFor(function() return Race.IsRaceActive() end, 15)
    check("Archived Classic Ascent unavailable", request({action="Map",courseId="classic_ascent_point_to_point"}).ok == false)
    check("Map switch accepted", request({action="Map",courseId="classic_circuit"}).ok)
    waitFor(function() return Course.GetActiveCourseId() == "classic_circuit" and Race.IsRaceActive() end, 20)
    check("Classic Circuit loads", Course.GetActiveCourse() ~= nil)
    check("Switch back to V3 accepted", request({action="Map",courseId="city_run"}).ok)
    waitFor(function() return Course.GetActiveCourseId() == "city_run" and Race.IsRaceActive() end, 20)
    check("V3 source survives map switching", Course.GetActiveCourse():FindFirstChild("__DevelopmentSyncProbe", true) ~= nil)
    check("Advance state accepted", request({action="NextState"}).ok)
    waitFor(function() return not Race.IsRaceActive() end, 5)
    check("Hold lobby after advance accepted", request({action="HoldLobby"}).ok)
    waitFor(function() return Race.GetRaceState() == "WaitingForPlayers" and Course.GetActiveCourse() == nil end, 6)
end, debug.traceback)
workspace:SetAttribute("DevelopmentWorkflowTest", HttpService:JSONEncode({ok=ok,passed=results,error=if ok then nil else problem}))
print("[DevelopmentWorkflowTest]", ok, #results, problem)

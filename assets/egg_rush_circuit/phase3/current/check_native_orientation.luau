local flips = {
    {Name = "Source", Sign = Vector3.new(1, 1, 1)},
    {Name = "Y180", Sign = Vector3.new(-1, 1, -1)},
    {Name = "X180", Sign = Vector3.new(1, -1, -1)},
    {Name = "Z180", Sign = Vector3.new(-1, -1, 1)},
}

local function triangleDistance(origin, direction, a, b, c)
    local edge1, edge2 = b - a, c - a
    local cross = direction:Cross(edge2)
    local determinant = edge1:Dot(cross)
    if math.abs(determinant) < 1e-8 then return nil end
    local inverse = 1 / determinant
    local offset = origin - a
    local u = offset:Dot(cross) * inverse
    if u < -1e-7 or u > 1.0000001 then return nil end
    local q = offset:Cross(edge1)
    local v = direction:Dot(q) * inverse
    if v < -1e-7 or u + v > 1.0000001 then return nil end
    local distance = edge2:Dot(q) * inverse
    return distance >= 0 and distance or nil
end

local function expectedDistance(row, vertices, origin, direction, length)
    local nearest = nil
    for _, triangle in ipairs(row.triangles) do
        local distance = triangleDistance(origin, direction, vertices[triangle[1]], vertices[triangle[2]], vertices[triangle[3]])
        if distance and distance <= length and (not nearest or distance < nearest) then nearest = distance end
    end
    return nearest
end

local function createMarker(parent, frame, point, index)
    local marker = Instance.new("Part")
    marker.Name = "ExpectedSourcePoint_" .. index
    marker.Shape = Enum.PartType.Ball
    marker.Size = Vector3.new(.22, .22, .22)
    marker.CFrame = frame * CFrame.new(point)
    marker.Anchored, marker.CanCollide, marker.CanTouch, marker.CanQuery = true, false, false, false
    marker.Material = Enum.Material.Neon
    marker.Color = Color3.fromRGB(65, 180, 255)
    marker:SetAttribute("EROrientationGuide", true)
    marker.Parent = parent
end

function Check.run(library, frame, options)
    assert(typeof(frame) == "CFrame", "Supply a safe isolated probe-center CFrame.")
    options = options or {}
    local correction = options.Correction or CFrame.identity
    assert(typeof(correction) == "CFrame", "Correction must be a CFrame.")
    local workspace = game:GetService("Workspace")
    local testName = options.Name or "ER_Phase3_OrientationProbe"
    assert(not workspace:FindFirstChild(testName), "A probe with this name already exists; inspect it before cleanup.")
    local folder = Instance.new("Folder")
    folder.Name = testName
    folder:SetAttribute("EROwnedTemporaryTest", true)
    folder.Parent = workspace
    local report = {build = "ER_P3_WORLD_KIT_A03", assetId = "80825818781490", meshes = {},
        proofBoundary = "Raycasts inspect imported collision geometry, which may simplify the rendered mesh. Source compatibility is evidence against the tested 180-degree flips, not final rendered visual acceptance or proof against every possible transform.",
        expectedMarkers = "Blue markers are exact A03 source contour vertices in the proposed local frame.",
        sourcePackageSHA256 = "39f0633130f71e05f1282f59280940a39772ba386ec074a8a6d6fac5baf0b69e"}
    local ok, failure = pcall(function()
        for meshIndex, key in ipairs({"PipeElbow", "RockLobe"}) do
            local row = source[key]
            local original = assert(library:FindFirstChild("ERW_" .. key, true), "Missing ERW_" .. key)
            assert(original:IsA("MeshPart"), original:GetFullName())
            local clone = original:Clone()
            clone.Name = "Probe_" .. key
            clone.Size = Vector3.new(table.unpack(row.size))
            local meshFrame = frame * CFrame.new((meshIndex - 1) * 60, 0, 0)
            clone.CFrame = meshFrame * correction
            clone.Anchored, clone.CanCollide, clone.CanTouch, clone.CanQuery = true, false, false, true
            clone.Transparency = 0
            clone.Parent = folder
            local query = RaycastParams.new()
            query.FilterType = Enum.RaycastFilterType.Include
            query.FilterDescendantsInstances = {clone}
            query.RespectCanCollide = false
            local candidates = {}
            for _, flip in ipairs(flips) do
                local candidate = {Name = flip.Name, vertices = {}, error = 0, disagreements = 0}
                for _, point in ipairs(row.vertices) do
                    table.insert(candidate.vertices, Vector3.new(table.unpack(point)) * clone.Size * flip.Sign)
                end
                table.insert(candidates, candidate)
            end
            if options.ShowExpectedMarkers then
                for _, index in ipairs(row.markers) do createMarker(folder, meshFrame, candidates[1].vertices[index], key .. "_" .. index) end
            end
            local record = {name = key, collisionFidelity = tostring(clone.CollisionFidelity),
                originalFrame = {original.CFrame:GetComponents()}, expectedFrame = {meshFrame:GetComponents()},
                testedFrame = {clone.CFrame:GetComponents()}, correction = {correction:GetComponents()}, rays = {}}
            for axis = 1, 3 do
                local axisVector = axis == 1 and Vector3.xAxis or (axis == 2 and Vector3.yAxis or Vector3.zAxis)
                local axisSize = row.size[axis]
                for _, u in ipairs({-.34, -.18, 0, .18, .34}) do
                    for _, v in ipairs({-.34, -.18, 0, .18, .34}) do
                        local position = axis == 1 and Vector3.new(-.85 * axisSize, u * row.size[2], v * row.size[3])
                            or (axis == 2 and Vector3.new(u * row.size[1], -.85 * axisSize, v * row.size[3])
                            or Vector3.new(u * row.size[1], v * row.size[2], -.85 * axisSize))
                        local length = 1.7 * axisSize
                        local hit = workspace:Raycast(meshFrame:PointToWorldSpace(position), meshFrame:VectorToWorldSpace(axisVector) * length, query)
                        local actual = hit and hit.Distance or nil
                        local sourceExpected = nil
                        for index, candidate in ipairs(candidates) do
                            local expected = expectedDistance(row, candidate.vertices, position, axisVector, length)
                            if index == 1 then sourceExpected = expected end
                            if (expected == nil) ~= (actual == nil) then
                                candidate.error += 1
                                candidate.disagreements += 1
                            elseif expected and actual then
                                candidate.error += math.abs(expected - actual) / axisSize
                            end
                        end
                        table.insert(record.rays, {axis = axis, u = u, v = v, actualDistance = actual or -1, sourceDistance = sourceExpected or -1})
                    end
                end
            end
            local scores = {}
            for _, candidate in ipairs(candidates) do
                table.insert(scores, {orientation = candidate.Name, meanNormalizedError = candidate.error / #record.rays,
                    hitMissDisagreements = candidate.disagreements, rays = #record.rays})
            end
            table.sort(scores, function(a, b) return a.meanNormalizedError < b.meanNormalizedError end)
            record.scores = scores
            record.bestTestedOrientation = scores[1].orientation
            local separated = scores[2].meanNormalizedError - scores[1].meanNormalizedError >= .005
            local faithful = scores[1].meanNormalizedError <= .03 and scores[1].hitMissDisagreements <= 6
            record.sourceCompatible = scores[1].orientation == "Source" and separated and faithful and clone.CollisionFidelity ~= Enum.CollisionFidelity.Box
            record.status = clone.CollisionFidelity == Enum.CollisionFidelity.Box and "InconclusiveBoxCollision"
                or (not faithful or not separated) and "InconclusiveCollisionApproximation"
                or record.sourceCompatible and "SourceCompatibleAgainstTestedFlips" or "DifferentOrientationFitsBetter"
            report.meshes[key] = record
        end
    end)
    report.keptVisuals = options.KeepVisuals == true
    report.probeFolder = folder:GetFullName()
    if not options.KeepVisuals then folder:Destroy() end
    if not ok then error(failure) end
    return report
end

return Check

   table.insert(rows,relative(v,root).."|"..tostring(v.Size).."|"..table.concat(cf,",").."|"..tostring(v.Color).."|"..tostring(v.CanCollide).."|"..tostring(v.CanQuery).."|"..tostring(v.CanTouch).."|"..tostring(v.Transparency))

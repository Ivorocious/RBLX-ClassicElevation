function WarningPlacements.Apply(course: Model, origin: Vector3)
	local group = course.MapEnvironment.HazardIndicators
	for name, components in placements do
		local sign = group:FindFirstChild(name)
		assert(sign and sign:IsA("Model"), "Missing preserved warning board: " .. name)
		sign:PivotTo(CFrame.new(origin) * CFrame.new(table.unpack(components)))
		sign:SetAttribute("PlacementSource", "Owner's live M02 poses captured October 9")
	end
end

return WarningPlacements

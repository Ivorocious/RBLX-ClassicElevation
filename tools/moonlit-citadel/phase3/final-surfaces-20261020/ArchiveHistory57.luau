 local parts, count = 0, 1
 for _, child in root:GetDescendants() do
  count += 1
  if child:IsA("BasePart") then parts += 1 end
  assert(not ((child:IsA("Script") or child:IsA("LocalScript")) and child.Enabled), "Enabled script in "..row.path)
 end
 if root:IsA("BasePart") then parts += 1 end
 table.insert(prepared, {root=root, originalParent=root.Parent, path=row.path, group=row.group, parts=parts, instances=count})
 totalParts += parts; totalInstances += count
 task.wait()
end

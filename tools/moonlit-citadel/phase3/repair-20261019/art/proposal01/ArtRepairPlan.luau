local retired = {
 ["GalleryHeraldry1"]=true,
 ["GalleryHeraldry2"]=true,
 ["GalleryOneShrub"]=true,
 ["GalleryTwoShrub"]=true,
 ["GalleryThreeShrub"]=true,
}
function Art.Apply(plan)
 local result, found = {}, {}
 for _, data in plan do
  if retired[data.name] then found[data.name]=true; continue end
  local edit=edits[data.name]
  if edit then
   assert(data.asset==edit.beforeAsset and data.library==edit.beforeLibrary,"Art repair unit identity changed")
   local copy=table.clone(data);copy.asset=edit.asset;copy.library=edit.library;copy.materialRole=edit.materialRole;copy.supportUnit=edit.supportUnit;copy.localCF=edit.localCF;copy.scale=edit.scale;data=copy;found[data.name]=true
  end
  table.insert(result,data)
 end
 for name in edits do assert(found[name],"Missing art repair unit "..name) end
 for name in retired do assert(found[name],"Missing retired gallery overlay "..name) end
 return result
end
return Art

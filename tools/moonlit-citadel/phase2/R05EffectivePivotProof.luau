local H=game.HttpService local ss=game.ServerStorage local before=ss.MoonlitR05AssemblyBaseline.R04_FinalB_Workspace local after=ss.CourseLibrary.Course_MoonlitCitadel local out={candidate=after:GetAttribute('CandidateId'),method='Native inactive template getters; stored metadata is separately disclosed by readback',models={}} local function resolve(root,path) local a=root for n in path:gmatch('[^/]+') do a=assert(a:FindFirstChild(n),n) end return a end local function snap(m) local p=assert(m.PrimaryPart) return {name=m.Name,primary=p.Name,primaryCFrame={p.CFrame:GetComponents()},pivotOffset={p.PivotOffset:GetComponents()},effectivePivot={m:GetPivot():GetComponents()},worldPivotGetter={m.WorldPivot:GetComponents()}} end for _,path in ipairs({'Obstacles/MovingCars/Upper_Bay2','Obstacles/UpperMechanism/OutboardWeight2'}) do local a,b=resolve(before,path),resolve(after,path) out.models[#out.models+1]={path=path,before=snap(a),after=snap(b),primaryEqual=a.PrimaryPart.CFrame==b.PrimaryPart.CFrame,pivotOffsetEqual=a.PrimaryPart.PivotOffset==b.PrimaryPart.PivotOffset,effectivePivotEqual=a:GetPivot()==b:GetPivot()} assert(a.PrimaryPart.CFrame==b.PrimaryPart.CFrame and a.PrimaryPart.PivotOffset==b.PrimaryPart.PivotOffset and a:GetPivot()==b:GetPivot()) end return H:JSONEncode(out)

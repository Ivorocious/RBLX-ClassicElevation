on == \"S02\" then \"S02Finished\" else section .. \"Environment\", \"SectionEnvironment\")\n\t\t\tsections[section]:SetAttribute(\"SectionId\", section)\n\t\tend\n\tend\n\tfor sequenceIndex, sequence in ipairs(layout.sequences) do\n\t\tif not selected[sequence.section] then continue end\n\t\tlocal section = sections[sequence.section]\n\t\tlocal vignetteGroup = Kit.Model(section, sequence.id .. \"Planting\", \"RouteFacingPlanting\")\n\t\tvignetteGroup:SetAttribute(\"SequenceId\", sequence.id)\n\t\tlocal points = sequence.points\n\t\tlocal sampleIndices = if sequence.section == \"S02\" then { 1, math.max(1, math.ceil(#points / 2)), #points } else { 1, #points }\n\t\tfor sample, pointIndex in ipairs(sampleIndices) do\n\t\t\tlocal point = points[pointIndex]\n\t\t\tlocal nextPoint = points[math.min(#points, pointIndex + 1)] or point\n\t\t\tlocal previousPoint = points[math.max(1, pointIndex - 1)] or point\n\t\t\tlocal direction = flat(nextPoint.position - previousPoint.position)\n\t\t\tif direction.Magnitude < 0.1 then direction = Vector3.zAxis end\n\t\t\tdirection = direction.Unit\n\t\t\tlocal normal = Vector3.new(direction.Z, 0, -direction.X)\n\t\t\tlocal side = if (sequenceIndex + sample) % 2 == 0 then 1 else -1\n\t\t\tlocal offset = math.sqrt(point.size.X ^ 2 + point.size.Z ^ 2) / 2 + 7.3\n\t\t\tlocal intended = point.position + normal * side * offset\n\t\t\tintended = Vector3.new(intended.X, point.position.Y - 0.8, intended.Z)\n\t\t\tlocal position = locate(intended, 3.65, layout, occupied)\n\t\t\tif not position then continue end\n\t\t\treserve(occupied, position, 3.65)\n\t\t\tlocal frame = origin * CFrame.new(position) * CFrame.Angles(0, math.atan2(direction.X, direction.Z), 0)\n\t\t\tlocal cropOptions = CROPS[sequence.section]\n\t\t\tlocal crop = cropOptions[(sequenceIndex + sample - 2) % #cropOptions + 1]\n\t\t\tlocal bed = planting(vignetteGroup, frame, crop, sequenceIndex + sample, colors)\n\t\t\tbed.Name = crop .. \"Bed\" .. sample\n\t\t\tfoundation(bed, frame, Vector3.new(5.3, 1, 4.2), groundLevel(layout, sequence.section), position.Y, colors)\n\t\t\tif sample == 1 and sequenceIndex % 2 == 0 then\n\t\t\t\tKit.Fence(bed, frame * CFrame.new(0, 0, 2.7), 5.5, colors)\n\t\t\tend\n\t\tend\n\tend\n\treturn sections\nend\n\nlocal function addPet(parent: Instance, family: string, position: Vector3, scale: number, colors: any, origin: CFrame, layout: any, occupied: any): boolean\n\tlocal location = locate(position, 3.2, layout, occupied)\n\tif not location then return false end\n\treserve(occupied, location, 3.2)\n\tlocal frame = origin * CFrame.new(location) * CFrame.Angles(0, 0.6, 0)\n\tlocal group = Kit.Model(parent, family .. \"Vignette\", \"PetVignette\")\n\tlocal soilOffset = if family == \"Bee\" or family == \"Dragonfly\" then -1.8 else -0.2\n\tlocal soilFrame = frame * CFrame.new(0, soilOffset, 0)\n\tlocal bed = Kit.Planter(group, soilFrame, Vector3.new(5.5, 1, 4.4), colors)\n\tfoundation(bed, soilFrame, Vector3.new(5.5, 1, 4.4), -5, location.Y + soilOffset, colors)\n\tKit[family](bed, frame * CFrame.new(0, 0.08, 0), scale, colors)\n\tif family == \"Rabbit\" then Kit.Carrot(bed, frame * CFrame.new(1.65, 0, -0.9), 0.65, colors) end\n\tif family == \"Bee\" or family == \"Dragonfly\" then Kit.Flower(bed, soilFrame * CFrame.new(-1.5, 0.1, 0), 0.9, colors) end\n\treturn true\nend\n\nlocal function landmarks(art: Model, layout: any, colors: any, origin: CFrame, selected: any, occupied: any)\n\tlocal group = art:FindFirstChild(\"LandmarkContext\") or Kit.Model(art, \"LandmarkContext\", \"GardenLandmarks\")\n\tlocal s02Only = selected.S02 and not selected.S01\n\tfor tree, intended in ipairs({ Vector3.new(205, -5, -186), Vector3.new(190, -5, -222), Vector3.new(222, -5, -131), Vector3.new(167, -5, -209) }) do\n\t\tif group:FindFirstChild(\"CandyBlossom\" .. tree) then continue end\n\t\tif (selected.S03 or s02Only) and (not s02Only or tree <= 2) then\n\t\t\tlocal position = locate(intended, 7, layout, occupied)\n\t\t\tif position then\n\t\t\t\treserve(occupied, position, 7)\n\t\t\t\tlocal frame = origin * CFrame.new(position) * CFrame.Angles(0, tree * 0.4, 0)\n\t\t\t\tlocal model = Kit.CandyBlossom(group, frame, if tree % 2 == 0 then 13 else 15, colors)\n\t\t\t\tmodel.Name = \"CandyBlossom\" .. tree\n\t\t\t\tlocal bed = Kit.Planter(model, frame, Vector3.new(8.5, 1, 7), colors)\n\t\t\t\tKit.Flower(bed, frame * CFrame.new(-3.2, 0, 1.8), 0.9, colors, colors.Purple)\n\t\t\t\tKit.Flower(bed, frame * CFrame.new(2.8, 0, -2.2), 0.75, colors)\n\t\t\tend\n\t\tend\n\tend\n\tif (selected.S04 or s02Only) and not group:FindFirstChild(\"Beanstalk\") then\n\t\tlocal position = locate(Vector3.new(-60, -5, -174), 6.8, layout, occupied)\n\t\tif position then\n\t\t\treserve(occupied, position, 6.8)\n\t\t\tlocal frame = origin * CFrame.new(position)\n\t\t\tlocal vine = Kit.Beanstalk(group, frame, 31, colors)\n\t\t\tlocal bed = Kit.Planter(vine, frame, Vector3.new(9, 1, 9), colors)\n\t\t\tKit.Flower(bed, frame * CFrame.new(-3.5, 0.02, 2.7), 0.8, colors)\n\t\t\tKit.Flower(bed, frame * CFrame.new(3.3, 0.02, -2.9), 0.75, colors, colors.PinkLight)\n\t\tend\n\tend\nend\n\nlocal function shopAndFestival(art: Model, layout: any, colors: any, origin: CFrame, selected: any, occupied: any)\n\tlocal group = art:FindFirstChild(\"GardenArrival\") or Kit.Model(art, \"GardenArrival\", \"ArrivalAndFinish\")\n\tif selected.S01 then\n\t\tlocal position = locate(Vector3.new(-213, 0, 157), 10, layout, occupied)\n\t\tif position then\n\t\t\treserve(occupied, position, 10)\n\t\t\tlocal frame = origin * CFrame.new(position) * CFrame.Angles(0, math.pi, 0)\n\t\t\tlocal shop = Kit.SeedShop(group, frame, colors)\n\t\t\tfoundation(shop, frame, Vector3.new(13, 1, 4.5), groundLevel(layout, \"S01\"), position.Y, colors)\n\t\t\tKit.Pot(shop, frame * CFrame.new(-7.5, 0, -2.1), Vector3.new(2.5, 2.2, 2.5), colors)\n\t\t\tKit.Sunflower(shop, frame * CFrame.new(-7.5, 2.3, -2.1), 0.85, colors)\n\t\tend\n\tend\n\tif selected.S05 then\n\t\tlocal finish = layout.finish\n\t\tif finish then\n\t\t\tlocal frame = origin * CFrame.new(finish.position)\n\t\t\tlocal gate = Kit.Model(group, \"FestivalFinish\", \"Festival\")\n\t\t\tlocal halfWidth = finish.size.X / 2 + 1.7\n\t\t\tfor i, x in ipairs({ -halfWidth, halfWidth }) do\n\t\t\t\tKit.Part(gate, \"FinishPost\" .. i, frame * CFrame.new(x, 8.8, 0), Vector3.new(1.0, 17.6, 1.0), colors.Honey)\n\t\t\t\tKit.Part(gate, \"PostTop\" .. i, frame * CFrame.new(x, 17.7, 0), Vector3.new(1.4, 0.4, 1.4), colors.HoneyLight)\n\t\t\tend\n\t\t\tKit.Part(gate, \"BuntingCord\", frame * CFrame.new(0, 17.4, 0), Vector3.new(halfWidth * 2, 0.13, 0.13), colors.WoodDark, { studs = false })\n\t\t\tfor flag = 1, 9 do\n\t\t\t\tlocal x = (flag - 5) * halfWidth * 2 / 10\n\t\t\t\tKit.Wedge(gate, \"FestivalFlag\" .. flag, frame * CFrame.new(x, 16.66, 0) * CFrame.Angles(0, 0, math.pi), Vector3.new(1.3, 1.4, 0.09), ({ colors.Pink, colors.Gold, colors.Aqua })[(flag - 1) % 3 + 1])\n\t\t\tend\n\t\t\tKit.Sign(gate, \"FinishSign\", frame * CFrame.new(0, 13.5, 0) * CFrame.Angles(0, math.pi, 0), \"FINISH\", 7.5, colors)\n\t\tend\n\tend\nend\n\nlocal function routeFrames(art: Model, layout: any, colors: any, origin: CFrame, selected: any)\n\tlocal group = art:FindFirstChild(\"GardenFrames\") or Kit.Model(art, \"GardenFrames\", \"RouteArchitecture\")\n\tfor _, sequence in ipairs(layout.sequences) do\n\t\tif selected[sequence.section] and (sequence.id == \"M1A\" or sequence.id == \"D3\" or sequence.id == \"E2\") then\n\t\t\tlocal point = sequence.points[math.max(1, math.ceil(#sequence.points / 2))]\n\t\t\tlocal frame = origin * CFrame.new(point.position) * CFrame.Angles(0, math.rad(point.yaw or 0), 0)\n\t\t\tlocal trellis = Kit.Trellis(group, frame, point.size.X + 10, colors)\n\t\t\ttrellis.Name = sequence.id .. \"Trellis\"\n\t\t\ttrellis:SetAttribute(\"SequenceId\", sequence.id)\n\t\tend\n\tend\nend\n\nlocal function populate(parent: Instance, cfg: any, layout: any, selected: any, art: Model, occupied: any): Model\n\tlocal origin, colors = originFrame(cfg.Origin), Kit.Colors(cfg.Palette)\n\tlandmarks(art, layout, colors, origin, selected, occupied)\n\tshopAndFestival(art, layout, colors, origin, selected, occupied)\n\tlocal sections = cropLanes(art, layout, colors, origin, selected, occupied)\n\tdecorateSurfaces(parent, layout, selected, colors, origin)\n\thazardVisuals(art, cfg, layout, colors, selected)\n\trouteFrames(art, layout, colors, origin, selected)\n\tfor section, group in pairs(sections) do\n\t\tlocal first\n\t\tfor _, sequence in ipairs(layout.sequences) do\n\t\t\tif sequence.section == section then first = sequence.points[1] break end\n\t\tend\n\t\tif not first then continue end\n\t\tlocal y = first.position.Y - 0.8\n\t\tlocal petPosition = Vector3.new(first.position.X + 20, y, first.position.Z + 17)\n\t\taddPet(group, if section == \"S03\" then \"Dragonfly\" elseif section == \"S04\" then \"Bee\" else \"Rabbit\", petPosition, if section == \"S03\" then 0.85 else 1, colors, origin, layout, occupied)\n\t\tif section == \"S02\" then\n\t\t\taddPet(group, \"Bee\", Vector3.new(80, 3.8, 171), 0.9, colors, origin, layout, occupied)\n\t\t\tlocal location = locate(Vector3.new(177, 2.2, 119), 4.3, layout, occupied)\n\t\t\tif location then\n\t\t\t\treserve(occupied, location, 4.3)\n\t\t\t\tKit.EggDisplay(group, origin * CFrame.new(location), colors)\n\t\t\tend\n\t\tend\n\tend\n\tlocal inventory = Kit.Inventory(art)\n\tart:SetAttribute(\"ArtParts\", inventory.parts)\n\tart:SetAttribute(\"ArtCollidableParts\", inventory.collidable)\n\tart:SetAttribute(\"ArtMeshParts\", inventory.meshParts)\n\tart:SetAttribute(\"ArtLights\", inventory.lights)\n\tlocal skinParts = 0\n\tfor _, object in ipairs(parent:GetDescendants()) do\n\t\tif object:IsA(\"Model\") and object.Name == \"NativeSkin\" then skinParts += Kit.Inventory(object).parts end\n\tend\n\tart:SetAttribute(\"NativeSkinParts\", skinParts)\n\tart:SetAttribute(\"PerformanceEvidence\", \"Inventory only; target-device and 20-racer frame time unmeasured\")\n\treturn art\nend\n\nfunction Art.Create(parent: Instance, cfg: any, layout: any, mode: string?): Model\n\tassert(not parent:FindFirstChild(\"Art\"), \"Stud Garden Art already exists; preserve current native edits\")\n\tlocal selected = if mode == \"S02\" or mode == \"Representative\" or mode == \"representative\" then { S02 = true } else { S01 = true, S02 = true, S03 = true, S04 = true, S05 = true }\n\tlocal art = Kit.Model(parent, \"Art\", \"StudGardenEnvironment\")\n\tart:SetAttribute(\"BuildId\", cfg.BuildId or \"SG_V1_01\")\n\tart:SetAttribute(\"ArtMode\", if selected.S01 then \"Full\" else \"S02\")\n\tart:SetAttribute(\"AssetSource\", \"Original native block and stud art; no uploaded assets\")\n\tpopulate(parent, cfg, layout, selected, art, {})\n\tArt.Enrich(parent, cfg, layout)\n\treturn art\nend\n\nlocal function existingReservations(art: Model, origin: CFrame): any\n\tlocal occupied = {}\n\tlocal families = { Planter = true, PetVignette = true, LandmarkCandyBlossom = true, LandmarkBeanstalk = true, FacadeSeedShop = true }\n\tfor _, object in ipairs(art:GetDescendants()) do\n\t\tif not object:IsA(\"Model\") or not families[object:GetAttribute(\"StudGardenFamily\")] then continue end\n\t\tlocal nested = false\n\t\tlocal ancestor = object.Parent\n\t\twhile ancestor and ancestor ~= art do\n\t\t\tif families[ancestor:GetAttribute(\"StudGardenFamily\")] then nested = true break end\n\t\t\tancestor = ancestor.Parent\n\t\tend\n\t\tif nested then continue end\n\t\tlocal minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge\n\t\tfor _, part in ipairs(object:GetDescendants()) do\n\t\t\tif not part:IsA(\"BasePart\") then continue end\n\t\t\tfor _, x in ipairs({ -0.5, 0.5 }) do\n\t\t\t\tfor _, y in ipairs({ -0.5, 0.5 }) do\n\t\t\t\t\tfor _, z in ipairs({ -0.5, 0.5 }) do\n\t\t\t\t\t\tlocal point = origin:PointToObjectSpace(part.CFrame:PointToWorldSpace(Vector3.new(part.Size.X * x, part.Size.Y * y, part.Size.Z * z)))\n\t\t\t\t\t\tminX, maxX = math.min(minX, point.X), math.max(maxX, point.X)\n\t\t\t\t\t\tminZ, maxZ = math.min(minZ, point.Z), math.max(maxZ, point.Z)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tif minX < math.huge then\n\t\t\treserve(occupied, Vector3.new((minX + maxX) / 2, 0, (minZ + maxZ) / 2), math.sqrt((maxX - minX) ^ 2 + (maxZ - minZ) ^ 2) / 2)\n\t\tend\n\tend\n\treturn occupied\nend\n\nfunction Art.Complete(parent: Instance, cfg: any, layout: any): Model\n\tlocal art = parent:FindFirstChild(\"Art\")\n\tassert(art and art:IsA(\"Model\") and art:GetAttribute(\"ArtMode\") == \"S02\", \"Art.Complete requires the existing S02 milestone\")\n\tassert(art:GetAttribute(\"BuildId\") == (cfg.BuildId or \"SG_V1_01\"), \"Do not expand a different native candidate\")\n\tassert(art:FindFirstChild(\"S02Finished\"), \"Preserve the S02 environment before expansion\")\n\tlocal selected = { S01 = true, S03 = true, S04 = true, S05 = true }\n\tlocal occupied = existingReservations(art, originFrame(cfg.Origin))\n\tpopulate(parent, cfg, layout, selected, art, occupied)\n\tart:SetAttribute(\"ArtMode\", \"Full\")\n\tart:SetAttribute(\"ExpandedFrom\", \"S02 internal milestone; native S02 groups retained\")\n\tArt.Enrich(parent, cfg, layout)\n\treturn art\nend\n\nlocal WALL_SECTIONS = {\n\tOpeningRows = \"S01\", ToolsToPlanters = \"S02\", CropUpperFold = \"S02\", CropMainToExpert = \"S02\", CropReturnToExpert = \"S02\", CropToCandy = \"S02\",\n\tCandyUpperFold = \"S03\", CandyToRootEntry = \"S03\", RootEntryFold = \"S04\", VineMainToExpert = \"S04\", VineToFestival = \"S04\",\n\tFestivalFold = \"S05\", FestivalToTrellis = \"S05\", StartToFestival = \"S01\",\n}\n\nlocal function dividerSkins(course: Instance, close: Model, layout: any, colors: any, origin: CFrame, selected: any)\n\tlocal group = close:FindFirstChild(\"DividerSkins\") or Kit.Model(close, \"DividerSkins\", \"DividerSkins\")\n\tlocal barriers = course:FindFirstChild(\"Barriers\")\n\tfor index, record in ipairs(layout.barriers or {}) do\n\t\tif not selected[WALL_SECTIONS[record.id]] or group:FindFirstChild(record.id) then continue end\n\t\tlocal wall = barriers and barriers:FindFirstChild(record.id)\n\t\tif wall and wall:IsA(\"BasePart\") then\n\t\t\twall.Color, wall.Material = if index % 3 == 0 then colors.TerracottaLight else colors.Honey, Enum.Material.Plastic\n\t\tend\n\t\tlocal model = Kit.Model(group, record.id, \"SolidGardenDividerSkin\")\n\t\tmodel:SetAttribute(\"ColliderOwner\", record.id)\n\t\tmodel:SetAttribute(\"SurfaceIntent\", \"Opaque skin on unchanged solid route divider\")\n\t\tlocal alongX = record.size.X > record.size.Z\n\t\tlocal length = if alongX then record.size.X else record.size.Z\n\t\tlocal width = if alongX then record.size.Z else record.size.X\n\t\tlocal frame = origin * CFrame.new(record.position) * CFrame.Angles(0, if alongX then 0 else math.pi / 2, 0)\n\t\tlocal soilHeight = math.clamp(record.adjacentTop - layout.groundY + 0.4, 2, record.size.Y - 2)\n\t\tfor side = -1, 1, 2 do\n\t\t\tlocal z = side * (width / 2 + 0.025)\n\t\t\tKit.Part(model, \"SoilFace\" .. side, frame * CFrame.new(0, -record.size.Y / 2 + soilHeight / 2, z), Vector3.new(length, soilHeight, 0.08), colors.SoilLight, { studs = false })\n\t\t\tKit.Part(model, \"PlantedTop\" .. side, frame * CFrame.new(0, record.size.Y / 2 - 0.7, z), Vector3.new(length, 1.4, 0.08), colors.LeafLight)\n\t\t\tlocal count = math.max(2, math.ceil(length / 28))\n\t\t\tfor post = 1, count do\n\t\t\t\tlocal x = (post - 1) * length / math.max(1, count - 1) - length / 2\n\t\t\t\tKit.Part(model, \"TimberStile\" .. side .. \"_\" .. post, frame * CFrame.new(x, soilHeight / 2, z + side * 0.035), Vector3.new(0.72, record.size.Y - soilHeight, 0.09), colors.HoneyLight)\n\t\t\tend\n\t\t\tlocal localPosition = Vector3.new(record.position.X, record.adjacentTop + 0.2, record.position.Z) + (if alongX then Vector3.new(0, 0, side * (width / 2 + 0.24)) else Vector3.new(side * (width / 2 + 0.24), 0, 0))\n\t\t\tlocal clear = true\n\t\t\tfor _, sequence in ipairs(layout.sequences) do for _, point in ipairs(sequence.points) do if not rectangleClear(localPosition, 1.3, point, 3) then clear = false break end end if not clear then break end end\n\t\t\tfor _, collection in ipairs({ layout.checkpoints, layout.choices, layout.merges }) do\n\t\t\t\tfor _, point in ipairs(collection) do\n\t\t\t\t\tif not rectangleClear(localPosition, 1.3, point, 3) then clear = false end\n\t\t\t\t\tif point.spawnPosition and not rectangleClear(localPosition, 1.3, { position = point.spawnPosition, size = point.spawnSize }, 3) then clear = false end\n\t\t\t\tend\n\t\t\tend\n\t\t\tif not rectangleClear(localPosition, 1.3, layout.finish, 3) or not rectangleClear(localPosition, 1.3, layout.finish.runoff, 3) then clear = false end\n\t\t\tfor _, hazard in ipairs(layout.hazards) do if not rectangleClear(localPosition, 1.3, hazard.volume, 3) or not rectangleClear(localPosition, 1.3, hazard.safeBefore, 3) or not rectangleClear(localPosition, 1.3, hazard.safeAfter, 3) then clear = false end end\n\t\t\tif clear then\n\t\t\t\tlocal vineFrame = origin * CFrame.new(localPosition) * CFrame.Angles(0, (if alongX then 0 else math.pi / 2) + (if side == 1 then math.pi else 0), 0)\n\t\t\t\tKit.Climber(model, vineFrame, colors, if index % 2 == 0 then colors.PinkLight else colors.White)\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function sprinklerGarden(close: Model, layout: any, colors: any, origin: CFrame, occupied: any)\n\tif close:FindFirstChild(\"H01PlantedBorders\") then return end\n\tlocal group = Kit.Model(close, \"H01PlantedBorders\", \"HazardBorderPlanting\")\n\tfor row, x in ipairs({ 2, 44 }) do\n\t\tlocal valid = true\n\t\tfor _, z in ipairs({ 64, 72, 80, 88, 96, 104 }) do\n\t\t\tif not placementClear(Vector3.new(x, 2.2, z), 3.2, layout, occupied) then valid = false break end\n\t\tend\n\t\tif not valid then continue end\n\t\tlocal position = Vector3.new(x, 2.2, 84)\n\t\tlocal frame = origin * CFrame.new(position)\n\t\tlocal bed = Kit.Planter(group, frame, Vector3.new(5.8, 1, 40), colors)\n\t\tbed.Name = \"MixedCropBorder\" .. row\n\t\tbed:SetAttribute(\"ArtRole\", \"SceneryField\")\n\t\tfoundation(bed, frame, Vector3.new(5.8, 1, 40), layout.groundY, position.Y, colors)\n\t\tKit.Part(bed, \"GroundSoilPatch\", origin * CFrame.new(x, layout.groundY + 0.025, 84), Vector3.new(8.2, 0.05, 42), colors.Soil)\n\t\tfor crop = 1, 7 do\n\t\t\tlocal cropFrame = frame * CFrame.new(if crop % 2 == 0 then -1.2 else 1.0, 0.08, (crop - 4) * 5.2) * CFrame.Angles(0, crop * 0.8, 0)\n\t\t\tif crop % 3 == 0 then Kit.Sunflower(bed, cropFrame, 0.94, colors) elseif crop % 2 == 0 then Kit.Carrot(bed, cropFrame, 0.95, colors) else Kit.Strawberry(bed, cropFrame, 1.1, colors) end\n\t\tend\n\t\tfor flower = 1, 5 do\n\t\t\tKit.StemCluster(bed, frame * CFrame.new(if flower % 2 == 0 then 1.5 else -1.5, 0.05, (flower - 3) * 7.1 + 1.2), 0.85, colors, if flower % 2 == 0 then colors.PinkLight else colors.Purple)\n\t\tend\n\t\treserve(occupied, position, 21)\n\tend\nend\n\nlocal function closePockets(close: Model, layout: any, colors: any, origin: CFrame, selected: any, occupied: any)\n\tfor section, enabled in pairs(selected) do\n\t\tif not enabled or close:FindFirstChild(section) then continue end\n\t\tlocal group = Kit.Model(close, section, \"CloseRoutePlanting\")\n\t\tfor sequenceIndex, sequence in ipairs(layout.sequences) do\n\t\t\tif sequence.section ~= section or sequence.kind == \"expert\" then continue end\n\t\t\tlocal stride = if section == \"S02\" then 3 else 6\n\t\t\tfor index = 2, #sequence.points - 1, stride do\n\t\t\t\tlocal point = sequence.points[index]\n\t\t\t\tlocal direction = point.forward or flat(sequence.points[math.min(#sequence.points, index + 1)].position - point.position).Unit\n\t\t\t\tlocal normal = Vector3.new(direction.Z, 0, -direction.X)\n\t\t\t\tlocal halfWidth = math.abs(normal.X) * point.size.X / 2 + math.abs(normal.Z) * point.size.Z / 2\n\t\t\t\tlocal side = if (sequenceIndex + index) % 2 == 0 then 1 else -1\n\t\t\t\tlocal position = point.position + normal * side * (halfWidth + 5.4) - Vector3.new(0, 0.65, 0)\n\t\t\t\tif not placementClear(position, 1.65, layout, occupied) then\n\t\t\t\t\tposition = point.position - normal * side * (halfWidth + 5.4) - Vector3.new(0, 0.65, 0)\n\t\t\t\t\tif not placementClear(position, 1.65, layout, occupied) then continue end\n\t\t\t\tend\n\t\t\t\treserve(occupied, position, 1.65)\n\t\t\t\tlocal frame = origin * CFrame.new(position) * CFrame.Angles(0, sequenceIndex * 0.45, 0)\n\t\t\t\tlocal cluster = Kit.StemCluster(group, frame, if index % 2 == 0 then 1.1 else 0.9, colors, ({ colors.White, colors.Gold, colors.Purple, colors.PinkLight })[(sequenceIndex - 1) % 4 + 1])\n\t\t\t\tcluster.Name = sequence.id .. \"_Stems\" .. index\n\t\t\t\tcluster:SetAttribute(\"ArtRole\", \"SceneryField\")\n\t\t\t\tlocal height = math.max(0.3, position.Y - layout.groundY)\n\t\t\t\tKit.Part(cluster, \"RootSoil\", frame * CFrame.new(0, -height / 2, 0), Vector3.new(1.6, height, 1.4), colors.SoilLight)\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal CORNER_GARDENS = { OpeningRows = true, ToolsToPlanters = true, CropMainToExpert = true, CropReturnToExpert = true, CandyUpperFold = true, VineMainToExpert = true, VineToFestival = true, FestivalFold = true }\n\nfunction Art.LayerGardens(parent: Instance, cfg: any, layout: any): Model\n\tlocal art = parent:FindFirstChild(\"Art\")\n\tassert(art and art:IsA(\"Model\"), \"LayerGardens requires an existing native candidate\")\n\tassert(art:GetAttribute(\"BuildId\") == (cfg.BuildId or \"SG_V1_01\"), \"Do not plant around a different native candidate\")\n\tlocal group = art:FindFirstChild(\"LandmarkPlanting\") or Kit.Model(art, \"LandmarkPlanting\", \"LayeredGardenContext\")\n\tlocal origin, colors = originFrame(cfg.Origin), Kit.Colors(cfg.Palette)\n\tlocal selected = if art:GetAttribute(\"ArtMode\") == \"S02\" then { S02 = true } else { S01 = true, S02 = true, S03 = true, S04 = true, S05 = true }\n\tlocal occupied = existingReservations(art, origin)\n\tlocal radius = 8.8\n\tlocal function field(name: string, intended: Vector3, kind: string): boolean\n\t\tif group:FindFirstChild(name) then return true end\n\t\tlocal position = locate(intended, radius, layout, occupied)\n\t\tif not position then return false end\n\t\treserve(occupied, position, radius)\n\t\tlocal frame = origin * CFrame.new(position)\n\t\tlocal bed = Kit.Planter(group, frame, Vector3.new(10, 1, 8), colors)\n\t\tbed.Name = name\n\t\tbed:SetAttribute(\"ArtRole\", \"SceneryField\")\n\t\tbed:SetAttribute(\"SurfaceIntent\", \"Offset planted context; never a route connection\")\n\t\tbed:SetAttribute(\"ArtRevision\", \"SG_ART_03\")\n\t\tbed:SetAttribute(\"LayoutPosition\", position)\n\t\tbed:SetAttribute(\"PlacementRadius\", radius)\n\t\tfoundation(bed, frame, Vector3.new(10, 1, 8), layout.groundY, position.Y, colors)\n\t\tlocal bankHeight = math.max(0.4, position.Y - layout.groundY)\n\t\tfor side = -1, 1, 2 do\n\t\t\tKit.Part(bed, \"SoilCourse\" .. side, frame * CFrame.new(0, -bankHeight * 0.48, side * 3.92), Vector3.new(9.9, 0.42, 0.14), colors.Honey)\n\t\tend\n\t\tif kind == \"candy\" then\n\t\t\tKit.CandyBlossom(bed, frame * CFrame.new(0.1, 0.05, 0.2) * CFrame.Angles(0, 0.45, 0), 14, colors)\n\t\t\tKit.LeafMass(bed, frame * CFrame.new(-2.8, 0.05, 0.9), 0.65, colors)\n\t\t\tKit.Flower(bed, frame * CFrame.new(3.35, 0.05, -2.25), 1.1, colors, colors.PinkLight)\n\t\telseif kind == \"vine\" then\n\t\t\tKit.LeafMass(bed, frame * CFrame.new(-1.8, 0.05, -0.7), 1.0, colors)\n\t\t\tKit.LeafMass(bed, frame * CFrame.new(2.0, 0.05, 1.0) * CFrame.Angles(0, 1.4, 0), 1.0, colors)\n\t\t\tKit.Bamboo(bed, frame * CFrame.new(0, 0.05, -2.7), 0.95, colors)\n\t\telse\n\t\t\tKit.LeafMass(bed, frame * CFrame.new(-1.3, 0.05, 0.5), if kind == \"corner\" then 1.4 else 1.05, colors)\n\t\t\tif kind == \"corner\" then\n\t\t\t\tKit.Bamboo(bed, frame * CFrame.new(2.5, 0.05, -1.2), 1.1, colors)\n\t\t\telseif kind == \"seed\" then\n\t\t\t\tKit.Carrot(bed, frame * CFrame.new(2.8, 0.05, -1.6), 1.0, colors)\n\t\t\t\tKit.Carrot(bed, frame * CFrame.new(2.7, 0.05, 1.2), 0.9, colors)\n\t\t\telseif kind == \"festival\" then\n\t\t\t\tKit.Sunflower(bed, frame * CFrame.new(2.6, 0.05, -1.8), 1.15, colors)\n\t\t\t\tKit.Sunflower(bed, frame * CFrame.new(2.7, 0.05, 1.2) * CFrame.Angles(0, 0.8, 0), 1.0, colors)\n\t\t\telse\n\t\t\t\tKit.Strawberry(bed, frame * CFrame.new(2.7, 0.05, -1.6), 1.2, colors)\n\t\t\t\tKit.Strawberry(bed, frame * CFrame.new(2.7, 0.05, 1.2), 1.05, colors)\n\t\t\tend\n\t\tend\n\t\treturn true\n\tend\n\tfor _, record in ipairs(layout.barriers or {}) do\n\t\tif not CORNER_GARDENS[record.id] or not selected[WALL_SECTIONS[record.id]] or group:FindFirstChild(record.id .. \"CornerGarden\") then continue end\n\t\tlocal along = if record.size.X > record.size.Z then Vector3.xAxis else Vector3.zAxis\n\t\tlocal normal = Vector3.new(along.Z, 0, -along.X)\n\t\tlocal length = math.max(record.size.X, record.size.Z)\n\t\tfor _, side in ipairs({ 1, -1 }) do\n\t\t\tlocal intended = record.position + along * (length / 2 + 11) + normal * side * 12\n\t\t\tintended = Vector3.new(intended.X, record.adjacentTop - 0.7, intended.Z)\n\t\t\tif field(record.id .. \"CornerGarden\", intended, \"corner\") then break end\n\t\t\tintended = record.position - along * (length / 2 + 11) + normal * side * 12\n\t\t\tintended = Vector3.new(intended.X, record.adjacentTop - 0.7, intended.Z)\n\t\t\tif field(record.id .. \"CornerGarden\", intended, \"corner\") then break end\n\t\tend\n\tend\n\tif selected.S01 then field(\"SeedShopGarden\", Vector3.new(-239, 1, 167), \"seed\") end\n\tif selected.S02 then field(\"CropMiddleGarden\", Vector3.new(84, 4, 100), \"crop\") end\n\tif selected.S03 then\n\t\tfield(\"CandyGroveNear\", Vector3.new(201, 7, -158), \"candy\")\n\t\tfield(\"CandyGroveReturn\", Vector3.new(163, 8, -178), \"candy\")\n\tend\n\tif selected.S04 then\n\t\tfield(\"VineInnerGarden\", Vector3.new(-95, 8, -165), \"vine\")\n\t\tfield(\"VineEntryGarden\", Vector3.new(-25, 7, -145), \"vine\")\n\tend\n\tif selected.S05 and layout.finish then field(\"FestivalHarvestGarden\", layout.finish.position + Vector3.new(34, 0, 17), \"festival\") end\n\tgroup:SetAttribute(\"AddedParts\", Kit.Inventory(group).parts)\n\tgroup:SetAttribute(\"ArtRevision\", \"SG_ART_03\")\n\treturn group\nend\n\nfunction Art.Enrich(parent: Instance, cfg: any, layout: any): Model\n\tlocal art = parent:FindFirstChild(\"Art\")\n\tassert(art and art:IsA(\"Model\"), \"Enrich requires existing native artwork\")\n\tassert(art:GetAttribute(\"BuildId\") == (cfg.BuildId or \"SG_V1_01\"), \"Do not enrich a different native candidate\")\n\tlocal close = art:FindFirstChild(\"CloseGarden\") or Kit.Model(art, \"CloseGarden\", \"CloseGarden\")\n\tlocal selected = if art:GetAttribute(\"ArtMode\") == \"S02\" then { S02 = true } else { S01 = true, S02 = true, S03 = true, S04 = true, S05 = true }\n\tlocal newSections = {}\n\tfor section, enabled in pairs(selected) do newSections[section] = enabled and not close:FindFirstChild(section) end\n\tlocal origin, colors = originFrame(cfg.Origin), Kit.Colors(cfg.Palette)\n\tlocal occupied = existingReservations(art, origin)\n\tif selected.S02 then sprinklerGarden(close, layout, colors, origin, occupied) end\n\tclosePockets(close, layout, colors, origin, selected, occupied)\n\tdividerSkins(parent, close, layout, colors, origin, selected)\n\tfor _, object in ipairs(parent:GetDescendants()) do\n\t\tif object:IsA(\"BasePart\") and object:GetAttribute(\"CoreFloor\") and newSections[object:GetAttribute(\"SectionId\")] then\n\t\t\tlocal sequence = object:GetAttribute(\"SequenceId\")\n\t\t\tif SEQUENCE_COLORS[sequence] then object.Color = colors[SEQUENCE_COLORS[sequence]] end\n\t\tend\n\tend\n\tArt.LayerGardens(parent, cfg, layout)\n\tlocal inventory = Kit.Inventory(art)\n\tart:SetAttribute(\"ArtParts\", inventory.parts)\n\tart:SetAttribute(\"CloseGardenParts\", Kit.Inventory(close).parts)\n\tart:SetAttribute(\"ArtRevision\", \"SG_ART_03\")\n\tart:SetAttribute(\"GardenEnrichment\", \"Native close planting, opaque divider skins and layered landmark fields\")\n\treturn close\nend\n\nreturn Art\n"},{"path":["ServerStorage","CourseBuilders","StudGarden","Build"],"source":"--!strict\n\nlocal Config = require(game.ReplicatedStorage.Config.StudGardenConfig)\nlocal Layout = require(script.Parent.Layout)\nlocal Geometry = require(script.Parent.Geometry)\nlocal Art = require(script.Parent.Art)\nlocal Build = {}\n\nlocal function folder(parent: Instance, name: string): Folder\n\tlocal existing = parent:FindFirstChild(name)\n\tassert(existing == nil or existing:IsA(\"Folder\"), name .. \" must be a Folder\")\n\tif existing then return existing :: Folder end\n\tlocal result = Instance.new(\"Folder\")\n\tresult.Name, result.Parent = name, parent\n\treturn result\nend\n\nlocal function marker(parent: Instance, name: string, frame: CFrame, size: Vector3, touch: boolean): Part\n\tassert(parent:FindFirstChild(name) == nil, \"Preserve existing \" .. name)\n\tlocal part = Instance.new(\"Part\")\n\tpart.Name, part.Size, part.CFrame = name, size, frame\n\tpart.Anchored, part.Transparency = true, 1\n\tpart.CanCollide, part.CanTouch, part.CanQuery = false, touch, false\n\tpart:SetAttribute(\"StudGardenBuild\", Config.BuildId)\n\tpart.Parent = parent\n\treturn part\nend\n\nlocal function facing(origin: Vector3, top: Vector3, forward: Vector3, height: number): CFrame\n\tlocal position = origin + top + Vector3.new(0, height, 0)\n\treturn CFrame.lookAt(position, position + forward)\nend\n\nfunction Build.Create(parent: Instance, options: any?): Model\n\tlocal cfg = table.clone(Config)\n\tif options and options.name then cfg.ModelName = options.name end\n\tassert(not parent:FindFirstChild(cfg.ModelName), \"Preserve current Stud Garden assembly\")\n\tlocal layout = Layout.Get()\n\tlocal model = Geometry.Create(parent, cfg, layout)\n\tmodel:SetAttribute(\"CourseId\", cfg.CourseId)\n\tmodel:SetAttribute(\"StudGardenBuild\", cfg.BuildId)\n\tmodel:SetAttribute(\"ManualEditing\", true)\n\tmodel:SetAttribute(\"Candidate\", if options and options.mode == \"S02\" then \"representative_study\" else \"full_candidate\")\n\tlocal info = folder(model, \"CourseInfo\")\n\tfor key, value in pairs({CourseId=cfg.CourseId, DisplayName=\"Stud Garden\", RaceFormat=\"PointToPoint\", LapCount=1, Enabled=true, Difficulty=\"Intermediate with precision expert routes\", TargetNewPlayerTime=320, TargetPracticedTime=180, CheckpointCount=4}) do\n\t\tinfo:SetAttribute(key, value)\n\tend\n\tlocal checkpoints = folder(model, \"Checkpoints\")\n\tfolder(model, \"Obstacles\")\n\tfolder(model, \"RouteMarkers\")\n\tlocal decoration = folder(model, \"Decoration\")\n\tlocal bounds = folder(model, \"Bounds\")\n\tmarker(bounds, \"CourseOrigin\", CFrame.new(cfg.Origin), Vector3.one, false)\n\tlocal fallZones = folder(model, \"FallZones\")\n\tlocal low, high = layout.footprint.min, layout.footprint.max\n\tmarker(fallZones, \"FallZone_Main\", CFrame.new(cfg.Origin + Vector3.new((low.X+high.X)/2, layout.groundY-0.5, (low.Z+high.Z)/2)), Vector3.new(high.X-low.X+16, 1, high.Z-low.Z+16), true)\n\tlocal ground = Instance.new(\"Part\")\n\tground.Name = \"GardenGround\"\n\tground.Anchored, ground.CanCollide, ground.CanTouch = true, true, false\n\tground.Size = Vector3.new(high.X-low.X+16, 3, high.Z-low.Z+16)\n\tground.Position = cfg.Origin + Vector3.new((low.X+high.X)/2, layout.groundY-1.6, (low.Z+high.Z)/2)\n\tground.Color, ground.Material = Color3.fromRGB(86, 135, 51), Enum.Material.Plastic\n\tground:SetAttribute(\"SurfaceIntent\", \"Missed-landing ground; the overlaid fall zone returns racers to their checkpoint\")\n\tground.Parent = decoration\n\tfor _, checkpoint in ipairs(layout.checkpoints) do\n\t\tlocal forward = checkpoint.forward\n\t\tlocal across = if math.abs(forward.X) > 0.5 then checkpoint.size.Z else checkpoint.size.X\n\t\tlocal along = if math.abs(forward.X) > 0.5 then checkpoint.size.X else checkpoint.size.Z\n\t\tlocal part: Part\n\t\tif checkpoint.index == 0 then\n\t\t\tpart = marker(model, \"Start\", facing(cfg.Origin, checkpoint.position, forward, -0.5), Vector3.new(across, 1, along), false)\n\t\telse\n\t\t\tpart = marker(checkpoints, string.format(\"Checkpoint_%03d\", checkpoint.index), facing(cfg.Origin, checkpoint.position, forward, 3), Vector3.new(across, 6, along), true)\n\t\tend\n\t\tpart:SetAttribute(\"CheckpointId\", checkpoint.id)\n\t\tpart:SetAttribute(\"RespawnCFrame\", facing(cfg.Origin, checkpoint.spawnPosition, forward, 5))\n\t\tlocal spawnSize = checkpoint.spawnSize\n\t\tpart:SetAttribute(\"RespawnAreaSize\", if math.abs(forward.X) > 0.5 then Vector3.new(spawnSize.Z, 0, spawnSize.X) else Vector3.new(spawnSize.X, 0, spawnSize.Z))\n\tend\n\tlocal finish = layout.finish\n\tmarker(model, \"Finish\", facing(cfg.Origin, finish.position, finish.forward, 3), Vector3.new(34, 6, 1.5), true)\n\tArt.Create(model, cfg, layout, if options then options.mode else nil)\n\treturn model\nend\n\nfunction Build.Inventory(model: Model): any\n\tlocal result: any = {instances=1, parts=0, collidable=0, meshes=0, scripts=0, lights=0, transparent=0, coreFloors=0, barriers=0, nativeSkinParts=0}\n\tfor _, object in ipairs(model:GetDescendants()) do\n\t\tresult.instances += 1\n\t\tif object:IsA(\"BasePart\") then\n\t\t\tresult.parts += 1\n\t\t\tif object.CanCollide then result.collidable += 1 end\n\t\t\tif object.Transparency > 0 and object.Transparency < 1 then result.transparent += 1 end\n\t\t\tif object:GetAttribute(\"CoreFloor\") == true then result.coreFloors += 1 end\n\t\t\tif object:GetAttribute(\"RouteBarrier\") == true then result.barriers += 1 end\n\t\telseif object:IsA(\"LuaSourceContainer\") then result.scripts += 1\n\t\telseif object:IsA(\"Light\") then result.lights += 1 end\n\t\tif object:IsA(\"MeshPart\") then result.meshes += 1 end\n\tend\n\tlocal art = model:FindFirstChild(\"Art\")\n\tif art then result.nativeSkinParts = art:GetAttribute(\"NativeSkinParts\") or 0 end\n\treturn result\nend\n\nreturn Build\n"},{"path":["ServerStorage","CourseBuilders","StudGarden","Geometry"],"source":"--!strict\n\nlocal Layout = require(script.Parent.Layout)\nlocal Geometry = {}\n\nlocal PALETTE = {\n\tS01 = Color3.fromRGB(188,117,71), S02 = Color3.fromRGB(107,171,65),\n\tS03 = Color3.fromRGB(78,186,173), S04 = Color3.fromRGB(107,166,58), S05 = Color3.fromRGB(214,159,72),\n}\n\nlocal function group(parent: Instance, name: string): Model\n\tlocal model = Instance.new(\"Model\")\n\tmodel.Name = name\n\tmodel.Parent = parent\n\treturn model\nend\n\nfunction Geometry.Create(parent: Instance, cfg: any, suppliedLayout: any?): Model\n\tlocal layout = suppliedLayout or Layout.Get()\n\tlocal model = group(parent, cfg.ModelName or \"Course_StudGarden\")\n\tmodel:SetAttribute(\"BuildId\", cfg.BuildId)\n\tmodel:SetAttribute(\"StudGardenBuild\", cfg.BuildId)\n\tmodel:SetAttribute(\"LayoutRevision\", layout.revision)\n\tmodel:SetAttribute(\"CourseId\", cfg.CourseId or \"stud_garden\")\n\tmodel:SetAttribute(\"Candidate\", \"rough_whole_route\")\n\tmodel:SetAttribute(\"RequiredRacers\", 20)\n\tmodel:SetAttribute(\"CourseOrigin\", cfg.Origin)\n\tlocal sections = group(model, \"Sections\")\n\tlocal recovery = group(model, \"Recovery\")\n\tlocal choices = group(model, \"Choices\")\n\tlocal merges = group(model, \"Merges\")\n\tlocal finish = group(model, \"FinishArea\")\n\tlocal barriers = group(model, \"Barriers\")\n\tlocal bounds = Instance.new(\"Folder\")\n\tbounds.Name = \"Bounds\"\n\tbounds.Parent = model\n\tbounds:SetAttribute(\"CourseOrigin\", cfg.Origin)\n\tbounds:SetAttribute(\"GroundY\", cfg.Origin.Y + layout.groundY)\n\tbounds:SetAttribute(\"RecoveryDrop\", cfg.RecoveryDrop or 6)\n\tlocal bySection: any = {}\n\tfor _, id in layout.sections do bySection[id] = group(sections,id) end\n\n\tlocal function floor(parentModel: Model, name: string, record: any, section: string, sequenceId: string, color: Color3?): Part\n\t\tlocal part = Instance.new(\"Part\")\n\t\tpart.Name = name\n\t\tpart.Anchored = true\n\t\tpart.Size = record.size\n\t\tpart.CFrame = CFrame.new(cfg.Origin + record.position - Vector3.new(0,record.size.Y/2,0)) * CFrame.Angles(0,math.rad(record.yaw or 0),0)\n\t\tpart.Material = Enum.Material.SmoothPlastic\n\t\tpart.Color = color or PALETTE[section]\n\t\tpart.TopSurface = Enum.SurfaceType.Studs\n\t\tpart.BottomSurface = Enum.SurfaceType.Smooth\n\t\tpart.CanCollide = true\n\t\tpart.CanTouch = false\n\t\tpart.CanQuery = true\n\t\tpart:SetAttribute(\"WalkSurface\",true)\n\t\tpart:SetAttribute(\"CoreFloor\",true)\n\t\tpart:SetAttribute(\"SectionId\",section)\n\t\tpart:SetAttribute(\"SequenceId\",sequenceId)\n\t\tpart:SetAttribute(\"PointId\",record.id or name)\n\t\tpart:SetAttribute(\"BuildId\",cfg.BuildId)\n\t\tpart.Parent = parentModel\n\t\tparentModel.PrimaryPart = part\n\t\treturn part\n\tend\n\n\tfor _, sequence in layout.sequences do\n\t\tlocal sequenceModel = group(bySection[sequence.section],sequence.id)\n\t\tsequenceModel:SetAttribute(\"SequenceId\",sequence.id)\n\t\tsequenceModel:SetAttribute(\"SectionId\",sequence.section)\n\t\tsequenceModel:SetAttribute(\"RouteKind\",sequence.kind)\n\t\tsequenceModel:SetAttribute(\"RecoveryIndex\",sequence.recoveryIndex)\n\t\tfor _, point in sequence.points do\n\t\t\tlocal unit = group(sequenceModel,\"Point_\"..point.id)\n\t\t\tunit:SetAttribute(\"PointId\",point.id)\n\t\t\tfloor(unit,\"CoreFloor\",point,sequence.section,sequence.id,if sequence.kind==\"expert\" then Color3.fromRGB(229,176,61) else nil)\n\t\tend\n\tend\n\tfor _, hazard in layout.hazards do\n\t\tlocal hazardModel = group(bySection[hazard.section],hazard.id)\n\t\thazardModel:SetAttribute(\"HazardId\",hazard.id)\n\t\thazardModel:SetAttribute(\"RecoveryIndex\",hazard.recoveryIndex)\n\t\tfor _, item in {{\"DryBefore\",hazard.safeBefore},{\"Walkway\",hazard.crossing},{\"DryAfter\",hazard.safeAfter}} do\n\t\t\tlocal unit = group(hazardModel,item[1])\n\t\t\tlocal part = floor(unit,\"CoreFloor\",item[2],hazard.section,hazard.id,if item[1]==\"Walkway\" then Color3.fromRGB(200,154,83) else Color3.fromRGB(119,169,71))\n\t\t\tpart:SetAttribute(\"DryRefuge\",item[1]~=\"Walkway\")\n\t\t\tpart:SetAttribute(\"HazardId\",hazard.id)\n\t\tend\n\tend\n\tfor _, checkpoint in layout.checkpoints do\n\t\tlocal checkpointModel = group(recovery,checkpoint.id)\n\t\tlocal deck = floor(checkpointModel,\"ProgressDeck\",checkpoint,checkpoint.section,checkpoint.id,Color3.fromRGB(129,183,83))\n\t\tdeck:SetAttribute(\"CheckpointIndex\",checkpoint.index)\n\t\tdeck:SetAttribute(\"CheckpointId\",checkpoint.id)\n\t\tdeck:SetAttribute(\"Forward\",checkpoint.forward)\n\t\tlocal spawnRecord = {position=checkpoint.spawnPosition,size=checkpoint.spawnSize,id=checkpoint.id..\"_Spawn\"}\n\t\tlocal spawn = floor(group(checkpointModel,\"RecoveryPocket\"),\"Spawn\",spawnRecord,checkpoint.section,checkpoint.id,Color3.fromRGB(170,197,104))\n\t\tspawn:SetAttribute(\"CheckpointIndex\",checkpoint.index)\n\t\tspawn:SetAttribute(\"CheckpointId\",checkpoint.id)\n\t\tspawn:SetAttribute(\"SpawnPoint\",true)\n\t\tspawn:SetAttribute(\"Forward\",checkpoint.forward)\n\t\tif checkpoint.index == 0 then\n\t\t\tspawn.Transparency = 1\n\t\t\tspawn.CanCollide = false\n\t\t\tspawn:SetAttribute(\"WalkSurface\",false)\n\t\t\tspawn:SetAttribute(\"CoreFloor\",false)\n\t\tend\n\tend\n\tfor _, item in layout.choices do floor(group(choices,item.id),\"SetupDeck\",item,item.section,item.id,Color3.fromRGB(217,170,77)) end\n\tfor _, item in layout.merges do floor(group(merges,item.id),\"MergeDeck\",item,item.section,item.id,Color3.fromRGB(132,183,95)) end\n\tlocal finishModel = group(finish,\"F0\")\n\tlocal finishDeck = floor(finishModel,\"FinishDeck\",layout.finish,\"S05\",\"F0\",Color3.fromRGB(232,182,80))\n\tfinishDeck:SetAttribute(\"FinishId\",\"F0\")\n\tfloor(group(finishModel,\"Runoff\"),\"RunoffDeck\",layout.finish.runoff,\"S05\",\"F0\",Color3.fromRGB(226,173,89))\n\tfor _, barrier in layout.barriers do\n\t\tlocal part = Instance.new(\"Part\")\n\t\tpart.Name = barrier.id\n\t\tpart.Size = barrier.size\n\t\tpart.Position = cfg.Origin + barrier.position\n\t\tpart.Anchored = true\n\t\tpart.Color = Color3.fromRGB(107,94,55)\n\t\tpart.Material = Enum.Material.Wood\n\t\tpart.CanCollide = true\n\t\tpart.CanTouch = false\n\t\tpart:SetAttribute(\"RouteBarrier\",true)\n\t\tpart:SetAttribute(\"BuildId\",cfg.BuildId)\n\t\tpart:SetAttribute(\"AdjacentFloorTop\",barrier.adjacentTop)\n\t\tpart.Parent = barriers\n\tend\n\treturn model\nend\n\nreturn Geometry\n"},{"path":["ServerStorage","CourseBuilders","StudGarden","HazardState"],"source":"--!strict\n\nlocal HazardState = {}\n\nexport type Timing = {\n\tClear: number,\n\tWarning: number,\n\tActive: number,\n\tOffset: number?,\n}\n\nfunction HazardState.Phase(elapsed: number, timing: Timing): (string, number)\n\tlocal cycle = timing.Clear + timing.Warning + timing.Active\n\tlocal age = (math.max(0, elapsed) + (timing.Offset or 0)) % cycle\n\tif age < timing.Clear then\n\t\treturn \"Clear\", age / timing.Clear\n\tend\n\tif age < timing.Clear + timing.Warning then\n\t\treturn \"Warning\", (age - timing.Clear) / timing.Warning\n\tend\n\treturn \"Active\", (age - timing.Clear - timing.Warning) / timing.Active\nend\n\nfunction HazardState.ActiveIntervals(previous: number, current: number, timing: Timing): {{number}}\n\tlocal intervals = {}\n\tif current < previous then\n\t\treturn intervals\n\tend\n\tlocal cycle = timing.Clear + timing.Warning + timing.Active\n\tlocal offset = timing.Offset or 0\n\tfor lap = math.floor((previous + offset) / cycle), math.floor((current + offset) / cycle) do\n\t\tlocal start = lap * cycle - offset + timing.Clear + timing.Warning\n\t\tlocal first, last = math.max(previous, start), math.min(current, start + timing.Active)\n\t\tif last > first then\n\t\t\ttable.insert(intervals, {math.clamp((first - start) / timing.Active, 0, 1),\n\t\t\t\tmath.clamp((last - start) / timing.Active, 0, 1)})\n\t\tend\n\tend\n\treturn intervals\nend\n\nfunction HazardState.CanContact(active: boolean, eligible: boolean, alive: boolean, now: number,\n\trecoveryUntil: number, lastRecovery: number?, cooldown: number, elapsedDt: number, maxDt: number): boolean\n\treturn active and eligible and alive and elapsedDt > 0 and elapsedDt <= maxDt\n\t\tand recoveryUntil <= now\n\t\tand (lastRecovery == nil or now - lastRecovery >= cooldown)\nend\n\nreturn HazardState\n"},{"path":["ServerStorage","CourseBuilders","StudGarden","Kit"],"source":"--!strict\n\nlocal Kit = {}\n\nKit.Palette = {\n\tGrass = Color3.fromRGB(111, 169, 63),\n\tGrassLight = Color3.fromRGB(151, 198, 82),\n\tLeaf = Color3.fromRGB(48, 119, 67),\n\tLeafLight = Color3.fromRGB(83, 153, 69),\n\tSoil = Color3.fromRGB(80, 49, 34),\n\tSoilLight = Color3.fromRGB(111, 69, 43),\n\tHoney = Color3.fromRGB(195, 135, 65),\n\tHoneyLight = Color3.fromRGB(228, 173, 96),\n\tWoodDark = Color3.fromRGB(126, 82, 47),\n\tTerracotta = Color3.fromRGB(197, 102, 63),\n\tTerracottaLight = Color3.fromRGB(223, 137, 85),\n\tCarrot = Color3.fromRGB(236, 136, 42),\n\tStrawberry = Color3.fromRGB(207, 58, 65),\n\tStrawberryLight = Color3.fromRGB(236, 89, 91),\n\tCream = Color3.fromRGB(255, 241, 205),\n\tWhite = Color3.fromRGB(246, 241, 224),\n\tPink = Color3.fromRGB(229, 117, 169),\n\tPinkLight = Color3.fromRGB(247, 164, 198),\n\tAqua = Color3.fromRGB(73, 168, 174),\n\tAquaLight = Color3.fromRGB(107, 200, 193),\n\tGold = Color3.fromRGB(242, 190, 57),\n\tPurple = Color3.fromRGB(145, 109, 189),\n\tDark = Color3.fromRGB(44, 42, 38),\n\tGray = Color3.fromRGB(147, 148, 142),\n\tGrayLight = Color3.fromRGB(190, 190, 180),\n\tWater = Color3.fromRGB(97, 183, 211),\n}\n\nfunction Kit.Colors(overrides: any?): any\n\tlocal colors = table.clone(Kit.Palette)\n\tif overrides then\n\t\tfor name, color in pairs(overrides) do\n\t\t\tcolors[name] = color\n\t\tend\n\tend\n\treturn colors\nend\n\nfunction Kit.Model(parent: Instance, name: string, family: string?): Model\n\tlocal model = Instance.new(\"Model\")\n\tmodel.Name = name\n\tmodel:SetAttribute(\"StudGardenFamily\", family or name)\n\tmodel:SetAttribute(\"Provenance\", \"Original native Stud Garden assembly; no external assets\")\n\tmodel.Parent = parent\n\treturn model\nend\n\nfunction Kit.Part(parent: Instance, name: string, frame: CFrame, size: Vector3, color: Color3, options: any?): Part\n\tlocal settings = options or {}\n\tlocal part = Instance.new(\"Part\")\n\tpart.Name, part.CFrame, part.Size = name, frame, size\n\tpart.Color = color\n\tpart.Material = settings.material or Enum.Material.Plastic\n\tpart.Reflectance = 0\n\tpart.Anchored = true\n\tpart.CanCollide = settings.solid == true\n\tpart.CanTouch = settings.touch == true\n\tpart.CanQuery = settings.query == true\n\tpart.CastShadow = settings.shadow ~= false\n\tpart.TopSurface = if settings.studs == false then Enum.SurfaceType.Smooth else Enum.SurfaceType.Studs\n\tpart.BottomSurface = Enum.SurfaceType.Smooth\n\tif settings.shape then part.Shape = settings.shape end\n\tif settings.transparency then part.Transparency = settings.transparency end\n\tpart:SetAttribute(\"ArtRole\", settings.role or \"Decoration\")\n\tpart.Parent = parent\n\treturn part\nend\n\nfunction Kit.Wedge(parent: Instance, name: string, frame: CFrame, size: Vector3, color: Color3): WedgePart\n\tlocal part = Instance.new(\"WedgePart\")\n\tpart.Name, part.CFrame, part.Size, part.Color = name, frame, size, color\n\tpart.Material, part.Reflectance = Enum.Material.Plastic, 0\n\tpart.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, false\n\tpart.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth\n\tpart:SetAttribute(\"ArtRole\", \"Decoration\")\n\tpart.Parent = parent\n\treturn part\nend\n\nlocal function build(parent: Instance, name: string, family: string, frame: CFrame, scale: number, colors: any?)\n\tlocal model = Kit.Model(parent, name, family)\n\tmodel.WorldPivot = frame\n\tmodel:SetAttribute(\"AuthoredScale\", scale)\n\tlocal c = colors or Kit.Palette\n\tlocal function block(partName: string, x: number, y: number, z: number, sx: number, sy: number, sz: number, color: Color3, rotation: CFrame?, options: any?): Part\n\t\treturn Kit.Part(model, partName, frame * CFrame.new(x * scale, y * scale, z * scale) * (rotation or CFrame.identity), Vector3.new(sx, sy, sz) * scale, color, options)\n\tend\n\treturn model, c, block\nend\n\nfunction Kit.StudCaps(parent: Instance, frame: CFrame, size: Vector3, color: Color3, count: number?)\n\tlocal columns = math.min(count or 2, 3)\n\tfor index = 1, columns do\n\t\tlocal x = (index - (columns + 1) / 2) * math.min(2, size.X / (columns + 1))\n\t\tKit.Part(parent, \"StudCap\" .. index, frame * CFrame.new(x, size.Y / 2 + 0.06, 0) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(0.12, 0.64, 0.64), color, { shape = Enum.PartType.Cylinder, studs = false, shadow = false })\n\tend\nend\n\nfunction Kit.Carrot(parent: Instance, frame: CFrame, scale: number?, colors: any?): Model\n\tlocal model, c, b = build(parent, \"Carrot\", \"CropCarrot\", frame, scale or 1, colors)\n\tb(\"RootShoulder\", 0, 1.45, 0, 1.5, 1.8, 1.5, c.Carrot)\n\tb(\"RootTip\", 0, 0.4, 0, 0.85, 0.8, 0.85, c.Carrot)\n\tb(\"RootBand\", 0, 1.82, -0.765, 1.3, 0.15, 0.08, c.TerracottaLight, nil, { studs = false })\n\tfor i, data in ipairs({ { -0.4, 2.7, 0, -0.35 }, { 0.4, 2.85, 0, 0.32 }, { 0, 3.05, 0.15, 0 } }) do\n\t\tb(\"Leaf\" .. i, data[1], data[2], data[3], 0.52, 1.55, 0.55, if i == 2 then c.LeafLight else c.Leaf, CFrame.Angles(0, 0, data[4]))\n\tend\n\treturn model\nend\n\nfunction Kit.Strawberry(parent: Instance, frame: CFrame, scale: number?, colors: any?): Model\n\tlocal model, c, b = build(parent, \"Strawberry\", \"CropStrawberry\", frame, scale or 1, colors)\n\tb(\"BerryTip\", 0, 0.36, 0, 1.05, 0.65, 1.05, c.Strawberry)\n\tb(\"BerryBody\", 0, 1.1, 0, 1.95, 1.1, 1.8, c.Strawberry)\n\tb(\"BerryShoulder\", 0, 1.8, 0, 1.65, 0.5, 1.55, c.StrawberryLight)\n\tfor i, yaw in ipairs({ 0, math.pi / 2, math.pi, math.pi * 1.5 }) do\n\t\tb(\"Leaf\" .. i, math.sin(yaw) * 0.56, 2.13, math.cos(yaw) * 0.56, 0.75, 0.22, 1.35, if i % 2 == 0 then c.LeafLight else c.Leaf, CFrame.Angles(0, yaw, 0.18))\n\tend\n\tfor i, data in ipairs({ { -0.53, 1.45 }, { 0.44, 1.16 }, { -0.15, 0.92 } }) do\n\t\tb(\"Seed\" .. i, data[1], data[2], -0.925, 0.12, 0.22, 0.055, c.Cream, CFrame.Angles(0, 0, 0.25), { studs = false, shadow = false })\n\tend\n\treturn model\nend\n\nfunction Kit.Bamboo(parent: Instance, frame: CFrame, scale: number?, colors: any?): Model\n\tlocal model, c, b = build(parent, \"Bamboo\", \"CropBamboo\", frame, scale or 1, colors)\n\tfor stem = 1, 3 do\n\t\tlocal x, z = (stem - 2) * 1.08, if stem == 2 then 0.45 else 0\n\t\tlocal height = if stem == 2 then 5.25 else 4.2\n\t\tb(\"Stem\" .. stem, x, height / 2, z, 0.64, height, 0.64, if stem == 1 then c.Leaf else c.LeafLight)\n\t\tfor joint = 1, 2 do\n\t\t\tb(\"Node\" .. stem .. \"_\" .. joint, x, height * joint / 3, z, 0.88, 0.16, 0.88, c.GrassLight)\n\t\tend\n\tend\n\tb(\"SideLeafA\", -1.52, 3.1, 0, 1.35, 0.28, 0.6, c.Leaf, CFrame.Angles(0, 0, 0.45))\n\tb(\"SideLeafB\", 1.46, 3.6, 0.1, 1.3, 0.28, 0.6, c.LeafLight, CFrame.Angles(0, 0, -0.45))\n\treturn model\nend\n\nfunction Kit.Sunflower(parent: Instance, frame: CFrame, scale: number?, colors: any?): Model\n\tlocal model, c, b = build(parent, \"Sunflower\", \"CropSunflower\", frame, scale or 1, colors)\n\tb(\"Stem\", 0, 1.9, 0, 0.32, 3.8, 0.32, c.Leaf)\n\tb(\"LeafA\", -0.66, 1.55, 0, 1.5, 0.25, 0.6, c.Leaf, CFrame.Angles(0, 0, 0.35))\n\tb(\"LeafB\", 0.63, 2.3, 0, 1.4, 0.25, 0.6, c.LeafLight, CFrame.Angles(0, 0, -0.35))\n\tfor petal = 1, 6 do\n\t\tlocal angle = (petal - 1) * math.pi / 3\n\t\tb(\"Petal\" .. petal, math.sin(angle) * 0.84, 4 + math.cos(angle) * 0.84, 0, 0.66, 1.15, 0.35, c.Gold, CFrame.Angles(0, 0, -angle))\n\tend\n\tb(\"SeedFace\", 0, 4, -0.24, 1.18, 1.18, 0.55, c.Soil, nil, { studs = false })\n\tb(\"SeedFaceInset\", -0.1, 4.12, -0.54, 0.67, 0.67, 0.06, c.SoilLight, nil, { studs = false })\n\treturn model\nend\n\nfunction Kit.Flower(parent: Instance, frame: CFrame, scale: number?, colors: any?, bloomColor: Color3?): Model\n\tlocal model, c, b = build(parent, \"FlowerCluster\", \"Flower\", frame, scale or 1, colors)\n\tb(\"Leaves\", 0, 0.3, 0, 1.45, 0.45, 1.3, c.Leaf)\n\tb(\"Stem\", 0, 0.8, 0, 0.16, 1.2, 0.16, c.LeafLight)\n\tlocal bloom = bloomColor or c.White\n\tb(\"PetalCrossA\", 0, 1.4, 0, 1.28, 0.24, 0.42, bloom)\n\tb(\"PetalCrossB\", 0, 1.4, 0, 0.42, 0.24, 1.28, bloom)\n\tb(\"GoldCenter\", 0, 1.58, 0, 0.35, 0.18, 0.35, c.Gold)\n\treturn model\nend\n\nfunction Kit.StemCluster(parent: Instance, frame: CFrame, scale: number?, colors: any?, bloomColor: Color3?): Model\n\tlocal model, c, b = build(parent, \"WildflowerStems\", \"StemCluster\", frame, scale or 1, colors)\n\tb(\"LeafBase\", 0, 0.32, 0, 1.8, 0.55, 1.3, c.Leaf)\n\tb(\"Stem\", 0.3, 1.4, 0.1, 0.22, 2.8, 0.22, c.LeafLight)\n\tb(\"SideLeaf\", -0.36, 1.05, 0, 1.0, 0.26, 0.55, c.GrassLight, CFrame.Angles(0, 0.4, 0.35))\n\tb(\"Bloom\", 0.3, 2.82, 0.1, 1.05, 0.55, 0.8, bloomColor or c.Purple)\n\treturn model\nend\n\nfunction Kit.Climber(parent: Instance, frame: CFrame, colors: any?, bloomColor: Color3?): Model\n\tlocal model, c, b = build(parent, \"FloweringClimber\", \"WallClimber\", frame, 1, colors)\n\tb(\"Stem\", 0, 2.2, 0, 0.18, 4.4, 0.12, c.Leaf)\n\tb(\"LeafA\", -0.43, 1.25, -0.035, 1.1, 0.65, 0.13, c.LeafLight, CFrame.Angles(0, 0, 0.38))\n\tb(\"LeafB\", 0.44, 2.68, -0.035, 1.1, 0.65, 0.13, c.Leaf, CFrame.Angles(0, 0, -0.38))\n\tb(\"Flower\", 0.05, 4.0, -0.05, 1.2, 0.7, 0.15, bloomColor or c.White)\n\tb(\"FlowerCenter\", 0.05, 4.0, -0.15, 0.3, 0.3, 0.13, c.Gold, nil, { studs = false })\n\treturn model\nend\n\nfunction Kit.LeafMass(parent: Instance, frame: CFrame, scale: number?, colors: any?): Model\n\tlocal amount = scale or 1\n\tlocal model, c, b = build(parent, \"SteppedLeafMass\", \"GardenLeafMass\", frame, amount, colors)\n\tb(\"BranchStem\", 0, 2.9, 0, 0.55, 5.8, 0.55, c.Leaf)\n\tlocal leaves = {\n\t\t{ Vector3.new(-1.1, 2.7, 0), Vector3.new(4.3, 0.95, 4.8), CFrame.Angles(0.38, -0.5, 0.45), c.Leaf },\n\t\t{ Vector3.new(1.1, 4.2, 0.6), Vector3.new(4.9, 1.05, 4.8), CFrame.Angles(-0.38, 1.4, -0.5), c.LeafLight },\n\t\t{ Vector3.new(-0.35, 5.3, -0.2), Vector3.new(3.8, 0.9, 4.4), CFrame.Angles(0.4, 3.2, 0.5), c.GrassLight },\n\t}\n\tfor index, leaf in ipairs(leaves) do\n\t\tKit.Wedge(model, \"SlopedLeaf\" .. index, frame * CFrame.new(leaf[1] * amount) * leaf[3], leaf[2] * amount, leaf[4])\n\tend\n\tb(\"LeafVein\", 1.1, 4.28, 0.6, 0.24, 0.18, 3.8, c.GrassLight, leaves[2][3])\n\tmodel:SetAttribute(\"SurfaceIntent\", \"Sloping foliage in a planted field; not a racing landing\")\n\treturn model\nend\n\nlocal function eyes(b: any, c: any, y: number, z: number, spacing: number)\n\tfor i, x in ipairs({ -spacing, spacing }) do\n\t\tb(\"Eye\" .. i, x, y, z, 0.19, 0.28, 0.08, c.Dark, nil, { studs = false, shadow = false })\n\t\tb(\"EyeGlint\" .. i, x - 0.035, y + 0.06, z - 0.045, 0.045, 0.06, 0.025, c.White, nil, { studs = false, shadow = false })\n\tend\nend\n\nfunction Kit.Rabbit(parent: Instance, frame: CFrame, scale: number?, colors: any?): Model\n\tlocal model, c, b = build(parent, \"Rabbit\", \"PetRabbit\", frame, scale or 1, colors)\n\tb(\"Body\", 0, 0.83, 0.28, 1.5, 1.4, 1.8, c.White)\n\tb(\"Head\", 0, 1.65, -0.55, 1.54, 1.35, 1.3, c.White)\n\tfor i, x in ipairs({ -0.47, 0.47 }) do\n\t\tb(\"Ear\" .. i, x, 2.96, -0.53, 0.38, 1.6, 0.5, c.White, CFrame.Angles(0, 0, if i == 1 then 0.1 else -0.1))\n\t\tb(\"EarPink\" .. i, x, 2.98, -0.792, 0.19, 1.12, 0.04, c.PinkLight, nil, { studs = false })\n\t\tb(\"Foot\" .. i, x, 0.2, -0.36, 0.6, 0.38, 0.95, c.White)\n\tend\n\tb(\"Tail\", 0, 0.93, 1.28, 0.65, 0.65, 0.6, c.White)\n\teyes(b, c, 1.79, -1.245, 0.37)\n\tb(\"Nose\", 0, 1.52, -1.255, 0.2, 0.16, 0.06, c.Pink, nil, { studs = false })\n\tb(\"Mouth\", 0, 1.36, -1.255, 0.32, 0.045, 0.06, c.Dark, nil, { studs = false })\n\treturn model\nend\n\nfunction Kit.Raccoon(parent: Instance, frame: CFrame, scale: number?, colors: any?): Model\n\tlocal model, c, b = build(parent, \"Raccoon\", \"PetRaccoon\", frame, scale or 1, colors)\n\tb(\"Body\", 0, 1.03, 0.15, 1.7, 1.65, 1.6, c.Gray)\n\tb(\"Belly\", 0, 1.0, -0.7, 1.14, 1.15, 0.2, c.GrayLight, nil, { studs = false })\n\tb(\"Head\", 0, 2.05, -0.45, 1.9, 1.25, 1.45, c.GrayLight)\n\tb(\"Mask\", 0, 2.12, -1.2, 1.67, 0.49, 0.1, c.Dark, nil, { studs = false })\n\tfor i, x in ipairs({ -0.67, 0.67 }) do\n\t\tb(\"Ear\" .. i, x, 2.87, -0.41, 0.48, 0.5, 0.45, c.Gray)\n\t\tb(\"EarInset\" .. i, x, 2.89, -0.65, 0.26, 0.25, 0.035, c.Dark, nil, { studs = false })\n\t\tb(\"Foot\" .. i, x, 0.2, -0.28, 0.58, 0.4, 0.8, c.Dark)\n\tend\n\tb(\"Muzzle\", 0, 1.79, -1.23, 0.65, 0.37, 0.28, c.White, nil, { studs = false })\n\tb(\"Nose\", 0, 1.87, -1.385, 0.25, 0.2, 0.09, c.Dark, nil, { studs = false })\n\teyes(b, c, 2.17, -1.275, 0.47)\n\tfor stripe = 1, 4 do\n\t\tb(\"TailStripe\" .. stripe, 0.35, 0.85 + stripe * 0.28, 0.85 + stripe * 0.48, 0.65, 0.57, 0.58, if stripe % 2 == 0 then c.Gray else c.Dark, CFrame.Angles(-0.42, 0.15, 0))\n\tend\n\treturn model\nend\n\nfunction Kit.Bee(parent: Instance, frame: CFrame, scale: number?, colors: any?): Model\n\tlocal model, c, b = build(parent, \"Bee\", \"PetBee\", frame, scale or 1, colors)\n\tb(\"Body\", 0, 0.9, 0, 1.65, 1.3, 1.45, c.Gold)\n\tb(\"BackStripe\", 0, 0.92, 0.25, 1.73, 1.38, 0.31, c.Dark, nil, { studs = false })\n\tb(\"Face\", 0, 0.95, -0.77, 1.4, 1.05, 0.1, c.Gold, nil, { studs = false })\n\teyes(b, c, 1.08, -0.85, 0.34)\n\tb(\"Smile\", 0, 0.75, -0.85, 0.37, 0.055, 0.05, c.Dark, nil, { studs = false })\n\tfor i, side in ipairs({ -1, 1 }) do\n\t\tb(\"Wing\" .. i, side * 1.05, 1.68, 0.04, 1.1, 0.17, 1.6, c.Cream, CFrame.Angles(0.18, side * 0.32, side * 0.28), { studs = false, shadow = false })\n\t\tb(\"Antenna\" .. i, side * 0.43, 1.91, -0.42, 0.12, 0.7, 0.12, c.Dark, CFrame.Angles(0, 0, side * -0.2), { studs = false })\n\t\tb(\"AntennaTip\" .. i, side * 0.49, 2.25, -0.42, 0.24, 0.24, 0.24, c.Dark, nil, { studs = false })\n\tend\n\treturn model\nend\n\nfunction Kit.Dragonfly(parent: Instance, frame: CFrame, scale: number?, colors: any?): Model\n\tlocal model, c, b = build(parent, \"GoldenDragonfly\", \"PetDragonfly\", frame, scale or 1, colors)\n\tb(\"Head\", 0, 0.55, -0.9, 0.85, 0.72, 0.78, c.Gold)\n\tb(\"Body\", 0, 0.5, 0.1, 0.55, 0.55, 1.9, c.HoneyLight)\n\tb(\"Tail\", 0, 0.45, 1.6, 0.3, 0.3, 1.3, c.Gold)\n\teyes(b, c, 0.61, -1.32, 0.23)\n\tfor i, side in ipairs({ -1, 1 }) do\n\t\tfor wing, z in ipairs({ -0.1, 0.8 }) do\n\t\t\tb(\"Wing\" .. i .. \"_\" .. wing, side * 1.24, 0.68, z, 2.3, 0.095, 0.62, c.Cream, CFrame.Angles(0, side * (if wing == 1 then -0.32 else 0.26), side * 0.08), { studs = false, shadow = false })\n\t\tend\n\tend\n\treturn model\nend\n\nfunction Kit.Planter(parent: Instance, frame: CFrame, size: Vector3, colors: any?): Model\n\tlocal c = colors or Kit.Palette\n\tlocal model = Kit.Model(parent, \"PlantedBed\", \"Planter\")\n\tmodel.WorldPivot = frame\n\tKit.Part(model, \"Soil\", frame * CFrame.new(0, -0.28, 0), Vector3.new(size.X, 0.55, size.Z), c.Soil)\n\tfor i, z in ipairs({ -size.Z / 2, size.Z / 2 }) do\n\t\tKit.Part(model, \"LongTrim\" .. i, frame * CFrame.new(0, -0.48, z), Vector3.new(size.X + 0.35, 1.05, 0.38), c.Honey)\n\tend\n\tfor i, x in ipairs({ -size.X / 2, size.X / 2 }) do\n\t\tKit.Part(model, \"EndTrim\" .. i, frame * CFrame.new(x, -0.48, 0), Vector3.new(0.38, 1.05, size.Z), c.HoneyLight)\n\tend\n\treturn model\nend\n\nfunction Kit.Pot(parent: Instance, frame: CFrame, size: Vector3, colors: any?): Model\n\tlocal c = colors or Kit.Palette\n\tlocal model = Kit.Model(parent, \"TerracottaPot\", \"Pot\")\n\tmodel.WorldPivot = frame\n\tKit.Part(model, \"Bowl\", frame * CFrame.new(0, size.Y * 0.45, 0), Vector3.new(size.X * 0.78, size.Y * 0.9, size.Z * 0.78), c.Terracotta)\n\tKit.Part(model, \"Rim\", frame * CFrame.new(0, size.Y - 0.21, 0), Vector3.new(size.X, 0.42, size.Z), c.TerracottaLight)\n\tKit.Part(model, \"SoilInset\", frame * CFrame.new(0, size.Y + 0.01, 0), Vector3.new(size.X * 0.76, 0.12, size.Z * 0.76), c.Soil)\n\treturn model\nend\n\nfunction Kit.Crate(parent: Instance, frame: CFrame, size: Vector3, colors: any?): Model\n\tlocal c = colors or Kit.Palette\n\tlocal model = Kit.Model(parent, \"HarvestCrate\", \"Crate\")\n\tmodel.WorldPivot = frame\n\tKit.Part(model, \"Body\", frame * CFrame.new(0, size.Y / 2, 0), size, c.Honey)\n\tfor i, z in ipairs({ -size.Z / 2 - 0.07, size.Z / 2 + 0.07 }) do\n\t\tKit.Part(model, \"TopRail\" .. i, frame * CFrame.new(0, size.Y * 0.82, z), Vector3.new(size.X, 0.35, 0.14), c.HoneyLight)\n\t\tKit.Part(model, \"BottomRail\" .. i, frame * CFrame.new(0, size.Y * 0.19, z), Vector3.new(size.X, 0.35, 0.14), c.WoodDark)\n\tend\n\treturn model\nend\n\nfunction Kit.Fence(parent: Instance, frame: CFrame, length: number, colors: any?): Model\n\tlocal c = colors or Kit.Palette\n\tlocal model = Kit.Model(parent, \"GardenFence\", \"Fence\")\n\tmodel.WorldPivot = frame\n\tfor i, x in ipairs({ -length / 2, length / 2 }) do\n\t\tKit.Part(model, \"Post\" .. i, frame * CFrame.new(x, 1.6, 0), Vector3.new(0.65, 3.2, 0.65), c.Honey)\n\t\tKit.Part(model, \"PostCap\" .. i, frame * CFrame.new(x, 3.22, 0), Vector3.new(0.85, 0.18, 0.85), c.HoneyLight)\n\tend\n\tfor i, y in ipairs({ 0.85, 2.3 }) do\n\t\tKit.Part(model, \"Rail\" .. i, frame * CFrame.new(0, y, 0), Vector3.new(length, 0.42, 0.38), c.HoneyLight)\n\tend\n\treturn model\nend\n\nfunction Kit.CandyBlossom(parent: Instance, frame: CFrame, height: number?, colors: any?): Model\n\tlocal model, c, b = build(parent, \"CandyBlossom\", \"LandmarkCandyBlossom\", frame, (height or 14) / 14, colors)\n\tb(\"PinkTrunk\", 0, 4.6, 0, 1.8, 9.2, 1.8, c.Pink)\n\tb(\"RootA\", -1.1, 0.65, 0, 3.4, 1.3, 1.3, c.Pink)\n\tb(\"RootB\", 0.65, 0.6, 0.9, 1.3, 1.2, 3.2, c.PinkLight)\n\tb(\"BranchA\", -1.95, 7.9, 0, 4.1, 1.05, 1.15, c.PinkLight, CFrame.Angles(0, 0, -0.35))\n\tb(\"BranchB\", 1.8, 8.65, 0.3, 3.7, 1.0, 1.1, c.Pink, CFrame.Angles(0, 0, 0.3))\n\tb(\"CrownBase\", 0, 10, 0, 8.8, 2.4, 6.6, c.Aqua)\n\tb(\"CrownStepA\", -2.05, 11.9, -0.7, 5.6, 1.5, 5.2, c.AquaLight)\n\tb(\"CrownStepB\", 2.9, 10.8, 0.75, 3.4, 1.5, 4.2, c.Aqua)\n\tb(\"CrownTop\", -0.85, 13.1, -0.75, 3.6, 1.0, 3.5, c.Aqua)\n\tb(\"CrownFrontStep\", 0.5, 10.9, -3.25, 3.0, 1.1, 2.3, c.AquaLight)\n\tfor i, data in ipairs({ { -3.0, 8.7, -2.4 }, { 2.3, 8.6, -2.5 }, { 3.5, 9.0, 1.75 } }) do\n\t\tb(\"CandyFruit\" .. i, data[1], data[2], data[3], 1.2, 1.3, 1.2, if i == 2 then c.Pink else c.PinkLight)\n\tend\n\treturn model\nend\n\nfunction Kit.Beanstalk(parent: Instance, frame: CFrame, height: number?, colors: any?): Model\n\tlocal scale = (height or 31) / 31\n\tlocal model, c, b = build(parent, \"Beanstalk\", \"LandmarkBeanstalk\", frame, scale, colors)\n\tfor segment = 1, 10 do\n\t\tlocal angle = segment * 0.68\n\t\tb(\"Stem\" .. segment, math.sin(angle) * 1.1, (segment - 0.5) * 3, math.cos(angle) * 1.1, 2.65, 3.5, 2.65, if segment % 2 == 0 then c.LeafLight else c.Leaf, CFrame.Angles(0.1 * math.cos(angle), angle, 0.12 * math.sin(angle)))\n\t\tb(\"TwiningVine\" .. segment, math.sin(angle + 2) * 1.8, (segment - 0.5) * 3, math.cos(angle + 2) * 1.8, 0.65, 3.5, 0.65, c.GrassLight, CFrame.Angles(0, angle, 0.2))\n\tend\n\tfor leaf = 1, 5 do\n\t\tlocal angle, y = leaf * 2.35, 4.5 + leaf * 4.6\n\t\tlocal leafFrame = frame * CFrame.new(math.sin(angle) * 3.4 * scale, y * scale, math.cos(angle) * 3.4 * scale) * CFrame.Angles(0, angle, 0.34)\n\t\tKit.Wedge(model, \"LeafBlade\" .. leaf, leafFrame, Vector3.new(4.3, 0.85, 5.9) * scale, c.LeafLight)\n\t\tKit.Wedge(model, \"LeafTip\" .. leaf, leafFrame * CFrame.new(0, 0.16 * scale, -3.1 * scale) * CFrame.Angles(0, math.pi, 0), Vector3.new(3.0, 0.8, 3.2) * scale, c.Leaf)\n\tend\n\tfor pod = 1, 4 do\n\t\tlocal angle, y = pod * 1.8, 14.2 + pod * 3.6\n\t\tlocal x, z = math.sin(angle) * 3.5, math.cos(angle) * 3.5\n\t\tb(\"PodStem\" .. pod, x, y + 1.1, z, 0.25, 1.65, 0.25, c.Leaf)\n\t\tb(\"BeanPod\" .. pod, x, y - 0.5, z, 1.25, 2.65, 1.05, c.GrassLight, CFrame.Angles(0, angle, 0.13))\n\t\tb(\"PodTip\" .. pod, x - 0.18, y - 2, z, 0.72, 0.9, 0.7, c.LeafLight, CFrame.Angles(0, angle, 0.27))\n\tend\n\treturn model\nend\n\nfunction Kit.Sign(parent: Instance, name: string, frame: CFrame, text: string, width: number, colors: any?): Model\n\tlocal c = colors or Kit.Palette\n\tlocal model = Kit.Model(parent, name, \"Sign\")\n\tKit.Part(model, \"SignPost\", frame * CFrame.new(0, 1.1, 0.12), Vector3.new(0.38, 2.2, 0.4), c.WoodDark)\n\tlocal panel = Kit.Part(model, \"SignFace\", frame * CFrame.new(0, 2.2, 0), Vector3.new(width, 1.35, 0.24), c.Cream, { studs = false })\n\tlocal gui = Instance.new(\"SurfaceGui\")\n\tgui.Name, gui.Face, gui.SizingMode, gui.PixelsPerStud = \"GardenLabel\", Enum.NormalId.Front, Enum.SurfaceGuiSizingMode.PixelsPerStud, 40\n\tgui.LightInfluence = 1\n\tgui.Parent = panel\n\tlocal label = Instance.new(\"TextLabel\")\n\tlabel.Name, label.BackgroundTransparency, label.Size = \"Label\", 1, UDim2.fromScale(0.94, 0.82)\n\tlabel.Position, label.Text, label.TextColor3 = UDim2.fromScale(0.03, 0.09), text, c.WoodDark\n\tlabel.TextScaled, label.Font = true, Enum.Font.GothamBold\n\tlabel.Parent = gui\n\treturn model\nend\n\nfunction Kit.SeedShop(parent: Instance, frame: CFrame, colors: any?): Model\n\tlocal model, c, b = build(parent, \"SeedShop\", \"FacadeSeedShop\", frame, 1, colors)\n\tb(\"BackWall\", 0, 3.5, 2.0, 13, 7, 0.65, c.Cream)\n\tb(\"Counter\", 0, 1.5, -0.9, 12.4, 3, 2.2, c.Honey)\n\tb(\"Shelf\", 0, 4.15, 1.1, 11.6, 0.35, 1.7, c.HoneyLight)\n\tfor i, x in ipairs({ -6.15, 6.15 }) do\n\t\tb(\"SidePost\" .. i, x, 4.1, 0.2, 0.75, 8.2, 3.8, c.Honey)\n\tend\n\tb(\"RoofBeam\", 0, 8.1, 0.15, 13.5, 0.8, 4.5, c.Honey)\n\tfor stripe = 1, 6 do\n\t\tb(\"AwningStripe\" .. stripe, (stripe - 3.5) * 2.15, 7.33, -2.18, 2.15, 0.32, 3.0, if stripe % 2 == 0 then c.White else c.LeafLight, CFrame.Angles(0.14, 0, 0))\n\tend\n\tfor packet = 1, 5 do\n\t\tb(\"SeedPacket\" .. packet, (packet - 3) * 1.8, 5.25, 0.15, 1.18, 1.5, 0.23, c.White)\n\t\tb(\"PacketLeaf\" .. packet, (packet - 3) * 1.8, 5.36, -0.005, 0.5, 0.67, 0.08, if packet % 2 == 0 then c.Carrot else c.LeafLight, CFrame.Angles(0, 0, 0.2))\n\tend\n\tKit.Sign(model, \"SeedShopSign\", frame * CFrame.new(0, 6.5, -0.38), \"SEEDS\", 5.8, c)\n\treturn model\nend\n\nfunction Kit.EggDisplay(parent: Instance, frame: CFrame, colors: any?): Model\n\tlocal c = colors or Kit.Palette\n\tlocal model = Kit.Model(parent, \"EggDisplay\", \"DisplayEggs\")\n\tKit.Crate(model, frame, Vector3.new(6, 1.7, 3.2), c)\n\tfor egg = 1, 3 do\n\t\tlocal x = (egg - 2) * 1.75\n\t\tKit.Part(model, \"EggBase\" .. egg, frame * CFrame.new(x, 2.24, 0), Vector3.new(1.2, 1.0, 1.2), if egg == 2 then c.PinkLight else c.Cream)\n\t\tKit.Part(model, \"EggTop\" .. egg, frame * CFrame.new(x, 2.88, 0), Vector3.new(0.8, 0.5, 0.8), if egg == 2 then c.PinkLight else c.Cream)\n\tend\n\treturn model\nend\n\nfunction Kit.Trellis(parent: Instance, frame: CFrame, width: number, colors: any?): Model\n\tlocal c = colors or Kit.Palette\n\tlocal model = Kit.Model(parent, \"GardenTrellis\", \"Trellis\")\n\tfor i, x in ipairs({ -width / 2, width / 2 }) do\n\t\tKit.Part(model, \"Post\" .. i, frame * CFrame.new(x, 7.5, 0), Vector3.new(0.8, 15, 0.8), c.Honey)\n\t\tKit.Bamboo(model, frame * CFrame.new(x, 0, 0.65), 0.85, c)\n\tend\n\tKit.Part(model, \"Header\", frame * CFrame.new(0, 15.25, 0), Vector3.new(width + 1.3, 0.8, 1.0), c.HoneyLight)\n\tfor i, x in ipairs({ -width / 2 + 1, 0, width / 2 - 1 }) do\n\t\tKit.Flower(model, frame * CFrame.new(x, 15.7, 0), 0.7, c)\n\tend\n\treturn model\nend\n\nfunction Kit.CreateLibrary(parent: Instance, frame: CFrame?, overrides: any?): Model\n\tlocal origin, colors = frame or CFrame.identity, Kit.Colors(overrides)\n\tlocal library = Kit.Model(parent, \"StudGardenNativeKit\", \"NativeAssetLibrary\")\n\tlibrary:SetAttribute(\"AssetIds\", \"None; original native assemblies\")\n\tlocal plants = { \"Carrot\", \"Strawberry\", \"Bamboo\", \"Sunflower\", \"Flower\" }\n\tlocal pets = { \"Rabbit\", \"Raccoon\", \"Bee\", \"Dragonfly\" }\n\tfor index, family in ipairs(plants) do\n\t\tlocal model = Kit[family](library, origin * CFrame.new((index - 1) * 8, 0, 0), 1, colors)\n\t\tmodel.Name = \"SG_\" .. family\n\t\tmodel:SetAttribute(\"AssetId\", \"Native_SG_\" .. family)\n\tend\n\tfor index, family in ipairs(pets) do\n\t\tlocal model = Kit[family](library, origin * CFrame.new((index - 1) * 8, 0, 12), 1, colors)\n\t\tmodel.Name = \"SG_\" .. family\n\t\tmodel:SetAttribute(\"AssetId\", \"Native_SG_\" .. family)\n\tend\n\tKit.StemCluster(library, origin * CFrame.new(36, 0, 12), 1, colors)\n\tKit.Climber(library, origin * CFrame.new(44, 0, 12), colors)\n\tKit.LeafMass(library, origin * CFrame.new(52, 0, 12), 1, colors)\n\tKit.Planter(library, origin * CFrame.new(0, 0, 24), Vector3.new(5.3, 1, 4.2), colors)\n\tKit.Pot(library, origin * CFrame.new(8, 0, 24), Vector3.new(3, 3, 3), colors)\n\tKit.Crate(library, origin * CFrame.new(16, 0, 24), Vector3.new(4, 3, 4), colors)\n\tKit.Fence(library, origin * CFrame.new(24, 0, 24), 6, colors)\n\tKit.EggDisplay(library, origin * CFrame.new(34, 0, 24), colors)\n\tKit.CandyBlossom(library, origin * CFrame.new(0, 0, 42), 14, colors)\n\tKit.Beanstalk(library, origin * CFrame.new(18, 0, 42), 31, colors)\n\tKit.SeedShop(library, origin * CFrame.new(38, 0, 42), colors)\n\tKit.Trellis(library, origin * CFrame.new(59, 0, 42), 22, colors)\n\treturn library\nend\n\nfunction Kit.Inventory(root: Instance): any\n\tlocal inventory = { parts = 0, models = 0, collidable = 0, touchable = 0, queryable = 0, meshParts = 0, lights = 0 }\n\tfor _, object in ipairs(root:GetDescendants()) do\n\t\tif object:IsA(\"BasePart\") then\n\t\t\tinventory.parts += 1\n\t\t\tif object.CanCollide then inventory.collidable += 1 end\n\t\t\tif object.CanTouch then inventory.touchable += 1 end\n\t\t\tif object.CanQuery then inventory.queryable += 1 end\n\t\t\tif object:IsA(\"MeshPart\") then inventory.meshParts += 1 end\n\t\telseif object:IsA(\"Model\") then\n\t\t\tinventory.models += 1\n\t\telseif object:IsA(\"Light\") then\n\t\t\tinventory.lights += 1\n\t\tend\n\tend\n\treturn inventory\nend\n\nreturn Kit\n"},{"path":["ServerStorage","CourseBuilders","StudGarden","Layout"],"source":"--!strict\n\nlocal Layout = {}\n\nlocal DIRECTIONS = {\n\tE = Vector3.new(1, 0, 0), W = Vector3.new(-1, 0, 0),\n\tN = Vector3.new(0, 0, -1), S = Vector3.new(0, 0, 1),\n}\n\nlocal MAIN_IDS = {\"A1\", \"A2\", \"A3\", \"B1\", \"H01\", \"M1A\", \"M1B\", \"M1C\", \"B3\", \"C1\", \"H02\", \"C2\", \"C3\", \"C4\", \"D1\", \"M2A\", \"M2B\", \"M2C\", \"D3\", \"E1\", \"E2\", \"E3\"}\n\n-- Positions are floor tops in local course space. Artwork and behavior share these records.\nfunction Layout.Get(): any\n\tlocal result: any = {\n\t\trevision = \"SG_LAYOUT_04\", mainSequenceIds = table.clone(MAIN_IDS),\n\t\tsequences = {}, checkpoints = {}, choices = {}, merges = {}, hazards = {}, barriers = {},\n\t\tsequenceById = {}, nodeById = {}, sectionBounds = {}, traversal = {},\n\t\tsections = {\"S01\", \"S02\", \"S03\", \"S04\", \"S05\"},\n\t\tgroundY = -5, maxFloorTop = 12, bodyJumpClearance = 13.2,\n\t\tfootprint = {min = Vector3.new(-279, -5, -297), max = Vector3.new(276, 38, 248)},\n\t\tlandmarks = {vine = Vector3.new(-62, -5, -181), candy = Vector3.new(183, -5, -178)},\n\t\ttuning = {mainGap = 5, mainLength = 12, mainWidth = 17, openingWidth = 24, expertSize = 4.5, fenceAboveFloor = 10, walkSpeed = 16, jumpHeight = 7.2},\n\t}\n\tlocal cursor: any\n\tlocal wave = {0, 1, 2, 1, 0, 2, 0, 1}\n\n\tlocal function node(id: string, section: string, top: Vector3, size: Vector3, forward: Vector3, kind: string, index: number?): any\n\t\tlocal record: any = {id = id, section = section, position = top, size = size, forward = forward, kind = kind}\n\t\tif index ~= nil then\n\t\t\trecord.index = index\n\t\t\trecord.spawnPosition = top + Vector3.new(0, 0, 18)\n\t\t\trecord.spawnSize = Vector3.new(24, 2, 14)\n\t\tend\n\t\tresult.nodeById[id] = record\n\t\tcursor = record\n\t\treturn record\n\tend\n\n\tlocal function advanceNode(id: string, section: string, direction: string, size: Vector3, topY: number, kind: string, index: number?): any\n\t\tlocal dir = DIRECTIONS[direction]\n\t\tlocal previousHalf = if dir.X ~= 0 then cursor.size.X / 2 else cursor.size.Z / 2\n\t\tlocal nextHalf = if dir.X ~= 0 then size.X / 2 else size.Z / 2\n\t\tlocal top = cursor.position + dir * (previousHalf + nextHalf + result.tuning.mainGap)\n\t\treturn node(id, section, Vector3.new(top.X, topY, top.Z), size, dir, kind, index)\n\tend\n\n\tlocal function sequence(id: string, section: string, title: string, instructions: {{any}}, baseY: number, exitY: number, recoveryIndex: number, opening: boolean?): any\n\t\tlocal record: any = {id = id, section = section, kind = \"main\", title = title, points = {}, recoveryIndex = recoveryIndex}\n\t\tlocal number = 0\n\t\tfor _, instruction in instructions do\n\t\t\tlocal direction, count = instruction[1], instruction[2]\n\t\t\tlocal dir = DIRECTIONS[direction]\n\t\t\tfor _ = 1, count do\n\t\t\t\tnumber += 1\n\t\t\t\tlocal size = Vector3.new(12, 2, 12)\n\t\t\t\tif opening then\n\t\t\t\t\tsize = if dir.X ~= 0 then Vector3.new(14, 2, 24) else Vector3.new(24, 2, 14)\n\t\t\t\tend\n\t\t\t\tlocal previousHalf = if dir.X ~= 0 then cursor.size.X / 2 else cursor.size.Z / 2\n\t\t\t\tlocal nextHalf = if dir.X ~= 0 then size.X / 2 else size.Z / 2\n\t\t\t\tlocal horizontal = cursor.position + dir * (previousHalf + nextHalf + result.tuning.mainGap)\n\t\t\t\tlocal point: any = {id = id .. \"_\" .. string.format(\"%02d\", number), position = Vector3.new(horizontal.X, baseY + wave[(number - 1) % #wave + 1], horizontal.Z), size = size, yaw = 0, forward = dir}\n\t\t\t\ttable.insert(record.points, point)\n\t\t\t\tcursor = point\n\t\t\tend\n\t\tend\n\t\trecord.points[#record.points].position = Vector3.new(cursor.position.X, exitY, cursor.position.Z)\n\t\tcursor = record.points[#record.points]\n\t\ttable.insert(result.sequences, record)\n\t\tresult.sequenceById[id] = record\n\t\treturn record\n\tend\n\n\tlocal function expert(id: string, section: string, title: string, positions: {{number}}, recoveryIndex: number): any\n\t\tlocal record: any = {id = id, section = section, kind = \"expert\", title = title, recoveryIndex = recoveryIndex, points = {}}\n\t\tfor i, position in positions do\n\t\t\ttable.insert(record.points, {id = id .. \"_\" .. string.format(\"%02d\", i), position = Vector3.new(position[1], position[2], position[3]), size = Vector3.new(4.5, 2, 4.5), yaw = 0})\n\t\tend\n\t\ttable.insert(result.sequences, record)\n\t\tresult.sequenceById[id] = record\n\t\treturn record\n\tend\n\n\tlocal function fence(id: string, a: Vector3, b: Vector3, adjacentTop: number)\n\t\tlocal delta = b - a\n\t\tlocal height = adjacentTop + result.tuning.fenceAboveFloor - result.groundY\n\t\ttable.insert(result.barriers, {id = id, position = Vector3.new((a.X + b.X) / 2, result.groundY + height / 2, (a.Z + b.Z) / 2), size = Vector3.new(if math.abs(delta.X) > 0 then math.abs(delta.X) else 2, height, if math.abs(delta.Z) > 0 then math.abs(delta.Z) else 2), adjacentTop = adjacentTop})\n\tend\n\n\ttable.insert(result.checkpoints, node(\"R0\", \"S01\", Vector3.new(-215, 0, 218), Vector3.new(40, 2, 32), DIRECTIONS.E, \"checkpoint\", 0))\n\tresult.checkpoints[1].spawnPosition = Vector3.new(-215, 0, 218)\n\tresult.checkpoints[1].spawnSize = Vector3.new(40, 2, 32)\n\tsequence(\"A1\", \"S01\", \"Pot steps\", {{\"E\", 9}}, 0, 2, 0, true)\n\tsequence(\"A2\", \"S01\", \"Tool-handle turns\", {{\"N\", 4}, {\"W\", 3}}, 2, 2, 0, true)\n\tsequence(\"A3\", \"S01\", \"Planter weave\", {{\"N\", 2}, {\"E\", 4}, {\"N\", 2}}, 2, 2, 0)\n\ttable.insert(result.checkpoints, advanceNode(\"R1\", \"S02\", \"W\", Vector3.new(26, 2, 22), 2, \"checkpoint\", 1))\n\tsequence(\"B1\", \"S02\", \"Strawberry rows\", {{\"N\", 4}, {\"E\", 6}, {\"S\", 2}, {\"W\", 2}}, 3, 3, 1)\n\tcursor.size = Vector3.new(12, 2, 24)\n\n\tlocal h01: any = {\n\t\tid = \"H01\", section = \"S02\", kind = \"sprinkler\", recoveryIndex = 1,\n\t\tposition = Vector3.new(23, 3, 83), floorTop = 3, forward = DIRECTIONS.S,\n\t\tcrossingAxis = \"Z\", crossingLength = 36, crossingWidth = 18,\n\t\tcrossing = {position = Vector3.new(23, 3, 83), size = Vector3.new(18, 2, 36)},\n\t\tvolume = {position = Vector3.new(22.5, 5.75, 83), size = Vector3.new(27, 5.5, 32)},\n\t\tsafeBefore = {position = Vector3.new(23, 3, 53), size = Vector3.new(24, 2, 24)},\n\t\tsafeAfter = {position = Vector3.new(23, 3, 119), size = Vector3.new(24, 2, 24)},\n\t\tnozzlePosition = Vector3.new(10, 4, 83),\n\t\twaterStart = Vector3.new(35, 5.75, 68), waterFinish = Vector3.new(35, 5.75, 98),\n\t}\n\ttable.insert(result.hazards, h01)\n\tresult.sequenceById.H01 = h01\n\tcursor = node(\"H01_After\", \"S02\", h01.safeAfter.position, h01.safeAfter.size, DIRECTIONS.S, \"refuge\")\n\ttable.insert(result.choices, advanceNode(\"J1\", \"S02\", \"S\", Vector3.new(28, 2, 28), 4, \"choice\"))\n\tsequence(\"M1A\", \"S02\", \"Bamboo gates\", {{\"S\", 4}, {\"E\", 4}}, 4, 4, 1)\n\tsequence(\"M1B\", \"S02\", \"Offset beds\", {{\"E\", 7}, {\"N\", 1}}, 4, 4, 1)\n\tsequence(\"M1C\", \"S02\", \"Return row\", {{\"N\", 4}, {\"W\", 4}, {\"N\", 2}}, 4, 4, 1)\n\ttable.insert(result.merges, advanceNode(\"K1\", \"S02\", \"N\", Vector3.new(26, 2, 28), 4, \"merge\"))\n\tsequence(\"B3\", \"S02\", \"Egg-yard hops\", {{\"N\", 6}, {\"E\", 4}}, 5, 5, 1)\n\ttable.insert(result.checkpoints, advanceNode(\"R2\", \"S03\", \"N\", Vector3.new(24, 2, 24), 6, \"checkpoint\", 2))\n\tsequence(\"C1\", \"S03\", \"Root slalom\", {{\"N\", 3}, {\"W\", 5}}, 7, 7, 2)\n\tcursor.size = Vector3.new(12, 2, 20)\n\n\tlocal h02: any = {\n\t\tid = \"H02\", section = \"S03\", kind = \"fruitChute\", recoveryIndex = 2,\n\t\tposition = Vector3.new(127, 7, -167), floorTop = 7, forward = DIRECTIONS.N,\n\t\tcrossingAxis = \"Z\", crossingLength = 40, crossingWidth = 18,\n\t\tcrossing = {position = Vector3.new(127, 7, -167), size = Vector3.new(18, 2, 40)},\n\t\tvolume = {position = Vector3.new(127, 10, -167), size = Vector3.new(39, 6, 10)},\n\t\tsafeBefore = {position = Vector3.new(127, 7, -136), size = Vector3.new(24, 2, 24)},\n\t\tsafeAfter = {position = Vector3.new(127, 7, -202), size = Vector3.new(24, 2, 24)},\n\t\tfruitStart = Vector3.new(109, 9, -167), fruitFinish = Vector3.new(145, 8.5, -167),\n\t\tchuteStart = Vector3.new(109, 9, -167), chuteEnd = Vector3.new(145, 8.5, -167),\n\t\tcatchPosition = Vector3.new(148, 7, -167),\n\t}\n\ttable.insert(result.hazards, h02)\n\tresult.sequenceById.H02 = h02\n\tcursor = node(\"H02_After\", \"S03\", h02.safeAfter.position, h02.safeAfter.size, DIRECTIONS.N, \"refuge\")\n\tsequence(\"C2\", \"S03\", \"Candy crates\", {{\"E\", 7}}, 8, 8, 2)\n\tsequence(\"C3\", \"S03\", \"Crown-fringe pads\", {{\"N\", 2}, {\"W\", 7}}, 9, 9, 2)\n\tsequence(\"C4\", \"S03\", \"Picker descent\", {{\"W\", 3}, {\"S\", 5}}, 7, 5, 2)\n\ttable.insert(result.checkpoints, advanceNode(\"R3\", \"S04\", \"W\", Vector3.new(24, 2, 24), 5, \"checkpoint\", 3))\n\tsequence(\"D1\", \"S04\", \"Root-garden entry\", {{\"S\", 4}, {\"W\", 2}, {\"N\", 2}}, 5, 5, 3)\n\ttable.insert(result.choices, advanceNode(\"J2\", \"S04\", \"W\", Vector3.new(28, 2, 28), 5, \"choice\"))\n\tsequence(\"M2A\", \"S04\", \"Broad leaves\", {{\"N\", 7}}, 7, 7, 3)\n\tsequence(\"M2B\", \"S04\", \"Outer planter wrap\", {{\"W\", 8}, {\"S\", 2}}, 10, 10, 3)\n\tsequence(\"M2C\", \"S04\", \"Lower-leaf return\", {{\"S\", 5}, {\"E\", 2}, {\"S\", 2}}, 8, 6, 3)\n\ttable.insert(result.merges, advanceNode(\"K2\", \"S04\", \"S\", Vector3.new(28, 2, 26), 6, \"merge\"))\n\tsequence(\"D3\", \"S04\", \"Trellis crossing\", {{\"W\", 6}, {\"S\", 3}}, 5, 5, 3)\n\ttable.insert(result.checkpoints, advanceNode(\"R4\", \"S05\", \"S\", Vector3.new(24, 2, 24), 5, \"checkpoint\", 4))\n\tsequence(\"E1\", \"S05\", \"Harvest crates\", {{\"S\", 4}, {\"W\", 3}}, 5, 5, 4)\n\tsequence(\"E2\", \"S05\", \"Flower-arch weave\", {{\"N\", 10}}, 4, 4, 4)\n\tsequence(\"E3\", \"S05\", \"Finish rhythm\", {{\"E\", 2}, {\"N\", 8}}, 5, 5, 4)\n\tresult.finish = advanceNode(\"F0\", \"S05\", \"N\", Vector3.new(38, 2, 40), 5, \"finish\")\n\tresult.finish.runoff = {position = result.finish.position + DIRECTIONS.N * 24, size = Vector3.new(38, 2, 24)}\n\tresult.checkpoints[2].spawnPosition = result.checkpoints[2].position + Vector3.new(-19,0,0)\n\tresult.checkpoints[2].spawnSize = Vector3.new(18,2,22)\n\tresult.checkpoints[2].forward = DIRECTIONS.N\n\tresult.checkpoints[3].spawnPosition = result.checkpoints[3].position + Vector3.new(18,0,0)\n\tresult.checkpoints[3].spawnSize = Vector3.new(18,2,24)\n\tresult.checkpoints[4].spawnPosition = result.checkpoints[4].position + Vector3.new(-18,0,0)\n\tresult.checkpoints[4].spawnSize = Vector3.new(18,2,24)\n\tresult.checkpoints[4].forward = DIRECTIONS.S\n\tresult.checkpoints[5].spawnPosition = result.checkpoints[5].position + Vector3.new(18,0,0)\n\tresult.checkpoints[5].spawnSize = Vector3.new(18,2,24)\n\n\texpert(\"X01A\", \"S02\", \"Narrow fence caps\", {{45,4,150},{55,5,150},{65,4,150},{75,6,150},{85,4,150},{95,5,150},{105,4,150},{115,4,150}}, 1)\n\texpert(\"X01B\", \"S02\", \"Fence turn and offset\", {{125,4,150},{123,5,140},{123,4,130},{123,6,120},{123,4,110},{123,4,104}}, 1)\n\texpert(\"X02A\", \"S04\", \"Pod-side launch\", {{2,5,-90.75},{2,6,-80.75},{-8,5,-80.75},{-18,7,-80.75},{-28,5,-80.75},{-38,5,-80.75}}, 3)\n\texpert(\"X02B\", \"S04\", \"Pod offset and turn\", {{-48,5,-80.75},{-57,6,-90.75},{-68,5,-90.75},{-78,7,-90.75},{-82,6,-81}}, 3)\n\tfor _, record in result.sequences do\n\t\tif record.kind == \"main\" and record.id ~= \"A1\" and record.id ~= \"A2\" then\n\t\t\tfor i, point in record.points do\n\t\t\t\tlocal following = record.points[i + 1]\n\t\t\t\tif following and following.forward == point.forward then\n\t\t\t\t\tpoint.size = if point.forward.X ~= 0 then Vector3.new(12,2,result.tuning.mainWidth) else Vector3.new(result.tuning.mainWidth,2,12)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Preserve the incoming jump gap while giving the opening pack room to turn.\n\tresult.sequenceById.A1.points[9].size = Vector3.new(24, 2, 24)\n\tresult.sequenceById.A1.points[9].position += DIRECTIONS.E * 5\n\tresult.sequenceById.A2.points[4].size = Vector3.new(24, 2, 24)\n\n\tresult.mainRoute = {\"R0\",\"A1\",\"A2\",\"A3\",\"R1\",\"B1\",\"H01\",\"J1\",\"M1A\",\"M1B\",\"M1C\",\"K1\",\"B3\",\"R2\",\"C1\",\"H02\",\"C2\",\"C3\",\"C4\",\"R3\",\"D1\",\"J2\",\"M2A\",\"M2B\",\"M2C\",\"K2\",\"D3\",\"R4\",\"E1\",\"E2\",\"E3\",\"F0\"}\n\tresult.forks = {\n\t\t{id=\"X01\", entry=\"J1\", main={\"M1A\",\"M1B\",\"M1C\"}, expert={\"X01A\",\"X01B\"}, merge=\"K1\", recoveryIndex=1},\n\t\t{id=\"X02\", entry=\"J2\", main={\"M2A\",\"M2B\",\"M2C\"}, expert={\"X02A\",\"X02B\"}, merge=\"K2\", recoveryIndex=3},\n\t}\n\n\tfence(\"OpeningRows\", Vector3.new(-205,0,177), Vector3.new(-60,0,177), 4)\n\tfence(\"ToolsToPlanters\", Vector3.new(-73,0,120), Vector3.new(-16,0,120), 4)\n\tfence(\"CropUpperFold\", Vector3.new(-32,0,7), Vector3.new(36,0,7), 5)\n\tfence(\"CropMainToExpert\", Vector3.new(46,0,185), Vector3.new(195,0,185), 6)\n\tfence(\"CropReturnToExpert\", Vector3.new(130.5,0,106), Vector3.new(130.5,0,158), 6)\n\tfence(\"CropToCandy\", Vector3.new(174,0,-5), Vector3.new(196,0,-5), 7)\n\tfence(\"CandyUpperFold\", Vector3.new(144,0,-219), Vector3.new(238,0,-219), 11)\n\tfence(\"CandyToRootEntry\", Vector3.new(72,0,-135), Vector3.new(72,0,-76), 9)\n\tfence(\"RootEntryFold\", Vector3.new(43,0,-107), Vector3.new(43,0,-93), 7)\n\tfence(\"VineMainToExpert\", Vector3.new(-90,0,-109), Vector3.new(-18,0,-109), 12)\n\tfence(\"VineToFestival\", Vector3.new(-170,0,-239), Vector3.new(-170,0,-88), 12)\n\tfence(\"FestivalFold\", Vector3.new(-244,0,-55), Vector3.new(-244,0,67), 7)\n\tfence(\"FestivalToTrellis\", Vector3.new(-225,0,-75), Vector3.new(-225,0,-27), 7)\n\tfence(\"StartToFestival\", Vector3.new(-270,0,148), Vector3.new(-118,0,148), 7)\n\n\tlocal bounds = {\n\t\tS01={-242,50,-6,241}, S02={-84,-44,230,245}, S03={70,-254,266,-42},\n\t\tS04={-220,-251,77,5}, S05={-275,-297,-145,106},\n\t}\n\tfor section, values in bounds do\n\t\tresult.sectionBounds[section] = {min=Vector3.new(values[1],-5,values[2]),max=Vector3.new(values[3],14,values[4]),groundY=-5}\n\tend\n\tfor _, combination in {{false,false},{true,false},{false,true},{true,true}} do\n\t\tlocal ids = {}\n\t\tfor _, id in result.mainRoute do\n\t\t\tif id == \"M1A\" and combination[1] then table.insert(ids,\"X01A\"); table.insert(ids,\"X01B\")\n\t\t\telseif id == \"M2A\" and combination[2] then table.insert(ids,\"X02A\"); table.insert(ids,\"X02B\")\n\t\t\telseif (combination[1] and (id==\"M1B\" or id==\"M1C\")) or (combination[2] and (id==\"M2B\" or id==\"M2C\")) then continue\n\t\t\telse table.insert(ids,id) end\n\t\tend\n\t\tlocal waypoints = {}\n\t\tfor _, id in ids do\n\t\t\tlocal record = result.sequenceById[id] or result.nodeById[id]\n\t\t\tif record.points then\n\t\t\t\tfor _, point in record.points do table.insert(waypoints,{id=point.id,sequenceId=id,position=point.position,size=point.size,kind=record.kind}) end\n\t\t\telseif record.crossing then\n\t\t\t\tfor _, pair in {{\"Before\",record.safeBefore},{\"Crossing\",record.crossing},{\"After\",record.safeAfter}} do table.insert(waypoints,{id=id..\"_\"..pair[1],sequenceId=id,position=pair[2].position,size=pair[2].size,kind=\"hazard\"}) end\n\t\t\telse table.insert(waypoints,{id=id,sequenceId=id,position=record.position,size=record.size,kind=record.kind}) end\n\t\tend\n\t\tlocal key = (if combination[1] then \"X01\" else \"main\") .. \"_\" .. (if combination[2] then \"X02\" else \"main\")\n\t\tresult.traversal[key] = {ids=ids,waypoints=waypoints}\n\tend\n\treturn result\nend\n\nreturn Layout\n"},{"path":["ServerStorage","CourseBuilders","StudGarden","Runtime"],"source":"--!strict\n\nlocal Players = game:GetService(\"Players\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal Config = require(game.ReplicatedStorage.Config.StudGardenConfig)\nlocal ContactGeometry = require(game.ReplicatedStorage.Shared.ShipwreckHazards)\nlocal Layout = require(script.Parent.Layout)\nlocal HazardState = require(script.Parent.HazardState)\n\nlocal Runtime = {}\nlocal BODY_NAMES = {\n\tHead = true, Torso = true, UpperTorso = true, LowerTorso = true,\n\t[\"Left Arm\"] = true, [\"Right Arm\"] = true, [\"Left Leg\"] = true, [\"Right Leg\"] = true,\n\tLeftUpperArm = true, LeftLowerArm = true, LeftHand = true,\n\tRightUpperArm = true, RightLowerArm = true, RightHand = true,\n\tLeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,\n\tRightUpperLeg = true, RightLowerLeg = true, RightFoot = true,\n}\n\nlocal function vector(value: any): Vector3\n\treturn if typeof(value) == \"Vector3\" then value else Vector3.new(value[1], value[2], value[3])\nend\n\nlocal function visualPart(parent: Instance?, name: string): BasePart?\n\tlocal part = if parent ~= nil then parent:FindFirstChild(name) else nil\n\treturn if part ~= nil and part:IsA(\"BasePart\") then part else nil\nend\n\nlocal function runtimePart(parent: Instance, name: string, size: Vector3, color: Color3): Part\n\tlocal part = Instance.new(\"Part\")\n\tpart.Name = name\n\tpart.Size = size\n\tpart.Color = color\n\tpart.Material = Enum.Material.SmoothPlastic\n\tpart.Anchored = true\n\tpart.CanCollide = false\n\tpart.CanTouch = false\n\tpart.CanQuery = false\n\tpart.CastShadow = false\n\tpart.Transparency = 1\n\tpart.Parent = parent\n\treturn part\nend\n\nfunction Runtime.Create(course: Model, recoverPlayer: (Player, string) -> boolean,\n\tisEligible: (Player) -> boolean): any\n\tassert(course:GetAttribute(\"StudGardenBuild\") == Config.BuildId\n\t\tand course:GetAttribute(\"CourseId\") == Config.CourseId, \"Stud Garden runtime course mismatch\")\n\tlocal layout = Layout.Get()\n\tlocal bounds = course:FindFirstChild(\"Bounds\")\n\tlocal marker = visualPart(bounds, \"CourseOrigin\")\n\tlocal origin = if marker ~= nil then marker.CFrame else CFrame.new(Config.Origin)\n\tlocal art = course:FindFirstChild(\"Art\")\n\tlocal hazardVisuals = if art ~= nil then art:FindFirstChild(\"HazardVisuals\") else nil\n\tlocal owned = Instance.new(\"Folder\")\n\towned.Name = \"StudGardenRuntime\"\n\towned:SetAttribute(\"RuntimeOwner\", Config.BuildId)\n\towned.Parent = course\n\n\tlocal originals: {[BasePart]: any} = {}\n\tlocal modelPivots: {[Model]: CFrame} = {}\n\tlocal records: {any} = {}\n\tlocal disabled: {string} = {}\n\tlocal cooldowns: {[Player]: number} = setmetatable({}, {__mode = \"k\"}) :: any\n\tlocal previousTime = 0\n\tlocal accumulated = 0\n\tlocal stopped = false\n\tlocal idle = true\n\tlocal diagnostics = {bound = true, visualSteps = 0, contactTests = 0, recoveries = 0,\n\t\tskippedStalls = 0, lastStepMs = 0, maxStepMs = 0, lastEligibleCount = 0}\n\n\tlocal function remember(part: BasePart)\n\t\toriginals[part] = {cframe = part.CFrame, color = part.Color, material = part.Material,\n\t\t\ttransparency = part.Transparency}\n\tend\n\tlocal function position(value: any): Vector3\n\t\treturn origin:PointToWorldSpace(vector(value))\n\tend\n\tlocal function hazardData(id: string): any\n\t\tlocal data = layout.hazards[id]\n\t\tif data ~= nil then\n\t\t\treturn data\n\t\tend\n\t\tfor _, item in layout.hazards do\n\t\t\tif item.id == id then\n\t\t\t\treturn item\n\t\t\tend\n\t\tend\n\t\treturn nil\n\tend\n\tfor _, id in {\"H01\", \"H02\"} do\n\t\tlocal data = hazardData(id)\n\t\tlocal group = if hazardVisuals ~= nil then hazardVisuals:FindFirstChild(id) else nil\n\t\tlocal lamp = visualPart(group, \"WarningLamp\")\n\t\tlocal timing = Config.Hazards[id]\n\t\tlocal cap = if id == \"H01\" then visualPart(group, \"NozzleCap\") else nil\n\t\tlocal raccoon = if group ~= nil then group:FindFirstChild(\"RaccoonCue\") else nil\n\t\tlocal valid = data ~= nil and timing ~= nil and lamp ~= nil\n\t\t\tand (if id == \"H01\" then cap ~= nil and visualPart(group, \"NozzleBase\") ~= nil and data.nozzlePosition ~= nil\n\t\t\t\tand data.waterStart ~= nil and data.waterFinish ~= nil\n\t\t\t\telse raccoon ~= nil and raccoon:IsA(\"Model\")\n\t\t\t\t\tand visualPart(group, \"ChuteLip\") ~= nil and visualPart(group, \"CatchCrate\") ~= nil\n\t\t\t\t\tand data.chuteStart ~= nil and data.chuteEnd ~= nil)\n\t\tif not valid then\n\t\t\ttable.insert(disabled, id .. \": required layout or visible cue is missing\")\n\t\t\tcontinue\n\t\tend\n\t\tassert(timing.Warning >= 1.2 and timing.Clear >= 5 and timing.Active > 0,\n\t\t\tid .. \" must retain a warning and generous clear crossing window\")\n\t\tremember(lamp :: BasePart)\n\t\tlocal record: any = {id = id, data = data, timing = timing, lamp = lamp, group = group,\n\t\t\tphase = \"Clear\", originalPhase = group:GetAttribute(\"HazardPhase\")}\n\t\tif id == \"H01\" then\n\t\t\tremember(cap :: BasePart)\n\t\t\trecord.cap = cap\n\t\t\trecord.start = position(data.waterStart)\n\t\t\trecord.finish = position(data.waterFinish)\n\t\t\tlocal nozzle = vector(data.nozzlePosition)\n\t\t\trecord.nozzle = position(Vector3.new(nozzle.X, vector(data.waterStart).Y, nozzle.Z))\n\t\t\trecord.waterSize = vector(data.waterSize or timing.WaterSize)\n\t\t\trecord.part = runtimePart(owned, \"H01_WaterSweep\", record.waterSize, Color3.fromRGB(88, 194, 242))\n\t\telse\n\t\t\tmodelPivots[raccoon :: Model] = (raccoon :: Model):GetPivot()\n\t\t\trecord.raccoon = raccoon\n\t\t\trecord.start = position(data.chuteStart)\n\t\t\trecord.finish = position(data.chuteEnd)\n\t\t\tlocal size = vector(data.fruitSize or timing.FruitSize)\n\t\t\tassert(math.abs(size.X - size.Y) < 0.001 and math.abs(size.X - size.Z) < 0.001,\n\t\t\t\t\"H02 fruit must be a sphere with one visible diameter\")\n\t\t\trecord.radius = size.X / 2\n\t\t\trecord.part = runtimePart(owned, \"H02_HarvestFruit\", size, Color3.fromRGB(227, 66, 73))\n\t\t\trecord.part.Shape = Enum.PartType.Ball\n\t\tend\n\t\trecord.part:SetAttribute(\"HazardId\", id)\n\t\trecord.part:SetAttribute(\"RecoveryCheckpoint\", if id == \"H01\" then \"R1\" else \"R2\")\n\t\ttable.insert(records, record)\n\tend\n\tfor _, reason in disabled do\n\t\twarn(\"[StudGarden] Disabled \" .. reason)\n\tend\n\n\tlocal function waterFrame(record: any, progress: number): (CFrame, Vector3)\n\t\tlocal endpoint = record.start:Lerp(record.finish, progress)\n\t\tlocal length = (endpoint - record.nozzle).Magnitude\n\t\treturn CFrame.lookAt((endpoint + record.nozzle) / 2, endpoint),\n\t\t\tVector3.new(record.waterSize.X, record.waterSize.Y, length)\n\tend\n\tlocal function display(record: any, phase: string, progress: number)\n\t\trecord.phase = phase\n\t\trecord.part:SetAttribute(\"Phase\", phase)\n\t\trecord.group:SetAttribute(\"HazardPhase\", phase)\n\t\trecord.lamp.Color = if phase == \"Warning\" then Color3.fromRGB(255, 174, 44)\n\t\t\telseif phase == \"Active\" then Color3.fromRGB(244, 72, 67) else Color3.fromRGB(103, 192, 104)\n\t\trecord.lamp.Material = if phase == \"Clear\" then Enum.Material.SmoothPlastic else Enum.Material.Neon\n\t\tif record.id == \"H01\" then\n\t\t\tlocal target = record.start:Lerp(record.finish, if phase == \"Active\" then progress else 0)\n\t\t\tlocal original = originals[record.cap].cframe\n\t\t\tlocal aim = CFrame.lookAt(original.Position, Vector3.new(target.X, original.Position.Y, target.Z))\n\t\t\trecord.cap.CFrame = if phase == \"Clear\" then original\n\t\t\t\telseif phase == \"Warning\" then original:Lerp(aim, progress) else aim\n\t\t\trecord.part.CFrame, record.part.Size = waterFrame(record, if phase == \"Active\" then progress else 0)\n\t\t\trecord.part.Transparency = if phase == \"Active\" then 0.28 else 1\n\t\telse\n\t\t\tlocal gesture = if phase == \"Warning\" then progress elseif phase == \"Active\" then 1 else 0\n\t\t\trecord.raccoon:PivotTo(modelPivots[record.raccoon] * CFrame.Angles(math.rad(-9) * gesture, 0, 0))\n\t\t\trecord.part.CFrame = CFrame.new(record.start:Lerp(record.finish,\n\t\t\t\tif phase == \"Active\" then progress elseif phase == \"Warning\" then 0 else 1))\n\t\t\trecord.part.Transparency = if phase == \"Clear\" then 1 else 0\n\t\tend\n\tend\n\tlocal function racers(active: boolean, now: number, elapsedDt: number): {any}\n\t\tlocal result = {}\n\t\tfor _, player in Players:GetPlayers() do\n\t\t\tlocal character = player.Character\n\t\t\tlocal humanoid = if character ~= nil then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\t\t\tlocal alive = humanoid ~= nil and humanoid.Health > 0\n\t\t\tlocal immunity = if character ~= nil then character:GetAttribute(\"RecoveryUntil\") or 0 else 0\n\t\t\tif not HazardState.CanContact(active, isEligible(player), alive, now, immunity,\n\t\t\t\tcooldowns[player], Config.Runtime.RecoveryCooldown, elapsedDt, Config.Runtime.MaxContactDt) then\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tlocal bodyParts = {}\n\t\t\tfor _, child in (character :: Model):GetChildren() do\n\t\t\t\tif child:IsA(\"BasePart\") and BODY_NAMES[child.Name] and child.Transparency < 1 then\n\t\t\t\t\ttable.insert(bodyParts, child)\n\t\t\t\tend\n\t\t\tend\n\t\t\ttable.insert(result, {player = player, character = character, bodyParts = bodyParts})\n\t\tend\n\t\treturn result\n\tend\n\n\tlocal controller = {}\n\tfunction controller.Step(elapsed: number, dt: number, active: boolean)\n\t\tif stopped then\n\t\t\treturn\n\t\tend\n\t\tif not active then\n\t\t\tif not idle then\n\t\t\t\tfor _, record in records do\n\t\t\t\t\tdisplay(record, \"Clear\", 0)\n\t\t\t\tend\n\t\t\tend\n\t\t\tidle = true\n\t\t\tpreviousTime = elapsed\n\t\t\taccumulated = 0\n\t\t\treturn\n\t\tend\n\t\tidle = false\n\t\taccumulated += math.max(0, dt)\n\t\tif accumulated < Config.Runtime.VisualInterval and elapsed >= previousTime then\n\t\t\treturn\n\t\tend\n\t\tlocal started = os.clock()\n\t\tlocal elapsedDt = elapsed - previousTime\n\t\tlocal now = Workspace:GetServerTimeNow()\n\t\tlocal participants = racers(active, now, elapsedDt)\n\t\tlocal recovered: {[Player]: boolean} = {}\n\t\tif elapsedDt > Config.Runtime.MaxContactDt then\n\t\t\tdiagnostics.skippedStalls += 1\n\t\tend\n\t\tdiagnostics.lastEligibleCount = #participants\n\t\tfor _, record in records do\n\t\t\tlocal phase, progress = HazardState.Phase(elapsed, record.timing)\n\t\t\tdisplay(record, phase, progress)\n\t\t\tif record.part.Parent == nil then\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tif #participants == 0 then\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tfor _, interval in HazardState.ActiveIntervals(previousTime, elapsed, record.timing) do\n\t\t\t\tlocal first, last = interval[1], interval[2]\n\t\t\t\tlocal samples = if record.id == \"H01\" then math.max(1,\n\t\t\t\t\tmath.ceil((record.finish - record.start).Magnitude * (last - first) / 0.25)) else 1\n\t\t\t\tfor sample = 0, (if record.id == \"H01\" then samples else 0) do\n\t\t\t\t\tlocal age = first + (last - first) * sample / samples\n\t\t\t\t\tlocal cf, size = CFrame.identity, Vector3.zero\n\t\t\t\t\tif record.id == \"H01\" then\n\t\t\t\t\t\tcf, size = waterFrame(record, age)\n\t\t\t\t\tend\n\t\t\t\t\tfor _, racer in participants do\n\t\t\t\t\t\tif recovered[racer.player] then\n\t\t\t\t\t\t\tcontinue\n\t\t\t\t\t\tend\n\t\t\t\t\t\tfor _, body in racer.bodyParts do\n\t\t\t\t\t\t\tif body.Parent ~= racer.character then\n\t\t\t\t\t\t\t\tcontinue\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tdiagnostics.contactTests += 1\n\t\t\t\t\t\t\tlocal hit = if record.id == \"H01\"\n\t\t\t\t\t\t\t\tthen ContactGeometry.BoxesIntersect(cf, size, body.CFrame, body.Size)\n\t\t\t\t\t\t\t\telse ContactGeometry.SweptSphere(record.start:Lerp(record.finish, first),\n\t\t\t\t\t\t\t\t\trecord.start:Lerp(record.finish, last), record.radius, body.CFrame, body.Size)\n\t\t\t\t\t\t\tif hit then\n\t\t\t\t\t\t\t\trecovered[racer.player] = true\n\t\t\t\t\t\t\t\tif recoverPlayer(racer.player, \"StudGarden \" .. record.id) then\n\t\t\t\t\t\t\t\t\tcooldowns[racer.player] = now\n\t\t\t\t\t\t\t\t\tdiagnostics.recoveries += 1\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tpreviousTime = elapsed\n\t\taccumulated = 0\n\t\tdiagnostics.visualSteps += 1\n\t\tdiagnostics.lastStepMs = (os.clock() - started) * 1000\n\t\tdiagnostics.maxStepMs = math.max(diagnostics.maxStepMs, diagnostics.lastStepMs)\n\tend\n\tfunction controller.Reset()\n\t\tif stopped then\n\t\t\treturn\n\t\tend\n\t\tpreviousTime = 0\n\t\taccumulated = 0\n\t\tidle = true\n\t\ttable.clear(cooldowns)\n\t\tfor _, record in records do\n\t\t\tdisplay(record, \"Clear\", 0)\n\t\tend\n\tend\n\tfunction controller.Stop()\n\t\tif stopped then\n\t\t\treturn\n\t\tend\n\t\tstopped = true\n\t\tfor part, original in originals do\n\t\t\tif part.Parent ~= nil then\n\t\t\t\tpart.CFrame = original.cframe\n\t\t\t\tpart.Color = original.color\n\t\t\t\tpart.Material = original.material\n\t\t\t\tpart.Transparency = original.transparency\n\t\t\tend\n\t\tend\n\t\tfor model, pivot in modelPivots do\n\t\t\tif model.Parent ~= nil then\n\t\t\t\tmodel:PivotTo(pivot)\n\t\t\tend\n\t\tend\n\t\tfor _, record in records do\n\t\t\tif record.group.Parent ~= nil then\n\t\t\t\trecord.group:SetAttribute(\"HazardPhase\", record.originalPhase)\n\t\t\tend\n\t\tend\n\t\towned:Destroy()\n\t\ttable.clear(cooldowns)\n\tend\n\tfunction controller.Diagnostics(): any\n\t\tlocal report = table.clone(diagnostics)\n\t\treport.bound = not stopped\n\t\treport.disabled = table.clone(disabled)\n\t\treport.hazards = {}\n\t\tfor _, record in records do\n\t\t\treport.hazards[record.id] = {phase = record.phase, warning = record.timing.Warning,\n\t\t\t\tactive = record.timing.Active, clear = record.timing.Clear}\n\t\tend\n\t\treturn report\n\tend\n\tcontroller.Reset()\n\treturn controller\nend\n\nreturn Runtime\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","CourseBuild"],"source":"--!strict\n\nlocal Kit=require(script.Parent.Kit)\nlocal Prototype=require(script.Parent.Prototype)\nlocal P=require(script.Parent.CourseParts)\nlocal Seed=require(script.Parent.SeedCourse)\nlocal Grove=require(script.Parent.GroveCourse)\nlocal Vine=require(script.Parent.VineCourse)\nlocal Festival=require(script.Parent.FestivalCourse)\nlocal Wayfinding=require(script.Parent.Wayfinding)\nlocal CourseBuild={}\nCourseBuild.Revision=\"SGV2_R207\"\n\nlocal checkpoints={\n\t{\"SeedSorting\",-152,7.3,78,0,-1,24,24},\n\t{\"R1_CropEntry\",-56,4.24,28,0,-1,28,22},\n\t{\"H1_Exit\",-56,7.24,-97,-1,0,36,22},\n\t{\"K1_StakesMerge\",-103,7.24,-24,-1,0,32,24},\n\t{\"R2_GroveEntry\",-18,8.24,-139,1,0,28,22},\n\t{\"H2_Exit\",131,8.24,-141,1,0,22,28},\n\t{\"R3_VineEntry\",76,8.24,-57,0,1,28,21},\n\t{\"K2_TendrilMerge\",31,10.75,16,0,1,40,30,27,14,28,24},\n\t{\"R4_FestivalEntry\",36,8.24,82,0,1,32,24,33,82,24,24},\n}\n\nfunction CourseBuild.Create(parent: Instance): Model\n\tassert(not parent:FindFirstChild(\"Course_StudGardenV2\"),\"Preserve existing V2 candidate and manual edits\")\n\tlocal m=Kit.Group(parent,\"Course_StudGardenV2\",CFrame.new(P.Origin))\n\tm:SetAttribute(\"CandidateId\",CourseBuild.Revision)\n\tm:SetAttribute(\"CourseId\",\"stud_garden_v2\")\n\tm:SetAttribute(\"CourseOrigin\",P.Origin)\n\tm:SetAttribute(\"ManualEditing\",true)\n\tm:SetAttribute(\"CandidateRequiresVerification\",true)\n\tm:SetAttribute(\"Phase\",\"2 Course assembly; movement and timing pending\")\n\tlocal info=P.Folder(m,\"CourseInfo\")\n\tfor k,v in {CourseId=\"stud_garden_v2\",DisplayName=\"Stud Garden V2\",RaceFormat=\"PointToPoint\",LapCount=1,Enabled=false,Difficulty=\"Intermediate; optional precision branches\",TargetNewPlayerTime=270,TargetPracticedTime=150,CheckpointCount=#checkpoints} do info:SetAttribute(k,v) end\n\tlocal obstacles=P.Folder(m,\"Obstacles\")\n\tlocal markers=P.Folder(m,\"RouteMarkers\")\n\tlocal decoration=P.Folder(m,\"Decoration\")\n\tlocal bounds=P.Folder(m,\"Bounds\")\n\tlocal fallZones=P.Folder(m,\"FallZones\")\n\tP.Marker(bounds,\"CourseOrigin\",Vector3.zero,Vector3.new(0,0,-1),Vector3.one,false)\n\tlocal ground=Kit.Part(decoration,\"LowGardenGround\",P.Frame(0,-4.3,0),Vector3.new(374,3,380),Kit.Colors.grass,\"Blocker\")\n\tground:SetAttribute(\"SurfaceIntent\",\"Missed landing; covered by ordinary course fall zone when registered\")\n\tP.Marker(fallZones,\"FallZone_Main\",Vector3.new(0,-.6,0),Vector3.new(0,0,-1),Vector3.new(380,6,386),true)\n\tSeed.Build(obstacles,markers)\n\tlocal crops=Prototype.Sample(obstacles,true,true)\n\tcrops.Name=\"G2_CropGarden\"\n\tcrops:PivotTo(CFrame.new(P.Origin+Vector3.new(-56,0,-12)))\n\tcrops:SetAttribute(\"CourseOrigin\",P.Origin)\n\tcrops:SetAttribute(\"CandidateId\",CourseBuild.Revision..\"_G2\")\n\tcrops:SetAttribute(\"EvidenceLimit\",\"Round2 crop branch geometry; P07 movement results do not apply\")\n\tcrops.H1_Sprinkler.Parent=m\n\tGrove.CropExit(obstacles,markers)\n\tlocal grove=Grove.Build(obstacles,markers)\n\tgrove.H2_Fruit.Parent=m\n\tVine.Build(obstacles,markers)\n\tFestival.Build(obstacles,markers)\n\tP.Path(markers,\"G2_Pots\",{{-56,4.24,28},{-56,6.4,12},{-50,6.4,9},{-47,6.4,3},{-50,6.4,-3},{-56,6.4,-6},{-64,7.4,-16},{-58,7.4,-19},{-55,7.4,-25},{-58,7.4,-31},{-64,7.4,-34},{-64,7.24,-43},{-56,7.24,-49},{-56,7.4,-64},{-56,7.4,-80},{-56,7.24,-97}},\"Main\")\n\tP.Path(markers,\"G2_Main\",{{-56,7.24,-97},{-82,7.4,-101.125},{-89,10,-101.125},{-96,7.4,-101.125},{-114,9.4,-91},{-122.5,9.6,-73.8},{-122.5,9.6,-69},{-122.5,9.6,-64.2},{-128,8.4,-61},{-135,9.4,-49},{-133,12.2,-43},{-128,9.4,-38},{-118,7.24,-34},{-103,7.24,-24}},\"MainBranch\")\n\tP.Path(markers,\"G2_Expert\",{{-56,7.24,-97},{-82,7.4,-92},{-84,7.4,-90},{-86,9.4,-82},{-91.5,11.5,-72.5},{-90,9,-62},{-96,10.9,-53},{-94,8.9,-43},{-94,7.24,-33},{-103,7.24,-24}},\"ExpertBranch\")\n\tP.Arrow(decoration,-83,7.4,-102,90)\n\tP.Arrow(decoration,-83,7.4,-92,162,true)\n\tP.Arrow(decoration,20,10.75,27,144)\n\tP.Arrow(decoration,47,8.24,90,-125)\n\tlocal start=P.Marker(m,\"Start\",Vector3.new(-145,3.74,144),Vector3.new(1,0,0),Vector3.new(48,1,26),false)\n\tstart:SetAttribute(\"RespawnCFrame\",P.Frame(-145,9.24,144,-90))\n\tstart:SetAttribute(\"RespawnAreaSize\",Vector3.new(40,0,20))\n\tWayfinding.Start(decoration,P.Frame(-131.5,4.24,144,-90),48)\n\tlocal cp=P.Folder(m,\"Checkpoints\")\n\tfor i,r in checkpoints do\n\t\tlocal horizontal=math.abs(r[5])>.5\n\t\tlocal spawnX,spawnZ=r[9] or r[2],r[10] or r[4]\n\t\tlocal frame=CFrame.lookAt(P.Origin+Vector3.new(spawnX,r[3]+5,spawnZ),P.Origin+Vector3.new(spawnX+r[5],r[3]+5,spawnZ+r[6]))\n\t\tlocal across,along=if horizontal then r[8] else r[7],if horizontal then r[7] else r[8]\n\t\tlocal marker=P.Marker(cp,string.format(\"Checkpoint_%03d\",i),Vector3.new(r[2],r[3]+3,r[4]),Vector3.new(r[5],0,r[6]),Vector3.new(across,6,along),true)\n\t\tmarker:SetAttribute(\"CheckpointId\",r[1])\n\t\tmarker:SetAttribute(\"RespawnCFrame\",frame)\n\t\tmarker:SetAttribute(\"RespawnAreaSize\",Vector3.new(r[11] or across-2,0,r[12] or along-2))\n\t\tWayfinding.Checkpoint(decoration,marker,i,P.Origin.Y+r[3])\n\tend\n\tP.Marker(m,\"Finish\",Vector3.new(-16,10.24,150),Vector3.new(0,0,1),Vector3.new(17,6,1.5),true)\n\tm:SetAttribute(\"RequiredProgress\",\"9 ordinary ordered checkpoints; both branches share entry and merge; entire festival follows checkpoint9\")\n\tm:SetAttribute(\"RuntimeStatus\",\"Hazard source exists; course remains disabled until authorized integration/play checks\")\n\treturn m\nend\n\nreturn CourseBuild\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","CourseParts"],"source":"--!strict\n\nlocal Kit=require(script.Parent.Kit)\nlocal Structures=require(script.Parent.Structures)\nlocal Flora=require(script.Parent.Flora)\nlocal Parts={}\nParts.Origin=Vector3.new(9200,80,3500)\n\nfunction Parts.Frame(x: number,y: number,z: number,yaw: number?): CFrame\n\treturn CFrame.new(Parts.Origin+Vector3.new(x,y,z))*CFrame.Angles(0,math.rad(yaw or 0),0)\nend\n\nfunction Parts.Folder(parent: Instance,name: string): Folder\n\tlocal folder=Instance.new(\"Folder\"); folder.Name=name; folder.Parent=parent\n\treturn folder\nend\n\nfunction Parts.Table(parent: Instance,name: string,x: number,y: number,z: number,width: number,depth: number,yaw: number?): Model\n\treturn Structures.Workbench(parent,name,Parts.Frame(x,-2.8,z,yaw),width,depth,y+2.4)\nend\n\nfunction Parts.Terrace(parent: Instance,name: string,x: number,y: number,z: number,width: number,depth: number): Model\n\treturn Kit.Terrace(parent,name,Parts.Frame(x,y-.24,z),Vector3.new(width,y+2.56,depth),\"Refuge\")\nend\n\nfunction Parts.Root(parent: Instance,name: string,a: Vector3,b: Vector3,width: number,gap: number,color: Color3?): Model\n\tassert(math.abs(a.Y-b.Y)<.01,\"Root crowns remain level; use distinct heights between objects\")\n\tlocal frame=CFrame.lookAt(Parts.Origin+(a+b)/2,Parts.Origin+b)\n\treturn Flora.Root(parent,name,frame*CFrame.new(0,-.4,0),width,(a-b).Magnitude-gap,color)\nend\n\nfunction Parts.Marker(parent: Instance,name: string,position: Vector3,forward: Vector3,size: Vector3,touch: boolean): Part\n\tlocal frame=CFrame.lookAt(Parts.Origin+position,Parts.Origin+position+forward)\n\tlocal p=Kit.Part(parent,name,frame,size,Kit.Colors.white,\"Marker\")\n\tp.Transparency=1; p.CanTouch=touch\n\treturn p\nend\n\nfunction Parts.Path(parent: Instance,name: string,points: {{number}},kind: string)\n\tlocal folder=Parts.Folder(parent,name)\n\tfolder:SetAttribute(\"RouteKind\",kind)\n\tfor i,p in points do\n\t\tlocal marker=Parts.Marker(folder,string.format(\"Point_%03d\",i),Vector3.new(p[1],p[2],p[3]),Vector3.new(0,0,-1),Vector3.one,false)\n\t\tmarker:SetAttribute(\"Order\",i)\n\tend\n\treturn folder\nend\n\nfunction Parts.Arrow(parent: Instance,x: number,y: number,z: number,yaw: number,expert: boolean?)\n\tlocal f=Parts.Frame(x,y+.1,z,yaw)\n\tlocal color=if expert then Kit.Colors.gold else Kit.Colors.cream\n\tKit.Part(parent,\"OnwardStem\",f*CFrame.new(0,0,1),Vector3.new(.55,.1,3.2),color)\n\tKit.Triangle(parent,\"OnwardTip\",f*Vector3.new(-1.9,0,0),f*Vector3.new(1.9,0,0),f*Vector3.new(0,0,-2.1),.1,color,\"Decoration\")\nend\n\nreturn Parts\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","CourseRuntime"],"source":"--!strict\n\nlocal Sprinkler=require(script.Parent.Runtime)\nlocal Fruit=require(script.Parent.FruitRuntime)\nlocal CourseRuntime={}\n\nfunction CourseRuntime.Start(course: Model,eligible: (Player)->boolean,recover: (Player,string)->boolean)\n\tassert(course:GetAttribute(\"CourseId\")==\"stud_garden_v2\",\"Full V2 course required\")\n\tlocal giants=course:FindFirstChild(\"GardenGiants\")\n\tif giants then\n\t\t-- Cloning an avatar can restore torso collision even with its state machine disabled.\n\t\tfor _,part in giants:GetDescendants() do\n\t\t\tif part:IsA(\"Humanoid\") then part.EvaluateStateMachine=false\n\t\t\telseif part:IsA(\"BasePart\") then part.CanCollide=false;part.CanTouch=false;part.CanQuery=false end\n\t\tend\n\tend\n\tlocal sprinkler=Sprinkler.Start(course,eligible,recover)\n\tlocal ok,fruit=pcall(Fruit.Start,course.H2_Fruit,eligible,recover)\n\tif not ok then sprinkler.Stop();error(fruit) end\n\treturn {\n\t\tStop=function() sprinkler.Stop();fruit.Stop() end,\n\t\tDiagnostics=function() return {sprinkler=sprinkler.Diagnostics(),fruit=fruit.Diagnostics()} end,\n\t}\nend\n\nreturn CourseRuntime\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","Encounters"],"source":"--!strict\n\nlocal Kit=require(script.Parent.Kit)\nlocal Structures=require(script.Parent.Structures)\nlocal Flora=require(script.Parent.Flora)\nlocal Wayfinding=require(script.Parent.Wayfinding)\nlocal c=Kit.Colors\nlocal Encounters={}\n\nfunction Encounters.FruitCrossing(parent: Instance,name: string,frame: CFrame,courseAssembly: boolean?): Model\n\tlocal m=Kit.Group(parent,name,frame)\n\tm:SetAttribute(\"AssetFamily\",\"RaccoonFruitCrossing\")\n\tm:SetAttribute(\"Mount\",\"Root walking crownY0.4; entry+Z; translate/rotate whole encounter; scale1only\")\n\tm:SetAttribute(\"ClearSeconds\",7);m:SetAttribute(\"WarningSeconds\",1.5);m:SetAttribute(\"ActiveSeconds\",3.2);m:SetAttribute(\"MinimumEntrySeconds\",3.5)\n\tFlora.Root(m,\"CrossingRoot\",frame,26,32,c.wood)\n\tKit.Terrace(m,\"EntryRefuge\",frame*CFrame.new(0,0,27),Vector3.new(34,9,if courseAssembly then 24 else 18),\"Refuge\")\n\tKit.Terrace(m,\"ExitRefuge\",frame*CFrame.new(0,0,-27),Vector3.new(34,9,if courseAssembly then 24 else 18),\"Refuge\")\n\tfor _,z in {-13,13} do Kit.Part(m,\"WarningStripe\",frame*CFrame.new(0,.48,z),Vector3.new(21,.12,.7),c.gold,\"Decoration\") end\n\tlocal bankX=if courseAssembly then -36 else -24\n\tm:SetAttribute(\"ParkedX\",if courseAssembly then -34 else -22)\n\tKit.Terrace(m,\"RaccoonBank\",frame*CFrame.new(bankX,3,0),Vector3.new(if courseAssembly then 12 else 16,12,26),\"Blocker\")\n\tlocal raccoonFrame=frame*CFrame.new(bankX,3.24,8)\n\tif courseAssembly then\n\t\tStructures.Crate(m,\"RaccoonPerch\",frame*CFrame.new(-40,3.24,-8),4,5,3)\n\t\traccoonFrame=frame*CFrame.new(-40,6.24,-8)\n\tend\n\tFlora.Raccoon(m,\"Raccoon\",raccoonFrame*CFrame.Angles(0,math.rad(-135),0))\n\tStructures.Crate(m,\"TippedFruitCrate\",frame*CFrame.new(bankX,4,-3)*CFrame.Angles(0,0,math.rad(-15)),8,12,4,true)\n\tif courseAssembly then\n\t\tlocal a,b=frame*Vector3.new(-34,3,0),frame*Vector3.new(-17,.4,0)\n\t\tKit.Part(m,\"SupportedChute\",CFrame.lookAt((a+b)/2,b)*CFrame.Angles(0,math.pi/2,0),Vector3.new((a-b).Magnitude,.7,21),c.honey,\"Blocker\")\n\t\tfor _,z in {-13,13} do\n\t\t\tlocal mesh=Kit.Part(m,\"FruitBinMesh\",frame*CFrame.new(-24.1,7.5,z),Vector3.new(25.2,21,.35),c.aqua,\"Blocker\")\n\t\t\tmesh.Transparency=.8;mesh.CastShadow=false\n\t\t\tfor _,x in {-36.7,-11.5} do Kit.Part(m,\"MeshPost\",frame*CFrame.new(x,7.5,z),Vector3.new(.8,21,.8),c.wood,\"Blocker\") end\n\t\t\tfor i=1,9 do Kit.Part(m,\"MeshVertical\",frame*CFrame.new(-36.7+i*2.52,7.5,z),Vector3.new(.09,21,.09),c.cream) end\n\t\t\tfor i=1,7 do Kit.Part(m,\"MeshHorizontal\",frame*CFrame.new(-24.1,-3+i*2.625,z),Vector3.new(25.2,.09,.09),c.cream) end\n\t\t\tKit.Part(m,\"FruitBinTopRail\",frame*CFrame.new(-24.1,18.4,z),Vector3.new(26,.8,.8),c.wood,\"Blocker\")\n\t\tend\n\t\tWayfinding.HazardStatus(m,frame*CFrame.new(0,0,22)*CFrame.Angles(0,math.pi,0),34)\n\telse\n\t\tKit.Part(m,\"Chute\",frame*CFrame.new(-18,2.4,0)*CFrame.Angles(0,0,math.rad(-15)),Vector3.new(12,.7,21),c.honey,\"Decoration\")\n\tend\n\tm:SetAttribute(\"CatchDrop\",if courseAssembly then 10.6 else 0)\n\tKit.Part(m,\"CatchTrough\",frame*CFrame.new(20,if courseAssembly then -10.7 else -1.5,0),Vector3.new(10,1,23),c.soilLight,\"Blocker\")\n\tfor i,z in {-8,0,8} do\n\t\tlocal fruit=Kit.Group(m,\"Fruit_\"..i,frame*CFrame.new(if courseAssembly then -34 else -21,if courseAssembly then 5.7 else 3,z))\n\t\tfruit:SetAttribute(\"LaneZ\",z)\n\t\tlocal ball=Kit.Part(fruit,\"Body\",fruit:GetPivot(),Vector3.new(4.8,4.8,4.8),if i==2 then c.orange else c.pink,\"Hazard\",Enum.PartType.Ball)\n\t\tKit.Part(fruit,\"Stem\",fruit:GetPivot()*CFrame.new(0,2.75,0),Vector3.new(.4,.8,.4),c.leaf,\"Decoration\")\n\t\tKit.Part(fruit,\"Leaf\",fruit:GetPivot()*CFrame.new(.7,2.65,0)*CFrame.Angles(0,0,-.3),Vector3.new(1.9,.3,1),c.lime,\"Decoration\")\n\t\tball:SetAttribute(\"ContactShape\",\"Swept sphere radius2.4 matching visible body\")\n\tend\n\tKit.Part(m,\"WarningLamp\",frame*CFrame.new(18,4.5,18),Vector3.new(1.8,1.8,1.8),c.lime,\"Decoration\",Enum.PartType.Ball)\n\tKit.Part(m,\"LampPost\",frame*CFrame.new(18,2,18),Vector3.new(.65,4,.65),c.wood,\"Blocker\")\n\tKit.Sign(m,\"WarningSign\",frame*CFrame.new(22,0,23)*CFrame.Angles(0,math.pi,0),\"FRUIT CROSSING\\nFruit rolls across\",c.cream)\n\treturn m\nend\n\nreturn Encounters\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","FestivalCourse"],"source":"--!strict\n\nlocal Kit=require(script.Parent.Kit)\nlocal S=require(script.Parent.Structures)\nlocal P=require(script.Parent.CourseParts)\nlocal Movement=require(script.Parent.Movement)\nlocal FestivalCourse={}\n\nfunction FestivalCourse.Build(parent: Instance,markers: Instance)\n\tlocal m=Kit.Group(parent,\"G5_HarvestFestival\",CFrame.new(P.Origin))\n\tS.Wagon(m,\"FirstHarvestWagon\",P.Frame(68,2.84,111,-90),true)\n\tS.Crate(m,\"HarvestStack\",P.Frame(99,3.24,101),12,20,5)\n\tS.Wagon(m,\"SecondHarvestWagon\",P.Frame(125,2.84,101,-90),true)\n\tMovement.Windows(m,\"WagonWindowHops\",P.Frame(125,8.24,101,-90),23,2)\n\tP.Table(m,\"FestivalTurn\",154,8.24,122,24,24)\n\tS.Wagon(m,\"LongHarvestWagon\",P.Frame(152,2.84,151,180),true)\n\tS.Crate(m,\"PrizeCrate\",P.Frame(126,2.9,158),22,20,6)\n\tMovement.Hurdle(m,\"PrizeCrateHop\",P.Frame(126,8.9,158,90),20,3.2)\n\tlocal fork=S.Tool(m,\"HarvestFork\",P.Frame(82.5,8.1,155,90),\"Fork\");fork:ScaleTo(.9)\n\tP.Table(m,\"BasketTable\",49,8.5,151,20,24)\n\tS.Crate(m,\"BasketFloor\",P.Frame(25,6.1,135,-25),22,20,3,true)\n\tP.Table(m,\"StallTurn\",21,7.24,123,22,22)\n\tS.Tool(m,\"LastTrowel\",P.Frame(-3,7.04,126,90),\"Trowel\")\n\tP.Root(m,\"FinalRoot\",Vector3.new(-24,7.24,134),Vector3.new(-16,7.24,141),12,2,Kit.Colors.wood)\n\tP.Terrace(m,\"FinishRunoff\",-16,7.24,162,22,30)\n\tlocal arch=S.FinishArch(m,\"HarvestFinish\",P.Frame(-16,7.24,150))\n\tarch:ScaleTo(.55)\n\tS.Awning(m,\"FestivalLandmark\",P.Frame(72,-2.8,170),30,14,\"Harvest\")\n\tS.Bunting(m,\"ArrivalBunting\",P.Frame(129,-2.8,172),42)\n\tP.Path(markers,\"G5_Festival\",{{33,8.24,82},{49,8.24,93},{58,8.24,104},{68,8.24,111},{81,8.24,111},{87,6.74,111},{95,8.24,108},{103,8.24,104},{115,8.24,106.375},{119.5,10.84,106.375},{125,8.24,106.375},{130.5,11.44,106.375},{137,8.24,106.375},{150,8.24,116},{154,8.24,130},{152,8.24,142},{152,8.24,156},{137,8.9,158},{126,12.1,158},{119,8.9,158},{114,8.5,155},{103,8.5,155},{86,8.4,155},{66,8.4,155},{50,8.5,151},{33,6.9,140},{25,6.9,131},{21,7.24,123},{15,7.44,126},{1,7.34,126},{-17,7.34,126},{-24,7.34,127},{-22,7.24,135},{-18,7.24,141},{-16,7.24,149},{-16,7.24,162}},\"Main\")\n\tfor _,r in {{66,8.24,110,-90},{125,8.24,101,-90},{152,8.24,151,180},{86,8.4,155,90},{21,7.24,123,90},{1,7.34,126,90}} do P.Arrow(m,table.unpack(r)) end\n\treturn m\nend\n\nreturn FestivalCourse\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","Flora"],"source":"--!strict\n\nlocal Kit=require(script.Parent.Kit)\nlocal c=Kit.Colors\nlocal Flora={}\n\nfunction Flora.Leaf(parent: Instance,name: string,frame: CFrame,width: number,length: number,expert: boolean?,broadEnds: boolean?): Model\n\tlocal m=Kit.Group(parent,name,frame)\n\tm:SetAttribute(\"AssetFamily\",if expert then \"ExpertLeaf\" else \"BroadPlayableLeaf\")\n\tm:SetAttribute(\"Mount\",\"Blade center; flat walking surface Y0.25; pointed end -Z; move/rotate complete model\")\n\tlocal vertices=if broadEnds then {{-.18,-.5},{.18,-.5},{.38,-.3},{.5,0},{.38,.3},{.18,.5},{-.18,.5},{-.38,.3},{-.5,0},{-.38,-.3}} else {{0,-.5},{.35,-.35},{.5,-.02},{.37,.3},{0,.5},{-.37,.3},{-.5,-.02},{-.35,-.35}}\n\tfor i,p in vertices do\n\t\tlocal q=vertices[i%#vertices+1]\n\t\tKit.Triangle(m,\"BladeFacet_\"..i,frame.Position,frame*Vector3.new(p[1]*width,0,p[2]*length),frame*Vector3.new(q[1]*width,0,q[2]*length),.5,if i%3==0 then c.lime else c.grass,\"Walk\")\n\tend\n\tKit.Part(m,\"Midrib\",frame*CFrame.new(0,.28,0),Vector3.new(.34,.1,length*.8),c.lime,\"Decoration\")\n\tfor _,s in {-1,1} do for _,z in {-.22,.05,.27} do\n\t\tlocal a=frame*Vector3.new(0,.29,z*length)\n\t\tlocal b=frame*Vector3.new(s*width*.32,.29,(z-.16)*length)\n\t\tKit.Part(m,\"Vein\",CFrame.lookAt((a+b)/2,b),Vector3.new(.2,.08,(b-a).Magnitude),c.lime,\"Decoration\")\n\tend end\n\treturn m\nend\n\nfunction Flora.Root(parent: Instance,name: string,frame: CFrame,width: number,length: number,color: Color3?): Model\n\tlocal m=Kit.Group(parent,name,frame)\n\tm:SetAttribute(\"AssetFamily\",\"FacetedRootBridge\"); m:SetAttribute(\"Mount\",\"Walking crown topY0.4; root extends along Z\")\n\tlocal tint=color or c.pink\n\tKit.Part(m,\"RootCrown\",frame,Vector3.new(width*.72,.8,length),tint,\"Walk\")\n\tfor _,s in {-1,1} do\n\t\tKit.Part(m,\"RootBevel\",frame*CFrame.new(s*width*.39,.03-width*.13*math.sin(.4),0)*CFrame.Angles(0,0,-s*.4),Vector3.new(width*.26,.8,length*.94),tint,\"Walk\")\n\t\tKit.Part(m,\"RootRidge\",frame*CFrame.new(s*width*.26,.43,length*.15),Vector3.new(.22,.1,length*.5),if color then c.honey else c.cream,\"Decoration\")\n\tend\n\treturn m\nend\n\nfunction Flora.Vine(parent: Instance,name: string,frame: CFrame): Model\n\tlocal m=Kit.Group(parent,name,frame)\n\tm:SetAttribute(\"AssetFamily\",\"LowerVineLandmark\"); m:SetAttribute(\"Mount\",\"Ground center; attached leaves have matching support; broad route leaves supplied separately\")\n\tlocal previous=frame*Vector3.new(0,0,0)\n\tfor i=1,8 do\n\t\tlocal point=frame*Vector3.new(math.sin(i*.82)*2.8,i*4.4,math.cos(i*.82)*2.8)\n\t\tKit.Part(m,\"BentStem\",CFrame.lookAt((previous+point)/2,point)*CFrame.Angles(0,math.pi/2,0),Vector3.new((point-previous).Magnitude+.5,6.5-i*.25,6.5-i*.25),c.leaf,\"Blocker\",Enum.PartType.Cylinder)\n\t\tprevious=point\n\t\tif i%2==0 then\n\t\t\tlocal cf=frame*CFrame.new(math.sin(i*.82)*6,i*4.4,math.cos(i*.82)*6)*CFrame.Angles(0,i*.82,math.rad(18))\n\t\t\tlocal leaf=Flora.Leaf(m,\"CanopyLeaf\",cf,11,16)\n\t\t\tleaf:SetAttribute(\"AssetFamily\",\"SupportedVineLeaf\")\n\t\tend\n\tend\n\tfor i,r in {{-5,18,-2},{4,25,2},{-3,29,3}} do\n\t\tlocal cf=frame*CFrame.new(r[1],r[2],r[3])*CFrame.Angles(0,i*.8,.15)\n\t\tKit.Part(m,\"Pod\",cf,Vector3.new(2.4,7,2.2),c.lime,\"Decoration\",Enum.PartType.Ball)\n\t\tfor j=-1,1 do Kit.Part(m,\"PeaLobe\",cf*CFrame.new(0,j*1.65,-.65),Vector3.new(2.3,2.4,1.7),c.grass,\"Decoration\",Enum.PartType.Ball) end\n\tend\n\treturn m\nend\n\nfunction Flora.Raccoon(parent: Instance,name: string,frame: CFrame): Model\n\tlocal m=Kit.Group(parent,name,frame)\n\tm:SetAttribute(\"AssetFamily\",\"FruitRaccoon\"); m:SetAttribute(\"Mount\",\"Ground center; face -Z\")\n\tlocal function b(n,x,y,z,sx,sy,sz,color,rotation)\n\t\treturn Kit.Part(m,n,frame*CFrame.new(x,y,z)*(rotation or CFrame.identity),Vector3.new(sx,sy,sz),color,\"Decoration\")\n\tend\n\tb(\"Body\",0,2,.4,3.4,3.3,3.7,c.gray)\n\tb(\"Head\",0,4,-1,3.5,2.8,2.6,c.gray)\n\tb(\"Mask\",0,4.15,-2.36,3.6,.95,.22,c.dark)\n\tb(\"Muzzle\",0,3.45,-2.65,1.9,1.1,.9,c.cream)\n\tb(\"Nose\",0,3.65,-3.14,.7,.5,.3,c.dark)\n\tfor _,s in {-1,1} do\n\t\tb(\"Ear\",s*1.2,5.65,-.8,1,1.3,.8,c.dark,CFrame.Angles(0,0,-s*.25))\n\t\tb(\"InnerEar\",s*1.2,5.66,-1.23,.5,.7,.13,c.cream)\n\t\tb(\"Eye\",s*.9,4.2,-2.51,.4,.45,.1,c.white)\n\t\tb(\"Pupil\",s*.9,4.17,-2.59,.21,.3,.08,c.dark)\n\t\tb(\"Foot\",s*1.1,.55,-.6,1.2,1,1.9,c.dark)\n\t\tb(\"Paw\",s*1.5,2.2,-1.9,.8,1.1,1,c.dark)\n\tend\n\tfor i=0,5 do b(\"TailBand\",.2,1.2+i*.24,2.4+i*.64,1.4,1.4,.78,if i%2==0 then c.dark else c.gray,CFrame.Angles(-.3,0,0)) end\n\tKit.Imported(m,\"StolenBerry\",\"BerryTuft\",frame*CFrame.new(0,1,-2.3),.5)\n\treturn m\nend\n\nfunction Flora.Chicken(parent: Instance,name: string,frame: CFrame): Model\n\tlocal m=Kit.Group(parent,name,frame)\n\tm:SetAttribute(\"AssetFamily\",\"GardenChicken\");m:SetAttribute(\"Mount\",\"Ground center; face -Z\")\n\tlocal function b(n,x,y,z,sx,sy,sz,color)\n\t\treturn Kit.Part(m,n,frame*CFrame.new(x,y,z),Vector3.new(sx,sy,sz),color,\"Decoration\")\n\tend\n\tb(\"Body\",0,1.8,.3,2.5,2.5,3,c.white); b(\"Head\",0,3,-1,1.8,2,1.7,c.white)\n\tb(\"Beak\",0,2.8,-2.15,.8,.6,.8,c.gold); b(\"Wattle\",0,2.35,-1.9,.55,.7,.4,c.red)\n\tfor i=-1,1 do b(\"Comb\",0,4.25,-1+i*.45,.5,.85,.52,c.red) end\n\tfor _,s in {-1,1} do b(\"Eye\",s*.92,3.25,-1.35,.12,.35,.35,c.dark);b(\"Wing\",s*1.3,1.9,.3,.5,1.5,1.9,c.cream);b(\"Foot\",s*.65,.25,-.3,.7,.5,1.4,c.gold) end\n\tb(\"Tail\",0,2.3,2,1.7,1.4,.7,c.cream)\n\treturn m\nend\n\nfunction Flora.PlantedEdge(parent: Instance,name: string,frame: CFrame,length: number): Model\n\tlocal m=Kit.Group(parent,name,frame)\n\tm:SetAttribute(\"AssetFamily\",\"LayeredGardenEdge\");m:SetAttribute(\"Mount\",\"Route-facing edge at Z0; planting behind +Z; ground at0\")\n\tlocal bays=math.max(1,math.floor(length/14))\n\tfor i=1,bays do\n\t\tlocal x=(i-(bays+1)/2)*length/bays\n\t\tlocal bank=frame*CFrame.new(x,1.1+(i%3)*.55,6+(i%2)*2)\n\t\tKit.Terrace(m,\"ScallopedBank\",bank,Vector3.new(14,3.5,11),\"Blocker\")\n\t\tFlora.Leaf(m,\"SupportedLowLeaf\",frame*CFrame.new(x-3,.65,1.3)*CFrame.Angles(0,math.rad(25+i*61),0),11,14)\n\t\tKit.Imported(m,\"BerryGroup\",\"BerryTuft\",bank*CFrame.new(-2,.3,-1),1.05)\n\t\tKit.Imported(m,\"CarrotGroup\",\"CarrotPair\",bank*CFrame.new(3,.3,1),1.1)\n\t\tfor j,r in {{-4,3.7,10,8,6,7},{2,4.7,12,9,8,8},{6,3.2,10,7,5,7}} do\n\t\t\tlocal cf=frame*CFrame.new(x+r[1],r[2],r[3]+4)\n\t\t\tKit.Part(m,\"MiddleShrub\",cf,Vector3.new(r[4],r[5],r[6]),if (i+j)%2==0 then c.leaf else c.grass,\"Decoration\",Enum.PartType.Ball)\n\t\t\tKit.Part(m,\"ShrubStud\",cf*CFrame.new(0,r[5]/2,0)*CFrame.Angles(0,0,math.pi/2),Vector3.new(.5,1.2,1.2),c.lime,\"Decoration\",Enum.PartType.Cylinder)\n\t\tend\n\t\tif i%3~=0 then Kit.Bamboo(m,\"MiddleBamboo\",frame*CFrame.new(x+3,0,13)*CFrame.Angles(0,i*.7,0),if i%2==0 then 13 else 18,true) end\n\t\tif i%3==1 then Kit.Imported(m,\"SunflowerAccent\",\"SunflowerClump\",bank*CFrame.new(-4,1,4),1.05) end\n\t\tif i%4==2 then Kit.CandyTree(m,\"GlimpseCanopy\",frame*CFrame.new(x-3,0,21)*CFrame.Angles(0,i,0),.78) end\n\tend\n\treturn m\nend\n\nreturn Flora\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","FruitMotion"],"source":"--!strict\n\nlocal FruitMotion={}\n\nfunction FruitMotion.Position(alpha: number,index: number,catchDrop: number?): Vector3\n\tlocal progress=math.clamp((alpha-(index-1)*.12)/.76,0,1)\n\tlocal x=-17+38*progress\n\tlocal fall=(catchDrop or 0)*math.clamp((x-13.6)/7.4,0,1)\n\treturn Vector3.new(x,2.8-fall,(index-2)*8)\nend\n\nfunction FruitMotion.Segments(first: number,last: number,index: number,catchDrop: number?): {Vector3}\n\tlocal points={FruitMotion.Position(first,index,catchDrop)}\n\tlocal corner=(index-1)*.12+.76*(13.6+17)/38\n\tif (catchDrop or 0)>0 and first<corner and last>corner then table.insert(points,FruitMotion.Position(corner,index,catchDrop)) end\n\ttable.insert(points,FruitMotion.Position(last,index,catchDrop))\n\treturn points\nend\n\nfunction FruitMotion.SweepTouchesBody(first: Vector3,last: Vector3,radius: number,frame: CFrame,size: Vector3): boolean\n\tlocal a=frame:PointToObjectSpace(first)\n\tlocal direction=frame:VectorToObjectSpace(last-first)\n\tlocal half=size/2\n\tlocal starts,steps,extents={a.X,a.Y,a.Z},{direction.X,direction.Y,direction.Z},{half.X,half.Y,half.Z}\n\tlocal breaks={0,1}\n\tfor axis=1,3 do\n\t\tif math.abs(steps[axis])>.000001 then\n\t\t\tfor _,side in {-1,1} do\n\t\t\t\tlocal t=(side*extents[axis]-starts[axis])/steps[axis]\n\t\t\t\tif t>0 and t<1 then table.insert(breaks,t) end\n\t\t\tend\n\t\tend\n\tend\n\ttable.sort(breaks)\n\t-- Between face crossings, squared distance to the body box is a quadratic.\n\tfor i=1,#breaks-1 do\n\t\tlocal low,high=breaks[i],breaks[i+1]\n\t\tlocal mid=(low+high)/2\n\t\tlocal quadratic,linear=0,0\n\t\tfor axis=1,3 do\n\t\t\tlocal value=starts[axis]+steps[axis]*mid\n\t\t\tif math.abs(value)>extents[axis] then\n\t\t\t\tlocal offset=starts[axis]-math.sign(value)*extents[axis]\n\t\t\t\tquadratic+=steps[axis]^2;linear+=steps[axis]*offset\n\t\t\tend\n\t\tend\n\t\tlocal t=if quadratic>0 then math.clamp(-linear/quadratic,low,high) else mid\n\t\tlocal distanceSquared=0\n\t\tfor axis=1,3 do distanceSquared+=math.max(0,math.abs(starts[axis]+steps[axis]*t)-extents[axis])^2 end\n\t\tif distanceSquared<=radius^2 then return true end\n\tend\n\treturn false\nend\n\nreturn FruitMotion\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","FruitRuntime"],"source":"--!strict\n\nlocal RunService=game:GetService(\"RunService\")\nlocal Players=game:GetService(\"Players\")\nlocal Phase=require(game.ServerStorage.CourseBuilders.StudGarden.HazardState)\nlocal Motion=require(script.Parent.FruitMotion)\nlocal Wayfinding=require(script.Parent.Wayfinding)\nlocal HazardClock=require(script.Parent.HazardClock)\nlocal FruitRuntime={}\n\nfunction FruitRuntime.Start(hazard: Model,eligible: (Player)->boolean,recover: (Player,string)->boolean)\n\tassert(RunService:IsServer() and RunService:IsRunning(),\"Runtime server required\")\n\tassert(hazard:GetAttribute(\"SGV2Owned\")==true and not hazard:GetAttribute(\"FruitRuntimeActive\"),\"Owned inactive fruit encounter required\")\n\tassert(math.abs(hazard:GetScale()-1)<.001,\"Translate/rotate complete encounter; scaling unsupported\")\n\tlocal timing={Clear=hazard:GetAttribute(\"ClearSeconds\") or 7,Warning=hazard:GetAttribute(\"WarningSeconds\") or 1.5,Active=hazard:GetAttribute(\"ActiveSeconds\") or 3.2}\n\tassert(timing.Clear>=5 and timing.Warning>=1.5 and timing.Active>=2.6,\"Preserve warning and crossing windows\")\n\tlocal frame=hazard:GetPivot()\n\tlocal catchDrop=hazard:GetAttribute(\"CatchDrop\") or 0\n\tlocal lamp=hazard.WarningLamp :: BasePart\n\tlocal fruits={hazard.Fruit_1,hazard.Fruit_2,hazard.Fruit_3}\n\tlocal saved={lamp=lamp.Color,frames={}}\n\tlocal originalStatus=Wayfinding.CaptureStatus(hazard)\n\tfor _,fruit in fruits do table.insert(saved.frames,fruit:GetPivot()) end\n\tlocal clock=HazardClock.New(workspace:GetServerTimeNow())\n\tlocal cooldowns: {[Player]: number}={}\n\tlocal report={steps=0,contacts=0,recoveries=0,pausedStalls=0,maxStepMs=0}\n\thazard:SetAttribute(\"FruitRuntimeActive\",true)\n\tlocal connection=RunService.Heartbeat:Connect(function()\n\t\tlocal before=os.clock()\n\t\tlocal previous,elapsed,advanced=HazardClock.Step(clock,workspace:GetServerTimeNow())\n\t\tif not advanced then report.pausedStalls=clock.pausedStalls;return end\n\t\tlocal phase,alpha=Phase.Phase(elapsed,timing)\n\t\tlocal remaining=if phase==\"Clear\" then timing.Clear*(1-alpha) else 0\n\t\tlocal entry=Wayfinding.UpdateHazard(hazard,\"FRUIT\",phase,alpha,timing,hazard:GetAttribute(\"MinimumEntrySeconds\") or 3.5)\n\t\tfor index,fruit in fruits do\n\t\t\tlocal parked=Vector3.new(hazard:GetAttribute(\"ParkedX\") or -22,5.7,(index-2)*8)\n\t\t\tlocal position=if phase==\"Active\" then Motion.Position(alpha,index,catchDrop) elseif phase==\"Warning\" then parked:Lerp(Motion.Position(0,index,catchDrop),alpha) else parked\n\t\t\tfruit:PivotTo(frame*CFrame.new(position)*CFrame.Angles(0,0,if phase==\"Active\" then -(position.X+17)/2.4 else 0))\n\t\tend\n\t\thazard:SetAttribute(\"Phase\",phase);hazard:SetAttribute(\"PhaseAlpha\",alpha);hazard:SetAttribute(\"ClearRemaining\",remaining);hazard:SetAttribute(\"EntryOpen\",entry)\n\t\tdo\n\t\t\tlocal intervals=Phase.ActiveIntervals(previous,elapsed,timing)\n\t\t\tif #intervals>0 then for _,player in Players:GetPlayers() do\n\t\t\t\tlocal character=player.Character\n\t\t\t\tlocal root=character and character:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\t\t\t\tlocal humanoid=character and character:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\tif character and root and humanoid and humanoid.Health>0 and (root.Position-frame.Position).Magnitude<60 and eligible(player) and (cooldowns[player] or 0)<elapsed then\n\t\t\t\t\tlocal hit=false\n\t\t\t\t\tfor _,body in character:GetChildren() do\n\t\t\t\t\t\tif body:IsA(\"BasePart\") and body.Name~=\"HumanoidRootPart\" then\n\t\t\t\t\t\t\tfor index=1,3 do for _,interval in intervals do\n\t\t\t\t\t\t\t\t\tlocal positions=Motion.Segments(interval[1],interval[2],index,catchDrop)\n\t\t\t\t\t\t\t\t\tfor segment=1,#positions-1 do\n\t\t\t\t\t\t\t\t\t\treport.contacts+=1\n\t\t\t\t\t\t\t\t\t\tif Motion.SweepTouchesBody(frame*positions[segment],frame*positions[segment+1],2.4,body.CFrame,body.Size) then hit=true;break end\n\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\t\tif hit then break end\n\t\t\t\t\t\t\tend;if hit then break end end\n\t\t\t\t\t\tend\n\t\t\t\t\t\tif hit then break end\n\t\t\t\t\tend\n\t\t\t\t\tif hit then cooldowns[player]=elapsed+1;if recover(player,\"SGV2_H2\") then report.recoveries+=1 end end\n\t\t\t\tend\n\t\t\tend end\n\t\tend\n\t\treport.steps+=1;report.maxStepMs=math.max(report.maxStepMs,(os.clock()-before)*1000)\n\tend)\n\tlocal stopped=false\n\treturn {\n\t\tDiagnostics=function() return table.clone(report) end,\n\t\tStop=function()\n\t\t\tif stopped then return end;stopped=true;connection:Disconnect()\n\t\t\tfor index,fruit in fruits do fruit:PivotTo(saved.frames[index]) end\n\t\t\tlamp.Color=saved.lamp\n\t\t\tWayfinding.RestoreStatus(originalStatus)\n\t\t\tfor _,name in {\"Phase\",\"PhaseAlpha\",\"ClearRemaining\",\"EntryOpen\",\"FruitRuntimeActive\"} do hazard:SetAttribute(name,nil) end\n\t\tend,\n\t}\nend\n\nreturn FruitRuntime\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","Gallery"],"source":"--!strict\n\nlocal Kit=require(script.Parent.Kit)\nlocal Structures=require(script.Parent.Structures)\nlocal Flora=require(script.Parent.Flora)\nlocal Encounters=require(script.Parent.Encounters)\nlocal Gallery={}\nGallery.Origin=Vector3.new(8500,80,3500)\n\nfunction Gallery.Build(parent: Instance): Model\n\tassert(not parent:FindFirstChild(\"SGV2_Kit_K13\"),\"Preserve prior gallery\")\n\tlocal origin=Gallery.Origin\n\tlocal m=Kit.Group(parent,\"SGV2_Kit_K13\",CFrame.new(origin))\n\tm:SetAttribute(\"CandidateId\",\"SGV2_K13\");m:SetAttribute(\"CourseOrigin\",origin);m:SetAttribute(\"StudyOnly\",true)\n\tlocal function f(x,y,z,yaw) return CFrame.new(origin+Vector3.new(x,y,z))*CFrame.Angles(0,math.rad(yaw or 0),0) end\n\tKit.Terrace(m,\"GalleryGround\",f(0,-3,15),Vector3.new(280,4,280),\"Blocker\")\n\tStructures.Tool(m,\"Trowel\",f(-90,1.74,-85),\"Trowel\")\n\tStructures.Tool(m,\"Fork\",f(-30,1.74,-85),\"Fork\")\n\tStructures.Wheelbarrow(m,\"Wheelbarrow\",f(30,-2.76,-80))\n\tStructures.Wagon(m,\"Wagon\",f(95,-2.76,-80))\n\tStructures.Workbench(m,\"Workbench\",f(-105,-2.76,-20),24,18,8)\n\tStructures.Crate(m,\"ClosedCrate\",f(-70,-2.76,-20),18,16,5,false)\n\tStructures.Crate(m,\"OpenCrate\",f(-44,-2.76,-20),16,16,5,true)\n\tFlora.Root(m,\"RootBridge\",f(-12,5,-20,-20),14,34)\n\tFlora.Leaf(m,\"BroadLeaf\",f(34,5,-20,15),22,30)\n\tFlora.Leaf(m,\"ExpertLeaf\",f(63,7,-20,-25),5,12,true)\n\tfor _,r in {{-12,5},{34,5},{63,7}} do Kit.Part(m,\"GalleryStem\",f(r[1],(r[2]-2.76)/2,-20)*CFrame.Angles(0,0,math.pi/2),Vector3.new(r[2]+2.76,2.2,2.2),Kit.Colors.leaf,\"Blocker\",Enum.PartType.Cylinder) end\n\tFlora.Vine(m,\"LowerVine\",f(99,-2.76,-20))\n\tStructures.SeedShop(m,\"SeedShop\",f(-98,-2.76,55))\n\tStructures.Awning(m,\"FestivalAwning\",f(-45,-2.76,58),32,18,\"Festival\")\n\tStructures.FinishArch(m,\"FinishArch\",f(13,-2.76,57))\n\tStructures.Bunting(m,\"Bunting\",f(73,-2.76,64),38)\n\tFlora.Raccoon(m,\"Raccoon\",f(75,-2.76,36))\n\tFlora.Chicken(m,\"Chicken\",f(87,-2.76,36))\n\tlocal proof=Kit.Group(m,\"PlantedEdgeProof\",f(0,0,102))\n\tKit.Plank(proof,\"Route\",f(0,4,96,90),18,98)\n\tfor _,x in {-42,-14,14,42} do for _,z in {90,102} do Kit.Part(proof,\"DeckLeg\",f(x,.4,z),Vector3.new(1.2,6.8,1.2),Kit.Colors.wood,\"Blocker\") end end\n\tKit.Terrace(proof,\"PlantedEmbankment\",f(0,1,124),Vector3.new(104,4,40),\"Blocker\")\n\tFlora.PlantedEdge(proof,\"CloseLayeredEdge\",f(0,3.4,108),98)\n\tKit.Bunny(proof,\"BunnyAtEdge\",f(-27,5.84,109.8))\n\tEncounters.FruitCrossing(m,\"H2_Fruit\",f(180,6,0))\n\tKit.Terrace(m,\"FruitStudyGround\",f(180,-3,0),Vector3.new(84,4,80),\"Blocker\")\n\treturn m\nend\n\nreturn Gallery\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","GroveCourse"],"source":"--!strict\n\nlocal Kit=require(script.Parent.Kit)\nlocal S=require(script.Parent.Structures)\nlocal E=require(script.Parent.Encounters)\nlocal P=require(script.Parent.CourseParts)\nlocal Movement=require(script.Parent.Movement)\nlocal GroveCourse={}\n\nfunction GroveCourse.CropExit(parent: Instance,markers: Instance)\n\tlocal m=Kit.Group(parent,\"G2_ToolGardenExit\",CFrame.new(P.Origin))\n\tP.Table(m,\"MergeExitBench\",-134,7.4,-24,26,20)\n\tP.Table(m,\"OuterCorner\",-156,8.1,-44,22,22)\n\tS.Crate(m,\"ToolCrate\",P.Frame(-159,2.6,-71),21,23,5.8)\n\tP.Table(m,\"LongToolShelf\",-159,8.4,-101,22,26)\n\tMovement.Windows(m,\"PottingShelfWindows\",P.Frame(-159,8.4,-101),20,2)\n\tP.Table(m,\"NorthToolCorner\",-157,8.4,-128,24,22)\n\tP.Table(m,\"ToolBladeApproach\",-142,8.4,-146,17,18)\n\tlocal trowel=S.Tool(m,\"StoredTrowel\",P.Frame(-112,8.04,-146,90),\"Trowel\");trowel:ScaleTo(.82)\n\tlocal fork=S.Tool(m,\"StoredFork\",P.Frame(-64,8.04,-146,90),\"Fork\");fork:ScaleTo(.82)\n\tMovement.Hurdle(m,\"StoredHandleHop\",P.Frame(-101,8.368,-146,90),7.38,2.8)\n\tP.Terrace(m,\"GroveRefuge\",-18,8.24,-139,32,26)\n\tKit.Sign(m,\"GroveDirection\",P.Frame(-152,8.4,-151,100),\"CANDY\\nGROVE\",Kit.Colors.aqua)\n\tP.Path(markers,\"G2_CommonExit\",{{-103,7.24,-24},{-114,7.24,-24},{-129,7.4,-24},{-139,7.4,-27},{-151,8.1,-38},{-156,8.1,-49},{-159,8.4,-65},{-159,8.4,-78},{-163.625,8.4,-89},{-163.625,11.6,-95.5},{-163.625,8.4,-101},{-163.625,11,-106.5},{-163.625,8.4,-113},{-157,8.4,-128},{-147,8.4,-142},{-137,8.4,-146},{-128,8.286,-146},{-115,8.286,-146},{-106,8.368,-146},{-101,11.168,-146},{-97,8.368,-146},{-91.5,8.368,-149.772},{-87,8.368,-149.772},{-79,8.286,-146},{-64,8.286,-146},{-51,8.368,-146},{-43,8.368,-149.772},{-38,8.368,-149.772},{-31,8.24,-145},{-18,8.24,-139}},\"Main\")\n\treturn m\nend\n\nfunction GroveCourse.Build(parent: Instance,markers: Instance)\n\tlocal m=Kit.Group(parent,\"G3_CandyGrove\",CFrame.new(P.Origin))\n\tlocal function root(name: string,a: {number},b: {number},height: number,width: number,length: number)\n\t\tlocal av,bv=Vector3.new(a[1],height,a[2]),Vector3.new(b[1],height,b[2])\n\t\treturn P.Root(m,name,av,bv,width,(av-bv).Magnitude-length)\n\tend\n\troot(\"EntryRoot\",{3,-139},{17,-139},8.4,18,14)\n\tlocal fork=root(\"ForkRoot\",{22,-139},{40,-139},10.4,18,18)\n\tMovement.Windows(m,\"OrchardTrellis\",fork:GetPivot()+Vector3.new(0,.4,0),18,1)\n\troot(\"HarvestRoot\",{45,-139},{59,-139},8.4,18,14)\n\tE.FruitCrossing(m,\"H2_Fruit\",P.Frame(104,8,-141,-90),true)\n\tlocal sections={\n\t\t{{155.6,-134}, {155.6,-111}, 8.9, 9.500},\n\t\t{{155.6,-111}, {127,-98}, 10.4, 16.427},\n\t\t{{127,-98}, {102,-108}, 8.9, 21.509},\n\t\t{{102,-108}, {80,-94}, 11.4, 9.200},\n\t\t{{80,-94}, {56,-112}, 9.4, 17.122},\n\t\t{{56,-112}, {29,-93}, 11.4, 15.214},\n\t\t{{29,-93}, {33,-69}, 8.9, 16.149},\n\t\t{{33,-69}, {59,-61}, 10.4, 9.617},\n\t}\n\tfor i,r in sections do\n\t\tlocal section=root(\"GroveRoot_\"..i,r[1],r[2],r[3],14,r[4])\n\t\tsection:SetAttribute(\"MovementIntent\",\"Separated root; alternate landing height; use the broad corner\")\n\t\tif i==3 then Movement.Corner(m,\"RootPlanterWrap\",section:GetPivot()+Vector3.new(0,.4,0)) end\n\t\tif i==5 then Movement.Windows(m,\"RootWindow\",section:GetPivot()+Vector3.new(0,.4,0),14,1) end\n\tend\n\tP.Terrace(m,\"VineRefuge\",76,8.24,-57,34,25)\n\tfor i,r in {{48,-156,.95},{157,-93,.88},{97,-86,1.1},{27,-116,.82}} do\n\t\tKit.Terrace(m,\"TreeSeat_\"..i,P.Frame(r[1],-.5,r[2]),Vector3.new(17,3,17),\"Blocker\")\n\t\tKit.CandyTree(m,\"CandyBlossom_\"..i,P.Frame(r[1],-.26,r[2],i*37),r[3])\n\t\tlocal nearest=if i==1 then {48,-139} elseif i==2 then {151,-111} elseif i==3 then {102,-108} else {29,-93}\n\t\tP.Root(m,\"AnchoredButtress_\"..i,Vector3.new(r[1],-1.8,r[2]),Vector3.new(nearest[1],-1.8,nearest[2]),10,0,Kit.Colors.pink)\n\t\tlocal a=P.Origin+Vector3.new(r[1],3,r[2]);local b=P.Origin+Vector3.new(nearest[1],7.6,nearest[2])\n\t\tKit.Part(m,\"RootAttachment\",CFrame.lookAt((a+b)/2,b),Vector3.new(3,3,(a-b).Magnitude),Kit.Colors.pink,\"Blocker\")\n\tend\n\tKit.Sign(m,\"GroveEntry\",P.Frame(-24,8.2,-157,180),\"CANDY GROVE\\nRoots & harvest\",Kit.Colors.aqua)\n\tlocal path={{-18,8.24,-139},{10,8.4,-139},{24,10.4,-143.5},{31,13,-143.5},{38,10.4,-143.5},{52,8.4,-139},{77,8.24,-141},{95,8.4,-141},{111,8.4,-141},{131,8.24,-141},{141,8.24,-129}}\n\tfor _,p in {{155.600,8.900,-122.500},{149.308,8.900,-118.750},{145.263,10.400,-113.214},{141.300,10.400,-104.500},{132.129,10.400,-107.243},{125.894,8.900,-105.220},{121.0,10.1,-106.32},{116.54,10.1,-108.10},{112.09,10.1,-109.89},{103.106,8.900,-100.780},{97.415,11.400,-97.624},{91.000,11.400,-101.000},{84.585,11.400,-104.376},{77.824,9.400,-103.497},{73.875,9.4,-102.5},{69.875,12,-105.5},{65.875,9.4,-108.5},{58.176,9.400,-102.503},{51.525,11.400,-101.156},{42.500,11.400,-102.500},{40.718,11.400,-93.552},{36.044,8.900,-89.013},{31.000,8.900,-81.000},{38.370,8.900,-75.056},{44.211,10.400,-72.134},{46.000,10.400,-65.000}} do table.insert(path,p) end\n\ttable.insert(path,{61,8.24,-61});table.insert(path,{76,8.24,-57})\n\tP.Path(markers,\"G3_Grove\",path,\"Main\")\n\treturn m\nend\n\nreturn GroveCourse\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","HazardClock"],"source":"--!strict\n\nlocal HazardClock={}\nexport type State={wall: number,elapsed: number,pausedStalls: number}\n\nfunction HazardClock.New(now: number): State\n\treturn {wall=now,elapsed=0,pausedStalls=0}\nend\n\nfunction HazardClock.Step(state: State,now: number): (number,number,boolean)\n\tlocal previous=state.elapsed\n\tlocal dt=now-state.wall\n\tstate.wall=now\n\t-- Hold motion and warnings together instead of skipping an unchecked sweep.\n\tif dt<=0 or dt>.2 then\n\t\tif dt>.2 then state.pausedStalls+=1 end\n\t\treturn previous,previous,false\n\tend\n\tstate.elapsed+=dt\n\treturn previous,state.elapsed,true\nend\n\nreturn HazardClock\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","Import"],"source":"--!strict\n\nlocal Import={}\nImport.AssetId=\"99291952647972\"\nImport.SourceHash=\"7c2306ca6b20b7a98856a2bea83f76e797bbe7b5735f256867a80d00383fdbae\"\nlocal colors={terra=Color3.fromRGB(186,86,50),rim=Color3.fromRGB(225,129,79),leaf=Color3.fromRGB(53,115,62),\n\tlime=Color3.fromRGB(164,204,79),red=Color3.fromRGB(219,65,67),seed=Color3.fromRGB(255,238,199),\n\torange=Color3.fromRGB(244,135,39),gold=Color3.fromRGB(249,196,56),brown=Color3.fromRGB(91,58,41),bamboo=Color3.fromRGB(116,167,59)}\nlocal origins={Pot24=0,BerryTuft=34,CarrotPair=68,SunflowerClump=102,BambooClump=136,BroadLeaf=170,Calibration10=204}\n\nfunction Import.Normalize(raw: Model): Folder\n\tassert(game.PlaceId==85558151074819 and not game:GetService(\"RunService\"):IsRunning(),\"Authorized Edit target required\")\n\tassert(not game.ServerStorage:FindFirstChild(\"StudGardenV2Assets_M01\"),\"Keep the existing asset library\")\n\tlocal witness=raw:FindFirstChild(\"Calibration10__seed\",true) :: MeshPart\n\tassert(witness and witness:IsA(\"MeshPart\"),\"Scale witness missing\")\n\tlocal factor=10/witness.Size.X\n\tassert(math.abs(witness.Size.Y/witness.Size.X-1)<0.001 and math.abs(witness.Size.Z/witness.Size.X-1)<0.001,\"Scale witness is distorted\")\n\tlocal initial=raw:GetPivot()\n\tlocal orientation=CFrame.fromMatrix(initial.Position,-initial.RightVector,Vector3.yAxis,-initial.ZVector)\n\tlocal folder=Instance.new(\"Folder\"); folder.Name=\"StudGardenV2Assets_M01\"\n\tfolder:SetAttribute(\"AssetId\",Import.AssetId); folder:SetAttribute(\"SourceHash\",Import.SourceHash)\n\tfolder:SetAttribute(\"ImportScale\",factor); folder:SetAttribute(\"Provenance\",\"Original Blender SGV2_M01; no textures or third-party assets\")\n\tlocal groups: {[string]: Model}={}\n\tfor name,x in origins do\n\t\tlocal m=Instance.new(\"Model\"); m.Name=name\n\t\tm.WorldPivot=orientation*CFrame.new(x/factor,0,0)\n\t\tm:SetAttribute(\"AssetFamily\",name); m:SetAttribute(\"SGV2Owned\",true)\n\t\tm:SetAttribute(\"SourceFile\",\"assets/stud_garden_v2/phase1/SGV2_M01.blend\")\n\t\tm:SetAttribute(\"Role\",\"Decoration\"); m.Parent=folder; groups[name]=m\n\tend\n\tlocal count=0\n\tfor _,d in raw:GetDescendants() do\n\t\tassert(not d:IsA(\"LuaSourceContainer\"),\"Reject executable import content\")\n\t\tif d:IsA(\"BasePart\") then\n\t\t\tassert(d:IsA(\"MeshPart\"),\"Expected mesh-only authored package\")\n\t\t\tlocal family,material=string.match(d.Name,\"^(.+)__(.+)$\")\n\t\t\tassert(family and groups[family] and material and colors[material],\"Unexpected authored mesh: \"..d.Name)\n\t\t\tlocal p=d:Clone(); p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false\n\t\t\tp.Color=colors[material]; p.Material=Enum.Material.Plastic; p.PivotOffset=CFrame.identity\n\t\t\tp:SetAttribute(\"Role\",\"Decoration\"); p:SetAttribute(\"OriginalAssetId\",Import.AssetId)\n\t\t\tp.Parent=groups[family]; count+=1\n\t\tend\n\tend\n\tassert(count==17,\"Mesh count mismatch\")\n\tfor _,m in groups do\n\t\tm:ScaleTo(m:GetScale()*factor)\n\t\tm:PivotTo(CFrame.identity)\n\t\tlocal _,size=m:GetBoundingBox()\n\t\tm:SetAttribute(\"AuthoredSize\",size)\n\tend\n\tlocal _,size=groups.Calibration10:GetBoundingBox()\n\tassert((size-Vector3.one*10).Magnitude<0.01,\"Final calibration cube mismatch\")\n\tfolder.Parent=game.ServerStorage\n\treturn folder\nend\n\nfunction Import.NormalizeCrops(raw: Model,assetId: string): Folder\n\tassert(game.PlaceId==85558151074819 and not game:GetService(\"RunService\"):IsRunning(),\"Authorized Edit target required\")\n\tassert(not game.ServerStorage:FindFirstChild(\"StudGardenV2Assets_M02\"),\"Keep existing crop library\")\n\tlocal witness=raw:FindFirstChild(\"Calibration10__seed\",true) :: MeshPart\n\tassert(witness and witness:IsA(\"MeshPart\"),\"Scale witness required\")\n\tlocal factor=10/witness.Size.X\n\tlocal initial=raw:GetPivot()\n\tlocal orientation=CFrame.fromMatrix(initial.Position,-initial.RightVector,Vector3.yAxis,-initial.ZVector)\n\tlocal folder=Instance.new(\"Folder\"); folder.Name=\"StudGardenV2Assets_M02\"\n\tfolder:SetAttribute(\"AssetId\",assetId); folder:SetAttribute(\"ImportScale\",factor)\n\tfolder:SetAttribute(\"SourceHash\",\"2371e77d04572fe61f5b7fc1a46c2aefab6684863f79517010bd38baf7172202\")\n\tfolder:SetAttribute(\"Provenance\",\"Original Blender SGV2_M02 crop revision; no textures or third-party assets\")\n\tlocal groups: {[string]: Model}={}\n\tfor name,x in {BerryTuft=34,CarrotPair=68,Calibration10=204} do\n\t\tlocal m=Instance.new(\"Model\"); m.Name=name; m.WorldPivot=orientation*CFrame.new(x/factor,0,0)\n\t\tm:SetAttribute(\"AssetFamily\",name); m:SetAttribute(\"SGV2Owned\",true); m:SetAttribute(\"Role\",\"Decoration\")\n\t\tm:SetAttribute(\"SourceFile\",\"assets/stud_garden_v2/phase1/SGV2_M02.blend\")\n\t\tm.Parent=folder; groups[name]=m\n\tend\n\tlocal count=0\n\tfor _,d in raw:GetDescendants() do\n\t\tassert(not d:IsA(\"LuaSourceContainer\"),\"Reject executable import content\")\n\t\tif d:IsA(\"BasePart\") then\n\t\t\tassert(d:IsA(\"MeshPart\"),\"Mesh-only package required\")\n\t\t\tlocal family,material=string.match(d.Name,\"^(.+)__(.+)$\")\n\t\t\tassert(family and groups[family] and material and colors[material],\"Unexpected crop mesh\")\n\t\t\tlocal p=d:Clone(); p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false\n\t\t\tp.Color=colors[material]; p.Material=Enum.Material.Plastic; p.PivotOffset=CFrame.identity\n\t\t\tp:SetAttribute(\"Role\",\"Decoration\"); p:SetAttribute(\"OriginalAssetId\",assetId); p.Parent=groups[family]; count+=1\n\t\tend\n\tend\n\tassert(count==7,\"Expected seven authored meshes\")\n\tfor _,m in groups do m:ScaleTo(m:GetScale()*factor); m:PivotTo(CFrame.identity); local _,sz=m:GetBoundingBox(); m:SetAttribute(\"AuthoredSize\",sz) end\n\tlocal _,size=groups.Calibration10:GetBoundingBox(); assert((size-Vector3.one*10).Magnitude<0.01,\"Crop calibration mismatch\")\n\tfolder.Parent=game.ServerStorage\n\treturn folder\nend\n\nreturn Import\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","Kit"],"source":"--!strict\n\nlocal Kit = {}\nKit.Revision = \"SGV2_K05\"\nKit.Colors = {\n\tgrass=Color3.fromRGB(116,167,59), lime=Color3.fromRGB(164,204,79), leaf=Color3.fromRGB(53,115,62),\n\tsoil=Color3.fromRGB(91,58,41), soilLight=Color3.fromRGB(128,83,48), wood=Color3.fromRGB(178,117,54),\n\thoney=Color3.fromRGB(225,163,79), terra=Color3.fromRGB(186,86,50), rim=Color3.fromRGB(225,129,79),\n\tpink=Color3.fromRGB(228,123,174), aqua=Color3.fromRGB(79,174,176), aquaLight=Color3.fromRGB(125,211,203),\n\tcream=Color3.fromRGB(255,238,199), white=Color3.fromRGB(247,243,229), dark=Color3.fromRGB(52,49,43),\n\tgold=Color3.fromRGB(249,196,56), orange=Color3.fromRGB(244,135,39), red=Color3.fromRGB(219,65,67),\n\tpurple=Color3.fromRGB(163,112,193), water=Color3.fromRGB(87,187,222), gray=Color3.fromRGB(135,149,137),\n}\nlocal c = Kit.Colors\n\nfunction Kit.Group(parent: Instance, name: string, frame: CFrame?): Model\n\tlocal m = Instance.new(\"Model\")\n\tm.Name = name\n\tm.WorldPivot = frame or CFrame.identity\n\tm:SetAttribute(\"SGV2Owned\", true)\n\tm:SetAttribute(\"KitRevision\", Kit.Revision)\n\tm:SetAttribute(\"Provenance\", \"Original native geometry authored for Stud Garden V2\")\n\tm.Parent = parent\n\treturn m\nend\n\nfunction Kit.Part(parent: Instance, name: string, frame: CFrame, size: Vector3, color: Color3, role: string?, shape: Enum.PartType?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Name, p.CFrame, p.Size, p.Color = name, frame, size, color\n\tp.Anchored, p.CanCollide = true, role == \"Walk\" or role == \"Blocker\" or role == \"Refuge\"\n\tp.CanTouch, p.CanQuery = false, p.CanCollide\n\tp.Material = Enum.Material.Plastic\n\tp.TopSurface, p.BottomSurface = Enum.SurfaceType.Studs, Enum.SurfaceType.Smooth\n\tp:SetAttribute(\"Role\", role or \"Decoration\")\n\tif shape then p.Shape = shape; p.TopSurface = Enum.SurfaceType.Smooth end\n\tp.Parent = parent\n\treturn p\nend\n\nlocal function author(parent: Instance, name: string, frame: CFrame, family: string)\n\tlocal m = Kit.Group(parent, name, frame)\n\tm:SetAttribute(\"AssetFamily\", family)\n\tm:SetAttribute(\"Mount\", \"Local origin is ground center; +Y up; -Z front\")\n\tlocal function b(n: string,x: number,y: number,z: number,sx: number,sy: number,sz: number,color: Color3,role: string?,rotation: CFrame?,shape: Enum.PartType?)\n\t\treturn Kit.Part(m,n,frame*CFrame.new(x,y,z)*(rotation or CFrame.identity),Vector3.new(sx,sy,sz),color,role,shape)\n\tend\n\treturn m,b\nend\n\nfunction Kit.Studs(parent: Instance, frame: CFrame, width: number, depth: number, color: Color3, spacing: number?)\n\tlocal pitch = spacing or 3\n\tlocal nx,nz = math.floor(width/pitch),math.floor(depth/pitch)\n\tfor ix=1,nx do for iz=1,nz do\n\t\tKit.Part(parent,\"RaisedStud\",frame*CFrame.new((ix-(nx+1)/2)*pitch,0.12,(iz-(nz+1)/2)*pitch)*CFrame.Angles(0,0,math.pi/2),Vector3.new(0.24,0.85,0.85),color,\"Decoration\",Enum.PartType.Cylinder).CastShadow=false\n\tend end\nend\n\nfunction Kit.Imported(parent: Instance,name: string,family: string,frame: CFrame,scale: number?): Model\n\tlocal crops=game.ServerStorage:FindFirstChild(\"StudGardenV2Assets_M02\")\n\tlocal library=if crops and (family==\"BerryTuft\" or family==\"CarrotPair\") then crops else game.ServerStorage:FindFirstChild(\"StudGardenV2Assets_M01\")\n\tassert(library and library:GetAttribute(\"AssetId\"),\"Verified asset library required\")\n\tlocal source=library:FindFirstChild(family) :: Model\n\tassert(source and source:IsA(\"Model\"),\"Missing imported family \"..family)\n\tlocal model=source:Clone(); model.Name=name\n\tmodel:SetAttribute(\"Mount\",if family==\"Pot24\" then \"Ground center; rim top6.4; fixed scale\" elseif family==\"BroadLeaf\" then \"Leaf stalk origin; decorative surface varies in height\" else \"Soil/ground center; +Y up; -Z front\")\n\tmodel:SetAttribute(\"Editing\",\"Move the complete family model; decoration has no player support\")\n\tif scale and scale~=1 then model:ScaleTo(model:GetScale()*scale) end\n\tmodel:PivotTo(frame); model.Parent=parent\n\treturn model\nend\n\nfunction Kit.Terrace(parent: Instance,name: string,frame: CFrame,size: Vector3,role: string?): Model\n\tlocal m,b = author(parent,name,frame,\"PlantedTerrace\")\n\tm:SetAttribute(\"Mount\",\"Top soil center; cap is 0.24 studs above origin\")\n\tb(\"Earth\",0,-size.Y/2,0,size.X,size.Y,size.Z,c.soilLight,\"Blocker\")\n\tb(\"GrassCap\",0,0.12,0,size.X+0.2,0.24,size.Z+0.2,c.grass,role or \"Walk\")\n\tfor _,s in {-1,1} do\n\t\tb(\"RetainingRail\",s*(size.X/2+0.04),-0.55,0,0.22,0.65,size.Z,c.wood)\n\t\tb(\"RetainingRail\",0,-0.55,s*(size.Z/2+0.04),size.X,0.65,0.22,c.wood)\n\tend\n\tfor i=1,math.floor(size.X/9) do\n\t\tb(\"SoilBrick\",(i-(math.floor(size.X/9)+1)/2)*9,-size.Y*0.55,-size.Z/2-0.02,8.4,math.min(2,size.Y*0.6),0.12,if i%2==0 then c.soil else c.wood)\n\tend\n\treturn m\nend\n\nfunction Kit.Triangle(parent: Instance,name: string,a: Vector3,b: Vector3,d: Vector3,thickness: number,color: Color3,role: string): {WedgePart}\n\tlocal ab,ad,bd=b-a,d-a,d-b\n\tif ab:Dot(ab)>ad:Dot(ad) and ab:Dot(ab)>bd:Dot(bd) then d,a=a,d\n\telseif ad:Dot(ad)>bd:Dot(bd) then a,b=b,a end\n\tab,ad,bd=b-a,d-a,d-b\n\tlocal right=ad:Cross(ab).Unit\n\tlocal back=bd.Unit\n\tlocal up=bd:Cross(right).Unit\n\tlocal height=math.abs(ab:Dot(up))\n\tlocal result={}\n\tfor i,r in {{(a+b)/2,right,up,back,math.abs(ab:Dot(back))},{(a+d)/2,-right,up,-back,math.abs(ad:Dot(back))}} do\n\t\tif r[5]>0.001 then\n\t\t\tlocal p=Instance.new(\"WedgePart\")\n\t\t\tp.Name=name..\"_\"..i; p.Size=Vector3.new(thickness,height,r[5]); p.CFrame=CFrame.fromMatrix(r[1],r[2],r[3],r[4])\n\t\t\tp.Anchored=true; p.CanCollide=role==\"Walk\" or role==\"Blocker\"; p.CanQuery=p.CanCollide; p.CanTouch=false\n\t\t\tp.Color=color; p.Material=Enum.Material.Plastic; p:SetAttribute(\"Role\",role); p.Parent=parent\n\t\t\ttable.insert(result,p)\n\t\tend\n\tend\n\treturn result\nend\n\nfunction Kit.CandyTree(parent: Instance,name: string,frame: CFrame,scale: number?): Model\n\tlocal m,b=author(parent,name,frame,\"CandyBlossom\")\n\tb(\"Trunk\",0,6.5,0,3.1,13,3.1,c.pink,\"Blocker\")\n\tfor _,r in {{-6,16,0},{6,17,1},{0,17,-5},{2,17,5}} do\n\t\tlocal a,d=frame*Vector3.new(0,8,0),frame*Vector3.new(r[1],r[2],r[3])\n\t\tKit.Part(m,\"RisingBranch\",CFrame.lookAt((a+d)/2,d),Vector3.new(2.1,2.1,(d-a).Magnitude),c.pink,\"Blocker\")\n\tend\n\tfor i,r in {{0,20,0,10,10},{-6,17,0,8,9},{6,18,1,9,8},{0,17,-5,8,7},{2,16.5,5,8,6}} do\n\t\tlocal color=if i%2==0 then c.aquaLight else c.aqua\n\t\tb(\"CrownLower_\"..i,r[1],r[2],r[3],r[4],2.8,r[5],color)\n\t\tb(\"CrownMiddle_\"..i,r[1]+0.4,r[2]+2,r[3]-0.5,r[4]*0.8,2,r[5]*0.8,color)\n\t\tb(\"CrownTop_\"..i,r[1],r[2]+3.5,r[3],r[4]*0.58,1.3,r[5]*0.6,color)\n\t\tKit.Studs(m,frame*CFrame.new(r[1],r[2]+4.2,r[3]),r[4]*0.58,r[5]*0.6,color,2.8)\n\tend\n\tfor i,r in {{-5,13,-3},{5,14,-3},{3,13,5},{-3,15,6}} do\n\t\tb(\"FruitStem\",r[1],r[2]+2.5,r[3],0.35,2,0.35,c.pink)\n\t\tb(\"Blossom_\"..i,r[1],r[2],r[3],2.7,3.4,2.7,c.pink,\"Decoration\",nil,Enum.PartType.Ball)\n\t\tb(\"BlossomStud\",r[1],r[2]+1.9,r[3],0.4,0.9,0.9,c.cream,\"Decoration\",CFrame.Angles(0,0,math.pi/2),Enum.PartType.Cylinder)\n\tend\n\tfor _,yaw in {30,145,260} do\n\t\tlocal cf=frame*CFrame.Angles(0,math.rad(yaw),0)*CFrame.new(0,0.65,2)\n\t\tKit.Part(m,\"Root\",cf,Vector3.new(2,1.3,6),c.pink,\"Blocker\")\n\tend\n\tif scale and scale~=1 then m:ScaleTo(scale) end\n\treturn m\nend\n\nfunction Kit.Pot(parent: Instance,name: string,frame: CFrame,diameter: number,height: number,rimWidth: number,imported: boolean?): Model\n\tlocal m,b=author(parent,name,frame,\"HollowPot\")\n\tlocal radius=diameter/2-rimWidth/2\n\tif imported then\n\t\tassert(diameter==24 and height==6 and rimWidth==6,\"M01 pot has fixed support dimensions\")\n\t\tlocal function vertex(radius: number,y: number,index: number): Vector3\n\t\t\tlocal a=index*math.pi/6\n\t\t\treturn frame:PointToWorldSpace(Vector3.new(radius*math.cos(a),y,radius*math.sin(a)))\n\t\tend\n\t\tlocal function quad(name: string,a: Vector3,b: Vector3,c_: Vector3,d: Vector3,thickness: number,role: string)\n\t\t\tfor _,vertices in {{a,b,c_},{a,c_,d}} do\n\t\t\t\tfor _,p in Kit.Triangle(m,name,vertices[1],vertices[2],vertices[3],thickness,c.terra,role) do p.Transparency=1 end\n\t\t\tend\n\t\tend\n\t\tfor i=0,11 do\n\t\t\tquad(\"Rim_\"..i,vertex(6,5.95,i),vertex(12,5.95,i),vertex(12,5.95,i+1),vertex(6,5.95,i+1),0.9,\"Walk\")\n\t\t\tquad(\"OuterWall_\"..i,vertex(7.8,0.4,i),vertex(10.3,5.5,i),vertex(10.3,5.5,i+1),vertex(7.8,0.4,i+1),0.1,\"Blocker\")\n\t\t\tquad(\"InnerWall_\"..i,vertex(5.7,2.7,i),vertex(6,5.5,i),vertex(6,5.5,i+1),vertex(5.7,2.7,i+1),0.1,\"Blocker\")\n\t\tend\n\t\tKit.Imported(m,\"PotSkin\",\"Pot24\",frame)\n\telse\n\tfor i=0,11 do\n\t\tlocal a=i*math.pi/6\n\t\tlocal rot=CFrame.Angles(0,-a,0)\n\t\tlocal x,z=math.cos(a)*radius,math.sin(a)*radius\n\t\tb(\"Rim_\"..i,x,height,z,rimWidth,0.8,2*radius*math.tan(math.pi/12)+0.25,c.rim,\"Walk\",rot)\n\t\tb(\"Wall_\"..i,x*0.9,height/2,z*0.9,1.15,height,2*radius*0.9*math.tan(math.pi/12)+0.3,if i%3==0 then c.rim else c.terra,\"Blocker\",rot)\n\tend\n\tend\n\tb(\"RecessedSoil\",0,math.max(0.5,height-3.3),0,0.7,diameter-rimWidth*1.5,diameter-rimWidth*1.5,c.soil,\"Walk\",CFrame.Angles(0,0,math.pi/2),Enum.PartType.Cylinder)\n\tm:SetAttribute(\"RimWidth\",rimWidth)\n\tm:SetAttribute(\"Recovery\", \"Soil is solid and 3.3 studs below rim; jump back out\")\n\treturn m\nend\n\nfunction Kit.Plank(parent: Instance,name: string,frame: CFrame,width: number,length: number,style: string?): Model\n\tlocal m,b=author(parent,name,frame,style or \"GardenBridge\")\n\tm:SetAttribute(\"Mount\",\"Deck center; walking top is 0.4 studs above origin\")\n\tlocal count=math.max(2,math.floor(length/3))\n\tfor i=1,count do b(\"DeckPlank_\"..i,0,0,(i-(count+1)/2)*length/count,width,0.8,length/count-0.07,if i%3==0 then c.honey else c.wood,\"Walk\") end\n\tb(\"BearerL\",-width*0.36,-0.8,0,0.75,1,length+0.6,c.soilLight,\"Blocker\")\n\tb(\"BearerR\",width*0.36,-0.8,0,0.75,1,length+0.6,c.soilLight,\"Blocker\")\n\treturn m\nend\n\nfunction Kit.Bamboo(parent: Instance,name: string,frame: CFrame,height: number,imported: boolean?): Model\n\tlocal m,b=author(parent,name,frame,\"BambooCluster\")\n\tif imported then\n\t\tlocal scale=height/16\n\t\tKit.Imported(m,\"BambooSkin\",\"BambooClump\",frame,scale)\n\t\tfor _,record in {{-1.3,0,13},{1,-0.6,16},{0,1.2,10}} do\n\t\t\tlocal p=b(\"CulmCollider\",record[1]*scale,record[3]*scale/2,record[2]*scale,record[3]*scale,1.16*scale,1.16*scale,c.grass,\"Blocker\",CFrame.Angles(0,0,math.pi/2),Enum.PartType.Cylinder)\n\t\t\tp.Transparency=1\n\t\tend\n\t\treturn m\n\tend\n\tfor i=1,3 do\n\t\tlocal x,z=(i-2)*1.9,if i==2 then 0.8 else 0\n\t\tlocal h=height-(i%2)*2\n\t\tb(\"Culm\",x,h/2,z,h,1.45,1.45,if i==2 then c.lime else c.grass,\"Blocker\",CFrame.Angles(0,0,math.pi/2),Enum.PartType.Cylinder)\n\t\tfor y=2,h,3.4 do b(\"Node\",x,y,z,0.28,1.66,1.66,c.lime,\"Decoration\",CFrame.Angles(0,0,math.pi/2),Enum.PartType.Cylinder) end\n\t\tfor j=1,2 do b(\"LeafBlade\",x+(j*2-3)*1.6,h-j*1.4,z,3.8,0.28,1.05,c.leaf,\"Decoration\",CFrame.Angles(0,0,math.rad((j*2-3)*25))) end\n\tend\n\treturn m\nend\n\nfunction Kit.Crop(parent: Instance,name: string,frame: CFrame,kind: string,scale: number?): Model\n\tlocal m,b=author(parent,name,frame,\"Crop_\"..kind)\n\tif kind==\"Carrot\" then\n\t\tb(\"Root\",0,1.35,0,1.8,2.6,1.8,c.orange)\n\t\tb(\"Shoulder\",0,2.7,0,2.4,1.2,2.4,c.orange)\n\t\tfor i=0,3 do local a=i*math.pi/2 b(\"Leaf\",math.cos(a)*0.7,4,math.sin(a)*0.7,0.65,2.5,0.7,c.leaf,\"Decoration\",CFrame.Angles(math.sin(a)*0.4,0,math.cos(a)*0.4)) end\n\telseif kind==\"Berry\" then\n\t\tb(\"Fruit\",0,1.2,0,2.6,2.7,2.6,c.red,\"Decoration\",nil,Enum.PartType.Ball)\n\t\tfor i=0,3 do local a=i*math.pi/2 b(\"Crown\",math.cos(a)*0.7,2.35,math.sin(a)*0.7,1.6,0.35,1.15,c.leaf,\"Decoration\",CFrame.Angles(0,-a,0)) end\n\t\tfor _,x in {-0.6,0.6} do b(\"Seed\",x,1.4,-1.19,0.2,0.32,0.16,c.cream) end\n\t\tb(\"LowerSeed\",0,0.7,-1.17,0.2,0.32,0.16,c.cream)\n\telse\n\t\tb(\"Stem\",0,2.4,0,0.45,4.8,0.45,c.leaf)\n\t\tb(\"FlowerCenter\",0,4.8,0,1.7,1.7,0.7,c.soil)\n\t\tfor i=0,7 do local a=i*math.pi/4 b(\"Petal\",math.cos(a)*1.45,4.8+math.sin(a)*1.45,0,1.15,1.15,0.55,c.gold,\"Decoration\",CFrame.Angles(0,0,a)) end\n\t\tfor _,s in {-1,1} do b(\"Leaf\",s*0.85,2.5,0,2.2,0.55,0.75,c.grass,\"Decoration\",CFrame.Angles(0,0,s*0.4)) end\n\tend\n\tif scale and scale~=1 then m:ScaleTo(scale) end\n\treturn m\nend\n\nfunction Kit.Bed(parent: Instance,name: string,frame: CFrame,width: number,length: number,kind: string,imported: boolean?): Model\n\tlocal m,b=author(parent,name,frame,\"RaisedCropBed\")\n\tb(\"Soil\",0,0.75,0,width,1.5,length,c.soil,\"Blocker\")\n\tfor _,s in {-1,1} do\n\t\tb(\"LongRail\",s*(width/2+0.15),1.2,0,0.65,2.4,length+1.1,c.wood,\"Blocker\")\n\t\tb(\"EndRail\",0,1.2,s*(length/2+0.15),width+1.1,2.4,0.65,c.honey,\"Blocker\")\n\tend\n\tlocal pitch=if imported then 6 else 4\n\tlocal nx,nz=math.max(1,math.floor(width/pitch)),math.max(1,math.floor(length/pitch))\n\tfor ix=1,nx do for iz=1,nz do\n\t\tlocal planting=frame*CFrame.new((ix-(nx+1)/2)*pitch,1.5,(iz-(nz+1)/2)*pitch)*CFrame.Angles(0,math.rad((ix*17+iz*23)%50-25),0)\n\t\tif imported then\n\t\t\tKit.Imported(m,kind..ix..\"_\"..iz,if kind==\"Flower\" then \"SunflowerClump\" elseif kind==\"Berry\" then \"BerryTuft\" else \"CarrotPair\",planting,if kind==\"Berry\" then 1.2 else 1)\n\t\telse\n\t\t\tKit.Crop(m,kind..ix..\"_\"..iz,planting,kind,if kind==\"Flower\" then 1.35 elseif kind==\"Berry\" then 1.3 else 1.15)\n\t\tend\n\tend end\n\treturn m\nend\n\nfunction Kit.Bunny(parent: Instance,name: string,frame: CFrame): Model\n\tlocal m,b=author(parent,name,frame,\"GardenBunny\")\n\tb(\"Body\",0,1.5,0.4,2.8,2.7,3,c.white)\n\tb(\"Head\",0,3,-1,2.65,2.3,2,c.white)\n\tfor _,s in {-1,1} do\n\t\tb(\"Ear\",s*0.72,5.1,-0.7,0.8,2.8,0.75,c.white,\"Decoration\",CFrame.Angles(0,0,-s*0.08))\n\t\tb(\"InnerEar\",s*0.76,5.15,-1.105,0.42,2.1,0.12,c.pink)\n\t\tb(\"Eye\",s*0.64,3.3,-2.02,0.42,0.62,0.14,c.dark)\n\t\tb(\"Catchlight\",s*0.64-0.08,3.46,-2.105,0.13,0.17,0.08,c.white)\n\t\tb(\"Foot\",s*0.92,0.4,-0.25,1.1,0.65,1.9,c.white)\n\tend\n\tb(\"Nose\",0,2.75,-2.08,0.37,0.3,0.18,c.pink)\n\tb(\"Tail\",0,1.7,2,1.15,1.15,1.15,c.white)\n\treturn m\nend\n\nfunction Kit.Fence(parent: Instance,name: string,frame: CFrame,length: number): Model\n\tlocal m,b=author(parent,name,frame,\"GardenFence\")\n\tlocal bays=math.max(1,math.ceil(length/9))\n\tfor i=0,bays do\n\t\tlocal x=-length/2+i*length/bays\n\t\tb(\"Post\",x,2.2,0,1.1,4.4,1.1,c.wood,\"Blocker\")\n\t\tb(\"PostCap\",x,4.55,0,1.35,0.4,1.35,c.honey,\"Blocker\")\n\tend\n\tfor _,y in {1.4,3.35} do b(\"Rail\",0,y,0,length,0.75,0.6,c.honey,\"Blocker\") end\n\treturn m\nend\n\nfunction Kit.Sign(parent: Instance,name: string,frame: CFrame,text: string,color: Color3?): Model\n\tlocal m,b=author(parent,name,frame,\"GardenSign\")\n\tb(\"Post\",0,2.4,.35,0.65,4.8,0.65,c.wood,\"Blocker\")\n\tlocal board=b(\"Board\",0,4.8,0,8,3.1,0.55,color or c.cream,\"Blocker\")\n\tlocal gui=Instance.new(\"SurfaceGui\"); gui.Face=Enum.NormalId.Front; gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud; gui.PixelsPerStud=45; gui.Parent=board\n\tlocal label=Instance.new(\"TextLabel\"); label.Size=UDim2.fromScale(0.92,0.84); label.Position=UDim2.fromScale(0.04,0.08)\n\tlabel.BackgroundTransparency=1; label.Text=text; label.TextColor3=c.dark; label.TextScaled=true; label.Font=Enum.Font.GothamBold; label.Parent=gui\n\treturn m\nend\n\nfunction Kit.Inventory(model: Model)\n\tlocal r={instances=1,parts=0,colliders=0,decoration=0,meshes=0,lights=0}\n\tfor _,d in model:GetDescendants() do\n\t\tr.instances+=1\n\t\tif d:IsA(\"BasePart\") then r.parts+=1; if d.CanCollide then r.colliders+=1 else r.decoration+=1 end end\n\t\tif d:IsA(\"MeshPart\") then r.meshes+=1 end\n\t\tif d:IsA(\"Light\") then r.lights+=1 end\n\tend\n\tlocal cf,sz=model:GetBoundingBox()\n\treturn {counts=r,bounds={sz.X,sz.Y,sz.Z},center={cf.X,cf.Y,cf.Z},revision=model:GetAttribute(\"CandidateId\")}\nend\n\nreturn Kit\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","Movement"],"source":"--!strict\n\nlocal Kit=require(script.Parent.Kit)\nlocal c=Kit.Colors\nlocal Movement={}\n\nfunction Movement.Windows(parent: Instance,name: string,frame: CFrame,width: number,rows: number): Model\n\tlocal m=Kit.Group(parent,name,frame)\n\tm:SetAttribute(\"PaletteFamily\",\"10_WindowHops; two parallel openings adapted to garden trellis\")\n\tm:SetAttribute(\"MovementIntent\",\"Choose either opening; jump the raised sill; land before the next row\")\n\tlocal opening=(width-4.5)/2\n\tfor i=1,rows do\n\t\tlocal z=(i-(rows+1)/2)*11\n\t\tlocal sill=if i%2==1 then 2.6 else 3.2\n\t\tfor _,x in {-(width-1.5)/2,0,(width-1.5)/2} do\n\t\t\tKit.Part(m,\"TrellisPost\",frame*CFrame.new(x,6.35,z),Vector3.new(1.5,14.3,1.3),c.leaf,\"Blocker\")\n\t\tend\n\t\tfor _,s in {-1,1} do\n\t\t\tlocal x=s*(opening/2+.75)\n\t\t\tKit.Part(m,\"JumpSill\",frame*CFrame.new(x,sill/2,z),Vector3.new(opening,sill,1.3),c.honey,\"Walk\")\n\t\t\tKit.Part(m,\"Lintel\",frame*CFrame.new(x,13.5,z),Vector3.new(opening,1,1.3),c.leaf,\"Blocker\")\n\t\t\tKit.Part(m,\"SillStripe\",frame*CFrame.new(x,sill+.06,z),Vector3.new(opening,.12,1.3),c.cream)\n\t\tend\n\tend\n\treturn m\nend\n\nfunction Movement.Hurdle(parent: Instance,name: string,frame: CFrame,width: number,height: number): Model\n\tlocal m=Kit.Group(parent,name,frame)\n\tm:SetAttribute(\"MovementIntent\",\"Jump the visible low retaining edge\")\n\tKit.Part(m,\"RetainingEdge\",frame*CFrame.new(0,height/2,0),Vector3.new(width,height,1.3),c.terra,\"Blocker\")\n\tKit.Part(m,\"PaintedTop\",frame*CFrame.new(0,height+.06,0),Vector3.new(width,.12,1.3),c.cream)\n\treturn m\nend\n\nfunction Movement.Corner(parent: Instance,name: string,frame: CFrame): Model\n\tlocal m=Kit.Group(parent,name,frame)\n\tm:SetAttribute(\"PaletteFamily\",\"12_CornerLedges; paired sides for passing\")\n\tm:SetAttribute(\"MovementIntent\",\"Round either side of the planter; rise onto the outside ledge\")\n\tKit.Part(m,\"PlanterColumn\",frame*CFrame.new(0,6.5,0),Vector3.new(6,13,6),c.terra,\"Blocker\")\n\tfor _,s in {-1,1} do\n\t\tKit.Part(m,\"SideLedge\",frame*CFrame.new(s*5.5,.6,0),Vector3.new(5,1.2,10),c.honey,\"Walk\")\n\tend\n\treturn m\nend\n\nreturn Movement\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","Prototype"],"source":"--!strict\n\nlocal Kit = require(script.Parent.Kit)\nlocal Movement = require(script.Parent.Movement)\nlocal Wayfinding = require(script.Parent.Wayfinding)\nlocal c = Kit.Colors\nlocal Prototype = {}\nPrototype.Revision = \"SGV2_P02\"\nPrototype.SampleOrigin = Vector3.new(8000,80,3500)\nPrototype.OutlineOrigin = Vector3.new(7600,80,3500)\n\nfunction Prototype.Sample(parent: Instance, imported: boolean?, courseAssembly: boolean?): Model\n\tlocal name=if imported then \"SGV2_Sample_P07\" else \"SGV2_Sample_P02\"\n\tassert(not parent:FindFirstChild(name),\"Preserve the existing sample\")\n\tlocal origin=Prototype.SampleOrigin\n\tlocal m=Kit.Group(parent,name,CFrame.new(origin))\n\tm:SetAttribute(\"CandidateId\",if imported then \"SGV2_P07\" else Prototype.Revision)\n\tm:SetAttribute(\"StudyOnly\",true)\n\tm:SetAttribute(\"CourseId\",\"stud_garden_v2_study\")\n\tm:SetAttribute(\"CourseOrigin\",origin)\n\tlocal route=Kit.Group(m,\"PlayableObjects\")\n\tlocal garden=Kit.Group(m,\"PlantedContext\")\n\tlocal markers=Kit.Group(m,\"StudyMarkers\")\n\tlocal function f(x: number,y: number,z: number,yaw: number?): CFrame\n\t\treturn CFrame.new(origin+Vector3.new(x,y,z))*CFrame.Angles(0,math.rad(yaw or 0),0)\n\tend\n\tif not courseAssembly then Kit.Terrace(garden,\"LowGardenGround\",f(-22,-3,-25),Vector3.new(138,4,158),\"Blocker\") end\n\tKit.Terrace(route,\"StartRefuge\",f(0,4,40),Vector3.new(32,7,if courseAssembly then 26 else 18),\"Refuge\")\n\tKit.Part(garden,\"PotSeat_A\",f(0,-1.42,15)*CFrame.Angles(0,0,math.pi/2),Vector3.new(2.85,17,17),c.soilLight,\"Blocker\",Enum.PartType.Cylinder)\n\tKit.Part(garden,\"PotSeat_B\",f(-8,-0.92,-13)*CFrame.Angles(0,0,math.pi/2),Vector3.new(3.85,17,17),c.soilLight,\"Blocker\",Enum.PartType.Cylinder)\n\tKit.Pot(route,\"PotRim_A\",f(0,0,15),24,6,6,imported)\n\tKit.Pot(route,\"PotRim_B\",f(-8,1,-13),24,6,6,imported)\n\tKit.Imported(route.PotRim_A,\"CenterCarrot\",\"CarrotPair\",f(0,2.9,15),0.9)\n\tKit.Imported(route.PotRim_B,\"CenterBerry\",\"BerryTuft\",f(-8,3.9,-13),1.1)\n\tKit.Terrace(route,\"DryWait\",f(0,7,-37),Vector3.new(if courseAssembly then 40 else 32,10,if courseAssembly then 24 else 18),\"Refuge\")\n\tKit.Plank(route,\"SprinklerBridge\",f(0,7,-61),24,30)\n\tKit.Terrace(route,\"DryExitAndChoice\",f(0,7,-85),Vector3.new(if courseAssembly then 40 else 32,10,if courseAssembly then 24 else 20),\"Refuge\")\n\tKit.Plank(route,\"BambooWest\",f(if courseAssembly then -33 else -30,7,-85,90),if courseAssembly then 18 else 16,if courseAssembly then 19 else 24)\n\tKit.Plank(route,\"BambooTurn\",f(if courseAssembly then -58 else -54,if courseAssembly then 9 else 8,if courseAssembly then -79 else -80,60),if courseAssembly then 18 else 15,if courseAssembly then 17 else 18)\n\tKit.Plank(route,\"BambooSouth\",f(if courseAssembly then -72 else -68,8,if courseAssembly then -57 else -58),if courseAssembly then 18 else 16,if courseAssembly then 19 else 21)\n\tKit.Plank(route,\"BambooReturn\",f(if courseAssembly then -77 else -65,if courseAssembly then 9 else 7,if courseAssembly then -31 else -32,-28),if courseAssembly then 18 else 16,if courseAssembly then 17 else 20)\n\tKit.Terrace(route,\"MergeRefuge\",f(-47,7,-12),Vector3.new(if courseAssembly then 36 else 28,10,if courseAssembly then 26 else 20),\"Refuge\")\n\tlocal expert=Kit.Group(route,\"ExpertStakes\")\n\tlocal stakes=if courseAssembly then {{-30,9,-70},{-35.5,11.1,-60.5},{-34,8.6,-50},{-40,10.5,-41},{-38,8.5,-31}} else {{-20,8,-69},{-26,9.4,-59.5},{-26,8,-47},{-36.5,9,-39},{-38,8,-27}}\n\tfor i,p in stakes do\n\t\tlocal stake=Kit.Group(expert,\"Stake_\"..i,f(p[1],p[2],p[3]))\n\t\tKit.Part(stake,\"Timber\",f(p[1],(p[2]-3)/2,p[3]),Vector3.new(if courseAssembly then 2.3 else 3.7,p[2]+3,if courseAssembly then 2.3 else 3.7),c.wood,\"Blocker\")\n\t\tKit.Part(stake,\"Cap\",f(p[1],p[2],p[3],if i%2==0 then 30 else -20),Vector3.new(if courseAssembly then 3.2 else 4.5,0.8,if courseAssembly then 4.8 else 5.5),c.gold,\"Walk\")\n\tend\n\tlocal expertSign=Kit.Sign(garden,\"ExpertChoice\",f(if courseAssembly then -11 else -12,7,if courseAssembly then -103 else -91,-120),\"EXPERT\\nSTAKES\",c.gold)\n\tlocal mainSign=Kit.Sign(garden,\"MainChoice\",f(if courseAssembly then -23 else -20,7,if courseAssembly then -97 else -96,-120),\"BAMBOO\\nWALK\",c.lime)\n\tif courseAssembly then\n\t\tfor _,sign in {expertSign,mainSign} do\n\t\t\tlocal post=sign.Post :: BasePart\n\t\t\tlocal top,bottom=post.Position.Y+post.Size.Y/2,origin.Y-2.8\n\t\t\tpost.Size=Vector3.new(post.Size.X,top-bottom,post.Size.Z)\n\t\t\tpost.CFrame=post.CFrame+Vector3.new(0,(top+bottom)/2-post.Position.Y,0)\n\t\tend\n\tend\n\tKit.Sign(garden,\"WarningSign\",f(if courseAssembly then 27 else 19,6,-36,160),\"SPRINKLER\\nWait for green\")\n\tKit.Sign(garden,\"SampleEntry\",f(20,2,38,165),\"CROP\\nGARDEN\",c.lime)\n\tlocal h=Kit.Group(m,\"H1_Sprinkler\",f(0,7,-61))\n\tif courseAssembly then\n\t\tMovement.Windows(route,\"BambooWindowHops\",f(-33,7.4,-85,90),18,1)\n\t\tMovement.Corner(route,\"BambooPlanterWrap\",f(-72,8.4,-57))\n\t\tMovement.Hurdle(route,\"BambooReturnHurdle\",f(-77,9.4,-31,-28),18,2.8)\n\t\tWayfinding.HazardStatus(h,f(0,7,-43,180),40)\n\tend\n\th:SetAttribute(\"ClearSeconds\",6.5); h:SetAttribute(\"WarningSeconds\",1.5); h:SetAttribute(\"ActiveSeconds\",2)\n\th:SetAttribute(\"Mount\",\"Encounter frame at bridge deck center; translate/rotate as a whole; do not scale\")\n\th:SetAttribute(\"MinimumEntrySeconds\",3.2)\n\tlocal railY=if courseAssembly then 17.5 else 13\n\tlocal curtainHeight=if courseAssembly then 9.5 else 5\n\th:SetAttribute(\"CurtainHeight\",curtainHeight)\n\th:SetAttribute(\"NozzleHeight\",railY-7)\n\tfor _,x in {-14,14} do\n\t\tfor _,z in {-74,-48} do Kit.Part(h,\"IrrigatorLeg\",f(x,(railY-3)/2,z),Vector3.new(0.65,railY+3,0.65),c.leaf,\"Blocker\") end\n\t\tKit.Part(h,\"IrrigatorTrack\",f(x,railY,-61),Vector3.new(0.7,0.7,28),c.leaf,\"Blocker\")\n\tend\n\tKit.Part(h,\"NozzleBase\",f(-16,8.2,-61),Vector3.new(3.5,2.4,3.5),c.gray,\"Blocker\")\n\tKit.Part(h,\"NozzleCap\",f(0,railY,-69),Vector3.new(28,0.75,0.75),c.gold,\"Decoration\")\n\tlocal jets=Kit.Group(h,\"WaterJets\",f(0,7,-61))\n\tfor i=0,12 do\n\t\tlocal jet=Kit.Part(jets,\"Jet_\"..i,f(-11.1+i*1.85,7.5+curtainHeight/2,-69),Vector3.new(0.28,curtainHeight,0.28),c.water,\"Decoration\",Enum.PartType.Cylinder)\n\t\tjet.Shape=Enum.PartType.Block; jet.Transparency=1; jet.CastShadow=false\n\t\tjet:SetAttribute(\"Across\",-11.1+i*1.85)\n\tend\n\tKit.Part(h,\"WarningLamp\",f(if courseAssembly then 22 else 15,10.5,-44),Vector3.new(1.7,1.7,1.7),c.lime,\"Decoration\",Enum.PartType.Ball)\n\tKit.Part(h,\"LampPost\",f(if courseAssembly then 22 else 15,8.5,-44),Vector3.new(0.5,4,0.5),c.wood,\"Blocker\")\n\tlocal water=Kit.Part(h,\"WaterSweep\",f(0,7.5+curtainHeight/2,-61),Vector3.new(24,curtainHeight,1.5),c.water,\"Hazard\")\n\twater.Transparency=1; water.CastShadow=false\n\th:SetAttribute(\"Warning\", \"Green permits entry; amber closes entry before the active rain curtain\")\n\th:SetAttribute(\"SafeWait\", \"DryWait and DryExitAndChoice are outside full sweep travel\")\n\tfor _,z in {-72,-50} do Kit.Part(h,\"WarningStripe\",f(0,7.46,z),Vector3.new(23.5,0.12,0.7),c.gold,\"Decoration\") end\n\tKit.Terrace(garden,\"BerryBank\",f(29,2,8),Vector3.new(19,5,35),\"Blocker\")\n\tKit.Terrace(garden,\"CarrotBank\",f(-35,2,22),Vector3.new(18,5,29),\"Blocker\")\n\tKit.Bed(garden,\"BerryBeds\",f(28,2.2,8),12,28,\"Berry\",imported)\n\tKit.Bed(garden,\"CarrotBeds\",f(-35,2.2,22),12,24,\"Carrot\",imported)\n\tKit.Bed(garden,\"FlowerBorder\",f(27,4,-83),8,24,\"Flower\",imported)\n\tKit.Bed(garden,\"TurnFlowers\",f(-86,3,-56),8,30,\"Flower\",imported)\n\tKit.Bed(garden,\"ChoiceBed\",f(-43,0,-68),12,15,\"Berry\",imported)\n\tKit.Bed(garden,\"BambooBed\",f(-47,0,-39),9,18,\"Carrot\",imported)\n\tfor i,p in {{23,-22},{-27,-90},{-79,-86},{-82,-23},{33,-53},{-17,36}} do\n\t\tif not courseAssembly or i~=4 then Kit.Bamboo(garden,\"Bamboo_\"..i,f(p[1],-2,p[2]),if i%2==0 then 16 else 19,imported) end\n\tend\n\tKit.Terrace(garden,\"PetBank\",f(28,3,35),Vector3.new(18,6,16),\"Blocker\")\n\tKit.Bunny(garden,\"Bunny\",f(25,3.2,34,-20))\n\tKit.Imported(garden,\"BunnyCarrot\",\"CarrotPair\",f(28,3.2,31),0.7)\n\tKit.Bed(garden,\"EntrySunflowers\",f(37,3,29),5,18,\"Flower\",imported)\n\tKit.Bed(garden,\"NearPotFlowers\",f(-25,2,-9),5,14,\"Flower\",imported)\n\tif not courseAssembly then\n\t\tKit.Fence(garden,\"EastFence\",f(40,-1,-17,90),125)\n\t\tKit.Fence(garden,\"NorthFence\",f(-19,-1,-103),117)\n\t\tKit.Fence(garden,\"WestFence\",f(-91,-1,-36,90),124)\n\tend\n\tKit.Terrace(garden,\"GroveBackdrop\",f(5,0,-107),Vector3.new(54,3,24),\"Blocker\")\n\tKit.CandyTree(garden,\"CandyView_A\",f(13,0,-108,15),1.05)\n\tKit.CandyTree(garden,\"CandyView_B\",f(41,-1,-44,-25),0.95)\n\tKit.CandyTree(garden,\"CandyView_C\",f(-87,-1,-8,45),0.85)\n\tfor i,p in {{42,2,18,25},{44,1,2,-30},{38,0,-13,70},{-44,2,31,110},{-45,2,15,65},{-42,1,-1,0},{24,3,32,-30}} do\n\t\tif not courseAssembly then Kit.Imported(garden,\"LowLeafLayer_\"..i,\"BroadLeaf\",f(p[1],p[2],p[3],p[4]),0.72) end\n\tend\n\tfor i,p in {{43,-1,22,16},{42,-1,-5,19},{-49,-1,24,17},{-46,-1,2,20}} do Kit.Bamboo(garden,\"LayeredBamboo_\"..i,f(p[1],p[2],p[3],i*40),p[4],true) end\n\tfor _,bridge in {route.BambooWest,route.BambooTurn,route.BambooSouth,route.BambooReturn,route.SprinklerBridge} do\n\t\tlocal pivot=bridge:GetPivot()\n\t\tfor _,x in {-4,4} do for _,z in {-5,5} do\n\t\t\tlocal top=pivot:PointToWorldSpace(Vector3.new(x,-1,z)); local bottom=origin.Y-2.8\n\t\t\tKit.Part(bridge,\"GroundedLeg\",CFrame.new(top.X,(top.Y+bottom)/2,top.Z),Vector3.new(0.9,top.Y-bottom,0.9),c.wood,\"Blocker\")\n\t\tend end\n\tend\n\tfor _,object in {route.DryWait,route.SprinklerBridge,route.DryExitAndChoice,garden.WarningSign} do object.Parent=h end\n\tfor i,p in {{-4,0,48},{0,6.4,25},{-8,7.4,-5},{0,7.4,-34},{0,7.4,-61},{0,7.4,-85},{-30,7.4,-85},{-54,8.4,-80},{-68,8.4,-58},{-65,7.4,-32},{-47,7.4,-12}} do\n\t\tlocal marker=Kit.Part(markers,string.format(\"Main_%02d\",i),f(p[1],p[2],p[3]),Vector3.one,c.white,\"Marker\")\n\t\tmarker.Transparency=1\n\tend\n\treturn m\nend\n\nfunction Prototype.Outline(parent: Instance): Model\n\tassert(not parent:FindFirstChild(\"SGV2_Outline_O02\"),\"Preserve the existing outline\")\n\tlocal origin=Prototype.OutlineOrigin\n\tlocal m=Kit.Group(parent,\"SGV2_Outline_O02\",CFrame.new(origin))\n\tm:SetAttribute(\"CandidateId\",\"SGV2_O02\")\n\tm:SetAttribute(\"StudyOnly\",true)\n\tm:SetAttribute(\"EvidenceLimit\",\"Spatial and relationship study only; blocks are not playable obstacles\")\n\tlocal regions={\n\t\t{\"G1_SeedShop\",-90,0,105,170,123,c.rim},\n\t\t{\"G2_CropGarden\",-90,1,-69,170,196,c.grass},\n\t\t{\"G3_CandyGrove\",93,4,-108,168,118,c.aqua},\n\t\t{\"G4_LowerVine\",93,8,18,168,110,c.lime},\n\t\t{\"G5_Festival\",86,6,125,182,82,c.gold},\n\t}\n\tKit.Part(m,\"Envelope\",CFrame.new(origin+Vector3.new(0,-5,0)),Vector3.new(370,2,354),c.soil,\"Decoration\")\n\tfor _,r in regions do\n\t\tlocal p=Kit.Part(m,r[1],CFrame.new(origin+Vector3.new(r[2],r[3]-1,r[4])),Vector3.new(r[5],2,r[6]),r[7],\"Decoration\")\n\t\tp:SetAttribute(\"AreaId\",string.sub(r[1],1,2))\n\t\tKit.Sign(m,r[1]..\"Label\",CFrame.new(origin+Vector3.new(r[2],r[3],r[4])),string.gsub(r[1],\"_\",\"\\n\"),r[7])\n\tend\n\tlocal route={{-143,1,145},{-48,1,145},{-48,1,114},{-135,1,114},{-135,1,79},{-64,1,79},{-64,2,45},{-56,2,28},{-56,2,3},{-64,2,-25},{-56,2,-49},{-56,2,-73},{-56,2,-97},{-86,2,-97},{-110,2,-92},{-124,2,-70},{-121,2,-44},{-103,2,-24},{-145,2,-24},{-159,3,-65},{-159,3,-123},{-133,3,-148},{-78,3,-148},{-18,4,-139},{38,5,-139},{67,5,-157},{139,5,-151},{149,5,-119},{115,5,-109},{87,5,-88},{29,5,-103},{23,5,-70},{76,6,-57},{79,9,-34},{133,9,-29},{144,9,14},{153,9,58},{113,9,64},{86,9,52},{66,9,26},{37,9,16},{19,9,48},{38,9,77},{53,7,92},{141,7,98},{150,7,140},{115,7,158},{50,7,148},{22,7,114},{67,7,113},{90,7,136}}\n\tfor i=1,#route-1 do\n\t\tlocal a,b=Vector3.new(table.unpack(route[i])),Vector3.new(table.unpack(route[i+1]))\n\t\tlocal p=Kit.Part(m,string.format(\"RouteStudy_%02d\",i),CFrame.lookAt(origin+(a+b)/2,origin+b),Vector3.new(6,0.4,(b-a).Magnitude),c.cream,\"Decoration\")\n\t\tp:SetAttribute(\"StudyOrder\",i)\n\tend\n\tfor branch,points in {{{-56,3,-97},{-76,3,-81},{-82,3,-71.5},{-82,3,-59},{-92.5,3,-51},{-94,3,-39},{-103,3,-24}},{{144,10,14},{118,10,8},{97,10,9},{71,10,10},{48,10,12},{37,10,16}}} do\n\t\tfor i=1,#points-1 do\n\t\t\tlocal a,b=Vector3.new(table.unpack(points[i])),Vector3.new(table.unpack(points[i+1]))\n\t\t\tKit.Part(m,\"ExpertStudy_\"..branch..\"_\"..i,CFrame.lookAt(origin+(a+b)/2,origin+b),Vector3.new(2,0.5,(b-a).Magnitude),c.gold,\"Decoration\")\n\t\tend\n\tend\n\tfor _,r in {{\"SeedShopMass\",-96,12,164,44,20,12},{\"CandyCrownMass\",86,23,-117,48,18,42},{\"VineMass\",96,24,6,16,44,16},{\"FestivalAwning\",80,15,167,44,12,10}} do\n\t\tKit.Part(m,r[1],CFrame.new(origin+Vector3.new(r[2],r[3],r[4])),Vector3.new(r[5],r[6],r[7]),c.cream,\"Decoration\")\n\tend\n\treturn m\nend\n\nreturn Prototype\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","Runtime"],"source":"--!strict\n\nlocal RunService=game:GetService(\"RunService\")\nlocal Players=game:GetService(\"Players\")\nlocal Geometry=require(game.ReplicatedStorage.Shared.ShipwreckHazards)\nlocal Phase=require(game.ServerStorage.CourseBuilders.StudGarden.HazardState)\nlocal Wayfinding=require(script.Parent.Wayfinding)\nlocal HazardClock=require(script.Parent.HazardClock)\nlocal Runtime={}\n\nfunction Runtime.Start(course: Model, eligible: (Player)->boolean, recover: (Player,string)->boolean)\n\tassert(RunService:IsServer() and RunService:IsRunning(),\"Runtime server required\")\n\tassert(course:GetAttribute(\"SGV2Owned\")==true,\"V2 course required\")\n\tassert(course:GetAttribute(\"SGV2RuntimeActive\")~=true,\"Runtime is already active\")\n\tlocal hazard=course:FindFirstChild(\"H1_Sprinkler\") :: Model\n\tassert(hazard and hazard:IsA(\"Model\"),\"Sprinkler assembly required\")\n\tassert(math.abs(hazard:GetScale()-1)<0.001,\"Move/rotate the complete encounter; scaling is not supported\")\n\tlocal water=hazard:FindFirstChild(\"WaterSweep\") :: BasePart\n\tlocal lamp=hazard:FindFirstChild(\"WarningLamp\") :: BasePart\n\tlocal nozzle=hazard:FindFirstChild(\"NozzleCap\") :: BasePart\n\tlocal jets=hazard:FindFirstChild(\"WaterJets\")\n\tassert(water and lamp and nozzle,\"Hazard visuals required\")\n\tlocal frame=hazard:GetPivot()\n\tlocal curtainCenter=.5+water.Size.Y/2\n\tlocal nozzleHeight=hazard:GetAttribute(\"NozzleHeight\") or 6\n\tlocal timing={Clear=hazard:GetAttribute(\"ClearSeconds\") or 6.5,Warning=hazard:GetAttribute(\"WarningSeconds\") or 1.5,Active=hazard:GetAttribute(\"ActiveSeconds\") or 2}\n\tassert(timing.Clear>=5 and timing.Warning>=1.2 and timing.Active>0,\"Keep a usable clear window and warning\")\n\tlocal original={water=water.CFrame,transparency=water.Transparency,lamp=lamp.Color,nozzle=nozzle.CFrame}\n\tlocal originalJets={}\n\tif jets then for _,jet in jets:GetChildren() do\n\t\tif jet:IsA(\"BasePart\") then table.insert(originalJets,{part=jet,frame=jet.CFrame,transparency=jet.Transparency}) end\n\tend end\n\tlocal originalStatus=Wayfinding.CaptureStatus(hazard)\n\tlocal clock=HazardClock.New(workspace:GetServerTimeNow())\n\tlocal cooldowns: {[Player]: number}={}\n\tlocal diagnostics={steps=0,contacts=0,recoveries=0,pausedStalls=0,maxStepMs=0}\n\tcourse:SetAttribute(\"SGV2RuntimeActive\",true)\n\tlocal function sweep(alpha: number): CFrame\n\t\treturn frame*CFrame.new(0,curtainCenter,-8+16*alpha)\n\tend\n\tlocal function step()\n\t\tlocal before=os.clock()\n\t\tlocal lastElapsed,elapsed,advanced=HazardClock.Step(clock,workspace:GetServerTimeNow())\n\t\tif not advanced then diagnostics.pausedStalls=clock.pausedStalls;return end\n\t\tlocal phase,alpha=Phase.Phase(elapsed,timing)\n\t\twater.CFrame=sweep(if phase==\"Active\" then alpha else 0)\n\t\twater.Transparency=if phase==\"Active\" then 0.78 else 1\n\t\tlocal remaining=if phase==\"Clear\" then timing.Clear*(1-alpha) else 0\n\t\tlocal entryOpen=Wayfinding.UpdateHazard(hazard,\"SPRINKLER\",phase,alpha,timing,hazard:GetAttribute(\"MinimumEntrySeconds\") or 3.2)\n\t\tnozzle.CFrame=frame*CFrame.new(0,nozzleHeight,-8+16*(if phase==\"Active\" then alpha else 0))\n\t\tif jets then for _,jet in jets:GetChildren() do\n\t\t\tif jet:IsA(\"BasePart\") then\n\t\t\t\tjet.CFrame=frame*CFrame.new(jet:GetAttribute(\"Across\"),curtainCenter,-8+16*(if phase==\"Active\" then alpha else 0))\n\t\t\t\tjet.Transparency=if phase==\"Active\" then 0.16 else 1\n\t\t\tend\n\t\tend end\n\t\thazard:SetAttribute(\"Phase\",phase)\n\t\thazard:SetAttribute(\"PhaseAlpha\",alpha)\n\t\thazard:SetAttribute(\"ClearRemaining\",if phase==\"Clear\" then timing.Clear*(1-alpha) else 0)\n\t\thazard:SetAttribute(\"EntryOpen\",entryOpen)\n\t\tdo\n\t\t\tlocal intervals=Phase.ActiveIntervals(lastElapsed,elapsed,timing)\n\t\t\tif #intervals>0 then for _,player in Players:GetPlayers() do\n\t\t\t\tlocal character=player.Character\n\t\t\t\tlocal hum=character and character:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\tif character and hum and hum.Health>0 and eligible(player) and (cooldowns[player] or 0)<elapsed then\n\t\t\t\t\tlocal hit=false\n\t\t\t\t\tfor _,body in character:GetChildren() do\n\t\t\t\t\t\tif body:IsA(\"BasePart\") and body.Name~=\"HumanoidRootPart\" then\n\t\t\t\t\t\t\tfor _,interval in intervals do\n\t\t\t\t\t\t\t\tdiagnostics.contacts+=1\n\t\t\t\t\t\t\t\tif Geometry.SweptBoxesIntersect(sweep(interval[1]),sweep(interval[2]),water.Size,body.CFrame,body.Size) then hit=true; break end\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\t\tif hit then break end\n\t\t\t\t\tend\n\t\t\t\t\tif hit then\n\t\t\t\t\t\tcooldowns[player]=elapsed+1\n\t\t\t\t\t\tif recover(player,\"SGV2_H1\") then diagnostics.recoveries+=1 end\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend end\n\t\tend\n\t\tdiagnostics.steps+=1\n\t\tdiagnostics.maxStepMs=math.max(diagnostics.maxStepMs,(os.clock()-before)*1000)\n\tend\n\tlocal connection=RunService.Heartbeat:Connect(step)\n\tlocal stopped=false\n\treturn {\n\t\tDiagnostics=function() return table.clone(diagnostics) end,\n\t\tStop=function()\n\t\t\tif stopped then return end\n\t\t\tstopped=true; connection:Disconnect()\n\t\t\twater.CFrame=original.water; water.Transparency=original.transparency\n\t\t\tlamp.Color=original.lamp; nozzle.CFrame=original.nozzle\n\t\t\tWayfinding.RestoreStatus(originalStatus)\n\t\t\tfor _,saved in originalJets do\n\t\t\t\tif saved.part.Parent then saved.part.CFrame=saved.frame;saved.part.Transparency=saved.transparency end\n\t\t\tend\n\t\t\thazard:SetAttribute(\"Phase\",nil); hazard:SetAttribute(\"PhaseAlpha\",nil); hazard:SetAttribute(\"ClearRemaining\",nil)\n\t\t\thazard:SetAttribute(\"EntryOpen\",nil)\n\t\t\tcourse:SetAttribute(\"SGV2RuntimeActive\",nil)\n\t\tend,\n\t}\nend\n\nreturn Runtime\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","SeedCourse"],"source":"--!strict\n\nlocal Kit=require(script.Parent.Kit)\nlocal S=require(script.Parent.Structures)\nlocal P=require(script.Parent.CourseParts)\nlocal SeedCourse={}\n\nfunction SeedCourse.Build(parent: Instance,markers: Instance)\n\tlocal m=Kit.Group(parent,\"G1_SeedShop\",CFrame.new(P.Origin))\n\tP.Terrace(m,\"StartGarden\",-145,4.24,144,30,52)\n\tfor i,z in {132,157} do S.Wheelbarrow(m,\"OpeningCart_\"..i,P.Frame(-111,-1,z,-90)) end\n\tP.Table(m,\"CommonPottingDeck\",-81,6.24,144,26,50)\n\tP.Table(m,\"ToolSetup\",-57,6.24,149,22,13)\n\tS.Tool(m,\"TrowelClimb\",P.Frame(-47,5.84,107),\"Trowel\")\n\tP.Terrace(m,\"BladeTurn\",-64,6.74,75,28,12)\n\tS.Tool(m,\"ForkCrossing\",P.Frame(-113,6.44,75,90),\"Fork\")\n\tP.Table(m,\"SeedSorting\",-152,7.3,78,26,30)\n\tS.Crate(m,\"TallSeedCrate\",P.Frame(-143,3.3,51),22,16,5)\n\tS.Crate(m,\"SideSeedCrate\",P.Frame(-117,3.3,53),18,20,5)\n\tP.Table(m,\"SeedBench\",-91,7.4,52,26,20)\n\tP.Table(m,\"GardenEntryBench\",-67,6.4,50,18,22)\n\tS.SeedShop(m,\"SeedShopLandmark\",P.Frame(-92,-2.8,169))\n\tKit.Sign(m,\"EntrySign\",P.Frame(-162,4,116,-90),\"TWO CARTS\\nBoth lead onward\",Kit.Colors.cream)\n\tfor _,r in {{-143,4.24,130,-90},{-80,6.24,143,-90},{-47,6.24,131,0},{-64,6.74,75,90},{-150,7.3,72,0},{-119,8.3,53,-90},{-66,6.4,47,0}} do P.Arrow(m,table.unpack(r)) end\n\tlocal left={{-145,4.24,132},{-128,4.2,132},{-118,4.2,132},{-109,4.2,132},{-99,6.2,132},{-90,6.24,132},{-80,6.24,144}}\n\tlocal right={{-145,4.24,157},{-128,4.2,157},{-118,4.2,157},{-109,4.2,157},{-99,6.2,157},{-90,6.24,157},{-80,6.24,144}}\n\tP.Path(markers,\"G1_OpeningLeft\",left,\"Opening\")\n\tP.Path(markers,\"G1_OpeningRight\",right,\"Opening\")\n\tP.Path(markers,\"G1_Tools\",{{-80,6.24,144},{-60,6.24,149},{-48,6.24,144},{-47,6.24,137},{-51.6,6.24,131},{-51.6,6.24,125},{-47,6.24,116},{-47,6.14,103},{-47,6.14,93},{-48,6.14,87},{-54,6.74,79},{-73,6.74,75},{-84,6.84,75},{-96,6.84,75},{-114,6.74,75},{-132,6.74,75},{-143,7.3,75},{-152,7.3,78},{-145,7.3,65},{-143,8.3,56},{-135,8.3,51},{-121,8.3,53},{-109,8.3,53},{-96,7.4,52},{-81,7.4,52},{-66,6.4,50},{-60,6.4,41},{-56,4.24,33},{-56,4.24,28}},\"Main\")\n\treturn m\nend\n\nreturn SeedCourse\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","Structures"],"source":"--!strict\n\nlocal Kit=require(script.Parent.Kit)\nlocal c=Kit.Colors\nlocal Structures={}\n\nlocal function unit(parent: Instance,name: string,frame: CFrame,family: string,mount: string)\n\tlocal m=Kit.Group(parent,name,frame)\n\tm:SetAttribute(\"AssetFamily\",family); m:SetAttribute(\"Mount\",mount)\n\tlocal function part(n: string,x: number,y: number,z: number,sx: number,sy: number,sz: number,color: Color3,role: string?,rotation: CFrame?,shape: Enum.PartType?)\n\t\treturn Kit.Part(m,n,frame*CFrame.new(x,y,z)*(rotation or CFrame.identity),Vector3.new(sx,sy,sz),color,role,shape)\n\tend\n\treturn m,part\nend\n\nfunction Structures.Tool(parent: Instance,name: string,frame: CFrame,kind: string): Model\n\tlocal m,b=unit(parent,name,frame,\"GardenTool_\"..kind,\"Blade/neck topY0.3; handle/grip topY0.4; handle points +Z\")\n\tif kind==\"Trowel\" then\n\t\tb(\"BladeShoulder\",0,0,-4,18,.6,12,c.gray,\"Walk\")\n\t\tfor _,vertices in {{{-9,0,-10},{9,0,-10},{0,0,-22}}} do\n\t\t\tKit.Triangle(m,\"PointedBlade\",frame*Vector3.new(table.unpack(vertices[1])),frame*Vector3.new(table.unpack(vertices[2])),frame*Vector3.new(table.unpack(vertices[3])),.6,c.gray,\"Walk\")\n\t\tend\n\t\tb(\"BladeRib\",0,.34,-5,.55,.12,13,c.white)\n\telse\n\t\tb(\"ForkShoulder\",0,0,-4,22,.6,6,c.gray,\"Walk\")\n\t\tfor i=-1,1 do b(\"ForkTine\",i*8,0,-14.5,5,.6,15,c.gray,\"Walk\") end\n\tend\n\tb(\"Neck\",0,0,if kind==\"Trowel\" then 5.5 else 4,10,.6,if kind==\"Trowel\" then 7 else 10,c.gray,\"Walk\")\n\tb(\"WoodHandle\",0,.05,16,9,.7,14,c.wood,\"Walk\")\n\tb(\"GripLeft\",-4.6,.05,26.25,3.2,.7,6.5,c.honey,\"Walk\")\n\tb(\"GripRight\",4.6,.05,26.25,3.2,.7,6.5,c.honey,\"Walk\")\n\tb(\"GripEnd\",0,.05,30.5,12.4,.7,2,c.honey,\"Walk\")\n\tfor _,z in {-5,10,23} do b(\"Trestle\",0,-2.4,z,7,4.2,2,c.wood,\"Blocker\") end\n\treturn m\nend\n\nfunction Structures.Wheelbarrow(parent: Instance,name: string,frame: CFrame): Model\n\tlocal m,b=unit(parent,name,frame,\"Wheelbarrow\",\"Ground at0; bowl floor top5.2, rim top7.4; handles toward +Z\")\n\tb(\"BowlFloor\",0,4.8,0,19,.8,24,c.leaf,\"Walk\")\n\tfor _,s in {-1,1} do\n\t\tb(\"BowlSide\",s*10.2,6.1,0,1.1,2.6,25,c.grass,\"Blocker\",CFrame.Angles(0,0,-s*.16))\n\t\tb(\"RimRail\",s*10.5,7.1,0,3,.6,25.5,c.lime,\"Walk\")\n\t\tb(\"Handle\",s*7,4.85,20,4,.7,18,c.wood,\"Walk\")\n\t\tb(\"Grip\",s*7,5.25,27,4.3,.12,4.7,c.honey)\n\t\tb(\"Leg\",s*7,2.2,7,1.2,4.4,1.3,c.leaf,\"Blocker\")\n\t\tb(\"WheelFork\",s*1.8,2.5,-12,1,1.2,12,c.leaf,\"Blocker\",CFrame.Angles(math.rad(-15),0,0))\n\tend\n\tb(\"FrontLip\",0,6,-12,21,2.4,1,c.grass,\"Blocker\")\n\tb(\"LowEntryLip\",0,5.15,12,19,.3,1.2,c.lime,\"Walk\")\n\tb(\"Wheel\",0,2.6,-15,2.6,5.2,5.2,c.dark,\"Blocker\",nil,Enum.PartType.Cylinder)\n\tb(\"Hub\",0,2.6,-15,3,1.6,1.6,c.gold,\"Decoration\",nil,Enum.PartType.Cylinder)\n\treturn m\nend\n\nfunction Structures.Crate(parent: Instance,name: string,frame: CFrame,width: number,depth: number,height: number,open: boolean?): Model\n\tlocal m,b=unit(parent,name,frame,\"HarvestCrate\",if open then \"Ground bottom; open floor top0.8\" else \"Ground bottom; closed walkable top at height\")\n\tb(\"Floor\",0,.4,0,width,.8,depth,c.wood,\"Walk\")\n\tlocal wallBottom=.82\n\tlocal wallTop=if open then height else height-.82\n\tlocal wallHeight=wallTop-wallBottom\n\tfor _,s in {-1,1} do\n\t\tfor _,fraction in {.2,.8} do\n\t\t\tlocal y=wallBottom+wallHeight*fraction\n\t\t\tb(\"SideSlat\",s*(width/2-.35),y,0,.7,wallHeight*.35,depth-2.4,c.honey,\"Blocker\")\n\t\t\tb(\"EndSlat\",0,y,s*(depth/2-.35),width-2.4,wallHeight*.35,.7,c.wood,\"Blocker\")\n\t\tend\n\t\tfor _,z in {-1,1} do b(\"Corner\",s*(width/2-.6),(wallBottom+wallTop)/2,z*(depth/2-.6),1.2,wallHeight,1.2,c.honey,\"Blocker\") end\n\tend\n\tif not open then\n\t\tlocal count=math.ceil(width/3)\n\t\tfor i=1,count do b(\"LidPlank\",(i-(count+1)/2)*width/count,height-.4,0,width/count-.04,.8,depth,c.wood,\"Walk\") end\n\tend\n\treturn m\nend\n\nfunction Structures.Wagon(parent: Instance,name: string,frame: CFrame,shortDrawbar: boolean?): Model\n\tlocal m,b=unit(parent,name,frame,\"HarvestWagon\",\"Ground0; cargo deck top5.4; front toward -Z\")\n\tKit.Plank(m,\"CargoDeck\",frame*CFrame.new(0,5,0),22,30)\n\tfor _,s in {-1,1} do\n\t\tfor _,z in {-9,9} do\n\t\t\tb(\"Wheel\",s*11,2.5,z,1.5,5,5,c.soil,\"Blocker\",nil,Enum.PartType.Cylinder)\n\t\t\tb(\"WheelHub\",s*11.85,2.5,z,.3,1.5,1.5,c.honey,\"Decoration\",nil,Enum.PartType.Cylinder)\n\t\tend\n\t\tb(\"SideRail\",s*11,7,0,.8,1.1,30,c.wood,\"Blocker\")\n\t\tfor _,z in {-12,0,12} do b(\"Upright\",s*11,5.6,z,.8,1.7,.8,c.honey,\"Blocker\") end\n\tend\n\tb(\"Drawbar\",0,3.3,if shortDrawbar then -17 else -21,if shortDrawbar then 3 else 4.5,1.2,if shortDrawbar then 4 else 15,c.wood,\"Walk\")\n\tb(\"DrawbarGrip\",0,3.3,if shortDrawbar then -19.5 else -30,if shortDrawbar then 8 else 12,1.2,if shortDrawbar then 1 else 3,c.honey,\"Walk\")\n\treturn m\nend\n\nfunction Structures.Workbench(parent: Instance,name: string,frame: CFrame,width: number,depth: number,height: number): Model\n\tlocal m,b=unit(parent,name,frame,\"PottingWorkbench\",\"Ground0; top at specified height plus0.4\")\n\tKit.Plank(m,\"TableTop\",frame*CFrame.new(0,height,0),width,depth)\n\tfor _,s in {-1,1} do for _,t in {-1,1} do b(\"Leg\",s*(width/2-1.7),height/2,t*(depth/2-1.5),1.6,height,1.6,c.wood,\"Blocker\") end end\n\tb(\"LowBrace\",0,1.4,0,width-3,1.3,2,c.honey,\"Blocker\")\n\treturn m\nend\n\nfunction Structures.Awning(parent: Instance,name: string,frame: CFrame,width: number,depth: number,theme: string): Model\n\tlocal m,b=unit(parent,name,frame,\"Awning_\"..theme,\"Ground center; open front -Z; lowest valance edgeY12.1\")\n\tlocal color=if theme==\"SeedShop\" then c.grass else c.terra\n\tfor _,s in {-1,1} do for _,z in {-1,1} do b(\"Post\",s*(width/2-1),6.5,z*(depth/2-1),1.1,13,1.1,c.wood,\"Blocker\") end end\n\tlocal count=math.ceil(width/4)\n\tfor i=1,count do\n\t\tlocal x=(i-(count+1)/2)*width/count\n\t\tb(\"RoofStripe\",x,14,0,width/count-.03,.65,depth+3,if i%2==0 then c.cream else color,\"Decoration\",CFrame.Angles(math.rad(7),0,0))\n\t\tb(\"Valance\",x,12.9,-depth/2-1.4,width/count-.03,1.6,.45,if i%2==0 then c.cream else color)\n\tend\n\treturn m\nend\n\nfunction Structures.SeedShop(parent: Instance,name: string,frame: CFrame): Model\n\tlocal m,b=unit(parent,name,frame,\"SeedShop\",\"Ground center; customer front -Z; scenery stall\")\n\tStructures.Awning(m,\"StripedAwning\",frame,36,18,\"SeedShop\")\n\tb(\"BackPanel\",0,5.5,7,34,11,1,c.cream,\"Blocker\")\n\tStructures.Workbench(m,\"Counter\",frame*CFrame.new(0,0,0),31,6,4)\n\tfor i=1,7 do\n\t\tb(\"SeedPacket\",(i-4)*4,6.4,6.3,2.9,4,.3,if i%3==0 then c.gold elseif i%3==1 then c.terra else c.aqua)\n\t\tb(\"PacketEmblem\",(i-4)*4,6.4,6.09,1.2,1.5,.18,if i%3==0 then c.gold elseif i%3==1 then c.orange else c.pink)\n\t\tb(\"PacketLeaf\",(i-4)*4,7.4,6.09,1.3,.4,.18,c.leaf)\n\tend\n\tlocal board=b(\"ShopSign\",0,10.2,-10.5,20,3,.5,c.cream)\n\tfor _,s in {-1,1} do b(\"SignHanger\",s*8,12,-10.3,.25,3,.25,c.wood) end\n\tlocal gui=Instance.new(\"SurfaceGui\");gui.Face=Enum.NormalId.Front;gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud;gui.PixelsPerStud=40;gui.Parent=board\n\tlocal label=Instance.new(\"TextLabel\");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.Text=\"STUD GARDEN\\nSeeds & supplies\";label.TextColor3=c.dark;label.TextScaled=true;label.Font=Enum.Font.GothamBold;label.Parent=gui\n\tStructures.Crate(m,\"SeedStock\",frame*CFrame.new(-13,4.4,-.3),5,4,2.5,true)\n\treturn m\nend\n\nfunction Structures.FinishArch(parent: Instance,name: string,frame: CFrame): Model\n\tlocal m,b=unit(parent,name,frame,\"HarvestFinishArch\",\"Ground center;31wide between foot blocks; lintel bottomY14.9; front -Z\")\n\tfor _,s in {-1,1} do\n\t\tb(\"Foot\",s*18,1.5,0,5,3,6,c.terra,\"Blocker\")\n\t\tb(\"Post\",s*18,8,0,2,14,2,c.wood,\"Blocker\")\n\t\tb(\"Cap\",s*18,16,0,4,1.3,4,c.honey)\n\t\tfor i=1,3 do b(\"GarlandLeaf\",s*18+s*1.1,3+i*3,-1.2,3.2,.4,1.7,c.lime,\"Decoration\",CFrame.Angles(0,0,s*.5)) end\n\tend\n\tb(\"Lintel\",0,16,0,38,2.2,2,c.honey,\"Blocker\")\n\tlocal board=b(\"FinishBoard\",0,16.2,-1.3,22,4,.45,c.cream)\n\tlocal gui=Instance.new(\"SurfaceGui\"); gui.Face=Enum.NormalId.Front; gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud; gui.PixelsPerStud=35; gui.Parent=board\n\tlocal label=Instance.new(\"TextLabel\"); label.Size=UDim2.fromScale(1,1); label.BackgroundTransparency=1; label.Font=Enum.Font.GothamBold; label.TextScaled=true; label.TextColor3=c.dark; label.Text=\"HARVEST FINISH\"; label.Parent=gui\n\treturn m\nend\n\nfunction Structures.Bunting(parent: Instance,name: string,frame: CFrame,length: number): Model\n\tlocal m,b=unit(parent,name,frame,\"FestivalBunting\",\"Ground endpoints; line at12-14studs; decoration overhead\")\n\tfor _,s in {-1,1} do b(\"Pole\",s*length/2,7,0,.65,14,.65,c.wood,\"Blocker\") end\n\tlocal count=math.ceil(length/4)\n\tfor i=1,count do\n\t\tlocal x=(i-(count+1)/2)*length/count\n\t\tlocal y=12+2*(math.abs(x)/(length/2))^2\n\t\tb(\"String\",x,y,0,length/count+.1,.12,.12,c.soil)\n\t\tKit.Triangle(m,\"Pennant\",frame*Vector3.new(x-1.35,y,0),frame*Vector3.new(x+1.35,y,0),frame*Vector3.new(x,y-2.5,0),.12,({c.terra,c.gold,c.lime,c.aqua})[(i-1)%4+1],\"Decoration\")\n\tend\n\treturn m\nend\n\nreturn Structures\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","Study"],"source":"--!strict\n\nlocal Study={}\nlocal RunService=game:GetService(\"RunService\")\nlocal Http=game:GetService(\"HttpService\")\n\nfunction Study.StartServer(course: Model)\n\tassert(RunService:IsStudio() and RunService:IsServer() and RunService:IsRunning(),\"Owned Studio test only\")\n\tassert(course:GetAttribute(\"StudyOnly\")==true,\"Representative sample required\")\n\tassert(not game.ServerStorage:FindFirstChild(\"SGV2StudySession\"),\"Preserve existing session\")\n\tlocal session=Instance.new(\"Folder\"); session.Name=\"SGV2StudySession\"; session.Parent=game.ServerStorage\n\tlocal player=game.Players:GetPlayers()[1]\n\tassert(player and player.Character,\"Player required\")\n\tlocal origin=course:GetAttribute(\"CourseOrigin\") :: Vector3\n\tlocal savedCF=player.Character:GetPivot()\n\tlocal recoveries=0\n\tcourse:SetAttribute(\"StudyRecoveries\",0)\n\tlocal checkpoint=Vector3.new(0,4.24,40)\n\tlocal lastRecovery=-math.huge\n\tlocal function place(position: Vector3)\n\t\tlocal character=player.Character :: Model\n\t\tlocal root=character:FindFirstChild(\"HumanoidRootPart\") :: BasePart\n\t\tlocal hum=character:FindFirstChildOfClass(\"Humanoid\") :: Humanoid\n\t\tcharacter:PivotTo(CFrame.new(origin+position+Vector3.yAxis*(hum.HipHeight+root.Size.Y/2+0.3)))\n\t\troot.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero\n\tend\n\tlocal function recover(p: Player,reason: string): boolean\n\t\tif p~=player or os.clock()-lastRecovery<1 then return false end\n\t\tlastRecovery=os.clock(); recoveries+=1\n\t\tplace(checkpoint)\n\t\tsession:SetAttribute(\"Recoveries\",recoveries); session:SetAttribute(\"LastRecovery\",reason)\n\t\tcourse:SetAttribute(\"StudyRecoveries\",recoveries)\n\t\treturn true\n\tend\n\tlocal runtime=require(script.Parent.Runtime).Start(course,function(p: Player) return p==player end,recover)\n\tlocal monitor=RunService.Heartbeat:Connect(function()\n\t\tlocal char=player.Character\n\t\tlocal root=char and char:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\t\tif root then\n\t\t\tlocal localPos=root.Position-origin\n\t\t\tif localPos.Y<2 and localPos.X>-105 and localPos.X<55 and localPos.Z>-115 and localPos.Z<60 then recover(player,\"SampleMiss\") end\n\t\tend\n\tend)\n\tlocal command=Instance.new(\"BindableFunction\"); command.Name=\"Command\"; command.Parent=session\n\tcommand.OnInvoke=function(action: string,payload: any)\n\t\tif action==\"Place\" then place(Vector3.new(table.unpack(payload))); return true end\n\t\tif action==\"Checkpoint\" then checkpoint=Vector3.new(table.unpack(payload)); return true end\n\t\tif action==\"Recover\" then return recover(player,\"DeliberateMiss\") end\n\t\tif action==\"Report\" then return {candidate=course:GetAttribute(\"CandidateId\"),recoveries=recoveries,hazard=runtime.Diagnostics(),phase=course.H1_Sprinkler:GetAttribute(\"Phase\")} end\n\t\tif action==\"Stop\" then runtime.Stop(); monitor:Disconnect(); player.Character:PivotTo(savedCF); return true end\n\t\terror(\"Unknown study action\")\n\tend\n\tplace(checkpoint)\n\treturn {candidate=course:GetAttribute(\"CandidateId\"),player=player.Name,scope=\"Single-player Studio sample; no race progress or duration proof\"}\nend\n\nfunction Study.RunClient(course: Model, commands: {any}, name: string)\n\tassert(RunService:IsStudio() and RunService:IsClient(),\"Studio client required\")\n\tlocal player=game.Players.LocalPlayer\n\tlocal char=player.Character :: Model\n\tlocal hum=char:FindFirstChildOfClass(\"Humanoid\") :: Humanoid\n\tlocal root=char:FindFirstChild(\"HumanoidRootPart\") :: BasePart\n\tassert(hum.WalkSpeed==16 and not hum.UseJumpPower and math.abs(hum.JumpHeight-7.2)<0.001,\"Normal movement required\")\n\tlocal controls=require(player.PlayerScripts.PlayerModule):GetControls()\n\tlocal previous=controls.controlsEnabled\n\tassert(type(previous)==\"boolean\",\"Expected control state\")\n\tlocal folder=Instance.new(\"Folder\"); folder.Name=\"SGV2_\"..name; folder.Parent=player.PlayerScripts\n\tlocal result=Instance.new(\"StringValue\"); result.Name=\"Result\"; result.Parent=folder\n\tlocal origin=course:GetAttribute(\"CourseOrigin\") :: Vector3\n\tlocal report={candidate=course:GetAttribute(\"CandidateId\"),name=name,status=\"Running\",evidence=\"Scripted normal-control Studio movement; not human gameplay\",reached={},jumps=0,elapsed=0,controlsRestored=false}\n\tlocal params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Include; params.FilterDescendantsInstances={course}; params.RespectCanCollide=true\n\tlocal started=os.clock()\n\tlocal initialRecoveries=course:GetAttribute(\"StudyRecoveries\") or 0\n\ttask.spawn(function()\n\t\tcontrols:Disable()\n\t\tlocal ok,err=xpcall(function()\n\t\t\tfor index,command in commands do\n\t\t\t\tlocal target=origin+Vector3.new(table.unpack(command.position))\n\t\t\t\tlocal timeout=os.clock()+12\n\t\t\t\tlocal jumped=false\n\t\t\t\tlocal wrongSupportSince: number?=nil\n\t\t\t\twhile true do\n\t\t\t\t\tlocal delta=(target-root.Position)*Vector3.new(1,0,1)\n\t\t\t\t\tlocal hit=workspace:Raycast(root.Position,Vector3.new(0,-6,0),params)\n\t\t\t\t\t-- Feet can straddle plank seams while the root-center ray passes through them.\n\t\t\t\t\tif not hit or math.abs(hit.Position.Y-target.Y)>=0.3 then\n\t\t\t\t\t\tfor _,offset in {Vector3.new(.35,0,0),Vector3.new(-.35,0,0),Vector3.new(0,0,.35),Vector3.new(0,0,-.35)} do\n\t\t\t\t\t\t\tlocal candidate=workspace:Raycast(root.Position+offset,Vector3.new(0,-6,0),params)\n\t\t\t\t\t\t\tif candidate and math.abs(candidate.Position.Y-target.Y)<0.3 then hit=candidate; break end\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\t\tlocal grounded=hum.FloorMaterial~=Enum.Material.Air\n\t\t\t\t\tlocal correctSupport=hit and math.abs(hit.Position.Y-target.Y)<0.3\n\t\t\t\t\tif delta.Magnitude<0.35 and grounded and correctSupport then\n\t\t\t\t\t\ttable.insert(report.reached,{index=index,support=hit.Instance:GetFullName(),position={root.Position.X-origin.X,root.Position.Y-origin.Y,root.Position.Z-origin.Z}})\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\t\tif delta.Magnitude<0.35 and grounded and not correctSupport and math.abs(root.AssemblyLinearVelocity.Y)<2 then\n\t\t\t\t\t\twrongSupportSince=wrongSupportSince or os.clock()\n\t\t\t\t\t\tassert(os.clock()-wrongSupportSince<0.25,\"Settled on wrong support at \"..index..\": \"..(if hit then hit.Instance:GetFullName() else \"no center support\"))\n\t\t\t\t\telse wrongSupportSince=nil end\n\t\t\t\t\tassert((course:GetAttribute(\"StudyRecoveries\") or 0)==initialRecoveries,\"Recovered during command \"..index)\n\t\t\t\t\tassert(os.clock()<timeout,\"Command timed out at \"..index)\n\t\t\t\t\tassert(hum.Health>0 and player.Character==char,\"Character unavailable\")\n\t\t\t\t\tif command.jump and not jumped and grounded then hum.Jump=true; jumped=true; report.jumps+=1 end\n\t\t\t\t\thum:Move(if delta.Magnitude>0.25 then delta.Unit else Vector3.zero,false)\n\t\t\t\t\tRunService.RenderStepped:Wait()\n\t\t\t\tend\n\t\t\t\thum:Move(Vector3.zero,false)\n\t\t\t\tif command.wait then task.wait(command.wait) end\n\t\t\tend\n\t\tend,debug.traceback)\n\t\thum:Move(Vector3.zero,false); hum.Jump=false\n\t\tif previous then controls:Enable() else controls:Disable() end\n\t\treport.controlsRestored=true; report.elapsed=os.clock()-started\n\t\treport.status=if ok then \"Passed\" else \"Failed\"; (report :: any).error=if ok then nil else err\n\t\tresult.Value=Http:JSONEncode(report)\n\tend)\n\treturn folder:GetFullName()\nend\n\nreturn Study\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","VineCourse"],"source":"--!strict\n\nlocal Kit=require(script.Parent.Kit)\nlocal F=require(script.Parent.Flora)\nlocal P=require(script.Parent.CourseParts)\nlocal Movement=require(script.Parent.Movement)\nlocal VineCourse={}\n\nlocal function leaves(m: Model,name: string,points: {{number}},expert: boolean)\n\tfor i,p in points do\n\t\tlocal leaf=F.Leaf(m,name..i,P.Frame(p[1],p[2]-.25,p[3],p[4]),if expert then 3.2 else (p[5] or 18),if expert then 10.5 else (p[6] or 20),expert,not expert)\n\t\tleaf:SetAttribute(\"MovementIntent\",if expert then \"Narrow pointed landing; offset height and direction\" else \"Separated broad landing with a blunt end\")\n\t\tlocal bottom=P.Origin+Vector3.new(p[1]+3,-2.4,p[3]+3)\n\t\tlocal top=P.Origin+Vector3.new(p[1],p[2]-.6,p[3])\n\t\tKit.Part(m,\"LeafStalk\",CFrame.lookAt((bottom+top)/2,top)*CFrame.Angles(0,math.pi/2,0),Vector3.new((top-bottom).Magnitude,if expert then .8 else 1.4,if expert then .8 else 1.4),Kit.Colors.leaf,\"Blocker\",Enum.PartType.Cylinder)\n\tend\nend\n\nfunction VineCourse.Build(parent: Instance,markers: Instance)\n\tlocal m=Kit.Group(parent,\"G4_LowerVine\",CFrame.new(P.Origin))\n\tlocal entry={{80,9.25,-30,0,16,18},{101,11.25,-24,75,16,18},{124,9.75,-24,90,16,18},{142,11.25,-12,145,16,18}}\n\tleaves(m,\"OpeningLeaf_\",entry,false)\n\tP.Terrace(m,\"VineChoice\",144,11.25,15,31,25)\n\tlocal main={{154,11.25,42,170},{151,13.25,64,-110},{128,11.25,74,100},{104,13.25,67,70},{81.5,11.25,51.2,35},{66.5,10.75,30,35}}\n\tleaves(m,\"BroadTurnLeaf_\",main,false)\n\tMovement.Windows(m,\"VineTrellis_1\",P.Frame(154,11.25,42,170),17,1)\n\tMovement.Windows(m,\"VineTrellis_2\",P.Frame(128,11.25,74,100),17,1)\n\tP.Terrace(m,\"VineMerge\",31,10.75,16,42,32)\n\tlocal expert={{119,13.25,13,88},{105,10.75,17,95},{91,13.05,13,84},{77,10.75,17,98},{63,12.25,14,86}}\n\tleaves(m,\"ExpertTendril_\",expert,true)\n\tlocal common={{8,10.25,47,150},{5,9.25,68,180,16,16}}\n\tleaves(m,\"ExitLeaf_\",common,false)\n\tP.Terrace(m,\"FestivalRefuge\",36,8.24,82,34,26)\n\tF.Vine(m,\"LowerVineLandmark\",P.Frame(108,-2.8,43))\n\tfor i,r in {{80,-34},{143,-10},{150,64},{99,62},{20,39}} do\n\t\tlocal a=Vector3.new(r[1],-1.8,r[2]); local b=Vector3.new(108,-1.8,43)\n\t\tP.Root(m,\"LeafBearingRoot_\"..i,a,b,5,0,Kit.Colors.leaf)\n\tend\n\tKit.Sign(m,\"MainVineChoice\",P.Frame(163,11,11,45),\"BROAD LEAVES\\nFollow the outside\",Kit.Colors.lime)\n\tP.Arrow(m,150,11.25,19,160)\n\tP.Arrow(m,137,11.25,15,90,true)\n\tKit.Sign(m,\"ExpertVineChoice\",P.Frame(131,11,1,-35),\"EXPERT\\nTENDRILS\",Kit.Colors.gold)\n\tKit.Sign(m,\"FestivalDirection\",P.Frame(13,8,91,-90),\"HARVEST\\nFESTIVAL\",Kit.Colors.terra)\n\tlocal entryPath={{76,8.24,-57}}; for _,p in entry do table.insert(entryPath,{p[1],p[2],p[3]}) end; table.insert(entryPath,{144,11.25,15})\n\tlocal mainPath={{144,11.25,15}}\n\tfor i,p in main do\n\t\tif i==1 or i==3 then\n\t\t\tlocal frame=P.Frame(p[1],p[2],p[3],p[4])\n\t\t\tfor _,r in {{3.875,0,5},{3.875,2.6,0},{3.875,0,-5}} do\n\t\t\t\tlocal point=frame*Vector3.new(table.unpack(r))-P.Origin\n\t\t\t\ttable.insert(mainPath,{point.X,point.Y,point.Z})\n\t\t\tend\n\t\telse table.insert(mainPath,{p[1],p[2],p[3]}) end\n\tend\n\ttable.insert(mainPath,{31,10.75,16})\n\tlocal expertPath={{144,11.25,15}};for _,p in expert do table.insert(expertPath,{p[1],p[2],p[3]}) end;table.insert(expertPath,{31,10.75,16})\n\tP.Path(markers,\"G4_Entry\",entryPath,\"Main\")\n\tP.Path(markers,\"G4_Main\",mainPath,\"MainBranch\")\n\tP.Path(markers,\"G4_Expert\",expertPath,\"ExpertBranch\")\n\tP.Path(markers,\"G4_Exit\",{{31,10.75,16},{8,10.25,47},{5,9.25,68},{22,8.24,78},{33,8.24,82}},\"Main\")\n\treturn m\nend\n\nreturn VineCourse\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","Wayfinding"],"source":"--!strict\n\nlocal Kit=require(script.Parent.Kit)\nlocal c=Kit.Colors\nlocal Wayfinding={}\n\nlocal function text(part: BasePart,words: string,color: Color3)\n\tfor _,face in {Enum.NormalId.Front,Enum.NormalId.Back} do\n\t\tlocal gui=Instance.new(\"SurfaceGui\")\n\t\tgui.Face=face;gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud;gui.PixelsPerStud=40;gui.Parent=part\n\t\tlocal label=Instance.new(\"TextLabel\")\n\t\tlabel.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.Font=Enum.Font.GothamBold\n\t\tlabel.TextScaled=true;label.TextColor3=color;label.Text=words;label.Parent=gui\n\tend\nend\n\nfunction Wayfinding.Checkpoint(parent: Instance,marker: BasePart,index: number,top: number)\n\tlocal f=CFrame.new(marker.Position.X,top,marker.Position.Z)*marker.CFrame.Rotation\n\tlocal m=Kit.Group(parent,string.format(\"VisibleCheckpoint_%02d\",index),f)\n\tm:SetAttribute(\"MatchesTrigger\",marker.Name)\n\tlocal w,d=marker.Size.X,marker.Size.Z\n\tfor _,s in {-1,1} do\n\t\tKit.Part(m,\"PlotSide\",f*CFrame.new(s*(w/2-.15),.09,0),Vector3.new(.3,.18,d),c.aqua)\n\t\tKit.Part(m,\"PlotEnd\",f*CFrame.new(0,.09,s*(d/2-.15)),Vector3.new(w-.6,.18,.3),c.aqua)\n\t\tKit.Part(m,\"CornerStake\",f*CFrame.new(s*(w/2+.7),1, d/2),Vector3.new(.5,2,.5),c.wood)\n\tend\n\tlocal sign=Kit.Part(m,\"CheckpointBoard\",f*CFrame.new(-(w/2+2.5),4.7,d/2),Vector3.new(5.5,5,.45),c.cream)\n\ttext(sign,string.format(\"CHECKPOINT\\n%02d\",index),c.leaf)\n\tKit.Part(m,\"SignPost\",f*CFrame.new(-(w/2+2.5),1.1,d/2),Vector3.new(.7,2.2,.7),c.wood)\n\tlocal banner=Kit.Part(m,\"CheckpointNumber\",f*CFrame.new(0,10.2,d/2),Vector3.new(8,2,.35),c.cream)\n\ttext(banner,string.format(\"CHECKPOINT %02d\",index),c.leaf)\n\tKit.Part(m,\"BannerRail\",f*CFrame.new(0,8.95,d/2+.425),Vector3.new(w+1.9,.5,.5),c.wood)\n\tfor _,s in {-1,1} do Kit.Part(m,\"BannerPost\",f*CFrame.new(s*(w/2+.7),5.5,d/2),Vector3.new(.5,11,.5),c.wood) end\n\treturn m\nend\n\nfunction Wayfinding.Start(parent: Instance,frame: CFrame,width: number)\n\tlocal m=Kit.Group(parent,\"GardenStartLine\",frame)\n\tfor i=1,16 do\n\t\tKit.Part(m,\"StartTile\",frame*CFrame.new((i-8.5)*width/16,.08,0),Vector3.new(width/16,.16,2),if i%2==0 then c.cream else c.leaf)\n\tend\n\tfor _,s in {-1,1} do Kit.Part(m,\"StartPost\",frame*CFrame.new(s*(width/2+.8),6,0),Vector3.new(1,12,1),c.wood) end\n\tlocal board=Kit.Part(m,\"StartBoard\",frame*CFrame.new(0,11.4,0),Vector3.new(26,3.6,.6),c.cream)\n\tKit.Part(m,\"StartRail\",frame*CFrame.new(0,9.275,.55),Vector3.new(width+2.6,.65,.5),c.wood)\n\ttext(board,\"START\\nPick either wheelbarrow\",c.leaf)\n\treturn m\nend\n\nfunction Wayfinding.HazardStatus(parent: Instance,frame: CFrame,span: number)\n\tlocal board=Kit.Part(parent,\"StatusBoard\",frame*CFrame.new(0,10,0),Vector3.new(12,3,.45),c.cream)\n\ttext(board,\"WAIT\\nCross when OPEN\",c.dark)\n\tKit.Part(parent,\"StatusRail\",frame*CFrame.new(0,11.8,.475),Vector3.new(span+2,.6,.5),c.wood)\n\tfor _,s in {-1,1} do Kit.Part(parent,\"StatusPost\",frame*CFrame.new(s*(span/2+.7),6.1,.475),Vector3.new(.65,12.2,.65),c.wood) end\n\treturn board\nend\n\nfunction Wayfinding.SetStatus(hazard: Instance,words: string,color: Color3?)\n\tlocal board=hazard:FindFirstChild(\"StatusBoard\")\n\tif board and board:GetAttribute(\"DisplayedStatus\")~=words then\n\t\tboard:SetAttribute(\"DisplayedStatus\",words)\n\t\tfor _,v in board:GetDescendants() do if v:IsA(\"TextLabel\") then v.Text=words end end\n\tend\n\tif board and board:IsA(\"BasePart\") and color then board.Color=color end\nend\n\nfunction Wayfinding.CaptureStatus(hazard: Instance)\n\tlocal saved={parts={},labels={},board=hazard:FindFirstChild(\"StatusBoard\")}\n\tif saved.board then saved.status=saved.board:GetAttribute(\"DisplayedStatus\") end\n\tfor _,part in hazard:GetChildren() do\n\t\tif part:IsA(\"BasePart\") and (part.Name==\"StatusBoard\" or part:GetAttribute(\"TimedWarningStripe\")==true) then\n\t\t\ttable.insert(saved.parts,{part=part,color=part.Color})\n\t\t\tfor _,label in part:GetDescendants() do\n\t\t\t\tif label:IsA(\"TextLabel\") then table.insert(saved.labels,{label=label,text=label.Text}) end\n\t\t\tend\n\t\tend\n\tend\n\treturn saved\nend\n\nfunction Wayfinding.RestoreStatus(saved)\n\tfor _,record in saved.parts do record.part.Color=record.color end\n\tfor _,record in saved.labels do record.label.Text=record.text end\n\tif saved.board then saved.board:SetAttribute(\"DisplayedStatus\",saved.status) end\nend\n\nfunction Wayfinding.UpdateHazard(hazard: Instance,title: string,phase: string,alpha: number,timing,minimumEntry: number): boolean\n\tlocal remaining=if phase==\"Clear\" then timing.Clear*(1-alpha) else 0\n\tlocal entryOpen=phase==\"Clear\" and remaining>=minimumEntry\n\tlocal color=if entryOpen then Color3.fromRGB(129,205,75) elseif phase==\"Active\" then Color3.fromRGB(245,110,82) else Color3.fromRGB(255,204,74)\n\tlocal waitSeconds=if phase==\"Clear\" then remaining+timing.Warning+timing.Active elseif phase==\"Warning\" then timing.Warning*(1-alpha)+timing.Active else timing.Active*(1-alpha)\n\tlocal words=if entryOpen then string.format(\"%s: GO\\nENTER NOW  %ds\\nKeep moving\",title,math.ceil(remaining-minimumEntry))\n\t\telse string.format(\"%s: %s\\nOPENS IN %ds\\nStay behind line\",title,if phase==\"Active\" then \"STOP\" else \"WAIT\",math.ceil(waitSeconds))\n\tWayfinding.SetStatus(hazard,words,color)\n\tlocal lamp=hazard:FindFirstChild(\"WarningLamp\")\n\tif lamp and lamp:IsA(\"BasePart\") then lamp.Color=color end\n\tfor _,stripe in hazard:GetChildren() do\n\t\tif stripe:IsA(\"BasePart\") and stripe:GetAttribute(\"TimedWarningStripe\")==true then\n\t\t\tstripe.Color=if phase==\"Warning\" and math.floor(alpha*6)%2==0 then Color3.fromRGB(255,239,201) else color\n\t\tend\n\tend\n\treturn entryOpen\nend\n\nreturn Wayfinding\n"},{"path":["ReplicatedStorage","Config","StudGardenConfig"],"source":"--!strict\n\nreturn {\n\tOrigin = Vector3.new(6500, 80, 3500),\n\tBuildId = \"SG_V1_01\",\n\tModelName = \"Course_StudGarden\",\n\tCourseId = \"stud_garden\",\n\tWalkSpeed = 16,\n\tJumpHeight = 7.2,\n\tRecoveryDrop = 6,\n\tSpawnHeight = 4,\n\tCapacity = 20,\n\tHazards = {\n\t\tH01 = {\n\t\t\tWarning = 1.5,\n\t\t\tActive = 1.8,\n\t\t\tClear = 6.5,\n\t\t\tOffset = 0,\n\t\t\tWaterSize = Vector3.new(1.2, 5.5, 18),\n\t\t},\n\t\tH02 = {\n\t\t\tWarning = 1.5,\n\t\t\tActive = 2,\n\t\t\tClear = 6.5,\n\t\t\tOffset = 3,\n\t\t\tFruitSize = Vector3.new(3, 3, 3),\n\t\t},\n\t},\n\tRuntime = {\n\t\tVisualInterval = 0.05,\n\t\tMaxContactDt = 0.2,\n\t\tRecoveryCooldown = 1,\n\t},\n}\n"},{"path":["ServerScriptService","Services","StudGardenService"],"source":"--!strict\n\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal Config = require(game.ReplicatedStorage.Config.StudGardenConfig)\nlocal Runtime = require(game.ServerStorage.CourseBuilders.StudGarden.Runtime)\nlocal RaceConstants = require(game.ReplicatedStorage.Shared.RaceConstants)\n\nlocal Service = {}\nlocal services: any\nlocal heartbeat: RBXScriptConnection? = nil\nlocal boundCourse: Model? = nil\nlocal controller: any = nil\nlocal epoch = 0\nlocal wasActive = false\nlocal boundV2 = false\n\nfunction Service.Init(context: any)\n\tservices = context.Services\nend\n\nlocal function isStudGarden(course: Model?): boolean\n\treturn course ~= nil and course:GetAttribute(\"StudGardenBuild\") == Config.BuildId\n\t\tand course:GetAttribute(\"CourseId\") == Config.CourseId\nend\n\nlocal function isEligible(player: Player): boolean\n\treturn services.RaceService.IsRaceActive() == true\n\t\tand services.PlayerRaceService.IsOfficialRacer(player) == true\n\t\tand services.PlayerRaceService.GetPlayerStatus(player) == RaceConstants.PlayerRaceStatus.Racing\nend\n\nfunction Service.Start()\n\tif heartbeat ~= nil then\n\t\treturn\n\tend\n\tassert(services ~= nil, \"StudGardenService.Init must run before Start\")\n\theartbeat = RunService.Heartbeat:Connect(function(dt)\n\t\tlocal course = services.CourseService.GetActiveCourse()\n\t\tlocal active = services.RaceService.IsRaceActive() == true\n\t\tlocal isV2 = course ~= nil and course:GetAttribute(\"CourseId\") == \"stud_garden_v2\"\n\t\t\tand course:GetAttribute(\"SGV2Owned\") == true\n\t\tlocal target = if isStudGarden(course) or (isV2 and active) then course else nil\n\t\tif target ~= boundCourse then\n\t\t\tif controller ~= nil then\n\t\t\t\tcontroller.Stop()\n\t\t\tend\n\t\t\tcontroller = nil\n\t\t\tboundCourse = target\n\t\t\tboundV2 = isV2\n\t\t\twasActive = false\n\t\t\tif target ~= nil then\n\t\t\t\tif boundV2 then\n\t\t\t\t\tcontroller = require(game.ServerStorage.CourseBuilders.StudGardenV2.CourseRuntime)\n\t\t\t\t\t\t.Start(target, isEligible, services.RespawnService.RecoverPlayer)\n\t\t\t\telse\n\t\t\t\t\tcontroller = Runtime.Create(target, services.RespawnService.RecoverPlayer, isEligible)\n\t\t\t\t\tepoch = Workspace:GetServerTimeNow()\n\t\t\t\t\tcontroller.Step(0, 0, false)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\tif controller ~= nil and not boundV2 then\n\t\t\tif active and not wasActive then\n\t\t\t\tepoch = Workspace:GetServerTimeNow()\n\t\t\t\tcontroller.Reset()\n\t\t\tend\n\t\t\tcontroller.Step(Workspace:GetServerTimeNow() - epoch, dt, active)\n\t\tend\n\t\twasActive = active\n\tend)\nend\n\nfunction Service.Stop()\n\tif heartbeat ~= nil then\n\t\theartbeat:Disconnect()\n\t\theartbeat = nil\n\tend\n\tif controller ~= nil then\n\t\tcontroller.Stop()\n\t\tcontroller = nil\n\tend\n\tboundCourse = nil\n\tboundV2 = false\n\twasActive = false\nend\n\nfunction Service.GetDiagnostics(): any\n\treturn if controller ~= nil then controller.Diagnostics() else {bound = false}\nend\n\nreturn Service\n"},{"path":["ServerScriptService","Services","CourseService"],"source":"--!strict\r\n\r\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\r\nlocal ServerStorage = game:GetService(\"ServerStorage\")\r\nlocal Workspace = game:GetService(\"Workspace\")\r\nlocal RunService = game:GetService(\"RunService\")\r\n\r\nlocal CheckpointConfig = require(ReplicatedStorage.Config.CheckpointConfig)\r\nlocal CourseConfig = require(ReplicatedStorage.Config.CourseConfig)\r\nlocal RaceConstants = require(ReplicatedStorage.Shared.RaceConstants)\r\nlocal RaceTypes = require(ReplicatedStorage.Shared.RaceTypes)\r\n\r\ntype CourseInfo = RaceTypes.CourseInfo\r\ntype RaceFormat = RaceTypes.RaceFormat\r\n\r\ntype ServiceContext = {\r\n\tServices: { [string]: any },\r\n}\r\n\r\ntype CourseRecord = {\r\n\tmodel: Model,\r\n\tinfo: CourseInfo,\r\n\tvalidationWarnings: { string },\r\n}\r\n\r\ntype OrderedCheckpoint = {\r\n\tindex: number,\r\n\tname: string,\r\n\tpart: BasePart,\r\n}\r\n\r\nlocal CourseService = {}\r\n\r\nlocal isInitialized = false\r\nlocal isStarted = false\r\nlocal inspectionMode = false\r\nlocal studioCourseId: string? = nil\r\nlocal discoveredCoursesById: { [string]: CourseRecord } = {}\r\nlocal discoveredCourseOrder: { string } = {}\r\nlocal activeCourseInfo: CourseInfo? = nil\r\n\r\nlocal function getCourseLibrary(): Folder?\r\n\tlocal library = ServerStorage:FindFirstChild(CourseConfig.CourseLibraryName)\r\n\r\n\tif library ~= nil and library:IsA(\"Folder\") then\r\n\t\treturn library\r\n\tend\r\n\r\n\treturn nil\r\nend\r\n\r\nlocal function ensureCourseLibrary(): Folder\r\n\tlocal library = getCourseLibrary()\r\n\r\n\tif library ~= nil then\r\n\t\treturn library\r\n\tend\r\n\r\n\tlibrary = Instance.new(\"Folder\")\r\n\tlibrary.Name = CourseConfig.CourseLibraryName\r\n\tlibrary.Parent = ServerStorage\r\n\r\n\treturn library\r\nend\r\n\r\nlocal function ensureCourseArchive(): Folder\r\n\tlocal archiveRoot = ServerStorage:FindFirstChild(\"Archive\")\r\n\tif not archiveRoot then archiveRoot = Instance.new(\"Folder\"); archiveRoot.Name = \"Archive\"; archiveRoot.Parent = ServerStorage end\r\n\tlocal archive = archiveRoot:FindFirstChild(CourseConfig.CourseArchiveName)\r\n\r\n\tif archive ~= nil and archive:IsA(\"Folder\") then\r\n\t\treturn archive\r\n\tend\r\n\r\n\tarchive = Instance.new(\"Folder\")\r\n\tarchive.Name = CourseConfig.CourseArchiveName\r\n\tarchive.Parent = archiveRoot\r\n\r\n\treturn archive\r\nend\r\n\r\nlocal function getCourseInfoInstance(courseModel: Model): Instance?\r\n\treturn courseModel:FindFirstChild(CourseConfig.RequiredChildNames.CourseInfo)\r\nend\r\n\r\nlocal function ensureFolder(parent: Instance, folderName: string): Folder\r\n\tlocal existingFolder = parent:FindFirstChild(folderName)\r\n\r\n\tif existingFolder ~= nil and existingFolder:IsA(\"Folder\") then\r\n\t\treturn existingFolder\r\n\tend\r\n\r\n\tlocal folder = Instance.new(\"Folder\")\r\n\tfolder.Name = folderName\r\n\tfolder.Parent = parent\r\n\r\n\treturn folder\r\nend\r\n\r\nlocal function ensureCourseInfoInstance(courseModel: Model): Instance\r\n\treturn ensureFolder(courseModel, CourseConfig.RequiredChildNames.CourseInfo)\r\nend\r\n\r\nlocal function getStringAttribute(instance: Instance?, attributeName: string, fallback: string): string\r\n\tif instance == nil then\r\n\t\treturn fallback\r\n\tend\r\n\r\n\tlocal value = instance:GetAttribute(attributeName)\r\n\r\n\tif typeof(value) == \"string\" and value ~= \"\" then\r\n\t\treturn value\r\n\tend\r\n\r\n\treturn fallback\r\nend\r\n\r\nlocal function getBooleanAttribute(instance: Instance?, attributeName: string, fallback: boolean): boolean\r\n\tif instance == nil then\r\n\t\treturn fallback\r\n\tend\r\n\r\n\tlocal value = instance:GetAttribute(attributeName)\r\n\r\n\tif typeof(value) == \"boolean\" then\r\n\t\treturn value\r\n\tend\r\n\r\n\treturn fallback\r\nend\r\n\r\nlocal function getNumberAttribute(instance: Instance?, attributeName: string, fallback: number?): number?\r\n\tif instance == nil then\r\n\t\treturn fallback\r\n\tend\r\n\r\n\tlocal value = instance:GetAttribute(attributeName)\r\n\r\n\tif typeof(value) == \"number\" then\r\n\t\treturn value\r\n\tend\r\n\r\n\treturn fallback\r\nend\r\n\r\nlocal function normalizeRaceFormat(value: string): RaceFormat\r\n\tif value == RaceConstants.RaceFormat.LapBased then\r\n\t\treturn RaceConstants.RaceFormat.LapBased\r\n\tend\r\n\r\n\treturn RaceConstants.RaceFormat.PointToPoint\r\nend\r\n\r\nlocal function readCourseInfo(courseModel: Model): CourseInfo\r\n\tlocal attributes = CourseConfig.CourseInfoAttributes\r\n\tlocal defaults = CourseConfig.DefaultCourseInfo\r\n\tlocal courseInfoInstance = getCourseInfoInstance(courseModel)\r\n\tlocal lapCount = math.max(1, getNumberAttribute(courseInfoInstance, attributes.LapCount, defaults.LapCount) or 1)\r\n\r\n\treturn {\r\n\t\tcourseId = getStringAttribute(courseInfoInstance, attributes.CourseId, defaults.CourseId),\r\n\t\tdisplayName = getStringAttribute(courseInfoInstance, attributes.DisplayName, defaults.DisplayName),\r\n\t\traceFormat = normalizeRaceFormat(getStringAttribute(courseInfoInstance, attributes.RaceFormat, defaults.RaceFormat)),\r\n\t\tlapCount = lapCount,\r\n\t\tenabled = getBooleanAttribute(courseInfoInstance, attributes.Enabled, defaults.Enabled),\r\n\t\tdifficulty = getStringAttribute(courseInfoInstance, attributes.Difficulty, defaults.Difficulty),\r\n\t\ttargetNewPlayerTime = getNumberAttribute(courseInfoInstance, attributes.TargetNewPlayerTime, defaults.TargetNewPlayerTime),\r\n\t\ttargetPracticedTime = getNumberAttribute(\r\n\t\t\tcourseInfoInstance,\r\n\t\t\tattributes.TargetPracticedTime,\r\n\t\t\tdefaults.TargetPracticedTime\r\n\t\t),\r\n\t\tcheckpointCount = getNumberAttribute(courseInfoInstance, attributes.CheckpointCount, defaults.CheckpointCount),\r\n\t}\r\nend\r\n\r\nlocal function getBasePart(parent: Instance?, childName: string): BasePart?\r\n\tif parent == nil then\r\n\t\treturn nil\r\n\tend\r\n\r\n\tlocal child = parent:FindFirstChild(childName)\r\n\r\n\tif child ~= nil and child:IsA(\"BasePart\") then\r\n\t\treturn child\r\n\tend\r\n\r\n\treturn nil\r\nend\r\n\r\nlocal function getFolder(parent: Instance?, childName: string): Folder?\r\n\tif parent == nil then\r\n\t\treturn nil\r\n\tend\r\n\r\n\tlocal child = parent:FindFirstChild(childName)\r\n\r\n\tif child ~= nil and child:IsA(\"Folder\") then\r\n\t\treturn child\r\n\tend\r\n\r\n\treturn nil\r\nend\r\n\r\nlocal function parseCheckpointIndex(checkpointName: string): number?\r\n\tlocal prefix = CheckpointConfig.CheckpointNamePrefix\r\n\tlocal padding = CheckpointConfig.CheckpointNumberPadding\r\n\tlocal digits = string.match(checkpointName, \"^\" .. prefix .. \"_(%d+)$\")\r\n\r\n\tif digits == nil or #digits ~= padding then\r\n\t\treturn nil\r\n\tend\r\n\r\n\treturn tonumber(digits)\r\nend\r\n\r\nlocal function discoverFallZones(fallZonesFolder: Folder?): { BasePart }\r\n\tlocal fallZones: { BasePart } = {}\r\n\r\n\tif fallZonesFolder ~= nil then\r\n\t\tfor _, descendant in ipairs(fallZonesFolder:GetDescendants()) do\r\n\t\t\tif descendant:IsA(\"BasePart\") then\r\n\t\t\t\ttable.insert(fallZones, descendant)\r\n\t\t\tend\r\n\t\tend\r\n\tend\r\n\r\n\treturn fallZones\r\nend\r\n\r\nlocal function discoverOrderedCheckpoints(checkpointsFolder: Folder?): { OrderedCheckpoint }\r\n\tlocal discoveredCheckpoints = {}\r\n\r\n\tif checkpointsFolder == nil then\r\n\t\treturn discoveredCheckpoints\r\n\tend\r\n\r\n\tfor _, child in ipairs(checkpointsFolder:GetChildren()) do\r\n\t\tif child:IsA(\"BasePart\") then\r\n\t\t\tlocal checkpointIndex = parseCheckpointIndex(child.Name)\r\n\r\n\t\t\tif checkpointIndex ~= nil then\r\n\t\t\t\ttable.insert(discoveredCheckpoints, {\r\n\t\t\t\t\tindex = checkpointIndex,\r\n\t\t\t\t\tname = child.Name,\r\n\t\t\t\t\tpart = child,\r\n\t\t\t\t})\r\n\t\t\tend\r\n\t\tend\r\n\tend\r\n\r\n\ttable.sort(discoveredCheckpoints, function(left, right)\r\n\t\treturn left.index < right.index\r\n\tend)\r\n\r\n\treturn discoveredCheckpoints\r\nend\r\n\r\nlocal function countOrderedCheckpoints(courseModel: Model): number\r\n\tlocal checkpointsFolder = getFolder(courseModel, CourseConfig.RequiredChildNames.Checkpoints)\r\n\r\n\treturn #discoverOrderedCheckpoints(checkpointsFolder)\r\nend\r\n\r\nlocal function writeCourseInfoAttributes(courseModel: Model, courseInfo: CourseInfo)\r\n\tlocal attributes = CourseConfig.CourseInfoAttributes\r\n\tlocal courseInfoInstance = ensureCourseInfoInstance(courseModel)\r\n\r\n\tcourseInfoInstance:SetAttribute(attributes.CourseId, courseInfo.courseId)\r\n\tcourseInfoInstance:SetAttribute(attributes.DisplayName, courseInfo.displayName)\r\n\tcourseInfoInstance:SetAttribute(attributes.RaceFormat, courseInfo.raceFormat)\r\n\tcourseInfoInstance:SetAttribute(attributes.LapCount, courseInfo.lapCount)\r\n\tcourseInfoInstance:SetAttribute(attributes.Enabled, courseInfo.enabled)\r\n\tcourseInfoInstance:SetAttribute(attributes.Difficulty, courseInfo.difficulty)\r\n\tcourseInfoInstance:SetAttribute(attributes.TargetNewPlayerTime, courseInfo.targetNewPlayerTime)\r\n\tcourseInfoInstance:SetAttribute(attributes.TargetPracticedTime, courseInfo.targetPracticedTime)\r\n\tcourseInfoInstance:SetAttribute(attributes.CheckpointCount, courseInfo.checkpointCount)\r\nend\r\n\r\nlocal function getClassicPointToPointCourseInfo(courseModel: Model): CourseInfo\r\n\tlocal defaults = CourseConfig.DefaultCourseInfo\r\n\r\n\treturn {\r\n\t\tcourseId = \"classic_point_to_point\",\r\n\t\tdisplayName = \"Classic Point-to-Point\",\r\n\t\traceFormat = RaceConstants.RaceFormat.PointToPoint,\r\n\t\tlapCount = 1,\r\n\t\tenabled = true,\r\n\t\tdifficulty = defaults.Difficulty,\r\n\t\ttargetNewPlayerTime = defaults.TargetNewPlayerTime,\r\n\t\ttargetPracticedTime = defaults.TargetPracticedTime,\r\n\t\tcheckpointCount = countOrderedCheckpoints(courseModel),\r\n\t}\r\nend\r\n\r\nlocal function addWarning(warnings: { string }, message: string)\r\n\ttable.insert(warnings, message)\r\nend\r\n\r\nlocal function validateCheckpointNames(checkpointsFolder: Folder?, warnings: { string })\r\n\tif checkpointsFolder == nil then\r\n\t\treturn\r\n\tend\r\n\r\n\tlocal validCheckpointCount = 0\r\n\r\n\tfor _, child in ipairs(checkpointsFolder:GetChildren()) do\r\n\t\tif child:IsA(\"BasePart\") and parseCheckpointIndex(child.Name) ~= nil then\r\n\t\t\tvalidCheckpointCount += 1\r\n\t\tend\r\n\tend\r\n\r\n\tif validCheckpointCount == 0 then\r\n\t\taddWarning(warnings, \"Checkpoints must contain at least one BasePart named Checkpoint_###.\")\r\n\tend\r\nend\r\n\r\nlocal function validateCourseModel(courseModel: Model, requireAuthoringFolders: boolean): { string }\r\n\tlocal childNames = CourseConfig.RequiredChildNames\r\n\tlocal warnings = {}\r\n\r\n\tif requireAuthoringFolders and courseModel:FindFirstChild(childNames.CourseInfo) == nil then\r\n\t\taddWarning(warnings, \"CourseInfo is missing.\")\r\n\tend\r\n\r\n\tif getBasePart(courseModel, childNames.Start) == nil then\r\n\t\taddWarning(warnings, \"Start must be a BasePart.\")\r\n\tend\r\n\r\n\tlocal checkpointsFolder = getFolder(courseModel, childNames.Checkpoints)\r\n\r\n\tif checkpointsFolder == nil then\r\n\t\taddWarning(warnings, \"Checkpoints must be a Folder.\")\r\n\telse\r\n\t\tvalidateCheckpointNames(checkpointsFolder, warnings)\r\n\tend\r\n\r\n\tif getBasePart(courseModel, childNames.Finish) == nil then\r\n\t\taddWarning(warnings, \"Finish must be a BasePart.\")\r\n\tend\r\n\r\n\tif requireAuthoringFolders and getFolder(courseModel, childNames.Obstacles) == nil then\r\n\t\taddWarning(warnings, \"Obstacles must be a Folder.\")\r\n\tend\r\n\r\n\tlocal fallZonesFolder = getFolder(courseModel, childNames.FallZones)\r\n\r\n\tif fallZonesFolder == nil then\r\n\t\taddWarning(warnings, \"FallZones must be a Folder.\")\r\n\telseif #discoverFallZones(fallZonesFolder) == 0 then\r\n\t\taddWarning(warnings, \"FallZones must contain at least one BasePart.\")\r\n\tend\r\n\r\n\tif requireAuthoringFolders and getFolder(courseModel, childNames.RouteMarkers) == nil then\r\n\t\taddWarning(warnings, \"RouteMarkers must be a Folder.\")\r\n\tend\r\n\r\n\tif requireAuthoringFolders and getFolder(courseModel, childNames.Decoration) == nil then\r\n\t\taddWarning(warnings, \"Decoration must be a Folder.\")\r\n\tend\r\n\r\n\tif requireAuthoringFolders and getFolder(courseModel, childNames.Bounds) == nil then\r\n\t\taddWarning(warnings, \"Bounds must be a Folder.\")\r\n\tend\r\n\r\n\treturn warnings\r\nend\r\n\r\nlocal function discoverCourseLibrary()\r\n\tdiscoveredCoursesById = {}\r\n\tdiscoveredCourseOrder = {}\r\n\tlocal duplicateCourseIds: { [string]: boolean } = {}\r\n\r\n\tlocal library = getCourseLibrary()\r\n\r\n\tif library == nil then\r\n\t\tprint(\"[CourseService] ServerStorage.CourseLibrary was not found; using Workspace.RaceCourse fallback.\")\r\n\t\treturn\r\n\tend\r\n\r\n\tfor _, child in ipairs(library:GetChildren()) do\r\n\t\tif child:IsA(\"Model\") then\r\n\t\t\tlocal info = readCourseInfo(child)\r\n\t\t\tif discoveredCoursesById[info.courseId] ~= nil or duplicateCourseIds[info.courseId] then\r\n\t\t\t\tduplicateCourseIds[info.courseId] = true\r\n\t\t\t\tdiscoveredCoursesById[info.courseId] = nil\r\n\t\t\t\twarn(string.format(\"[CourseService] Duplicate course ID %s; all copies are excluded until reconciled.\", info.courseId))\r\n\t\t\t\tcontinue\r\n\t\t\tend\r\n\t\t\tlocal warnings = validateCourseModel(child, true)\r\n\r\n\t\t\tdiscoveredCoursesById[info.courseId] = {\r\n\t\t\t\tmodel = child,\r\n\t\t\t\tinfo = info,\r\n\t\t\t\tvalidationWarnings = warnings,\r\n\t\t\t}\r\n\r\n\t\t\tfor _, warningMessage in ipairs(warnings) do\r\n\t\t\t\twarn(string.format(\"[CourseService] %s: %s\", child.Name, warningMessage))\r\n\t\t\tend\r\n\t\tend\r\n\tend\r\n\r\n\tfor courseId in pairs(discoveredCoursesById) do\r\n\t\ttable.insert(discoveredCourseOrder, courseId)\r\n\tend\r\n\ttable.sort(discoveredCourseOrder)\r\n\tprint(string.format(\"[CourseService] Discovered %d course model(s).\", #discoveredCourseOrder))\r\nend\r\n\r\nlocal function getFallbackActiveCourse(): Model?\r\n\tlocal activeCourse = Workspace:FindFirstChild(CourseConfig.ActiveCourseModelName)\r\n\r\n\tif activeCourse ~= nil and activeCourse:IsA(\"Model\") then\r\n\t\treturn activeCourse\r\n\tend\r\n\r\n\treturn nil\r\nend\r\n\r\nlocal function ensureClassicPointToPointCourseFromFallback()\r\n\tlocal library = ensureCourseLibrary()\r\n\tlocal existingCourse = library:FindFirstChild(CourseConfig.ClassicPointToPointCourseName)\r\n\r\n\tif existingCourse ~= nil then\r\n\t\tif existingCourse:IsA(\"Model\") then\r\n\t\t\tensureFolder(existingCourse, CourseConfig.RequiredChildNames.Obstacles)\r\n\t\t\tensureFolder(existingCourse, CourseConfig.RequiredChildNames.RouteMarkers)\r\n\t\t\tensureFolder(existingCourse, CourseConfig.RequiredChildNames.Decoration)\r\n\t\t\tensureFolder(existingCourse, CourseConfig.RequiredChildNames.Bounds)\r\n\t\t\twriteCourseInfoAttributes(existingCourse, getClassicPointToPointCourseInfo(existingCourse))\r\n\t\telse\r\n\t\t\twarn(\r\n\t\t\t\tstring.format(\r\n\t\t\t\t\t\"[CourseService] %s exists but is not a Model.\",\r\n\t\t\t\t\tCourseConfig.ClassicPointToPointCourseName\r\n\t\t\t\t)\r\n\t\t\t)\r\n\t\tend\r\n\r\n\t\treturn\r\n\tend\r\n\r\n\tlocal fallbackCourse = getFallbackActiveCourse()\r\n\r\n\tif fallbackCourse == nil then\r\n\t\treturn\r\n\tend\r\n\r\n\tlocal courseClone = fallbackCourse:Clone()\r\n\tcourseClone.Name = CourseConfig.ClassicPointToPointCourseName\r\n\tcourseClone:SetAttribute(CourseConfig.RuntimeActiveCourseAttribute, nil)\r\n\tcourseClone:SetAttribute(CourseConfig.SourceCourseIdAttribute, nil)\r\n\r\n\tensureFolder(courseClone, CourseConfig.RequiredChildNames.Obstacles)\r\n\tensureFolder(courseClone, CourseConfig.RequiredChildNames.RouteMarkers)\r\n\tensureFolder(courseClone, CourseConfig.RequiredChildNames.Decoration)\r\n\tensureFolder(courseClone, CourseConfig.RequiredChildNames.Bounds)\r\n\twriteCourseInfoAttributes(courseClone, getClassicPointToPointCourseInfo(courseClone))\r\n\r\n\tcourseClone.Parent = library\r\n\tprint(\"[CourseService] Created Course_ClassicPointToPoint from Workspace.RaceCourse fallback.\")\r\nend\r\n\r\nlocal function isPlayableCourseRecord(record: CourseRecord, allowStudioDevelopment: boolean?): boolean\r\n\tlocal studioDevelopment = allowStudioDevelopment == true and RunService:IsStudio()\r\n\t\tand record.info.courseId == \"stud_garden_v2\" and record.model:GetAttribute(\"SGV2Owned\") == true\r\n\tif record.info.enabled ~= true and not studioDevelopment then\r\n\t\treturn false\r\n\tend\r\n\r\n\tlocal warnings = validateCourseModel(record.model, false)\r\n\r\n\tfor _, warningMessage in ipairs(warnings) do\r\n\t\twarn(string.format(\"[CourseService] %s cannot be selected: %s\", record.model.Name, warningMessage))\r\n\tend\r\n\r\n\treturn #warnings == 0\r\nend\r\n\r\nlocal function selectActiveCourseRecord(): CourseRecord?\r\n\tif CourseConfig.SelectionMode ~= \"Fixed\" then\r\n\t\twarn(string.format(\"[CourseService] Unsupported selection mode %s; using Fixed.\", tostring(CourseConfig.SelectionMode)))\r\n\tend\r\n\r\n\tlocal configuredRecord = discoveredCoursesById[studioCourseId or CourseConfig.ActiveCourseId]\r\n\r\n\tif configuredRecord ~= nil and isPlayableCourseRecord(configuredRecord, studioCourseId ~= nil) then\r\n\t\treturn configuredRecord\r\n\tend\r\n\r\n\tif configuredRecord == nil then\r\n\t\twarn(string.format(\"[CourseService] Configured course id %s was not found.\", CourseConfig.ActiveCourseId))\r\n\telse\r\n\t\twarn(string.format(\"[CourseService] Configured course id %s is not playable.\", CourseConfig.ActiveCourseId))\r\n\tend\r\n\r\n\tfor _, courseId in ipairs(discoveredCourseOrder) do\r\n\t\tlocal record = discoveredCoursesById[courseId]\r\n\r\n\t\tif record ~= nil and isPlayableCourseRecord(record) then\r\n\t\t\twarn(string.format(\"[CourseService] Falling back to enabled course %s.\", courseId))\r\n\t\t\treturn record\r\n\t\tend\r\n\tend\r\n\r\n\treturn nil\r\nend\r\n\r\nlocal function getUniqueArchiveName(baseName: string): string\r\n\tlocal archive = ensureCourseArchive()\r\n\tlocal archiveName = baseName\r\n\tlocal index = 1\r\n\r\n\twhile archive:FindFirstChild(archiveName) ~= nil do\r\n\t\tindex += 1\r\n\t\tarchiveName = string.format(\"%s_%03d\", baseName, index)\r\n\tend\r\n\r\n\treturn archiveName\r\nend\r\n\r\nlocal function archiveExistingActiveCourse(activeCourse: Model)\r\n\tlocal archive = ensureCourseArchive()\r\n\tlocal archivedName = getUniqueArchiveName(activeCourse.Name .. \"_Legacy\")\r\n\r\n\tactiveCourse.Name = archivedName\r\n\tactiveCourse.Parent = archive\r\n\tprint(string.format(\"[CourseService] Archived existing active course as %s.\", activeCourse:GetFullName()))\nend\r\n\r\nlocal function spawnCourseRecord(record: CourseRecord, isCurrent: (() -> boolean)?): boolean\r\n\tlocal courseClone = record.model:Clone()\r\n\tcourseClone.Name = CourseConfig.ActiveCourseModelName\r\n\tcourseClone:SetAttribute(CourseConfig.RuntimeActiveCourseAttribute, true)\r\n\tcourseClone:SetAttribute(CourseConfig.SourceCourseIdAttribute, record.info.courseId)\r\n\r\n\tlocal warnings = validateCourseModel(courseClone, false)\r\n\r\n\tif #warnings > 0 then\r\n\t\tfor _, warningMessage in ipairs(warnings) do\r\n\t\t\twarn(string.format(\"[CourseService] Could not spawn %s: %s\", record.model.Name, warningMessage))\r\n\t\tend\r\n\r\n\t\tcourseClone:Destroy()\r\n\t\treturn false\r\n\tend\r\n\r\n\tif isCurrent and not isCurrent() then courseClone:Destroy();return false end\r\n\tlocal existingActiveCourse = getFallbackActiveCourse()\r\n\r\n\tif existingActiveCourse ~= nil then\r\n\t\tif existingActiveCourse:GetAttribute(CourseConfig.RuntimeActiveCourseAttribute) == true then\r\n\t\t\texistingActiveCourse:Destroy()\r\n\t\telse\r\n\t\t\tarchiveExistingActiveCourse(existingActiveCourse)\r\n\t\tend\r\n\tend\r\n\r\n\tcourseClone.Parent = Workspace\r\n\tactiveCourseInfo = readCourseInfo(courseClone)\r\n\r\n\tprint(\r\n\t\tstring.format(\r\n\t\t\t\"[CourseService] Spawned active course %s from %s.\",\r\n\t\t\tactiveCourseInfo.displayName,\r\n\t\t\trecord.model.Name\r\n\t\t)\r\n\t)\r\n\r\n\treturn true\r\nend\r\n\r\nlocal function prepareCourseLibrary()\n\tlocal studGardenV2 = Workspace:FindFirstChild(\"SGV2_Phase3_F04\")\r\n\tif RunService:IsStudio() and RunService:IsRunning() and studGardenV2 ~= nil then\r\n\t\tassert(studGardenV2:IsA(\"Model\") and studGardenV2:GetAttribute(\"ManualEditing\") == true\r\n\t\t\tand studGardenV2:GetAttribute(\"SGV2Owned\") == true, \"Preserve the V2 editing model\")\r\n\t\tlocal warnings = validateCourseModel(studGardenV2, true)\r\n\t\tassert(#warnings == 0, \"Stud Garden V2 is incomplete: \" .. table.concat(warnings, \"; \"))\r\n\t\tassert(readCourseInfo(studGardenV2).courseId == \"stud_garden_v2\", \"Unexpected Stud Garden V2 identity\")\r\n\t\tlocal library = ensureCourseLibrary()\r\n\t\tassert(library:FindFirstChild(studGardenV2.Name) == nil, \"Resolve the existing V2 template before replacing it\")\r\n\t\tstudGardenV2.Parent = library\r\n\tend\r\n\tlocal studGarden = Workspace:FindFirstChild(\"Course_StudGarden\")\r\n\tif RunService:IsRunning() and studGarden ~= nil then\r\n\t\tassert(studGarden:IsA(\"Model\") and studGarden:GetAttribute(\"ManualEditing\") == true,\r\n\t\t\t\"Preserve the visible Stud Garden editing model\")\r\n\t\tlocal warnings = validateCourseModel(studGarden, true)\r\n\t\tassert(#warnings == 0, \"Stud Garden is incomplete: \" .. table.concat(warnings, \"; \"))\r\n\t\tassert(readCourseInfo(studGarden).courseId == \"stud_garden\", \"Unexpected Stud Garden identity\")\r\n\t\tlocal library = ensureCourseLibrary()\r\n\t\tlocal previous = library:FindFirstChild(studGarden.Name)\r\n\t\tassert(previous == nil, \"Resolve the existing Stud Garden template before replacing it\")\r\n\t\tstudGarden.Parent = library\r\n\tend\r\n\tlocal shipwreck = Workspace:FindFirstChild(\"Course_ShipwreckCove\")\n\tif RunService:IsRunning() and shipwreck then\n\t\tif shipwreck:IsA(\"Folder\") and shipwreck:GetAttribute(\"EditablePiecesVersion\") == 1 then\n\t\t\tshipwreck = require(ServerStorage.CourseBuilders.ShipwreckCove.Authoring).ToRuntime(shipwreck)\n\t\tend\n\t\tassert(shipwreck:IsA(\"Model\") and shipwreck:GetAttribute(\"ManualEditing\") == true, \"Preserve Shipwreck editing model\")\n\t\tlocal warnings = validateCourseModel(shipwreck, true)\n\t\tassert(#warnings == 0, \"Shipwreck candidate is incomplete: \" .. table.concat(warnings, \"; \"))\n\t\tlocal library = ensureCourseLibrary()\n\t\tlocal previous = library:FindFirstChild(shipwreck.Name)\n\t\tif previous then\n\t\t\tprevious.Name = getUniqueArchiveName(\"Shipwreck_BeforeEditing\")\n\t\t\tprevious.Parent = ensureCourseArchive()\n\t\tend\n\t\tshipwreck.Parent = library\n\tend\n\tlocal cityRun = Workspace:FindFirstChild(\"Course_CityRun\")\r\n\tif RunService:IsRunning() and cityRun ~= nil then\r\n\t\tassert(cityRun:IsA(\"Model\") and cityRun:GetAttribute(\"ManualEditing\") == true,\r\n\t\t\t\"The visible City Run must be marked ManualEditing before Play\")\r\n\t\tlocal warnings = validateCourseModel(cityRun, true)\r\n\t\tassert(#warnings == 0, \"City Run is incomplete: \" .. table.concat(warnings, \"; \"))\r\n\t\tassert(readCourseInfo(cityRun).courseId == \"city_run\", \"Unexpected City Run identity\")\r\n\t\tlocal library = ensureCourseLibrary()\r\n\t\tlocal previous = library:FindFirstChild(\"Course_CityRun\")\r\n\t\tif previous ~= nil then\r\n\t\t\tprevious.Name = getUniqueArchiveName(\"CityRun_BeforeEditing\")\r\n\t\t\tprevious.Parent = ensureCourseArchive()\r\n\t\tend\r\n\t\tcityRun.Parent = library\r\n\tend\r\n\t-- Play receives a copy of the saved Workspace; moving it here leaves Edit-mode work intact.\r\n\tlocal editable = Workspace:FindFirstChild(CourseConfig.EditableCourseModelName)\r\n\tif RunService:IsRunning() and editable ~= nil then\r\n\t\tassert(editable:IsA(\"Model\") and editable:GetAttribute(CourseConfig.ManualEditingAttribute) == true,\r\n\t\t\t\"The visible Classic Ascent must be marked ManualEditing before Play\")\r\n\t\tassert(editable:GetAttribute(\"BuilderVersion\") == 7, \"Restore V7 before using the editing course\")\r\n\t\tlocal warnings = validateCourseModel(editable, true)\r\n\t\tassert(#warnings == 0, \"The editing course is incomplete: \" .. table.concat(warnings, \"; \"))\r\n\t\tlocal library = ensureCourseLibrary()\r\n\t\tlocal previous = library:FindFirstChild(CourseConfig.EditableCourseModelName)\r\n\t\tif previous ~= nil then\r\n\t\t\tprevious.Name = getUniqueArchiveName(\"ClassicAscent_BeforeEditing\")\r\n\t\t\tprevious.Parent = ensureCourseArchive()\r\n\t\tend\r\n\t\teditable.Parent = library\r\n\tend\r\n\tensureClassicPointToPointCourseFromFallback()\r\n\tif CourseConfig.AutoBuildClassicAscent then\n\t\tlocal classicAscentBuilder = require(ServerStorage.CourseBuilders.ClassicAscentPointToPoint)\n\t\tclassicAscentBuilder.Ensure(ensureCourseLibrary())\n\tend\n\tdiscoverCourseLibrary()\r\nend\r\n\r\nlocal function ensureActiveCourse()\r\n\tprepareCourseLibrary()\r\n\r\n\tlocal selectedRecord = selectActiveCourseRecord()\r\n\r\n\tif selectedRecord ~= nil and spawnCourseRecord(selectedRecord) then\r\n\t\treturn\r\n\tend\r\n\r\n\tlocal fallbackCourse = getFallbackActiveCourse()\r\n\r\n\tif fallbackCourse == nil then\r\n\t\twarn(\"[CourseService] No active course could be spawned and no Workspace.RaceCourse fallback exists.\")\r\n\t\treturn\r\n\tend\r\n\r\n\tlocal warnings = validateCourseModel(fallbackCourse, false)\r\n\r\n\tfor _, warningMessage in ipairs(warnings) do\r\n\t\twarn(string.format(\"[CourseService] Active fallback %s: %s\", fallbackCourse.Name, warningMessage))\r\n\tend\r\n\r\n\tactiveCourseInfo = readCourseInfo(fallbackCourse)\r\n\tprint(string.format(\"[CourseService] Using active course fallback: %s.\", activeCourseInfo.displayName))\r\nend\r\n\r\nlocal function getActiveCourseInfo(): CourseInfo\r\n\tlocal activeCourse = getFallbackActiveCourse()\r\n\r\n\tif activeCourse ~= nil then\r\n\t\tactiveCourseInfo = readCourseInfo(activeCourse)\r\n\telseif activeCourseInfo == nil then\r\n\t\tactiveCourseInfo = {\r\n\t\t\tcourseId = CourseConfig.DefaultCourseInfo.CourseId,\r\n\t\t\tdisplayName = CourseConfig.DefaultCourseInfo.DisplayName,\r\n\t\t\traceFormat = normalizeRaceFormat(CourseConfig.DefaultCourseInfo.RaceFormat),\r\n\t\t\tlapCount = CourseConfig.DefaultCourseInfo.LapCount,\r\n\t\t\tenabled = CourseConfig.DefaultCourseInfo.Enabled,\r\n\t\t\tdifficulty = CourseConfig.DefaultCourseInfo.Difficulty,\r\n\t\t\ttargetNewPlayerTime = CourseConfig.DefaultCourseInfo.TargetNewPlayerTime,\r\n\t\t\ttargetPracticedTime = CourseConfig.DefaultCourseInfo.TargetPracticedTime,\r\n\t\t\tcheckpointCount = CourseConfig.DefaultCourseInfo.CheckpointCount,\r\n\t\t}\r\n\tend\r\n\r\n\treturn activeCourseInfo :: CourseInfo\r\nend\r\n\r\nfunction CourseService.Init(_context: ServiceContext?)\r\n\tif isInitialized then\r\n\t\treturn\r\n\tend\r\n\r\n\tisInitialized = true\r\nend\r\n\r\nfunction CourseService.Start(_context: ServiceContext?)\r\n\tif not isInitialized then\r\n\t\twarn(\"[CourseService] Start called before Init.\")\r\n\t\treturn\r\n\tend\r\n\r\n\tif isStarted then\r\n\t\treturn\r\n\tend\r\n\r\n\tisStarted = true\r\n\tinspectionMode = false\r\n\tprepareCourseLibrary()\r\n\tif not inspectionMode then CourseService.UnloadActiveCourse() end\r\nend\r\n\r\nfunction CourseService.UnloadActiveCourse()\r\n\tif inspectionMode then return end\r\n\tlocal course = getFallbackActiveCourse()\r\n\tif course ~= nil then\r\n\t\tif course:GetAttribute(CourseConfig.RuntimeActiveCourseAttribute) == true then\r\n\t\t\tcourse:Destroy()\r\n\t\telse\r\n\t\t\tarchiveExistingActiveCourse(course)\r\n\t\tend\r\n\tend\r\n\tactiveCourseInfo = nil\r\nend\r\n\r\nfunction CourseService.CanSelectCourseForStudio(courseId: string): boolean\r\n    if not RunService:IsStudio() then return false end\r\n    local record = discoveredCoursesById[courseId]\r\n    return record ~= nil and isPlayableCourseRecord(record, true)\r\nend\r\n\r\nfunction CourseService.SelectCourseForStudio(courseId: string): boolean\r\n    if not CourseService.CanSelectCourseForStudio(courseId) then return false end\r\n    studioCourseId = courseId\r\n    return true\r\nend\r\n\r\nfunction CourseService.GetSelectedCourseId(): string\r\n    return studioCourseId or CourseConfig.ActiveCourseId\r\nend\r\n\r\nfunction CourseService.DiscoverCourses()\r\n\tdiscoverCourseLibrary()\r\nend\r\n\r\nfunction CourseService.EnsureActiveCourse()\r\n\tif inspectionMode then return end\r\n\tensureActiveCourse()\r\nend\r\n\r\nfunction CourseService.IsInspectionMode(): boolean\r\n\treturn inspectionMode\r\nend\r\n\r\nfunction CourseService.GetDiscoveredCourseIds(): { string }\r\n\tlocal courseIds = {}\r\n\r\n\tfor index, courseId in ipairs(discoveredCourseOrder) do\r\n\t\tcourseIds[index] = courseId\r\n\tend\r\n\r\n\treturn courseIds\r\nend\r\n\r\nfunction CourseService.GetEligibleCourses(): {CourseInfo}\r\n\tdiscoverCourseLibrary()\r\n\tlocal result = {}\r\n\tfor _, id in discoveredCourseOrder do\r\n\t\tlocal record = discoveredCoursesById[id]\r\n\t\tif record.model.Parent == getCourseLibrary() and isPlayableCourseRecord(record) then\r\n\t\t\trecord.info = readCourseInfo(record.model)\r\n\t\t\tif record.info.enabled then table.insert(result,table.clone(record.info)) end\r\n\t\tend\r\n\tend\r\n\treturn result\r\nend\r\n\r\nfunction CourseService.LoadTournamentCourse(courseId: string,isCurrent: (() -> boolean)?): boolean\r\n\tif inspectionMode then return false end\r\n\tprepareCourseLibrary()\r\n\tlocal record = discoveredCoursesById[courseId]\r\n\tif not record or not isPlayableCourseRecord(record) then return false end\r\n\treturn spawnCourseRecord(record,isCurrent) and CourseService.GetActiveCourseId() == courseId\r\nend\r\n\r\nfunction CourseService.GetCourseInfo(courseId: string): CourseInfo?\r\n\tlocal record = discoveredCoursesById[courseId]\r\n\r\n\tif record == nil then\r\n\t\treturn nil\r\n\tend\r\n\r\n\treturn record.info\r\nend\r\n\r\nfunction CourseService.GetActiveCourse(): Model?\r\n\treturn getFallbackActiveCourse()\r\nend\r\n\r\nfunction CourseService.GetActiveCourseModel(): Model?\r\n\treturn CourseService.GetActiveCourse()\r\nend\r\n\r\nfunction CourseService.GetActiveCourseInfo(): CourseInfo\r\n\treturn getActiveCourseInfo()\r\nend\r\n\r\nfunction CourseService.GetActiveCourseId(): string\r\n\treturn CourseService.GetActiveCourseInfo().courseId\r\nend\r\n\r\nfunction CourseService.GetActiveCourseDisplayName(): string\r\n\treturn CourseService.GetActiveCourseInfo().displayName\r\nend\r\n\r\nfunction CourseService.GetStartPart(): BasePart?\r\n\treturn getBasePart(CourseService.GetActiveCourse(), CourseConfig.RequiredChildNames.Start)\r\nend\r\n\r\nfunction CourseService.GetFinishPart(): BasePart?\r\n\treturn getBasePart(CourseService.GetActiveCourse(), CourseConfig.RequiredChildNames.Finish)\r\nend\r\n\r\nfunction CourseService.GetCheckpointsFolder(): Folder?\r\n\treturn getFolder(CourseService.GetActiveCourse(), CourseConfig.RequiredChildNames.Checkpoints)\r\nend\r\n\r\nfunction CourseService.GetOrderedCheckpoints(): { OrderedCheckpoint }\r\n\treturn discoverOrderedCheckpoints(CourseService.GetCheckpointsFolder())\r\nend\r\n\r\nfunction CourseService.GetFallZonesFolder(): Folder?\r\n\treturn getFolder(CourseService.GetActiveCourse(), CourseConfig.RequiredChildNames.FallZones)\r\nend\r\n\r\nfunction CourseService.GetFallZoneMain(): BasePart?\r\n\tlocal fallZonesFolder = CourseService.GetFallZonesFolder()\r\n\r\n\treturn getBasePart(fallZonesFolder, CourseConfig.RequiredChildNames.FallZoneMain)\r\nend\r\n\r\nfunction CourseService.GetFallZones(): { BasePart }\r\n\treturn discoverFallZones(CourseService.GetFallZonesFolder())\r\nend\r\n\r\nfunction CourseService.GetMainFallZone(): BasePart?\r\n\treturn CourseService.GetFallZoneMain()\r\nend\r\n\r\nfunction CourseService.GetRaceFormat(): RaceFormat\r\n\treturn CourseService.GetActiveCourseInfo().raceFormat\r\nend\r\n\r\nfunction CourseService.GetLapCount(): number\r\n\treturn CourseService.GetActiveCourseInfo().lapCount\r\nend\r\n\r\nfunction CourseService.ValidateCourseModel(courseModel: Model, requireAuthoringFolders: boolean?): { string }\r\n\treturn validateCourseModel(courseModel, requireAuthoringFolders == true)\r\nend\r\n\r\nreturn CourseService\r\n"}]]==])
local newSources=game.HttpService:JSONDecode([==[[{"path":["ServerStorage","CourseBuilders","StudGardenV2","CourseRuntime"],"source":"--!strict\n\nlocal Sprinkler=require(script.Parent.Runtime)\nlocal Fruit=require(script.Parent.FruitRuntime)\nlocal CourseRuntime={}\n\nfunction CourseRuntime.Start(course: Model,eligible: (Player)->boolean,recover: (Player,string)->boolean)\n\tassert(course:GetAttribute(\"CourseId\")==\"stud_garden_v2\",\"Full V2 course required\")\n\tlocal giants=course:FindFirstChild(\"GardenGiants\")\n\tif giants then\n\t\t-- Cloning an avatar can restore torso collision even with its state machine disabled.\n\t\tfor _,part in giants:GetDescendants() do\n\t\t\tif part:IsA(\"Humanoid\") then part.EvaluateStateMachine=false\n\t\t\telseif part:IsA(\"BasePart\") then part.CanCollide=false;part.CanTouch=false;part.CanQuery=false end\n\t\tend\n\tend\n\tlocal sprinkler=Sprinkler.Start(course,eligible,recover)\n\tlocal ok,fruit=pcall(Fruit.Start,course.H2_Fruit,eligible,recover)\n\tif not ok then sprinkler.Stop();error(fruit) end\n\treturn {\n\t\tStop=function() sprinkler.Stop();fruit.Stop() end,\n\t\tDiagnostics=function() return {sprinkler=sprinkler.Diagnostics(),fruit=fruit.Diagnostics()} end,\n\t}\nend\n\nreturn CourseRuntime\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","FruitMotion"],"source":"--!strict\n\nlocal FruitMotion={}\n\nfunction FruitMotion.Position(alpha: number,index: number,catchDrop: number?): Vector3\n\tlocal progress=math.clamp((alpha-(index-1)*.12)/.76,0,1)\n\tlocal x=-17+38*progress\n\tlocal fall=(catchDrop or 0)*math.clamp((x-13.6)/7.4,0,1)\n\treturn Vector3.new(x,2.8-fall,(index-2)*8)\nend\n\nfunction FruitMotion.Segments(first: number,last: number,index: number,catchDrop: number?): {Vector3}\n\tlocal points={FruitMotion.Position(first,index,catchDrop)}\n\tlocal corner=(index-1)*.12+.76*(13.6+17)/38\n\tif (catchDrop or 0)>0 and first<corner and last>corner then table.insert(points,FruitMotion.Position(corner,index,catchDrop)) end\n\ttable.insert(points,FruitMotion.Position(last,index,catchDrop))\n\treturn points\nend\n\nfunction FruitMotion.SweepTouchesBody(first: Vector3,last: Vector3,radius: number,frame: CFrame,size: Vector3): boolean\n\tlocal a=frame:PointToObjectSpace(first)\n\tlocal direction=frame:VectorToObjectSpace(last-first)\n\tlocal half=size/2\n\tlocal starts,steps,extents={a.X,a.Y,a.Z},{direction.X,direction.Y,direction.Z},{half.X,half.Y,half.Z}\n\tlocal breaks={0,1}\n\tfor axis=1,3 do\n\t\tif math.abs(steps[axis])>.000001 then\n\t\t\tfor _,side in {-1,1} do\n\t\t\t\tlocal t=(side*extents[axis]-starts[axis])/steps[axis]\n\t\t\t\tif t>0 and t<1 then table.insert(breaks,t) end\n\t\t\tend\n\t\tend\n\tend\n\ttable.sort(breaks)\n\t-- Between face crossings, squared distance to the body box is a quadratic.\n\tfor i=1,#breaks-1 do\n\t\tlocal low,high=breaks[i],breaks[i+1]\n\t\tlocal mid=(low+high)/2\n\t\tlocal quadratic,linear=0,0\n\t\tfor axis=1,3 do\n\t\t\tlocal value=starts[axis]+steps[axis]*mid\n\t\t\tif math.abs(value)>extents[axis] then\n\t\t\t\tlocal offset=starts[axis]-math.sign(value)*extents[axis]\n\t\t\t\tquadratic+=steps[axis]^2;linear+=steps[axis]*offset\n\t\t\tend\n\t\tend\n\t\tlocal t=if quadratic>0 then math.clamp(-linear/quadratic,low,high) else mid\n\t\tlocal distanceSquared=0\n\t\tfor axis=1,3 do distanceSquared+=math.max(0,math.abs(starts[axis]+steps[axis]*t)-extents[axis])^2 end\n\t\tif distanceSquared<=radius^2 then return true end\n\tend\n\treturn false\nend\n\nreturn FruitMotion\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","FruitRuntime"],"source":"--!strict\n\nlocal RunService=game:GetService(\"RunService\")\nlocal Players=game:GetService(\"Players\")\nlocal Phase=require(script.Parent.HazardState)\nlocal Motion=require(script.Parent.FruitMotion)\nlocal Wayfinding=require(script.Parent.Wayfinding)\nlocal HazardClock=require(script.Parent.HazardClock)\nlocal FruitRuntime={}\n\nfunction FruitRuntime.Start(hazard: Model,eligible: (Player)->boolean,recover: (Player,string)->boolean)\n\tassert(RunService:IsServer() and RunService:IsRunning(),\"Runtime server required\")\n\tassert(hazard:GetAttribute(\"SGV2Owned\")==true and not hazard:GetAttribute(\"FruitRuntimeActive\"),\"Owned inactive fruit encounter required\")\n\tassert(math.abs(hazard:GetScale()-1)<.001,\"Translate/rotate complete encounter; scaling unsupported\")\n\tlocal timing={Clear=hazard:GetAttribute(\"ClearSeconds\") or 7,Warning=hazard:GetAttribute(\"WarningSeconds\") or 1.5,Active=hazard:GetAttribute(\"ActiveSeconds\") or 3.2}\n\tassert(timing.Clear>=5 and timing.Warning>=1.5 and timing.Active>=2.6,\"Preserve warning and crossing windows\")\n\tlocal frame=hazard:GetPivot()\n\tlocal catchDrop=hazard:GetAttribute(\"CatchDrop\") or 0\n\tlocal lamp=hazard.WarningLamp :: BasePart\n\tlocal fruits={hazard.Fruit_1,hazard.Fruit_2,hazard.Fruit_3}\n\tlocal saved={lamp=lamp.Color,frames={}}\n\tlocal originalStatus=Wayfinding.CaptureStatus(hazard)\n\tfor _,fruit in fruits do table.insert(saved.frames,fruit:GetPivot()) end\n\tlocal clock=HazardClock.New(workspace:GetServerTimeNow())\n\tlocal cooldowns: {[Player]: number}={}\n\tlocal report={steps=0,contacts=0,recoveries=0,pausedStalls=0,maxStepMs=0}\n\thazard:SetAttribute(\"FruitRuntimeActive\",true)\n\tlocal connection=RunService.Heartbeat:Connect(function()\n\t\tlocal before=os.clock()\n\t\tlocal previous,elapsed,advanced=HazardClock.Step(clock,workspace:GetServerTimeNow())\n\t\tif not advanced then report.pausedStalls=clock.pausedStalls;return end\n\t\tlocal phase,alpha=Phase.Phase(elapsed,timing)\n\t\tlocal remaining=if phase==\"Clear\" then timing.Clear*(1-alpha) else 0\n\t\tlocal entry=Wayfinding.UpdateHazard(hazard,\"FRUIT\",phase,alpha,timing,hazard:GetAttribute(\"MinimumEntrySeconds\") or 3.5)\n\t\tfor index,fruit in fruits do\n\t\t\tlocal parked=Vector3.new(hazard:GetAttribute(\"ParkedX\") or -22,5.7,(index-2)*8)\n\t\t\tlocal position=if phase==\"Active\" then Motion.Position(alpha,index,catchDrop) elseif phase==\"Warning\" then parked:Lerp(Motion.Position(0,index,catchDrop),alpha) else parked\n\t\t\tfruit:PivotTo(frame*CFrame.new(position)*CFrame.Angles(0,0,if phase==\"Active\" then -(position.X+17)/2.4 else 0))\n\t\tend\n\t\thazard:SetAttribute(\"Phase\",phase);hazard:SetAttribute(\"PhaseAlpha\",alpha);hazard:SetAttribute(\"ClearRemaining\",remaining);hazard:SetAttribute(\"EntryOpen\",entry)\n\t\tdo\n\t\t\tlocal intervals=Phase.ActiveIntervals(previous,elapsed,timing)\n\t\t\tif #intervals>0 then for _,player in Players:GetPlayers() do\n\t\t\t\tlocal character=player.Character\n\t\t\t\tlocal root=character and character:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\t\t\t\tlocal humanoid=character and character:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\tif character and root and humanoid and humanoid.Health>0 and (root.Position-frame.Position).Magnitude<60 and eligible(player) and (cooldowns[player] or 0)<elapsed then\n\t\t\t\t\tlocal hit=false\n\t\t\t\t\tfor _,body in character:GetChildren() do\n\t\t\t\t\t\tif body:IsA(\"BasePart\") and body.Name~=\"HumanoidRootPart\" then\n\t\t\t\t\t\t\tfor index=1,3 do for _,interval in intervals do\n\t\t\t\t\t\t\t\t\tlocal positions=Motion.Segments(interval[1],interval[2],index,catchDrop)\n\t\t\t\t\t\t\t\t\tfor segment=1,#positions-1 do\n\t\t\t\t\t\t\t\t\t\treport.contacts+=1\n\t\t\t\t\t\t\t\t\t\tif Motion.SweepTouchesBody(frame*positions[segment],frame*positions[segment+1],2.4,body.CFrame,body.Size) then hit=true;break end\n\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\t\tif hit then break end\n\t\t\t\t\t\t\tend;if hit then break end end\n\t\t\t\t\t\tend\n\t\t\t\t\t\tif hit then break end\n\t\t\t\t\tend\n\t\t\t\t\tif hit then cooldowns[player]=elapsed+1;if recover(player,\"SGV2_H2\") then report.recoveries+=1 end end\n\t\t\t\tend\n\t\t\tend end\n\t\tend\n\t\treport.steps+=1;report.maxStepMs=math.max(report.maxStepMs,(os.clock()-before)*1000)\n\tend)\n\tlocal stopped=false\n\treturn {\n\t\tDiagnostics=function() return table.clone(report) end,\n\t\tStop=function()\n\t\t\tif stopped then return end;stopped=true;connection:Disconnect()\n\t\t\tfor index,fruit in fruits do fruit:PivotTo(saved.frames[index]) end\n\t\t\tlamp.Color=saved.lamp\n\t\t\tWayfinding.RestoreStatus(originalStatus)\n\t\t\tfor _,name in {\"Phase\",\"PhaseAlpha\",\"ClearRemaining\",\"EntryOpen\",\"FruitRuntimeActive\"} do hazard:SetAttribute(name,nil) end\n\t\tend,\n\t}\nend\n\nreturn FruitRuntime\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","HazardClock"],"source":"--!strict\n\nlocal HazardClock={}\nexport type State={wall: number,elapsed: number,pausedStalls: number}\n\nfunction HazardClock.New(now: number): State\n\treturn {wall=now,elapsed=0,pausedStalls=0}\nend\n\nfunction HazardClock.Step(state: State,now: number): (number,number,boolean)\n\tlocal previous=state.elapsed\n\tlocal dt=now-state.wall\n\tstate.wall=now\n\t-- Hold motion and warnings together instead of skipping an unchecked sweep.\n\tif dt<=0 or dt>.2 then\n\t\tif dt>.2 then state.pausedStalls+=1 end\n\t\treturn previous,previous,false\n\tend\n\tstate.elapsed+=dt\n\treturn previous,state.elapsed,true\nend\n\nreturn HazardClock\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","HazardState"],"source":"--!strict\n\nlocal HazardState = {}\n\nexport type Timing = {\n\tClear: number,\n\tWarning: number,\n\tActive: number,\n\tOffset: number?,\n}\n\nfunction HazardState.Phase(elapsed: number, timing: Timing): (string, number)\n\tlocal cycle = timing.Clear + timing.Warning + timing.Active\n\tlocal age = (math.max(0, elapsed) + (timing.Offset or 0)) % cycle\n\tif age < timing.Clear then\n\t\treturn \"Clear\", age / timing.Clear\n\tend\n\tif age < timing.Clear + timing.Warning then\n\t\treturn \"Warning\", (age - timing.Clear) / timing.Warning\n\tend\n\treturn \"Active\", (age - timing.Clear - timing.Warning) / timing.Active\nend\n\nfunction HazardState.ActiveIntervals(previous: number, current: number, timing: Timing): {{number}}\n\tlocal intervals = {}\n\tif current < previous then\n\t\treturn intervals\n\tend\n\tlocal cycle = timing.Clear + timing.Warning + timing.Active\n\tlocal offset = timing.Offset or 0\n\tfor lap = math.floor((previous + offset) / cycle), math.floor((current + offset) / cycle) do\n\t\tlocal start = lap * cycle - offset + timing.Clear + timing.Warning\n\t\tlocal first, last = math.max(previous, start), math.min(current, start + timing.Active)\n\t\tif last > first then\n\t\t\ttable.insert(intervals, {math.clamp((first - start) / timing.Active, 0, 1),\n\t\t\t\tmath.clamp((last - start) / timing.Active, 0, 1)})\n\t\tend\n\tend\n\treturn intervals\nend\n\nfunction HazardState.CanContact(active: boolean, eligible: boolean, alive: boolean, now: number,\n\trecoveryUntil: number, lastRecovery: number?, cooldown: number, elapsedDt: number, maxDt: number): boolean\n\treturn active and eligible and alive and elapsedDt > 0 and elapsedDt <= maxDt\n\t\tand recoveryUntil <= now\n\t\tand (lastRecovery == nil or now - lastRecovery >= cooldown)\nend\n\nreturn HazardState\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","Runtime"],"source":"--!strict\n\nlocal RunService=game:GetService(\"RunService\")\nlocal Players=game:GetService(\"Players\")\nlocal Geometry=require(game.ReplicatedStorage.Shared.ShipwreckHazards)\nlocal Phase=require(script.Parent.HazardState)\nlocal Wayfinding=require(script.Parent.Wayfinding)\nlocal HazardClock=require(script.Parent.HazardClock)\nlocal Runtime={}\n\nfunction Runtime.Start(course: Model, eligible: (Player)->boolean, recover: (Player,string)->boolean)\n\tassert(RunService:IsServer() and RunService:IsRunning(),\"Runtime server required\")\n\tassert(course:GetAttribute(\"SGV2Owned\")==true,\"V2 course required\")\n\tassert(course:GetAttribute(\"SGV2RuntimeActive\")~=true,\"Runtime is already active\")\n\tlocal hazard=course:FindFirstChild(\"H1_Sprinkler\") :: Model\n\tassert(hazard and hazard:IsA(\"Model\"),\"Sprinkler assembly required\")\n\tassert(math.abs(hazard:GetScale()-1)<0.001,\"Move/rotate the complete encounter; scaling is not supported\")\n\tlocal water=hazard:FindFirstChild(\"WaterSweep\") :: BasePart\n\tlocal lamp=hazard:FindFirstChild(\"WarningLamp\") :: BasePart\n\tlocal nozzle=hazard:FindFirstChild(\"NozzleCap\") :: BasePart\n\tlocal jets=hazard:FindFirstChild(\"WaterJets\")\n\tassert(water and lamp and nozzle,\"Hazard visuals required\")\n\tlocal frame=hazard:GetPivot()\n\tlocal curtainCenter=.5+water.Size.Y/2\n\tlocal nozzleHeight=hazard:GetAttribute(\"NozzleHeight\") or 6\n\tlocal timing={Clear=hazard:GetAttribute(\"ClearSeconds\") or 6.5,Warning=hazard:GetAttribute(\"WarningSeconds\") or 1.5,Active=hazard:GetAttribute(\"ActiveSeconds\") or 2}\n\tassert(timing.Clear>=5 and timing.Warning>=1.2 and timing.Active>0,\"Keep a usable clear window and warning\")\n\tlocal original={water=water.CFrame,transparency=water.Transparency,lamp=lamp.Color,nozzle=nozzle.CFrame}\n\tlocal originalJets={}\n\tif jets then for _,jet in jets:GetChildren() do\n\t\tif jet:IsA(\"BasePart\") then table.insert(originalJets,{part=jet,frame=jet.CFrame,transparency=jet.Transparency}) end\n\tend end\n\tlocal originalStatus=Wayfinding.CaptureStatus(hazard)\n\tlocal clock=HazardClock.New(workspace:GetServerTimeNow())\n\tlocal cooldowns: {[Player]: number}={}\n\tlocal diagnostics={steps=0,contacts=0,recoveries=0,pausedStalls=0,maxStepMs=0}\n\tcourse:SetAttribute(\"SGV2RuntimeActive\",true)\n\tlocal function sweep(alpha: number): CFrame\n\t\treturn frame*CFrame.new(0,curtainCenter,-8+16*alpha)\n\tend\n\tlocal function step()\n\t\tlocal before=os.clock()\n\t\tlocal lastElapsed,elapsed,advanced=HazardClock.Step(clock,workspace:GetServerTimeNow())\n\t\tif not advanced then diagnostics.pausedStalls=clock.pausedStalls;return end\n\t\tlocal phase,alpha=Phase.Phase(elapsed,timing)\n\t\twater.CFrame=sweep(if phase==\"Active\" then alpha else 0)\n\t\twater.Transparency=if phase==\"Active\" then 0.78 else 1\n\t\tlocal remaining=if phase==\"Clear\" then timing.Clear*(1-alpha) else 0\n\t\tlocal entryOpen=Wayfinding.UpdateHazard(hazard,\"SPRINKLER\",phase,alpha,timing,hazard:GetAttribute(\"MinimumEntrySeconds\") or 3.2)\n\t\tnozzle.CFrame=frame*CFrame.new(0,nozzleHeight,-8+16*(if phase==\"Active\" then alpha else 0))\n\t\tif jets then for _,jet in jets:GetChildren() do\n\t\t\tif jet:IsA(\"BasePart\") then\n\t\t\t\tjet.CFrame=frame*CFrame.new(jet:GetAttribute(\"Across\"),curtainCenter,-8+16*(if phase==\"Active\" then alpha else 0))\n\t\t\t\tjet.Transparency=if phase==\"Active\" then 0.16 else 1\n\t\t\tend\n\t\tend end\n\t\thazard:SetAttribute(\"Phase\",phase)\n\t\thazard:SetAttribute(\"PhaseAlpha\",alpha)\n\t\thazard:SetAttribute(\"ClearRemaining\",if phase==\"Clear\" then timing.Clear*(1-alpha) else 0)\n\t\thazard:SetAttribute(\"EntryOpen\",entryOpen)\n\t\tdo\n\t\t\tlocal intervals=Phase.ActiveIntervals(lastElapsed,elapsed,timing)\n\t\t\tif #intervals>0 then for _,player in Players:GetPlayers() do\n\t\t\t\tlocal character=player.Character\n\t\t\t\tlocal hum=character and character:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\tif character and hum and hum.Health>0 and eligible(player) and (cooldowns[player] or 0)<elapsed then\n\t\t\t\t\tlocal hit=false\n\t\t\t\t\tfor _,body in character:GetChildren() do\n\t\t\t\t\t\tif body:IsA(\"BasePart\") and body.Name~=\"HumanoidRootPart\" then\n\t\t\t\t\t\t\tfor _,interval in intervals do\n\t\t\t\t\t\t\t\tdiagnostics.contacts+=1\n\t\t\t\t\t\t\t\tif Geometry.SweptBoxesIntersect(sweep(interval[1]),sweep(interval[2]),water.Size,body.CFrame,body.Size) then hit=true; break end\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\t\tif hit then break end\n\t\t\t\t\tend\n\t\t\t\t\tif hit then\n\t\t\t\t\t\tcooldowns[player]=elapsed+1\n\t\t\t\t\t\tif recover(player,\"SGV2_H1\") then diagnostics.recoveries+=1 end\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend end\n\t\tend\n\t\tdiagnostics.steps+=1\n\t\tdiagnostics.maxStepMs=math.max(diagnostics.maxStepMs,(os.clock()-before)*1000)\n\tend\n\tlocal connection=RunService.Heartbeat:Connect(step)\n\tlocal stopped=false\n\treturn {\n\t\tDiagnostics=function() return table.clone(diagnostics) end,\n\t\tStop=function()\n\t\t\tif stopped then return end\n\t\t\tstopped=true; connection:Disconnect()\n\t\t\twater.CFrame=original.water; water.Transparency=original.transparency\n\t\t\tlamp.Color=original.lamp; nozzle.CFrame=original.nozzle\n\t\t\tWayfinding.RestoreStatus(originalStatus)\n\t\t\tfor _,saved in originalJets do\n\t\t\t\tif saved.part.Parent then saved.part.CFrame=saved.frame;saved.part.Transparency=saved.transparency end\n\t\t\tend\n\t\t\thazard:SetAttribute(\"Phase\",nil); hazard:SetAttribute(\"PhaseAlpha\",nil); hazard:SetAttribute(\"ClearRemaining\",nil)\n\t\t\thazard:SetAttribute(\"EntryOpen\",nil)\n\t\t\tcourse:SetAttribute(\"SGV2RuntimeActive\",nil)\n\t\tend,\n\t}\nend\n\nreturn Runtime\n"},{"path":["ServerStorage","CourseBuilders","StudGardenV2","Wayfinding"],"source":"--!strict\n\nlocal Wayfinding={}\n\nfunction Wayfinding.SetStatus(hazard: Instance,words: string,color: Color3?)\n\tlocal board=hazard:FindFirstChild(\"StatusBoard\")\n\tif board and board:GetAttribute(\"DisplayedStatus\")~=words then\n\t\tboard:SetAttribute(\"DisplayedStatus\",words)\n\t\tfor _,v in board:GetDescendants() do if v:IsA(\"TextLabel\") then v.Text=words end end\n\tend\n\tif board and board:IsA(\"BasePart\") and color then board.Color=color end\nend\n\nfunction Wayfinding.CaptureStatus(hazard: Instance)\n\tlocal saved={parts={},labels={},board=hazard:FindFirstChild(\"StatusBoard\")}\n\tif saved.board then saved.status=saved.board:GetAttribute(\"DisplayedStatus\") end\n\tfor _,part in hazard:GetChildren() do\n\t\tif part:IsA(\"BasePart\") and (part.Name==\"StatusBoard\" or part:GetAttribute(\"TimedWarningStripe\")==true) then\n\t\t\ttable.insert(saved.parts,{part=part,color=part.Color})\n\t\t\tfor _,label in part:GetDescendants() do\n\t\t\t\tif label:IsA(\"TextLabel\") then table.insert(saved.labels,{label=label,text=label.Text}) end\n\t\t\tend\n\t\tend\n\tend\n\treturn saved\nend\n\nfunction Wayfinding.RestoreStatus(saved)\n\tfor _,record in saved.parts do record.part.Color=record.color end\n\tfor _,record in saved.labels do record.label.Text=record.text end\n\tif saved.board then saved.board:SetAttribute(\"DisplayedStatus\",saved.status) end\nend\n\nfunction Wayfinding.UpdateHazard(hazard: Instance,title: string,phase: string,alpha: number,timing,minimumEntry: number): boolean\n\tlocal remaining=if phase==\"Clear\" then timing.Clear*(1-alpha) else 0\n\tlocal entryOpen=phase==\"Clear\" and remaining>=minimumEntry\n\tlocal color=if entryOpen then Color3.fromRGB(129,205,75) elseif phase==\"Active\" then Color3.fromRGB(245,110,82) else Color3.fromRGB(255,204,74)\n\tlocal waitSeconds=if phase==\"Clear\" then remaining+timing.Warning+timing.Active elseif phase==\"Warning\" then timing.Warning*(1-alpha)+timing.Active else timing.Active*(1-alpha)\n\tlocal words=if entryOpen then string.format(\"%s: GO\\nENTER NOW  %ds\\nKeep moving\",title,math.ceil(remaining-minimumEntry))\n\t\telse string.format(\"%s: %s\\nOPENS IN %ds\\nStay behind line\",title,if phase==\"Active\" then \"STOP\" else \"WAIT\",math.ceil(waitSeconds))\n\tWayfinding.SetStatus(hazard,words,color)\n\tlocal lamp=hazard:FindFirstChild(\"WarningLamp\")\n\tif lamp and lamp:IsA(\"BasePart\") then lamp.Color=color end\n\tfor _,stripe in hazard:GetChildren() do\n\t\tif stripe:IsA(\"BasePart\") and stripe:GetAttribute(\"TimedWarningStripe\")==true then\n\t\t\tstripe.Color=if phase==\"Warning\" and math.floor(alpha*6)%2==0 then Color3.fromRGB(255,239,201) else color\n\t\tend\n\tend\n\treturn entryOpen\nend\n\nreturn Wayfinding\n"},{"path":["ServerScriptService","Services","StudGardenService"],"source":"--!strict\n\nlocal RunService = game:GetService(\"RunService\")\nlocal Runtime = require(game.ServerStorage.CourseBuilders.StudGardenV2.CourseRuntime)\nlocal RaceConstants = require(game.ReplicatedStorage.Shared.RaceConstants)\n\nlocal Service = {}\nlocal services: any\nlocal heartbeat: RBXScriptConnection? = nil\nlocal boundCourse: Model? = nil\nlocal controller: any = nil\n\nfunction Service.Init(context: any)\n\tservices = context.Services\nend\n\nlocal function isEligible(player: Player): boolean\n\treturn services.RaceService.IsRaceActive() == true\n\t\tand services.PlayerRaceService.IsOfficialRacer(player) == true\n\t\tand services.PlayerRaceService.GetPlayerStatus(player) == RaceConstants.PlayerRaceStatus.Racing\nend\n\nfunction Service.Start()\n\tif heartbeat ~= nil then\n\t\treturn\n\tend\n\tassert(services ~= nil, \"StudGardenService.Init must run before Start\")\n\theartbeat = RunService.Heartbeat:Connect(function()\n\t\tlocal course = services.CourseService.GetActiveCourse()\n\t\tlocal active = services.RaceService.IsRaceActive() == true\n\t\tlocal isStudGarden = course ~= nil and course:GetAttribute(\"CourseId\") == \"stud_garden_v2\"\n\t\t\tand course:GetAttribute(\"SGV2Owned\") == true\n\t\tlocal target = if isStudGarden and active then course else nil\n\t\tif target == boundCourse then\n\t\t\treturn\n\t\tend\n\t\tif controller ~= nil then\n\t\t\tcontroller.Stop()\n\t\tend\n\t\tcontroller = nil\n\t\tboundCourse = target\n\t\tif target ~= nil then\n\t\t\tcontroller = Runtime.Start(target, isEligible, services.RespawnService.RecoverPlayer)\n\t\tend\n\tend)\nend\n\nfunction Service.Stop()\n\tif heartbeat ~= nil then\n\t\theartbeat:Disconnect()\n\t\theartbeat = nil\n\tend\n\tif controller ~= nil then\n\t\tcontroller.Stop()\n\t\tcontroller = nil\n\tend\n\tboundCourse = nil\nend\n\nfunction Service.GetDiagnostics(): any\n\treturn if controller ~= nil then controller.Diagnostics() else {bound = false}\nend\n\nreturn Service\n"},{"path":["ServerScriptService","Services","CourseService"],"source":"--!strict\r\n\r\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\r\nlocal ServerStorage = game:GetService(\"ServerStorage\")\r\nlocal Workspace = game:GetService(\"Workspace\")\r\nlocal RunService = game:GetService(\"RunService\")\r\n\r\nlocal CheckpointConfig = require(ReplicatedStorage.Config.CheckpointConfig)\r\nlocal CourseConfig = require(ReplicatedStorage.Config.CourseConfig)\r\nlocal RaceConstants = require(ReplicatedStorage.Shared.RaceConstants)\r\nlocal RaceTypes = require(ReplicatedStorage.Shared.RaceTypes)\r\n\r\ntype CourseInfo = RaceTypes.CourseInfo\r\ntype RaceFormat = RaceTypes.RaceFormat\r\n\r\ntype ServiceContext = {\r\n\tServices: { [string]: any },\r\n}\r\n\r\ntype CourseRecord = {\r\n\tmodel: Model,\r\n\tinfo: CourseInfo,\r\n\tvalidationWarnings: { string },\r\n}\r\n\r\ntype OrderedCheckpoint = {\r\n\tindex: number,\r\n\tname: string,\r\n\tpart: BasePart,\r\n}\r\n\r\nlocal CourseService = {}\r\n\r\nlocal isInitialized = false\r\nlocal isStarted = false\r\nlocal inspectionMode = false\r\nlocal studioCourseId: string? = nil\r\nlocal discoveredCoursesById: { [string]: CourseRecord } = {}\r\nlocal discoveredCourseOrder: { string } = {}\r\nlocal activeCourseInfo: CourseInfo? = nil\r\n\r\nlocal function getCourseLibrary(): Folder?\r\n\tlocal library = ServerStorage:FindFirstChild(CourseConfig.CourseLibraryName)\r\n\r\n\tif library ~= nil and library:IsA(\"Folder\") then\r\n\t\treturn library\r\n\tend\r\n\r\n\treturn nil\r\nend\r\n\r\nlocal function ensureCourseLibrary(): Folder\r\n\tlocal library = getCourseLibrary()\r\n\r\n\tif library ~= nil then\r\n\t\treturn library\r\n\tend\r\n\r\n\tlibrary = Instance.new(\"Folder\")\r\n\tlibrary.Name = CourseConfig.CourseLibraryName\r\n\tlibrary.Parent = ServerStorage\r\n\r\n\treturn library\r\nend\r\n\r\nlocal function ensureCourseArchive(): Folder\r\n\tlocal archiveRoot = ServerStorage:FindFirstChild(\"Archive\")\r\n\tif not archiveRoot then archiveRoot = Instance.new(\"Folder\"); archiveRoot.Name = \"Archive\"; archiveRoot.Parent = ServerStorage end\r\n\tlocal archive = archiveRoot:FindFirstChild(CourseConfig.CourseArchiveName)\r\n\r\n\tif archive ~= nil and archive:IsA(\"Folder\") then\r\n\t\treturn archive\r\n\tend\r\n\r\n\tarchive = Instance.new(\"Folder\")\r\n\tarchive.Name = CourseConfig.CourseArchiveName\r\n\tarchive.Parent = archiveRoot\r\n\r\n\treturn archive\r\nend\r\n\r\nlocal function getCourseInfoInstance(courseModel: Model): Instance?\r\n\treturn courseModel:FindFirstChild(CourseConfig.RequiredChildNames.CourseInfo)\r\nend\r\n\r\nlocal function ensureFolder(parent: Instance, folderName: string): Folder\r\n\tlocal existingFolder = parent:FindFirstChild(folderName)\r\n\r\n\tif existingFolder ~= nil and existingFolder:IsA(\"Folder\") then\r\n\t\treturn existingFolder\r\n\tend\r\n\r\n\tlocal folder = Instance.new(\"Folder\")\r\n\tfolder.Name = folderName\r\n\tfolder.Parent = parent\r\n\r\n\treturn folder\r\nend\r\n\r\nlocal function ensureCourseInfoInstance(courseModel: Model): Instance\r\n\treturn ensureFolder(courseModel, CourseConfig.RequiredChildNames.CourseInfo)\r\nend\r\n\r\nlocal function getStringAttribute(instance: Instance?, attributeName: string, fallback: string): string\r\n\tif instance == nil then\r\n\t\treturn fallback\r\n\tend\r\n\r\n\tlocal value = instance:GetAttribute(attributeName)\r\n\r\n\tif typeof(value) == \"string\" and value ~= \"\" then\r\n\t\treturn value\r\n\tend\r\n\r\n\treturn fallback\r\nend\r\n\r\nlocal function getBooleanAttribute(instance: Instance?, attributeName: string, fallback: boolean): boolean\r\n\tif instance == nil then\r\n\t\treturn fallback\r\n\tend\r\n\r\n\tlocal value = instance:GetAttribute(attributeName)\r\n\r\n\tif typeof(value) == \"boolean\" then\r\n\t\treturn value\r\n\tend\r\n\r\n\treturn fallback\r\nend\r\n\r\nlocal function getNumberAttribute(instance: Instance?, attributeName: string, fallback: number?): number?\r\n\tif instance == nil then\r\n\t\treturn fallback\r\n\tend\r\n\r\n\tlocal value = instance:GetAttribute(attributeName)\r\n\r\n\tif typeof(value) == \"number\" then\r\n\t\treturn value\r\n\tend\r\n\r\n\treturn fallback\r\nend\r\n\r\nlocal function normalizeRaceFormat(value: string): RaceFormat\r\n\tif value == RaceConstants.RaceFormat.LapBased then\r\n\t\treturn RaceConstants.RaceFormat.LapBased\r\n\tend\r\n\r\n\treturn RaceConstants.RaceFormat.PointToPoint\r\nend\r\n\r\nlocal function readCourseInfo(courseModel: Model): CourseInfo\r\n\tlocal attributes = CourseConfig.CourseInfoAttributes\r\n\tlocal defaults = CourseConfig.DefaultCourseInfo\r\n\tlocal courseInfoInstance = getCourseInfoInstance(courseModel)\r\n\tlocal lapCount = math.max(1, getNumberAttribute(courseInfoInstance, attributes.LapCount, defaults.LapCount) or 1)\r\n\r\n\treturn {\r\n\t\tcourseId = getStringAttribute(courseInfoInstance, attributes.CourseId, defaults.CourseId),\r\n\t\tdisplayName = getStringAttribute(courseInfoInstance, attributes.DisplayName, defaults.DisplayName),\r\n\t\traceFormat = normalizeRaceFormat(getStringAttribute(courseInfoInstance, attributes.RaceFormat, defaults.RaceFormat)),\r\n\t\tlapCount = lapCount,\r\n\t\tenabled = getBooleanAttribute(courseInfoInstance, attributes.Enabled, defaults.Enabled),\r\n\t\tdifficulty = getStringAttribute(courseInfoInstance, attributes.Difficulty, defaults.Difficulty),\r\n\t\ttargetNewPlayerTime = getNumberAttribute(courseInfoInstance, attributes.TargetNewPlayerTime, defaults.TargetNewPlayerTime),\r\n\t\ttargetPracticedTime = getNumberAttribute(\r\n\t\t\tcourseInfoInstance,\r\n\t\t\tattributes.TargetPracticedTime,\r\n\t\t\tdefaults.TargetPracticedTime\r\n\t\t),\r\n\t\tcheckpointCount = getNumberAttribute(courseInfoInstance, attributes.CheckpointCount, defaults.CheckpointCount),\r\n\t}\r\nend\r\n\r\nlocal function getBasePart(parent: Instance?, childName: string): BasePart?\r\n\tif parent == nil then\r\n\t\treturn nil\r\n\tend\r\n\r\n\tlocal child = parent:FindFirstChild(childName)\r\n\r\n\tif child ~= nil and child:IsA(\"BasePart\") then\r\n\t\treturn child\r\n\tend\r\n\r\n\treturn nil\r\nend\r\n\r\nlocal function getFolder(parent: Instance?, childName: string): Folder?\r\n\tif parent == nil then\r\n\t\treturn nil\r\n\tend\r\n\r\n\tlocal child = parent:FindFirstChild(childName)\r\n\r\n\tif child ~= nil and child:IsA(\"Folder\") then\r\n\t\treturn child\r\n\tend\r\n\r\n\treturn nil\r\nend\r\n\r\nlocal function parseCheckpointIndex(checkpointName: string): number?\r\n\tlocal prefix = CheckpointConfig.CheckpointNamePrefix\r\n\tlocal padding = CheckpointConfig.CheckpointNumberPadding\r\n\tlocal digits = string.match(checkpointName, \"^\" .. prefix .. \"_(%d+)$\")\r\n\r\n\tif digits == nil or #digits ~= padding then\r\n\t\treturn nil\r\n\tend\r\n\r\n\treturn tonumber(digits)\r\nend\r\n\r\nlocal function discoverFallZones(fallZonesFolder: Folder?): { BasePart }\r\n\tlocal fallZones: { BasePart } = {}\r\n\r\n\tif fallZonesFolder ~= nil then\r\n\t\tfor _, descendant in ipairs(fallZonesFolder:GetDescendants()) do\r\n\t\t\tif descendant:IsA(\"BasePart\") then\r\n\t\t\t\ttable.insert(fallZones, descendant)\r\n\t\t\tend\r\n\t\tend\r\n\tend\r\n\r\n\treturn fallZones\r\nend\r\n\r\nlocal function discoverOrderedCheckpoints(checkpointsFolder: Folder?): { OrderedCheckpoint }\r\n\tlocal discoveredCheckpoints = {}\r\n\r\n\tif checkpointsFolder == nil then\r\n\t\treturn discoveredCheckpoints\r\n\tend\r\n\r\n\tfor _, child in ipairs(checkpointsFolder:GetChildren()) do\r\n\t\tif child:IsA(\"BasePart\") then\r\n\t\t\tlocal checkpointIndex = parseCheckpointIndex(child.Name)\r\n\r\n\t\t\tif checkpointIndex ~= nil then\r\n\t\t\t\ttable.insert(discoveredCheckpoints, {\r\n\t\t\t\t\tindex = checkpointIndex,\r\n\t\t\t\t\tname = child.Name,\r\n\t\t\t\t\tpart = child,\r\n\t\t\t\t})\r\n\t\t\tend\r\n\t\tend\r\n\tend\r\n\r\n\ttable.sort(discoveredCheckpoints, function(left, right)\r\n\t\treturn left.index < right.index\r\n\tend)\r\n\r\n\treturn discoveredCheckpoints\r\nend\r\n\r\nlocal function countOrderedCheckpoints(courseModel: Model): number\r\n\tlocal checkpointsFolder = getFolder(courseModel, CourseConfig.RequiredChildNames.Checkpoints)\r\n\r\n\treturn #discoverOrderedCheckpoints(checkpointsFolder)\r\nend\r\n\r\nlocal function writeCourseInfoAttributes(courseModel: Model, courseInfo: CourseInfo)\r\n\tlocal attributes = CourseConfig.CourseInfoAttributes\r\n\tlocal courseInfoInstance = ensureCourseInfoInstance(courseModel)\r\n\r\n\tcourseInfoInstance:SetAttribute(attributes.CourseId, courseInfo.courseId)\r\n\tcourseInfoInstance:SetAttribute(attributes.DisplayName, courseInfo.displayName)\r\n\tcourseInfoInstance:SetAttribute(attributes.RaceFormat, courseInfo.raceFormat)\r\n\tcourseInfoInstance:SetAttribute(attributes.LapCount, courseInfo.lapCount)\r\n\tcourseInfoInstance:SetAttribute(attributes.Enabled, courseInfo.enabled)\r\n\tcourseInfoInstance:SetAttribute(attributes.Difficulty, courseInfo.difficulty)\r\n\tcourseInfoInstance:SetAttribute(attributes.TargetNewPlayerTime, courseInfo.targetNewPlayerTime)\r\n\tcourseInfoInstance:SetAttribute(attributes.TargetPracticedTime, courseInfo.targetPracticedTime)\r\n\tcourseInfoInstance:SetAttribute(attributes.CheckpointCount, courseInfo.checkpointCount)\r\nend\r\n\r\nlocal function getClassicPointToPointCourseInfo(courseModel: Model): CourseInfo\r\n\tlocal defaults = CourseConfig.DefaultCourseInfo\r\n\r\n\treturn {\r\n\t\tcourseId = \"classic_point_to_point\",\r\n\t\tdisplayName = \"Classic Point-to-Point\",\r\n\t\traceFormat = RaceConstants.RaceFormat.PointToPoint,\r\n\t\tlapCount = 1,\r\n\t\tenabled = true,\r\n\t\tdifficulty = defaults.Difficulty,\r\n\t\ttargetNewPlayerTime = defaults.TargetNewPlayerTime,\r\n\t\ttargetPracticedTime = defaults.TargetPracticedTime,\r\n\t\tcheckpointCount = countOrderedCheckpoints(courseModel),\r\n\t}\r\nend\r\n\r\nlocal function addWarning(warnings: { string }, message: string)\r\n\ttable.insert(warnings, message)\r\nend\r\n\r\nlocal function validateCheckpointNames(checkpointsFolder: Folder?, warnings: { string })\r\n\tif checkpointsFolder == nil then\r\n\t\treturn\r\n\tend\r\n\r\n\tlocal validCheckpointCount = 0\r\n\r\n\tfor _, child in ipairs(checkpointsFolder:GetChildren()) do\r\n\t\tif child:IsA(\"BasePart\") and parseCheckpointIndex(child.Name) ~= nil then\r\n\t\t\tvalidCheckpointCount += 1\r\n\t\tend\r\n\tend\r\n\r\n\tif validCheckpointCount == 0 then\r\n\t\taddWarning(warnings, \"Checkpoints must contain at least one BasePart named Checkpoint_###.\")\r\n\tend\r\nend\r\n\r\nlocal function validateCourseModel(courseModel: Model, requireAuthoringFolders: boolean): { string }\r\n\tlocal childNames = CourseConfig.RequiredChildNames\r\n\tlocal warnings = {}\r\n\r\n\tif requireAuthoringFolders and courseModel:FindFirstChild(childNames.CourseInfo) == nil then\r\n\t\taddWarning(warnings, \"CourseInfo is missing.\")\r\n\tend\r\n\r\n\tif getBasePart(courseModel, childNames.Start) == nil then\r\n\t\taddWarning(warnings, \"Start must be a BasePart.\")\r\n\tend\r\n\r\n\tlocal checkpointsFolder = getFolder(courseModel, childNames.Checkpoints)\r\n\r\n\tif checkpointsFolder == nil then\r\n\t\taddWarning(warnings, \"Checkpoints must be a Folder.\")\r\n\telse\r\n\t\tvalidateCheckpointNames(checkpointsFolder, warnings)\r\n\tend\r\n\r\n\tif getBasePart(courseModel, childNames.Finish) == nil then\r\n\t\taddWarning(warnings, \"Finish must be a BasePart.\")\r\n\tend\r\n\r\n\tif requireAuthoringFolders and getFolder(courseModel, childNames.Obstacles) == nil then\r\n\t\taddWarning(warnings, \"Obstacles must be a Folder.\")\r\n\tend\r\n\r\n\tlocal fallZonesFolder = getFolder(courseModel, childNames.FallZones)\r\n\r\n\tif fallZonesFolder == nil then\r\n\t\taddWarning(warnings, \"FallZones must be a Folder.\")\r\n\telseif #discoverFallZones(fallZonesFolder) == 0 then\r\n\t\taddWarning(warnings, \"FallZones must contain at least one BasePart.\")\r\n\tend\r\n\r\n\tif requireAuthoringFolders and getFolder(courseModel, childNames.RouteMarkers) == nil then\r\n\t\taddWarning(warnings, \"RouteMarkers must be a Folder.\")\r\n\tend\r\n\r\n\tif requireAuthoringFolders and getFolder(courseModel, childNames.Decoration) == nil then\r\n\t\taddWarning(warnings, \"Decoration must be a Folder.\")\r\n\tend\r\n\r\n\tif requireAuthoringFolders and getFolder(courseModel, childNames.Bounds) == nil then\r\n\t\taddWarning(warnings, \"Bounds must be a Folder.\")\r\n\tend\r\n\r\n\treturn warnings\r\nend\r\n\r\nlocal function discoverCourseLibrary()\r\n\tdiscoveredCoursesById = {}\r\n\tdiscoveredCourseOrder = {}\r\n\tlocal duplicateCourseIds: { [string]: boolean } = {}\r\n\r\n\tlocal library = getCourseLibrary()\r\n\r\n\tif library == nil then\r\n\t\tprint(\"[CourseService] ServerStorage.CourseLibrary was not found; using Workspace.RaceCourse fallback.\")\r\n\t\treturn\r\n\tend\r\n\r\n\tfor _, child in ipairs(library:GetChildren()) do\r\n\t\tif child:IsA(\"Model\") then\r\n\t\t\tlocal info = readCourseInfo(child)\r\n\t\t\tif discoveredCoursesById[info.courseId] ~= nil or duplicateCourseIds[info.courseId] then\r\n\t\t\t\tduplicateCourseIds[info.courseId] = true\r\n\t\t\t\tdiscoveredCoursesById[info.courseId] = nil\r\n\t\t\t\twarn(string.format(\"[CourseService] Duplicate course ID %s; all copies are excluded until reconciled.\", info.courseId))\r\n\t\t\t\tcontinue\r\n\t\t\tend\r\n\t\t\tlocal warnings = validateCourseModel(child, true)\r\n\r\n\t\t\tdiscoveredCoursesById[info.courseId] = {\r\n\t\t\t\tmodel = child,\r\n\t\t\t\tinfo = info,\r\n\t\t\t\tvalidationWarnings = warnings,\r\n\t\t\t}\r\n\r\n\t\t\tfor _, warningMessage in ipairs(warnings) do\r\n\t\t\t\twarn(string.format(\"[CourseService] %s: %s\", child.Name, warningMessage))\r\n\t\t\tend\r\n\t\tend\r\n\tend\r\n\r\n\tfor courseId in pairs(discoveredCoursesById) do\r\n\t\ttable.insert(discoveredCourseOrder, courseId)\r\n\tend\r\n\ttable.sort(discoveredCourseOrder)\r\n\tprint(string.format(\"[CourseService] Discovered %d course model(s).\", #discoveredCourseOrder))\r\nend\r\n\r\nlocal function getFallbackActiveCourse(): Model?\r\n\tlocal activeCourse = Workspace:FindFirstChild(CourseConfig.ActiveCourseModelName)\r\n\r\n\tif activeCourse ~= nil and activeCourse:IsA(\"Model\") then\r\n\t\treturn activeCourse\r\n\tend\r\n\r\n\treturn nil\r\nend\r\n\r\nlocal function ensureClassicPointToPointCourseFromFallback()\r\n\tlocal library = ensureCourseLibrary()\r\n\tlocal existingCourse = library:FindFirstChild(CourseConfig.ClassicPointToPointCourseName)\r\n\r\n\tif existingCourse ~= nil then\r\n\t\tif existingCourse:IsA(\"Model\") then\r\n\t\t\tensureFolder(existingCourse, CourseConfig.RequiredChildNames.Obstacles)\r\n\t\t\tensureFolder(existingCourse, CourseConfig.RequiredChildNames.RouteMarkers)\r\n\t\t\tensureFolder(existingCourse, CourseConfig.RequiredChildNames.Decoration)\r\n\t\t\tensureFolder(existingCourse, CourseConfig.RequiredChildNames.Bounds)\r\n\t\t\twriteCourseInfoAttributes(existingCourse, getClassicPointToPointCourseInfo(existingCourse))\r\n\t\telse\r\n\t\t\twarn(\r\n\t\t\t\tstring.format(\r\n\t\t\t\t\t\"[CourseService] %s exists but is not a Model.\",\r\n\t\t\t\t\tCourseConfig.ClassicPointToPointCourseName\r\n\t\t\t\t)\r\n\t\t\t)\r\n\t\tend\r\n\r\n\t\treturn\r\n\tend\r\n\r\n\tlocal fallbackCourse = getFallbackActiveCourse()\r\n\r\n\tif fallbackCourse == nil then\r\n\t\treturn\r\n\tend\r\n\r\n\tlocal courseClone = fallbackCourse:Clone()\r\n\tcourseClone.Name = CourseConfig.ClassicPointToPointCourseName\r\n\tcourseClone:SetAttribute(CourseConfig.RuntimeActiveCourseAttribute, nil)\r\n\tcourseClone:SetAttribute(CourseConfig.SourceCourseIdAttribute, nil)\r\n\r\n\tensureFolder(courseClone, CourseConfig.RequiredChildNames.Obstacles)\r\n\tensureFolder(courseClone, CourseConfig.RequiredChildNames.RouteMarkers)\r\n\tensureFolder(courseClone, CourseConfig.RequiredChildNames.Decoration)\r\n\tensureFolder(courseClone, CourseConfig.RequiredChildNames.Bounds)\r\n\twriteCourseInfoAttributes(courseClone, getClassicPointToPointCourseInfo(courseClone))\r\n\r\n\tcourseClone.Parent = library\r\n\tprint(\"[CourseService] Created Course_ClassicPointToPoint from Workspace.RaceCourse fallback.\")\r\nend\r\n\r\nlocal function isPlayableCourseRecord(record: CourseRecord, allowStudioDevelopment: boolean?): boolean\r\n\tlocal studioDevelopment = allowStudioDevelopment == true and RunService:IsStudio()\r\n\t\tand record.info.courseId == \"stud_garden_v2\" and record.model:GetAttribute(\"SGV2Owned\") == true\r\n\tif record.info.enabled ~= true and not studioDevelopment then\r\n\t\treturn false\r\n\tend\r\n\r\n\tlocal warnings = validateCourseModel(record.model, false)\r\n\r\n\tfor _, warningMessage in ipairs(warnings) do\r\n\t\twarn(string.format(\"[CourseService] %s cannot be selected: %s\", record.model.Name, warningMessage))\r\n\tend\r\n\r\n\treturn #warnings == 0\r\nend\r\n\r\nlocal function selectActiveCourseRecord(): CourseRecord?\r\n\tif CourseConfig.SelectionMode ~= \"Fixed\" then\r\n\t\twarn(string.format(\"[CourseService] Unsupported selection mode %s; using Fixed.\", tostring(CourseConfig.SelectionMode)))\r\n\tend\r\n\r\n\tlocal configuredRecord = discoveredCoursesById[studioCourseId or CourseConfig.ActiveCourseId]\r\n\r\n\tif configuredRecord ~= nil and isPlayableCourseRecord(configuredRecord, studioCourseId ~= nil) then\r\n\t\treturn configuredRecord\r\n\tend\r\n\r\n\tif configuredRecord == nil then\r\n\t\twarn(string.format(\"[CourseService] Configured course id %s was not found.\", CourseConfig.ActiveCourseId))\r\n\telse\r\n\t\twarn(string.format(\"[CourseService] Configured course id %s is not playable.\", CourseConfig.ActiveCourseId))\r\n\tend\r\n\r\n\tfor _, courseId in ipairs(discoveredCourseOrder) do\r\n\t\tlocal record = discoveredCoursesById[courseId]\r\n\r\n\t\tif record ~= nil and isPlayableCourseRecord(record) then\r\n\t\t\twarn(string.format(\"[CourseService] Falling back to enabled course %s.\", courseId))\r\n\t\t\treturn record\r\n\t\tend\r\n\tend\r\n\r\n\treturn nil\r\nend\r\n\r\nlocal function getUniqueArchiveName(baseName: string): string\r\n\tlocal archive = ensureCourseArchive()\r\n\tlocal archiveName = baseName\r\n\tlocal index = 1\r\n\r\n\twhile archive:FindFirstChild(archiveName) ~= nil do\r\n\t\tindex += 1\r\n\t\tarchiveName = string.format(\"%s_%03d\", baseName, index)\r\n\tend\r\n\r\n\treturn archiveName\r\nend\r\n\r\nlocal function archiveExistingActiveCourse(activeCourse: Model)\r\n\tlocal archive = ensureCourseArchive()\r\n\tlocal archivedName = getUniqueArchiveName(activeCourse.Name .. \"_Legacy\")\r\n\r\n\tactiveCourse.Name = archivedName\r\n\tactiveCourse.Parent = archive\r\n\tprint(string.format(\"[CourseService] Archived existing active course as %s.\", activeCourse:GetFullName()))\nend\r\n\r\nlocal function spawnCourseRecord(record: CourseRecord, isCurrent: (() -> boolean)?): boolean\r\n\tlocal courseClone = record.model:Clone()\r\n\tcourseClone.Name = CourseConfig.ActiveCourseModelName\r\n\tcourseClone:SetAttribute(CourseConfig.RuntimeActiveCourseAttribute, true)\r\n\tcourseClone:SetAttribute(CourseConfig.SourceCourseIdAttribute, record.info.courseId)\r\n\r\n\tlocal warnings = validateCourseModel(courseClone, false)\r\n\r\n\tif #warnings > 0 then\r\n\t\tfor _, warningMessage in ipairs(warnings) do\r\n\t\t\twarn(string.format(\"[CourseService] Could not spawn %s: %s\", record.model.Name, warningMessage))\r\n\t\tend\r\n\r\n\t\tcourseClone:Destroy()\r\n\t\treturn false\r\n\tend\r\n\r\n\tif isCurrent and not isCurrent() then courseClone:Destroy();return false end\r\n\tlocal existingActiveCourse = getFallbackActiveCourse()\r\n\r\n\tif existingActiveCourse ~= nil then\r\n\t\tif existingActiveCourse:GetAttribute(CourseConfig.RuntimeActiveCourseAttribute) == true then\r\n\t\t\texistingActiveCourse:Destroy()\r\n\t\telse\r\n\t\t\tarchiveExistingActiveCourse(existingActiveCourse)\r\n\t\tend\r\n\tend\r\n\r\n\tcourseClone.Parent = Workspace\r\n\tactiveCourseInfo = readCourseInfo(courseClone)\r\n\r\n\tprint(\r\n\t\tstring.format(\r\n\t\t\t\"[CourseService] Spawned active course %s from %s.\",\r\n\t\t\tactiveCourseInfo.displayName,\r\n\t\t\trecord.model.Name\r\n\t\t)\r\n\t)\r\n\r\n\treturn true\r\nend\r\n\r\nlocal function prepareCourseLibrary()\n\tlocal studGardenV2 = Workspace:FindFirstChild(\"SGV2_Phase3_F04\")\r\n\tif RunService:IsStudio() and RunService:IsRunning() and studGardenV2 ~= nil then\r\n\t\tassert(studGardenV2:IsA(\"Model\") and studGardenV2:GetAttribute(\"ManualEditing\") == true\r\n\t\t\tand studGardenV2:GetAttribute(\"SGV2Owned\") == true, \"Preserve the V2 editing model\")\r\n\t\tlocal warnings = validateCourseModel(studGardenV2, true)\r\n\t\tassert(#warnings == 0, \"Stud Garden V2 is incomplete: \" .. table.concat(warnings, \"; \"))\r\n\t\tassert(readCourseInfo(studGardenV2).courseId == \"stud_garden_v2\", \"Unexpected Stud Garden V2 identity\")\r\n\t\tlocal library = ensureCourseLibrary()\r\n\t\tassert(library:FindFirstChild(studGardenV2.Name) == nil, \"Resolve the existing V2 template before replacing it\")\r\n\t\tstudGardenV2.Parent = library\r\n\tend\r\n\tlocal shipwreck = Workspace:FindFirstChild(\"Course_ShipwreckCove\")\n\tif RunService:IsRunning() and shipwreck then\n\t\tif shipwreck:IsA(\"Folder\") and shipwreck:GetAttribute(\"EditablePiecesVersion\") == 1 then\n\t\t\tshipwreck = require(ServerStorage.CourseBuilders.ShipwreckCove.Authoring).ToRuntime(shipwreck)\n\t\tend\n\t\tassert(shipwreck:IsA(\"Model\") and shipwreck:GetAttribute(\"ManualEditing\") == true, \"Preserve Shipwreck editing model\")\n\t\tlocal warnings = validateCourseModel(shipwreck, true)\n\t\tassert(#warnings == 0, \"Shipwreck candidate is incomplete: \" .. table.concat(warnings, \"; \"))\n\t\tlocal library = ensureCourseLibrary()\n\t\tlocal previous = library:FindFirstChild(shipwreck.Name)\n\t\tif previous then\n\t\t\tprevious.Name = getUniqueArchiveName(\"Shipwreck_BeforeEditing\")\n\t\t\tprevious.Parent = ensureCourseArchive()\n\t\tend\n\t\tshipwreck.Parent = library\n\tend\n\tlocal cityRun = Workspace:FindFirstChild(\"Course_CityRun\")\r\n\tif RunService:IsRunning() and cityRun ~= nil then\r\n\t\tassert(cityRun:IsA(\"Model\") and cityRun:GetAttribute(\"ManualEditing\") == true,\r\n\t\t\t\"The visible City Run must be marked ManualEditing before Play\")\r\n\t\tlocal warnings = validateCourseModel(cityRun, true)\r\n\t\tassert(#warnings == 0, \"City Run is incomplete: \" .. table.concat(warnings, \"; \"))\r\n\t\tassert(readCourseInfo(cityRun).courseId == \"city_run\", \"Unexpected City Run identity\")\r\n\t\tlocal library = ensureCourseLibrary()\r\n\t\tlocal previous = library:FindFirstChild(\"Course_CityRun\")\r\n\t\tif previous ~= nil then\r\n\t\t\tprevious.Name = getUniqueArchiveName(\"CityRun_BeforeEditing\")\r\n\t\t\tprevious.Parent = ensureCourseArchive()\r\n\t\tend\r\n\t\tcityRun.Parent = library\r\n\tend\r\n\t-- Play receives a copy of the saved Workspace; moving it here leaves Edit-mode work intact.\r\n\tlocal editable = Workspace:FindFirstChild(CourseConfig.EditableCourseModelName)\r\n\tif RunService:IsRunning() and editable ~= nil then\r\n\t\tassert(editable:IsA(\"Model\") and editable:GetAttribute(CourseConfig.ManualEditingAttribute) == true,\r\n\t\t\t\"The visible Classic Ascent must be marked ManualEditing before Play\")\r\n\t\tassert(editable:GetAttribute(\"BuilderVersion\") == 7, \"Restore V7 before using the editing course\")\r\n\t\tlocal warnings = validateCourseModel(editable, true)\r\n\t\tassert(#warnings == 0, \"The editing course is incomplete: \" .. table.concat(warnings, \"; \"))\r\n\t\tlocal library = ensureCourseLibrary()\r\n\t\tlocal previous = library:FindFirstChild(CourseConfig.EditableCourseModelName)\r\n\t\tif previous ~= nil then\r\n\t\t\tprevious.Name = getUniqueArchiveName(\"ClassicAscent_BeforeEditing\")\r\n\t\t\tprevious.Parent = ensureCourseArchive()\r\n\t\tend\r\n\t\teditable.Parent = library\r\n\tend\r\n\tensureClassicPointToPointCourseFromFallback()\r\n\tif CourseConfig.AutoBuildClassicAscent then\n\t\tlocal classicAscentBuilder = require(ServerStorage.CourseBuilders.ClassicAscentPointToPoint)\n\t\tclassicAscentBuilder.Ensure(ensureCourseLibrary())\n\tend\n\tdiscoverCourseLibrary()\r\nend\r\n\r\nlocal function ensureActiveCourse()\r\n\tprepareCourseLibrary()\r\n\r\n\tlocal selectedRecord = selectActiveCourseRecord()\r\n\r\n\tif selectedRecord ~= nil and spawnCourseRecord(selectedRecord) then\r\n\t\treturn\r\n\tend\r\n\r\n\tlocal fallbackCourse = getFallbackActiveCourse()\r\n\r\n\tif fallbackCourse == nil then\r\n\t\twarn(\"[CourseService] No active course could be spawned and no Workspace.RaceCourse fallback exists.\")\r\n\t\treturn\r\n\tend\r\n\r\n\tlocal warnings = validateCourseModel(fallbackCourse, false)\r\n\r\n\tfor _, warningMessage in ipairs(warnings) do\r\n\t\twarn(string.format(\"[CourseService] Active fallback %s: %s\", fallbackCourse.Name, warningMessage))\r\n\tend\r\n\r\n\tactiveCourseInfo = readCourseInfo(fallbackCourse)\r\n\tprint(string.format(\"[CourseService] Using active course fallback: %s.\", activeCourseInfo.displayName))\r\nend\r\n\r\nlocal function getActiveCourseInfo(): CourseInfo\r\n\tlocal activeCourse = getFallbackActiveCourse()\r\n\r\n\tif activeCourse ~= nil then\r\n\t\tactiveCourseInfo = readCourseInfo(activeCourse)\r\n\telseif activeCourseInfo == nil then\r\n\t\tactiveCourseInfo = {\r\n\t\t\tcourseId = CourseConfig.DefaultCourseInfo.CourseId,\r\n\t\t\tdisplayName = CourseConfig.DefaultCourseInfo.DisplayName,\r\n\t\t\traceFormat = normalizeRaceFormat(CourseConfig.DefaultCourseInfo.RaceFormat),\r\n\t\t\tlapCount = CourseConfig.DefaultCourseInfo.LapCount,\r\n\t\t\tenabled = CourseConfig.DefaultCourseInfo.Enabled,\r\n\t\t\tdifficulty = CourseConfig.DefaultCourseInfo.Difficulty,\r\n\t\t\ttargetNewPlayerTime = CourseConfig.DefaultCourseInfo.TargetNewPlayerTime,\r\n\t\t\ttargetPracticedTime = CourseConfig.DefaultCourseInfo.TargetPracticedTime,\r\n\t\t\tcheckpointCount = CourseConfig.DefaultCourseInfo.CheckpointCount,\r\n\t\t}\r\n\tend\r\n\r\n\treturn activeCourseInfo :: CourseInfo\r\nend\r\n\r\nfunction CourseService.Init(_context: ServiceContext?)\r\n\tif isInitialized then\r\n\t\treturn\r\n\tend\r\n\r\n\tisInitialized = true\r\nend\r\n\r\nfunction CourseService.Start(_context: 
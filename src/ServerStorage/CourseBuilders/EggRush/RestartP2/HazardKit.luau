function HazardKit.Create(parent: Instance, key: string, frame: CFrame, scale: (number | Vector3)?): Model
	local definitions = assert(templates[key], "Unknown Egg Rush hazard: " .. key)
	local factor = if typeof(scale) == "number" then V(scale, scale, scale) elseif typeof(scale) == "Vector3" then scale else Vector3.one
	local model = Instance.new("Model")
	model.Name = key
	for _, definition in definitions do
		local part = Instance.new("Part")
		part.Name = definition.name
		part.Size = definition.size * factor
		part.CFrame = frame * CFrame.new(definition.frame.Position * factor) * definition.frame.Rotation
		part.Color, part.Material = definition.color, definition.material
		part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, definition.lethal
		part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		part:SetAttribute("ERLethal", definition.lethal)
		part.Parent = model
	end
	model.WorldPivot = frame
	model.Parent = parent
	return model
end

return HazardKit
